package rb

import ovid/io
import ovid/mem

// Node kinds.
const N_INT i64 = 1
const N_STR i64 = 2
const N_DSTR i64 = 3
const N_TRUE i64 = 4
const N_FALSE i64 = 5
const N_NIL i64 = 6
const N_VAR i64 = 7
const N_ASGN i64 = 8
const N_BIN i64 = 9
const N_NOT i64 = 10
const N_NEG i64 = 11
const N_AND i64 = 12
const N_OR i64 = 13
const N_IF i64 = 14
const N_WHILE i64 = 15
const N_DEF i64 = 16
const N_CALL i64 = 17
const N_BLOCK i64 = 18
const N_RET i64 = 19
const N_ARR i64 = 20
const N_INDEX i64 = 21
const N_ISET i64 = 22
const N_BREAK i64 = 23
const N_NEXT i64 = 24
const N_RANGE i64 = 25
const N_YIELD i64 = 26

// Binary operators (N_BIN ival).
const OP_ADD i64 = 1
const OP_SUB i64 = 2
const OP_MUL i64 = 3
const OP_DIV i64 = 4
const OP_MOD i64 = 5
const OP_EQ i64 = 6
const OP_NE i64 = 7
const OP_LT i64 = 8
const OP_LE i64 = 9
const OP_GT i64 = 10
const OP_GE i64 = 11
const OP_SHL i64 = 12
const OP_POW i64 = 13

// Node is one AST node. Lists (statements, args, params, parts) chain
// through next.
type Node struct {
  kind i64
  a *Node
  b *Node
  c *Node
  next *Node
  ival i64
  p i64
  n i64
  line i64
}

func nilNode() *Node {
  return 0 as *Node
}

// eqz reports whether p[0:n] equals the NUL-terminated literal lit.
func eqz(p i64, n i64, lit i64) bool {
  var i i64 = 0
  while i < n {
    if load8(lit + i) != load8(p + i) {
      return false
    }
    i = i + 1
  }
  return load8(lit + n) == 0
}

func tok(r *R) *Tok {
  return load64(r.toks + (r.pos * 8)) as *Tok
}

func nth(r *R, k i64) *Tok {
  var i i64 = r.pos + k
  if i >= r.ntok {
    i = r.ntok - 1
  }
  return load64(r.toks + (i * 8)) as *Tok
}

func adv(r *R) *Tok {
  var t *Tok = tok(r)
  if t.kind != T_EOF {
    r.pos = r.pos + 1
  }
  return t
}

// is reports whether t is the operator or keyword lit.
func is(t *Tok, lit i64) bool {
  if t.kind != T_OP && t.kind != T_ID {
    return false
  }
  return eqz(t.p, t.n, lit)
}

func at(r *R, lit i64) bool {
  return is(tok(r), lit)
}

// accept consumes the token lit if it is next.
func accept(r *R, lit i64) bool {
  if at(r, lit) {
    adv(r)
    return true
  }
  return false
}

func expect(r *R, lit i64) bool {
  if accept(r, lit) {
    return true
  }
  var t *Tok = tok(r)
  var b *ovid/mem.Buf = ovid/mem.New(r.io, 64)
  ovid/mem.WBytes(r.io, b, strptr("syntax error: expected '"), strlen("syntax error: expected '"))
  ovid/mem.WBytes(r.io, b, lit, ovid/io.CLen(lit))
  ovid/mem.WBytes(r.io, b, strptr("', got '"), strlen("', got '"))
  if t.kind == T_EOF {
    ovid/mem.WBytes(r.io, b, strptr("end of file"), strlen("end of file"))
  } else if t.kind == T_NL {
    ovid/mem.WBytes(r.io, b, strptr("newline"), strlen("newline"))
  } else {
    ovid/mem.WBytes(r.io, b, t.p, t.n)
  }
  ovid/mem.WByte(r.io, b, 39)
  ovid/mem.WByte(r.io, b, 0)
  rerr(r, t.line, b.data)
  return false
}

func skipNL(r *R) i64 {
  while tok(r).kind == T_NL {
    adv(r)
  }
  return 0
}

func mk(r *R, kind i64, line i64) *Node {
  var n *Node = ovid/io.Alloc(r.io, sizeof(Node)) as *Node
  n.kind = kind
  n.line = line
  return n
}

// isKw reports whether t is a reserved word that cannot start an argument.
func isKw(t *Tok) bool {
  if t.kind != T_ID {
    return false
  }
  return is(t, strptr("do")) || is(t, strptr("end")) || is(t, strptr("if")) || is(t, strptr("unless")) || is(t, strptr("while")) || is(t, strptr("until")) || is(t, strptr("then")) || is(t, strptr("and")) || is(t, strptr("or")) || is(t, strptr("elsif")) || is(t, strptr("else")) || is(t, strptr("def"))
}

// endsBody reports whether t closes a statement list.
func endsBody(t *Tok) bool {
  return t.kind == T_EOF || is(t, strptr("end")) || is(t, strptr("else")) || is(t, strptr("elsif")) || is(t, strptr("}"))
}

func parseProgram(r *R) *Node {
  var body *Node = parseBody(r)
  if !r.err && tok(r).kind != T_EOF {
    expect(r, strptr("end of file"))
  }
  return body
}

func parseBody(r *R) *Node {
  var head *Node = nilNode()
  var tail *Node = nilNode()
  skipNL(r)
  while !r.err && !endsBody(tok(r)) {
    var s *Node = parseStmt(r)
    if head == nilNode() {
      head = s
    } else {
      tail.next = s
    }
    tail = s
    if !endsBody(tok(r)) && !r.err {
      if tok(r).kind != T_NL {
        expect(r, strptr("newline"))
      }
    }
    skipNL(r)
  }
  return head
}

func parseStmt(r *R) *Node {
  var t *Tok = tok(r)
  var s *Node = nilNode()
  if is(t, strptr("def")) {
    s = parseDef(r)
  } else if is(t, strptr("if")) || is(t, strptr("unless")) {
    adv(r)
    s = ifTail(r, is(t, strptr("unless")))
    expect(r, strptr("end"))
  } else if is(t, strptr("while")) || is(t, strptr("until")) {
    adv(r)
    s = mk(r, N_WHILE, t.line)
    if is(t, strptr("until")) {
      s.ival = 1
    }
    var save bool = r.nodo
    r.nodo = true
    s.a = parseExpr(r)
    r.nodo = save
    accept(r, strptr("do"))
    s.b = parseBody(r)
    expect(r, strptr("end"))
  } else if is(t, strptr("return")) {
    adv(r)
    s = mk(r, N_RET, t.line)
    if startsArg(r) {
      s.a = parseExpr(r)
    }
  } else if is(t, strptr("break")) {
    adv(r)
    s = mk(r, N_BREAK, t.line)
  } else if is(t, strptr("next")) {
    adv(r)
    s = mk(r, N_NEXT, t.line)
  } else {
    s = parseExpr(r)
  }
  // statement modifiers: x if c, x unless c, x while c
  var m *Tok = tok(r)
  while !r.err && (is(m, strptr("if")) || is(m, strptr("unless")) || is(m, strptr("while")) || is(m, strptr("until"))) {
    adv(r)
    var w *Node = nilNode()
    if is(m, strptr("if")) || is(m, strptr("unless")) {
      w = mk(r, N_IF, m.line)
      w.a = parseExpr(r)
      if is(m, strptr("unless")) {
        w.c = s
      } else {
        w.b = s
      }
    } else {
      w = mk(r, N_WHILE, m.line)
      if is(m, strptr("until")) {
        w.ival = 1
      }
      w.a = parseExpr(r)
      w.b = s
    }
    s = w
    m = tok(r)
  }
  return s
}

// ifTail parses cond, body, and any elsif/else after if, unless, or elsif;
// the caller consumes the end.
func ifTail(r *R, neg bool) *Node {
  var line i64 = tok(r).line
  var n *Node = mk(r, N_IF, line)
  n.a = parseExpr(r)
  accept(r, strptr("then"))
  var body *Node = parseBody(r)
  var other *Node = nilNode()
  if accept(r, strptr("elsif")) {
    other = ifTail(r, false)
  } else if accept(r, strptr("else")) {
    other = parseBody(r)
  }
  if neg {
    n.b = other
    n.c = body
  } else {
    n.b = body
    n.c = other
  }
  return n
}

func parseDef(r *R) *Node {
  var t *Tok = adv(r)
  var name *Tok = adv(r)
  if name.kind != T_ID {
    rerr(r, name.line, strptr("syntax error: expected a method name"))
    return mk(r, N_NIL, t.line)
  }
  var d *Node = mk(r, N_DEF, t.line)
  d.p = name.p
  d.n = name.n
  if accept(r, strptr("(")) {
    d.a = parseParams(r, strptr(")"))
    expect(r, strptr(")"))
  } else if tok(r).kind == T_ID {
    d.a = parseParams(r, strptr("\n"))
  }
  d.b = parseBody(r)
  expect(r, strptr("end"))
  return d
}

// parseParams reads a comma-separated list of names up to close.
func parseParams(r *R, close i64) *Node {
  var head *Node = nilNode()
  var tail *Node = nilNode()
  while !r.err && tok(r).kind == T_ID {
    var t *Tok = adv(r)
    var v *Node = mk(r, N_VAR, t.line)
    v.p = t.p
    v.n = t.n
    if head == nilNode() {
      head = v
    } else {
      tail.next = v
    }
    tail = v
    if !accept(r, strptr(",")) {
      return head
    }
  }
  return head
}

func parseExpr(r *R) *Node {
  return parseLowOr(r)
}

func parseLowOr(r *R) *Node {
  var e *Node = parseLowAnd(r)
  while at(r, strptr("or")) {
    var t *Tok = adv(r)
    var n *Node = mk(r, N_OR, t.line)
    n.a = e
    n.b = parseLowAnd(r)
    e = n
  }
  return e
}

func parseLowAnd(r *R) *Node {
  var e *Node = parseLowNot(r)
  while at(r, strptr("and")) {
    var t *Tok = adv(r)
    var n *Node = mk(r, N_AND, t.line)
    n.a = e
    n.b = parseLowNot(r)
    e = n
  }
  return e
}

func parseLowNot(r *R) *Node {
  if at(r, strptr("not")) {
    var t *Tok = adv(r)
    var n *Node = mk(r, N_NOT, t.line)
    n.a = parseLowNot(r)
    return n
  }
  return parseAssign(r)
}

// assignOp returns the operator of = or op= at t: 0 for plain =, -1 for none.
func assignOp(t *Tok) i64 {
  if is(t, strptr("=")) {
    return 0
  } else if is(t, strptr("+=")) {
    return OP_ADD
  } else if is(t, strptr("-=")) {
    return OP_SUB
  } else if is(t, strptr("*=")) {
    return OP_MUL
  } else if is(t, strptr("/=")) {
    return OP_DIV
  }
  return -1
}

func parseAssign(r *R) *Node {
  var t *Tok = tok(r)
  if t.kind == T_ID && !isKw(t) && assignOp(nth(r, 1)) >= 0 {
    adv(r)
    var op i64 = assignOp(adv(r))
    var n *Node = mk(r, N_ASGN, t.line)
    n.p = t.p
    n.n = t.n
    skipNL(r)
    var rhs *Node = parseAssign(r)
    if op > 0 {
      var v *Node = mk(r, N_VAR, t.line)
      v.p = t.p
      v.n = t.n
      rhs = bin(r, op, v, rhs, t.line)
    }
    n.a = rhs
    return n
  }
  var e *Node = parseTernary(r)
  if e.kind == N_INDEX && assignOp(tok(r)) >= 0 {
    var op2 i64 = assignOp(adv(r))
    var s *Node = mk(r, N_ISET, e.line)
    s.a = e.a
    s.b = e.b
    skipNL(r)
    var rhs2 *Node = parseAssign(r)
    if op2 > 0 {
      rhs2 = bin(r, op2, e, rhs2, e.line)
    }
    s.c = rhs2
    return s
  }
  return e
}

func bin(r *R, op i64, a *Node, b *Node, line i64) *Node {
  var n *Node = mk(r, N_BIN, line)
  n.ival = op
  n.a = a
  n.b = b
  return n
}

func parseTernary(r *R) *Node {
  var c *Node = parseRange(r)
  if at(r, strptr("?")) {
    var t *Tok = adv(r)
    var n *Node = mk(r, N_IF, t.line)
    n.a = c
    n.b = parseTernary(r)
    expect(r, strptr(":"))
    n.c = parseTernary(r)
    return n
  }
  return c
}

func parseRange(r *R) *Node {
  var a *Node = parseOr(r)
  if at(r, strptr("..")) {
    var t *Tok = adv(r)
    var n *Node = mk(r, N_RANGE, t.line)
    n.a = a
    n.b = parseOr(r)
    return n
  }
  return a
}

func parseOr(r *R) *Node {
  var e *Node = parseAnd(r)
  while at(r, strptr("||")) {
    var t *Tok = adv(r)
    skipNL(r)
    var n *Node = mk(r, N_OR, t.line)
    n.a = e
    n.b = parseAnd(r)
    e = n
  }
  return e
}

func parseAnd(r *R) *Node {
  var e *Node = parseEq(r)
  while at(r, strptr("&&")) {
    var t *Tok = adv(r)
    skipNL(r)
    var n *Node = mk(r, N_AND, t.line)
    n.a = e
    n.b = parseEq(r)
    e = n
  }
  return e
}

func parseEq(r *R) *Node {
  var e *Node = parseRel(r)
  var going bool = true
  while going {
    var t *Tok = tok(r)
    if is(t, strptr("==")) {
      adv(r)
      e = bin(r, OP_EQ, e, parseRel(r), t.line)
    } else if is(t, strptr("!=")) {
      adv(r)
      e = bin(r, OP_NE, e, parseRel(r), t.line)
    } else {
      going = false
    }
  }
  return e
}

func parseRel(r *R) *Node {
  var e *Node = parseShift(r)
  var going bool = true
  while going {
    var t *Tok = tok(r)
    var op i64 = 0
    if is(t, strptr("<")) {
      op = OP_LT
    } else if is(t, strptr("<=")) {
      op = OP_LE
    } else if is(t, strptr(">")) {
      op = OP_GT
    } else if is(t, strptr(">=")) {
      op = OP_GE
    }
    if op == 0 {
      going = false
    } else {
      adv(r)
      e = bin(r, op, e, parseShift(r), t.line)
    }
  }
  return e
}

func parseShift(r *R) *Node {
  var e *Node = parseAdd(r)
  while at(r, strptr("<<")) {
    var t *Tok = adv(r)
    e = bin(r, OP_SHL, e, parseAdd(r), t.line)
  }
  return e
}

func parseAdd(r *R) *Node {
  var e *Node = parseMul(r)
  var going bool = true
  while going {
    var t *Tok = tok(r)
    if is(t, strptr("+")) {
      adv(r)
      skipNL(r)
      e = bin(r, OP_ADD, e, parseMul(r), t.line)
    } else if is(t, strptr("-")) {
      adv(r)
      skipNL(r)
      e = bin(r, OP_SUB, e, parseMul(r), t.line)
    } else {
      going = false
    }
  }
  return e
}

func parseMul(r *R) *Node {
  var e *Node = parseUnary(r)
  var going bool = true
  while going {
    var t *Tok = tok(r)
    var op i64 = 0
    if is(t, strptr("*")) {
      op = OP_MUL
    } else if is(t, strptr("/")) {
      op = OP_DIV
    } else if is(t, strptr("%")) {
      op = OP_MOD
    }
    if op == 0 {
      going = false
    } else {
      adv(r)
      skipNL(r)
      e = bin(r, op, e, parseUnary(r), t.line)
    }
  }
  return e
}

func parseUnary(r *R) *Node {
  var t *Tok = tok(r)
  if is(t, strptr("-")) && !(nth(r, 1).kind == T_INT && !nth(r, 1).sp) {
    adv(r)
    var n *Node = mk(r, N_NEG, t.line)
    n.a = parseUnary(r)
    return n
  } else if is(t, strptr("!")) {
    adv(r)
    var m *Node = mk(r, N_NOT, t.line)
    m.a = parseUnary(r)
    return m
  }
  return parsePow(r)
}

func parsePow(r *R) *Node {
  var e *Node = parsePostfix(r)
  if at(r, strptr("**")) {
    var t *Tok = adv(r)
    return bin(r, OP_POW, e, parseUnary(r), t.line)
  }
  return e
}

// startsArg reports whether the next token begins an argument of a call
// written without parentheses: puts x, return x.
func startsArg(r *R) bool {
  var t *Tok = tok(r)
  if t.kind == T_INT || t.kind == T_STR || t.kind == T_SQSTR || is(t, strptr("(")) {
    return true
  }
  if t.kind == T_ID {
    return !isKw(t)
  }
  if t.kind == T_OP && t.sp && !nth(r, 1).sp {
    return is(t, strptr("-")) || is(t, strptr("[")) || is(t, strptr("!")) || is(t, strptr(":"))
  }
  return is(t, strptr("("))
}

func parseArgs(r *R, close i64) *Node {
  var head *Node = nilNode()
  var tail *Node = nilNode()
  skipNL(r)
  while !r.err && !at(r, close) {
    var a *Node = parseExpr(r)
    if head == nilNode() {
      head = a
    } else {
      tail.next = a
    }
    tail = a
    skipNL(r)
    if !accept(r, strptr(",")) {
      return head
    }
    skipNL(r)
  }
  return head
}

// parseCmdArgs reads the arguments of a call written without parentheses.
func parseCmdArgs(r *R) *Node {
  var head *Node = parseAssign(r)
  var tail *Node = head
  while !r.err && accept(r, strptr(",")) {
    skipNL(r)
    var a *Node = parseAssign(r)
    tail.next = a
    tail = a
  }
  return head
}

// callRest parses the arguments and block of a call to name t.
func callRest(r *R, recv *Node, t *Tok) *Node {
  var c *Node = mk(r, N_CALL, t.line)
  c.p = t.p
  c.n = t.n
  c.a = recv
  var nt *Tok = tok(r)
  if is(nt, strptr("(")) && !nt.sp {
    adv(r)
    c.b = parseArgs(r, strptr(")"))
    expect(r, strptr(")"))
  } else if startsArg(r) {
    // f (x).y passes (x).y, as in Ruby
    c.b = parseCmdArgs(r)
  }
  c.c = parseBlock(r)
  return c
}

func parseBlock(r *R) *Node {
  var t *Tok = tok(r)
  var close i64 = 0
  if is(t, strptr("do")) && !r.nodo {
    close = strptr("end")
  } else if is(t, strptr("{")) {
    close = strptr("}")
  } else {
    return nilNode()
  }
  adv(r)
  var b *Node = mk(r, N_BLOCK, t.line)
  if accept(r, strptr("|")) {
    b.a = parseParams(r, strptr("|"))
    expect(r, strptr("|"))
  }
  var save bool = r.nodo
  r.nodo = false
  b.b = parseBody(r)
  r.nodo = save
  expect(r, close)
  return b
}

func parsePostfix(r *R) *Node {
  var e *Node = parsePrimary(r)
  var going bool = true
  while going && !r.err {
    var t *Tok = tok(r)
    if is(t, strptr(".")) || (t.kind == T_NL && is(nth(r, 1), strptr("."))) {
      if t.kind == T_NL {
        adv(r)
      }
      adv(r)
      var name *Tok = adv(r)
      if name.kind != T_ID {
        rerr(r, name.line, strptr("syntax error: expected a method name after '.'"))
        return e
      }
      e = callRest(r, e, name)
    } else if is(t, strptr("[")) && !t.sp {
      adv(r)
      var ix *Node = mk(r, N_INDEX, t.line)
      ix.a = e
      ix.b = parseExpr(r)
      expect(r, strptr("]"))
      e = ix
    } else {
      going = false
    }
  }
  return e
}

func parsePrimary(r *R) *Node {
  var t *Tok = adv(r)
  if is(t, strptr("-")) && nth(r, 0).kind == T_INT {
    // -2 is a literal, so -2.abs is 2
    var lit *Tok = adv(r)
    var neg *Node = mk(r, N_INT, t.line)
    neg.ival = 0 - lit.ival
    return neg
  } else if t.kind == T_INT {
    var n *Node = mk(r, N_INT, t.line)
    n.ival = t.ival
    return n
  } else if t.kind == T_STR {
    return parseStr(r, t)
  } else if t.kind == T_SQSTR {
    var b *ovid/mem.Buf = ovid/mem.New(r.io, t.n + 1)
    var i i64 = 0
    while i < t.n {
      var c i64 = load8(t.p + i)
      if c == 92 && (i + 1) < t.n && (load8(t.p + i + 1) == 39 || load8(t.p + i + 1) == 92) {
        i = i + 1
        c = load8(t.p + i)
      }
      ovid/mem.WByte(r.io, b, c)
      i = i + 1
    }
    var s *Node = mk(r, N_STR, t.line)
    s.p = b.data
    s.n = b.len
    return s
  } else if is(t, strptr("(")) {
    var save bool = r.nodo
    r.nodo = false
    skipNL(r)
    var e *Node = parseExpr(r)
    skipNL(r)
    r.nodo = save
    expect(r, strptr(")"))
    return e
  } else if is(t, strptr("[")) {
    var a *Node = mk(r, N_ARR, t.line)
    a.a = parseArgs(r, strptr("]"))
    expect(r, strptr("]"))
    return a
  } else if t.kind == T_ID {
    if is(t, strptr("true")) {
      return mk(r, N_TRUE, t.line)
    } else if is(t, strptr("false")) {
      return mk(r, N_FALSE, t.line)
    } else if is(t, strptr("nil")) {
      return mk(r, N_NIL, t.line)
    } else if is(t, strptr("yield")) {
      var y *Node = callRest(r, nilNode(), t)
      y.kind = N_YIELD
      return y
    } else if isKw(t) {
      return unexpected(r, t)
    }
    var nt *Tok = tok(r)
    if (is(nt, strptr("(")) && !nt.sp) || startsArg(r) || is(nt, strptr("{")) || (is(nt, strptr("do")) && !r.nodo) {
      return callRest(r, nilNode(), t)
    }
    var v *Node = mk(r, N_VAR, t.line)
    v.p = t.p
    v.n = t.n
    return v
  }
  return unexpected(r, t)
}

func unexpected(r *R, t *Tok) *Node {
  if !r.err {
    var b *ovid/mem.Buf = ovid/mem.New(r.io, 64)
    ovid/mem.WBytes(r.io, b, strptr("syntax error: unexpected '"), strlen("syntax error: unexpected '"))
    if t.kind == T_EOF {
      ovid/mem.WBytes(r.io, b, strptr("end of file"), strlen("end of file"))
    } else if t.kind == T_NL {
      ovid/mem.WBytes(r.io, b, strptr("newline"), strlen("newline"))
    } else {
      ovid/mem.WBytes(r.io, b, t.p, t.n)
    }
    ovid/mem.WByte(r.io, b, 39)
    ovid/mem.WByte(r.io, b, 0)
    rerr(r, t.line, b.data)
  }
  return mk(r, N_NIL, t.line)
}

// parseStr turns a double-quoted literal into N_STR, or N_DSTR whose parts
// are literal N_STRs and the expressions of each #{...}.
func parseStr(r *R, t *Tok) *Node {
  var head *Node = nilNode()
  var tail *Node = nilNode()
  var b *ovid/mem.Buf = ovid/mem.New(r.io, t.n + 1)
  var interp bool = false
  var i i64 = 0
  var line i64 = t.line
  while i < t.n && !r.err {
    var c i64 = load8(t.p + i)
    if c == 92 && (i + 1) < t.n {
      i = i + 1
      var e i64 = load8(t.p + i)
      if e == 110 {
        ovid/mem.WByte(r.io, b, 10)
      } else if e == 116 {
        ovid/mem.WByte(r.io, b, 9)
      } else if e == 101 {
        ovid/mem.WByte(r.io, b, 27)
      } else if e == 48 {
        ovid/mem.WByte(r.io, b, 0)
      } else {
        ovid/mem.WByte(r.io, b, e)
      }
      i = i + 1
    } else if c == 35 && (i + 1) < t.n && load8(t.p + i + 1) == 123 {
      interp = true
      var lit *Node = mk(r, N_STR, line)
      lit.p = b.data
      lit.n = b.len
      b = ovid/mem.New(r.io, 16)
      var s i64 = i + 2
      var j i64 = s
      var depth i64 = 1
      while j < t.n && depth > 0 {
        if load8(t.p + j) == 123 {
          depth = depth + 1
        } else if load8(t.p + j) == 125 {
          depth = depth - 1
        }
        if depth > 0 {
          j = j + 1
        }
      }
      var e2 *Node = subExpr(r, t.p + s, j - s, line)
      lit.next = e2
      if head == nilNode() {
        head = lit
      } else {
        tail.next = lit
      }
      tail = e2
      i = j + 1
    } else {
      if c == 10 {
        line = line + 1
      }
      ovid/mem.WByte(r.io, b, c)
      i = i + 1
    }
  }
  var last *Node = mk(r, N_STR, line)
  last.p = b.data
  last.n = b.len
  if !interp {
    last.line = t.line
    return last
  }
  tail.next = last
  var d *Node = mk(r, N_DSTR, t.line)
  d.a = head
  return d
}

// subExpr parses p[0:n], the inside of #{...}, as one expression.
func subExpr(r *R, p i64, n i64, line i64) *Node {
  var toks i64 = r.toks
  var ntok i64 = r.ntok
  var captok i64 = r.captok
  var pos i64 = r.pos
  var save bool = r.nodo
  r.nodo = false
  var e *Node = mk(r, N_NIL, line)
  if lex(r, p, n, line) == 0 {
    r.pos = 0
    skipNL(r)
    if tok(r).kind != T_EOF {
      e = parseExpr(r)
      skipNL(r)
      if !r.err && tok(r).kind != T_EOF {
        unexpected(r, tok(r))
      }
    }
  }
  r.toks = toks
  r.ntok = ntok
  r.captok = captok
  r.pos = pos
  r.nodo = save
  return e
}
