package rb

import ovid/io
import ovid/mem

// Value kinds.
const V_NIL i64 = 0
const V_BOOL i64 = 1
const V_INT i64 = 2
const V_STR i64 = 3
const V_ARR i64 = 4
const V_RANGE i64 = 5

// Val is a Ruby object. Strings are p[0:n]; arrays hold n *Val at p with
// room for cap; ranges are i..n; ints and bools use i.
type Val struct {
  kind i64
  i i64
  p i64
  n i64
  cap i64
}

const INT_LO i64 = -256
const INT_HI i64 = 1024

func newVal(r *R, kind i64) *Val {
  var v *Val = ovid/io.Alloc(r.io, sizeof(Val)) as *Val
  v.kind = kind
  return v
}

func mkInt(r *R, i i64) *Val {
  if i >= INT_LO && i < INT_HI {
    return load64(r.ints + ((i - INT_LO) * 8)) as *Val
  }
  var v *Val = newVal(r, V_INT)
  v.i = i
  return v
}

func mkBool(r *R, b bool) *Val {
  if b {
    return r.truev
  }
  return r.falsev
}

func mkStr(r *R, p i64, n i64) *Val {
  var v *Val = newVal(r, V_STR)
  v.p = p
  v.n = n
  return v
}

func bufStr(r *R, b *ovid/mem.Buf) *Val {
  return mkStr(r, b.data, b.len)
}

func mkArr(r *R, cap i64) *Val {
  var v *Val = newVal(r, V_ARR)
  if cap < 4 {
    cap = 4
  }
  v.p = ovid/io.Alloc(r.io, cap * 8)
  v.cap = cap
  return v
}

func at8(a *Val, i i64) *Val {
  return load64(a.p + (i * 8)) as *Val
}

func push(r *R, a *Val, v *Val) *Val {
  if a.n == a.cap {
    var nc i64 = a.cap * 2
    var np i64 = ovid/io.Alloc(r.io, nc * 8)
    ovid/mem.Copy(np, a.p, a.n * 8)
    a.p = np
    a.cap = nc
  }
  store64(a.p + (a.n * 8), v as i64)
  a.n = a.n + 1
  return a
}

// toArr is the elements of an array or range.
func toArr(r *R, v *Val) *Val {
  if v.kind == V_ARR {
    return v
  }
  var a *Val = mkArr(r, (v.n - v.i) + 1)
  var i i64 = v.i
  while i <= v.n {
    push(r, a, mkInt(r, i))
    i = i + 1
  }
  return a
}

func truthy(v *Val) bool {
  return v.kind != V_NIL && !(v.kind == V_BOOL && v.i == 0)
}

func typeName(v *Val) i64 {
  if v.kind == V_NIL {
    return strptr("NilClass")
  } else if v.kind == V_BOOL {
    if v.i != 0 {
      return strptr("TrueClass")
    }
    return strptr("FalseClass")
  } else if v.kind == V_INT {
    return strptr("Integer")
  } else if v.kind == V_STR {
    return strptr("String")
  } else if v.kind == V_ARR {
    return strptr("Array")
  }
  return strptr("Range")
}

func wlit(r *R, b *ovid/mem.Buf, lit i64) i64 {
  return ovid/mem.WBytes(r.io, b, lit, ovid/io.CLen(lit))
}

func wint(r *R, b *ovid/mem.Buf, i i64) i64 {
  ovid/mem.Grow(r.io, b, 52)
  b.len = b.len + ovid/mem.FormatI64(b.data + b.len, i)
  return 0
}

// tos appends v.to_s to b.
func tos(r *R, v *Val, b *ovid/mem.Buf) i64 {
  if v.kind == V_NIL {
    return 0
  } else if v.kind == V_STR {
    return ovid/mem.WBytes(r.io, b, v.p, v.n)
  }
  return inspect(r, v, b)
}

// inspect appends v.inspect to b.
func inspect(r *R, v *Val, b *ovid/mem.Buf) i64 {
  if v.kind == V_NIL {
    return wlit(r, b, strptr("nil"))
  } else if v.kind == V_BOOL {
    if v.i != 0 {
      return wlit(r, b, strptr("true"))
    }
    return wlit(r, b, strptr("false"))
  } else if v.kind == V_INT {
    return wint(r, b, v.i)
  } else if v.kind == V_STR {
    ovid/mem.WByte(r.io, b, 34)
    var i i64 = 0
    while i < v.n {
      var c i64 = load8(v.p + i)
      var after i64 = 0
      if (i + 1) < v.n {
        after = load8(v.p + i + 1)
      }
      if c == 34 || c == 92 || (c == 35 && (after == 123 || after == 36 || after == 64)) {
        ovid/mem.WByte(r.io, b, 92)
        ovid/mem.WByte(r.io, b, c)
      } else if c == 10 {
        wlit(r, b, strptr("\\n"))
      } else if c == 9 {
        wlit(r, b, strptr("\\t"))
      } else if c == 27 {
        wlit(r, b, strptr("\\e"))
      } else {
        ovid/mem.WByte(r.io, b, c)
      }
      i = i + 1
    }
    return ovid/mem.WByte(r.io, b, 34)
  } else if v.kind == V_ARR {
    ovid/mem.WByte(r.io, b, 91)
    var j i64 = 0
    while j < v.n {
      if j > 0 {
        wlit(r, b, strptr(", "))
      }
      inspect(r, at8(v, j), b)
      j = j + 1
    }
    return ovid/mem.WByte(r.io, b, 93)
  }
  wint(r, b, v.i)
  wlit(r, b, strptr(".."))
  return wint(r, b, v.n)
}

func valEq(a *Val, b *Val) bool {
  if a.kind != b.kind {
    return false
  }
  if a.kind == V_STR {
    return ovid/mem.Eq(a.p, a.n, b.p, b.n)
  } else if a.kind == V_ARR {
    if a.n != b.n {
      return false
    }
    var i i64 = 0
    while i < a.n {
      if !valEq(at8(a, i), at8(b, i)) {
        return false
      }
      i = i + 1
    }
    return true
  } else if a.kind == V_RANGE {
    return a.i == b.i && a.n == b.n
  }
  return a.i == b.i
}

// cmpv orders two ints or two strings: <0, 0, >0. Anything else is an error.
func cmpv(r *R, a *Val, b *Val, line i64) i64 {
  if a.kind == V_INT && b.kind == V_INT {
    if a.i < b.i {
      return -1
    } else if a.i > b.i {
      return 1
    }
    return 0
  }
  if a.kind == V_STR && b.kind == V_STR {
    var i i64 = 0
    while i < a.n && i < b.n {
      var d i64 = load8(a.p + i) - load8(b.p + i)
      if d != 0 {
        return d
      }
      i = i + 1
    }
    return a.n - b.n
  }
  var m *ovid/mem.Buf = ovid/mem.New(r.io, 64)
  wlit(r, m, strptr("comparison of "))
  wlit(r, m, typeName(a))
  wlit(r, m, strptr(" with "))
  inspect(r, b, m)
  wlit(r, m, strptr(" failed (ArgumentError)"))
  ovid/mem.WByte(r.io, m, 0)
  rerr(r, line, m.data)
  return 0
}
