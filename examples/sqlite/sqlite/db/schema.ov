package sqlite/db

import ovid/io
import ovid/mem

// Table is one table from sqlite_schema. ipk is the index of the column
// declared INTEGER PRIMARY KEY, or -1: that column is the rowid, and its
// slot in the record is NULL. real has one byte per column, 1 where the
// declared type gives REAL affinity: there an integer in the record is a
// whole-number real.
type Table struct {
  name i64
  namen i64
  root i64
  sql i64
  sqln i64
  ipk i64
  ncol i64
  real i64
  next *Table
}

// Tables reads sqlite_schema (the table rooted at page 1) and returns its
// tables in the order they were created. Check c.err afterwards.
func Tables(io *ovid/io.Cap, c *Cursor) *Table {
  var head *Table = 0 as *Table
  var tail *Table = 0 as *Table
  var rec *Rec = NewRec(io)
  First(c, 1)
  while Next(c) {
    // Columns: type, name, tbl_name, rootpage, sql.
    RecInit(rec, c.payload)
    var t *Table = ovid/io.Alloc(io, sizeof(Table)) as *Table
    var isTable bool = false
    var col i64 = 0
    while RecNext(rec) {
      if col == 0 {
        isTable = rec.kind == KText && ovid/mem.Eq(rec.ptr, rec.len, strptr("table"), strlen("table"))
      } else if col == 1 {
        t.name = rec.ptr
        t.namen = rec.len
      } else if col == 3 {
        t.root = rec.ival
      } else if col == 4 && rec.kind == KText {
        t.sql = rec.ptr
        t.sqln = rec.len
      }
      col = col + 1
    }
    if isTable {
      columns(io, t)
      if tail == 0 as *Table {
        head = t
      } else {
        tail.next = t
      }
      tail = t
    }
  }
  return head
}

func lower(c i64) i64 {
  if c >= 65 && c <= 90 {
    return c + 32
  }
  return c
}

func isWord(c i64) bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128
}

func isSpace(c i64) bool {
  return c == 32 || c == 9 || c == 10 || c == 13
}

// EqFold reports whether two byte strings are equal ignoring ASCII case.
func EqFold(a i64, an i64, b i64, bn i64) bool {
  if an != bn {
    return false
  }
  var i i64 = 0
  while i < an {
    if lower(load8(a + i)) != lower(load8(b + i)) {
      return false
    }
    i = i + 1
  }
  return true
}

// FindTable is the table with the given name, or 0.
func FindTable(t *Table, name i64, namen i64) *Table {
  while t != 0 as *Table {
    if EqFold(t.name, t.namen, name, namen) {
      return t
    }
    t = t.next
  }
  return t
}

// skipQuoted returns the index after the quoted token starting at i, or i
// when no quote starts there.
func skipQuoted(p i64, n i64, i i64) i64 {
  var q i64 = load8(p + i)
  if q == 91 {
    q = 93
  } else if q != 34 && q != 39 && q != 96 {
    return i
  }
  i = i + 1
  while i < n && load8(p + i) != q {
    i = i + 1
  }
  return i + 1
}

// wordAt reports whether the keyword lit (lower case, litn bytes) is the
// whole word starting at i.
func wordAt(p i64, n i64, i i64, lit i64, litn i64) bool {
  if (i + litn) > n || !EqFold(p + i, litn, lit, litn) {
    return false
  }
  return (i + litn) == n || !isWord(load8((p + i) + litn))
}

// afterName returns the index after the column name that starts the
// definition at p, and the spaces behind it.
func afterName(p i64, n i64) i64 {
  var i i64 = 0
  while i < n && isSpace(load8(p + i)) {
    i = i + 1
  }
  var j i64 = skipQuoted(p, n, i)
  if j == i {
    while j < n && isWord(load8(p + j)) {
      j = j + 1
    }
  }
  while j < n && isSpace(load8(p + j)) {
    j = j + 1
  }
  return j
}

// isIPK reports whether the column definition at p is "name INTEGER ...
// PRIMARY KEY ...": the one spelling that makes a column the rowid.
func isIPK(p i64, n i64) bool {
  var i i64 = afterName(p, n)
  if !wordAt(p, n, i, strptr("integer"), 7) {
    return false
  }
  i = i + 7
  while i < n {
    if wordAt(p, n, i, strptr("primary"), 7) && !isWord(load8((p + i) - 1)) {
      i = i + 7
      while i < n && isSpace(load8(p + i)) {
        i = i + 1
      }
      return wordAt(p, n, i, strptr("key"), 3)
    }
    i = i + 1
  }
  return false
}

// endsType reports whether a column constraint starts at i, which is
// where the declared type stops.
func endsType(p i64, n i64, i i64) bool {
  if isWord(load8((p + i) - 1)) {
    return false
  }
  return wordAt(p, n, i, strptr("constraint"), 10) || wordAt(p, n, i, strptr("primary"), 7) || wordAt(p, n, i, strptr("not"), 3) || wordAt(p, n, i, strptr("null"), 4) || wordAt(p, n, i, strptr("unique"), 6) || wordAt(p, n, i, strptr("check"), 5) || wordAt(p, n, i, strptr("default"), 7) || wordAt(p, n, i, strptr("collate"), 7) || wordAt(p, n, i, strptr("references"), 10) || wordAt(p, n, i, strptr("generated"), 9) || wordAt(p, n, i, strptr("as"), 2)
}

// has reports whether lit (litn bytes) occurs in p[from:to], ignoring case.
func has(p i64, from i64, to i64, lit i64, litn i64) bool {
  while (from + litn) <= to {
    if EqFold(p + from, litn, lit, litn) {
      return true
    }
    from = from + 1
  }
  return false
}

// isReal reports whether the column definition at p has REAL affinity, by
// SQLite's rules on the declared type: INT wins, then CHAR, CLOB, TEXT,
// then BLOB or no type, and only then REAL, FLOA, DOUB.
func isReal(p i64, n i64) bool {
  var i i64 = afterName(p, n)
  var end i64 = i
  while end < n && !endsType(p, n, end) {
    end = end + 1
  }
  if has(p, i, end, strptr("int"), 3) || has(p, i, end, strptr("char"), 4) || has(p, i, end, strptr("clob"), 4) || has(p, i, end, strptr("text"), 4) || has(p, i, end, strptr("blob"), 4) {
    return false
  }
  return has(p, i, end, strptr("real"), 4) || has(p, i, end, strptr("floa"), 4) || has(p, i, end, strptr("doub"), 4)
}

// columns walks the column definitions of t's CREATE TABLE statement and
// fills ipk, ncol, and real. A table-level PRIMARY KEY(col) constraint is
// not recognized as a rowid alias.
func columns(io *ovid/io.Cap, t *Table) i64 {
  var sql i64 = t.sql
  var n i64 = t.sqln
  t.ipk = -1
  t.real = ovid/io.Alloc(io, (n / 2) + 1)
  var i i64 = 0
  while i < n && load8(sql + i) != 40 {
    i = i + 1
  }
  i = i + 1
  var start i64 = i
  var col i64 = 0
  var depth i64 = 0
  while i < n {
    var c i64 = load8(sql + i)
    var q i64 = skipQuoted(sql, n, i)
    if q != i {
      i = q - 1
    } else if c == 40 {
      depth = depth + 1
    } else if c == 41 && depth > 0 {
      depth = depth - 1
    } else if (c == 44 && depth == 0) || c == 41 {
      if t.ipk < 0 && isIPK(sql + start, i - start) {
        t.ipk = col
      }
      if isReal(sql + start, i - start) {
        store8(t.real + col, 1)
      }
      col = col + 1
      start = i + 1
      if c == 41 {
        i = n
      }
    }
    i = i + 1
  }
  t.ncol = col
  return 0
}
