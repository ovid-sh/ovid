package sqlite/db

import ovid/io
import ovid/test

func TestVarint(io *ovid/io.Cap) i64 {
  var r *Rd = ovid/io.Alloc(io, sizeof(Rd)) as *Rd
  var p i64 = ovid/io.Alloc(io, 16)
  // 0x81 0x00 is 128; then nine 0xff bytes are -1.
  store8(p, 0x81)
  store64(p + 2, -1)
  store8(p + 10, 0xff)
  r.p = p
  if !ovid/test.Eq(io, Varint(r), 128) {
    return 1
  }
  if !ovid/test.Eq(io, Varint(r), -1) {
    return 2
  }
  if !ovid/test.Eq(io, r.p - p, 11) {
    return 3
  }
  return 0
}

func TestBeInt(io *ovid/io.Cap) i64 {
  var p i64 = ovid/io.Alloc(io, 8)
  store8(p, 0xff)
  store8(p + 1, 0x7f)
  if !ovid/test.Eq(io, beInt(p, 2), -129) {
    return 1
  }
  if !ovid/test.Eq(io, Be16(p), 0xff7f) {
    return 2
  }
  return 0
}

func col(io *ovid/io.Cap, sql i64, ipk i64, ncol i64, real i64) bool {
  var t *Table = ovid/io.Alloc(io, sizeof(Table)) as *Table
  t.sql = sql
  t.sqln = ovid/io.CLen(sql)
  columns(io, t)
  var mask i64 = 0
  var i i64 = 0
  while i < t.ncol {
    mask = mask | (load8(t.real + i) << i)
    i = i + 1
  }
  return ovid/test.Eq(io, t.ipk, ipk) && ovid/test.Eq(io, t.ncol, ncol) && ovid/test.Eq(io, mask, real)
}

func TestColumns(io *ovid/io.Cap) i64 {
  if !col(io, strptr("CREATE TABLE t(a, b REAL, c INTEGER PRIMARY KEY, d DOUBLE)"), 2, 4, 10) {
    return 1
  }
  if !col(io, strptr("create table \"x,y\" (\"a,b\" integer not null primary key autoincrement, v decimal(10,2), w float default (1.0))"), 0, 3, 4) {
    return 2
  }
  // INT is not INTEGER, so no rowid alias; "floating point" has INT in it.
  if !col(io, strptr("CREATE TABLE t(a INT PRIMARY KEY, b FLOATING POINT, c REAL)"), -1, 3, 4) {
    return 3
  }
  return 0
}
