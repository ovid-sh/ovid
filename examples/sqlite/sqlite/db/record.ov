package sqlite/db

import ovid/io

// The kinds of value a record column holds.
const KNull i64 = 0
const KInt i64 = 1
const KReal i64 = 2
const KText i64 = 3
const KBlob i64 = 4

// Rec reads the columns of one record in order. After RecNext returns
// true: kind is the column's kind; ival is a KInt's value or the IEEE 754
// bits of a KReal; ptr and len are the bytes of a KText or KBlob.
type Rec struct {
  rd *Rd
  hend i64
  body i64
  kind i64
  ival i64
  ptr i64
  len i64
}

// NewRec is a record reader; RecInit points it at a payload.
func NewRec(io *ovid/io.Cap) *Rec {
  var r *Rec = ovid/io.Alloc(io, sizeof(Rec)) as *Rec
  r.rd = ovid/io.Alloc(io, sizeof(Rd)) as *Rd
  return r
}

// RecInit starts reading the record at payload.
func RecInit(r *Rec, payload i64) i64 {
  r.rd.p = payload
  var hs i64 = Varint(r.rd)
  r.hend = payload + hs
  r.body = payload + hs
  return 0
}

// beInt is the big-endian signed n-byte integer at p.
func beInt(p i64, n i64) i64 {
  var v i64 = 0
  var i i64 = 0
  while i < n {
    v = (v << 8) | load8(p + i)
    i = i + 1
  }
  var sh i64 = 64 - (n * 8)
  return (v << sh) >> sh
}

// RecNext reads the next column; false when the record has no more.
func RecNext(r *Rec) bool {
  if r.rd.p >= r.hend {
    return false
  }
  var t i64 = Varint(r.rd)
  var n i64 = 0
  r.kind = KInt
  r.ival = 0
  if t == 0 {
    r.kind = KNull
  } else if t <= 4 {
    n = t
  } else if t == 5 {
    n = 6
  } else if t == 6 {
    n = 8
  } else if t == 7 {
    n = 8
    r.kind = KReal
  } else if t == 8 {
    r.ival = 0
  } else if t == 9 {
    r.ival = 1
  } else if t < 12 {
    r.kind = KNull
  } else if (t & 1) == 0 {
    r.kind = KBlob
    r.len = (t - 12) / 2
    r.ptr = r.body
    r.body = r.body + r.len
    return true
  } else {
    r.kind = KText
    r.len = (t - 13) / 2
    r.ptr = r.body
    r.body = r.body + r.len
    return true
  }
  if n > 0 {
    r.ival = beInt(r.body, n)
    r.body = r.body + n
  }
  return true
}
