package ovid/elf

import ovid/io
import ovid/asm
import ovid/mem

func W32(b *ovid/mem.Buf, io *ovid/io.Cap, v i64) i64 {
  ovid/mem.WByte(io, b, v)
  ovid/mem.WByte(io, b, v >> 8)
  ovid/mem.WByte(io, b, v >> 16)
  ovid/mem.WByte(io, b, v >> 24)
  return 0
}

func W64(b *ovid/mem.Buf, io *ovid/io.Cap, v i64) i64 {
  W32(b, io, v)
  W32(b, io, v >> 32)
  return 0
}

func Link(io *ovid/io.Cap, c *ovid/asm.Code) *ovid/mem.Buf {
  var filesz i64 = (120 + c.len) + c.ron
  var b *ovid/mem.Buf = ovid/mem.New(io, filesz + 16)
  ovid/mem.WByte(io, b, 127)
  ovid/mem.WByte(io, b, 69)
  ovid/mem.WByte(io, b, 76)
  ovid/mem.WByte(io, b, 70)
  ovid/mem.WByte(io, b, 2)
  ovid/mem.WByte(io, b, 1)
  ovid/mem.WByte(io, b, 1)
  var i i64 = 0
  while i < 9 {
    ovid/mem.WByte(io, b, 0)
    i = i + 1
  }
  ovid/mem.WByte(io, b, 2)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 62)
  ovid/mem.WByte(io, b, 0)
  W32(b, io, 1)
  W64(b, io, 4194424)
  W64(b, io, 64)
  W64(b, io, 0)
  W32(b, io, 0)
  ovid/mem.WByte(io, b, 64)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 56)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 1)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  W32(b, io, 1)
  W32(b, io, 7)
  W64(b, io, 0)
  W64(b, io, 4194304)
  W64(b, io, 4194304)
  W64(b, io, filesz)
  W64(b, io, filesz)
  W64(b, io, 4096)
  ovid/mem.WBytes(io, b, c.data, c.len)
  ovid/mem.WBytes(io, b, c.ro, c.ron)
  return b
}
