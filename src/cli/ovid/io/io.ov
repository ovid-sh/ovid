package ovid/io

type Cap struct {
  argc i64
  argv i64
  heap i64
  used i64
  size i64
}

const SYS_READ i64 = 0
const SYS_WRITE i64 = 1
const SYS_CLOSE i64 = 3
const SYS_FSTAT i64 = 5
const SYS_MMAP i64 = 9
const SYS_EXIT i64 = 60
const SYS_OPENAT i64 = 257
const SYS_FSTATAT i64 = 262
const AT_FDCWD i64 = -100
const O_RDONLY i64 = 0
const O_WRONLY i64 = 1
const O_CREAT i64 = 64
const O_TRUNC i64 = 512

func Argc(io *Cap) i64 {
  return io.argc
}

func Arg(io *Cap, i i64) i64 {
  return load64(io.argv + (i * 8))
}

func Alloc(io *Cap, n i64) i64 {
  var align i64 = (n + 7) & ^7
  if align < 8 {
    align = 8
  }
  var u i64 = io.used
  if (u + align) > io.size {
    return 0
  }
  var p i64 = io.heap + u
  io.used = u + align
  return p
}

func CLen(p i64) i64 {
  var i i64 = 0
  while load8(p + i) != 0 {
    i = i + 1
  }
  return i
}

func Write(fd i64, p i64, n i64) i64 {
  var off i64 = 0
  while off < n {
    var w i64 = syscall(SYS_WRITE, fd, p + off, n - off, 0, 0, 0)
    if w <= 0 {
      return -1
    }
    off = off + w
  }
  return 0
}

func Stdout(p i64, n i64) i64 {
  return Write(1, p, n)
}

func Stderr(p i64, n i64) i64 {
  return Write(2, p, n)
}

func CStr(io *Cap, p i64, n i64) i64 {
  var d i64 = Alloc(io, n + 1)
  var i i64 = 0
  while i < n {
    store8(d + i, load8(p + i))
    i = i + 1
  }
  store8(d + n, 0)
  return d
}

func Open(path i64, flags i64, mode i64) i64 {
  return syscall(SYS_OPENAT, AT_FDCWD, path, flags, mode, 0, 0)
}

func Close(fd i64) i64 {
  return syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
}

func Read(fd i64, p i64, n i64) i64 {
  return syscall(SYS_READ, fd, p, n, 0, 0, 0)
}

func Fstat(fd i64, buf i64) i64 {
  return syscall(SYS_FSTAT, fd, buf, 0, 0, 0, 0)
}

func FstatAt(path i64, buf i64) i64 {
  return syscall(SYS_FSTATAT, AT_FDCWD, path, buf, 0, 0, 0)
}

func LstatAt(path i64, buf i64) i64 {
  return syscall(SYS_FSTATAT, AT_FDCWD, path, buf, 256, 0, 0)
}

func ReadFile(io *Cap, path i64, pathn i64, outp i64, outn i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var fd i64 = Open(cs, O_RDONLY, 0)
  if fd < 0 {
    return -1
  }
  var st i64 = Alloc(io, 256)
  if Fstat(fd, st) < 0 {
    Close(fd)
    return -1
  }
  var sz i64 = load64(st + 48)
  var buf i64 = Alloc(io, sz + 1)
  if buf == 0 {
    Close(fd)
    return -1
  }
  var got i64 = 0
  while got < sz {
    var r i64 = Read(fd, buf + got, sz - got)
    if r <= 0 {
      Close(fd)
      return -1
    }
    got = got + r
  }
  Close(fd)
  store8(buf + sz, 0)
  store64(outp, buf)
  store64(outn, sz)
  return 0
}

func WriteFile(io *Cap, path i64, pathn i64, data i64, datan i64, mode i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var flags i64 = (O_WRONLY + O_CREAT) + O_TRUNC
  var fd i64 = Open(cs, flags, mode)
  if fd < 0 {
    return -1
  }
  var w i64 = Write(fd, data, datan)
  Close(fd)
  return w
}

func Mkdir(path i64) i64 {
  return syscall(258, AT_FDCWD, path, 493, 0, 0, 0)
}

func IsDir(io *Cap, path i64, pathn i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var st i64 = Alloc(io, 256)
  if FstatAt(cs, st) < 0 {
    return 0
  }
  var m i64 = load32(st + 24)
  if (m & 0xF000) == 0x4000 {
    return 1
  }
  return 0
}

// Hold this descriptor until the complete module transaction has finished.
// The lock file's inode is permanent so independently launched tools agree.
func Lock(path i64) i64 {
  var fd i64 = Open(path, 66, 420)
  if fd < 0 {
    return -1
  }
  var rc i64 = syscall(73, fd, 2, 0, 0, 0, 0)
  while rc == -4 {
    rc = syscall(73, fd, 2, 0, 0, 0, 0)
  }
  if rc < 0 {
    Close(fd)
    return -1
  }
  return fd
}

func Sync(fd i64) i64 {
  return syscall(74, fd, 0, 0, 0, 0, 0)
}

func Unlink(path i64) i64 {
  return syscall(87, path, 0, 0, 0, 0, 0)
}

func Rename(old i64, new i64) i64 {
  return syscall(82, old, new, 0, 0, 0, 0)
}

func AppendDecimal(dst i64, n i64) i64 {
  var divisor i64 = 1
  while (n / divisor) >= 10 {
    divisor = divisor * 10
  }
  var count i64 = 0
  while divisor > 0 {
    store8(dst + count, 48 + ((n / divisor) % 10))
    count = count + 1
    divisor = divisor / 10
  }
  return count
}

// Write and sync a new inode before exposing it to readers. The caller holds
// .ovid.lock; a unique O_EXCL temporary avoids following an existing symlink.
func AtomicFile(io *Cap, dir i64, path i64, data i64, n i64) i64 {
  var pathn i64 = CLen(path)
  var temp i64 = Alloc(io, pathn + 80)
  var i i64 = 0
  while i < pathn {
    store8(temp + i, load8(path + i))
    i = i + 1
  }
  var suffix i64 = strptr(".tmp-")
  i = 0
  while i < 5 {
    store8(temp + pathn + i, load8(suffix + i))
    i = i + 1
  }
  var pos i64 = pathn + 5
  pos = pos + AppendDecimal(temp + pos, syscall(39, 0, 0, 0, 0, 0, 0))
  store8(temp + pos, 45)
  pos = pos + 1
  var attempt i64 = 0
  var fd i64 = -1
  while attempt < 100 && fd < 0 {
    var end i64 = pos + AppendDecimal(temp + pos, attempt)
    store8(temp + end, 0)
    fd = Open(temp, 193, 420)
    if fd < 0 && fd != -17 {
      return -1
    }
    attempt = attempt + 1
  }
  if fd < 0 {
    return -1
  }
  var stat i64 = Alloc(io, 256)
  var mode i64 = 420
  if FstatAt(path, stat) == 0 {
    mode = load32(stat + 24) & 511
  }
  var rc i64 = syscall(91, fd, mode, 0, 0, 0, 0)
  if rc == 0 {
    rc = Write(fd, data, n)
  }
  if rc == 0 {
    rc = Sync(fd)
  }
  var closed i64 = Close(fd)
  if rc != 0 || closed != 0 {
    Unlink(temp)
    return -1
  }
  var dfd i64 = Open(dir, 65536, 0)
  if dfd < 0 {
    Unlink(temp)
    return -1
  }
  if Rename(temp, path) != 0 {
    Close(dfd)
    Unlink(temp)
    return -1
  }
  rc = Sync(dfd)
  Close(dfd)
  return rc
}

func ReadAll(io *Cap, fd i64, outp i64, outn i64) i64 {
  var cap i64 = 4096
  var buf i64 = Alloc(io, cap + 1)
  var n i64 = 0
  while true {
    if buf == 0 {
      return -1
    }
    if n == cap {
      cap = cap * 2
      var next i64 = Alloc(io, cap + 1)
      if next == 0 {
        return -1
      }
      var i i64 = 0
      while i < n {
        store8(next + i, load8(buf + i))
        i = i + 1
      }
      buf = next
    }
    var got i64 = Read(fd, buf + n, cap - n)
    if got == 0 {
      store8(buf + n, 0)
      store64(outp, buf)
      store64(outn, n)
      return 0
    }
    if got < 0 {
      if got != -4 {
        return -1
      }
    } else {
      n = n + got
    }
  }
  return -1
}
