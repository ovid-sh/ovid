package ovid/check

import ovid/io
import ovid/json
import ovid/mem
import ovid/sha

type Ch struct {
  io *ovid/io.Cap
  root i64
  file i64
  filen i64
  dir i64
  dirn i64
  errs i64
  pkgs i64
  npkg i64
  env i64
  nenv i64
  mark i64
  nmark i64
  typ i64
  tyn i64
  pathp i64
  pathn i64
  fnp i64
  fnn i64
  idp i64
  idn i64
  tab i64
  b *ovid/mem.Buf
  pkg i64
  nfunc i64
  resp i64
  resn i64
  tabsz i64
  emit i64
  expectedp i64
  expectedn i64
  actualp i64
  actualn i64
}

func Zero(p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    store8(p + i, 0)
    i = i + 1
  }
  return 0
}

func SGet(obj i64, lit i64, n i64) i64 {
  if obj == 0 {
    return 0
  }
  return ovid/json.GetLit(obj, lit, n)
}

func JStrP(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrP(v)
}

func JStrN(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrN(v)
}

func WLit(c *Ch, p i64, n i64) i64 {
  return ovid/mem.WBytes(c.io, c.b, p, n)
}

func WRaw(c *Ch, p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    var ch i64 = load8(p + i)
    if ch == 34 || ch == 92 {
      ovid/mem.WByte(c.io, c.b, 92)
      ovid/mem.WByte(c.io, c.b, ch)
    } else {
      if ch == 10 {
        ovid/mem.WByte(c.io, c.b, 92)
        ovid/mem.WByte(c.io, c.b, 110)
      } else {
        ovid/mem.WByte(c.io, c.b, ch)
      }
    }
    i = i + 1
  }
  return 0
}

func WStr(c *Ch, p i64, n i64) i64 {
  return ovid/json.Quote(c.io, c.b, p, n)
}

func WNum(c *Ch, v i64) i64 {
  var tmp i64 = ovid/io.Alloc(c.io, 64)
  var n i64 = ovid/mem.FormatI64(tmp, v)
  return ovid/mem.WBytes(c.io, c.b, tmp, n)
}

func Line(c *Ch) i64 {
  ovid/mem.WByte(c.io, c.b, 10)
  if c.emit == 1 {
    ovid/io.Stdout(c.b.data, c.b.len)
  }
  c.b.len = 0
  return 0
}

func Err(c *Ch, code i64, coden i64, detail i64, dn i64) i64 {
  c.errs = c.errs + 1
  WLit(c, strptr("{\"fact\":\"error\",\"id\":"), strlen("{\"fact\":\"error\",\"id\":"))
  WStr(c, c.idp, c.idn)
  WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
  WStr(c, c.pathp, c.pathn)
  WLit(c, strptr(",\"func\":"), strlen(",\"func\":"))
  WStr(c, c.fnp, c.fnn)
  WLit(c, strptr(",\"code\":"), strlen(",\"code\":"))
  WStr(c, code, coden)
  WLit(c, strptr(",\"detail\":"), strlen(",\"detail\":"))
  WStr(c, detail, dn)
  if c.expectedn != 0 {
    WLit(c, strptr(",\"expected\":"), strlen(",\"expected\":"))
    WStr(c, c.expectedp, c.expectedn)
    WLit(c, strptr(",\"actual\":"), strlen(",\"actual\":"))
    WStr(c, c.actualp, c.actualn)
  }
  ovid/mem.WByte(c.io, c.b, 125)
  var emit i64 = c.emit
  c.emit = 1
  Line(c)
  c.emit = emit
  c.expectedn = 0
  c.actualn = 0
  return 0
}

func Mismatch(c *Ch, node i64, ep i64, en i64, ap i64, an i64) i64 {
  Here(c, node)
  c.expectedp = ep
  c.expectedn = en
  c.actualp = ap
  c.actualn = an
  var detail *ovid/mem.Buf = ovid/mem.New(c.io, en + an + 32)
  ovid/mem.WBytes(c.io, detail, strptr("expected "), strlen("expected "))
  ovid/mem.WBytes(c.io, detail, ep, en)
  ovid/mem.WBytes(c.io, detail, strptr(", got "), strlen(", got "))
  ovid/mem.WBytes(c.io, detail, ap, an)
  return Err(c, strptr("type_mismatch"), strlen("type_mismatch"), detail.data, detail.len)
}

func Here(c *Ch, n i64) i64 {
  var id i64 = SGet(n, strptr("id"), strlen("id"))
  c.idp = JStrP(id)
  c.idn = JStrN(id)
  return 0
}

func Find(hay i64, n i64, needle i64, nn i64) i64 {
  if nn <= 0 {
    return 0
  }
  var i i64 = 0
  while (i + nn) <= n {
    if ovid/mem.Eq(hay + i, nn, needle, nn) {
      return i
    }
    i = i + 1
  }
  return -1
}

func IsHex(ch i64) bool {
  if ch >= 48 && ch <= 57 {
    return true
  }
  if ch >= 97 && ch <= 102 {
    return true
  }
  return false
}

func Hash(io *ovid/io.Cap, data i64, n i64, stored i64, comp i64) i64 {
  var at i64 = Find(data, n, strptr("\"revision\": \""), strlen("\"revision\": \""))
  if at < 0 {
    return -1
  }
  var start i64 = at + strlen("\"revision\": \"")
  if (start + 64) >= n {
    return -1
  }
  if load8(data + start + 64) != 34 {
    return -1
  }
  var i i64 = 0
  while i < 64 {
    if !IsHex(load8(data + start + i)) {
      return -1
    }
    store8(stored + i, load8(data + start + i))
    i = i + 1
  }
  var buf i64 = ovid/io.Alloc(io, n)
  if buf == 0 {
    return -1
  }
  ovid/mem.Copy(buf, data, n)
  i = 0
  while i < 64 {
    store8(buf + start + i, 48)
    i = i + 1
  }
  var raw i64 = ovid/io.Alloc(io, 32)
  ovid/sha.Sum(io, buf, n, raw)
  ovid/sha.Hex(comp, raw)
  return start
}

func HashStr(p i64, n i64) i64 {
  var h i64 = 5381
  var i i64 = 0
  while i < n {
    h = ((h << 5) + h) + load8(p + i)
    i = i + 1
  }
  return h & 262143
}

func Claim(c *Ch, p i64, n i64) i64 {
  if n <= 0 {
    c.idp = 0
    c.idn = 0
    Err(c, strptr("missing_id"), strlen("missing_id"), strptr("empty id"), strlen("empty id"))
    return 0
  }
  var slot i64 = HashStr(p, n)
  var i i64 = 0
  while i < c.tabsz {
    var idx i64 = (slot + i) & 262143
    var rec i64 = c.tab + (idx * 16)
    var sp i64 = load64(rec)
    var sn i64 = load64(rec + 8)
    if sp == 0 {
      store64(rec, p)
      store64(rec + 8, n)
      return 0
    }
    if ovid/mem.Eq(sp, sn, p, n) {
      c.idp = p
      c.idn = n
      Err(c, strptr("duplicate_id"), strlen("duplicate_id"), p, n)
      return 0
    }
    i = i + 1
  }
  Err(c, strptr("id_table"), strlen("id_table"), strptr("full"), strlen("full"))
  return 0
}

func ClaimNode(c *Ch, n i64) i64 {
  if n == 0 {
    return 0
  }
  var id i64 = SGet(n, strptr("id"), strlen("id"))
  if id != 0 {
    Claim(c, JStrP(id), JStrN(id))
  }
  ClaimNode(c, SGet(n, strptr("left"), strlen("left")))
  ClaimNode(c, SGet(n, strptr("right"), strlen("right")))
  ClaimNode(c, SGet(n, strptr("arg"), strlen("arg")))
  ClaimNode(c, SGet(n, strptr("base"), strlen("base")))
  ClaimNode(c, SGet(n, strptr("addr"), strlen("addr")))
  ClaimNode(c, SGet(n, strptr("val"), strlen("val")))
  ClaimNode(c, SGet(n, strptr("cond"), strlen("cond")))
  ClaimArr(c, SGet(n, strptr("args"), strlen("args")))
  ClaimArr(c, SGet(n, strptr("then"), strlen("then")))
  ClaimArr(c, SGet(n, strptr("else"), strlen("else")))
  ClaimArr(c, SGet(n, strptr("body"), strlen("body")))
  return 0
}

func ClaimArr(c *Ch, arr i64) i64 {
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    ClaimNode(c, s)
    s = ovid/json.Next(s)
  }
  return 0
}

func Push(c *Ch) i64 {
  if c.nmark >= 256 {
    Err(c, strptr("scope"), strlen("scope"), strptr("too deep"), strlen("too deep"))
    return 0
  }
  store64(c.mark + (c.nmark * 8), c.nenv)
  c.nmark = c.nmark + 1
  return 0
}

func Pop(c *Ch) i64 {
  if c.nmark <= 0 {
    return 0
  }
  c.nmark = c.nmark - 1
  c.nenv = load64(c.mark + (c.nmark * 8))
  return 0
}

func Lookup(c *Ch, np i64, nn i64) i64 {
  var i i64 = c.nenv - 1
  while i >= 0 {
    var rec i64 = c.env + (i * 32)
    if ovid/mem.Eq(load64(rec), load64(rec + 8), np, nn) {
      return rec
    }
    i = i - 1
  }
  return 0
}

func Define(c *Ch, np i64, nn i64, tp i64, tn i64) i64 {
  if Lookup(c, np, nn) != 0 {
    Err(c, strptr("duplicate_name"), strlen("duplicate_name"), np, nn)
  }
  if c.nenv >= 4096 {
    return 0
  }
  var rec i64 = c.env + (c.nenv * 32)
  store64(rec, np)
  store64(rec + 8, nn)
  store64(rec + 16, tp)
  store64(rec + 24, tn)
  c.nenv = c.nenv + 1
  return 0
}

func SetTy(c *Ch, p i64, n i64) i64 {
  c.typ = p
  c.tyn = n
  return 0
}

func SetI64(c *Ch) i64 {
  return SetTy(c, strptr("i64"), strlen("i64"))
}

func SetBool(c *Ch) i64 {
  return SetTy(c, strptr("bool"), strlen("bool"))
}

func SetBad(c *Ch) i64 {
  return SetTy(c, strptr("invalid"), strlen("invalid"))
}

func IsTy(c *Ch, p i64, n i64) bool {
  return ovid/mem.Eq(c.typ, c.tyn, p, n)
}

func Bad(c *Ch) bool {
  return IsTy(c, strptr("invalid"), strlen("invalid"))
}

func TyEq(p i64, n i64, q i64, m i64) bool {
  return ovid/mem.Eq(p, n, q, m)
}

func FindPkg(c *Ch, pp i64, pn i64) i64 {
  var i i64 = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    if ovid/json.IsLit(path, pp, pn) {
      return pkg
    }
    i = i + 1
  }
  return 0
}

func FindFunc(c *Ch, pp i64, pn i64, np i64, nn i64) i64 {
  var pkg i64 = FindPkg(c, pp, pn)
  if pkg == 0 {
    return 0
  }
  var fns i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
  if fns == 0 {
    return 0
  }
  var f i64 = ovid/json.Child(fns)
  while f != 0 {
    var nm i64 = SGet(f, strptr("name"), strlen("name"))
    if ovid/json.IsLit(nm, np, nn) {
      return f
    }
    f = ovid/json.Next(f)
  }
  return 0
}

func FindConst(c *Ch, np i64, nn i64) bool {
  var arr i64 = SGet(c.pkg, strptr("consts"), strlen("consts"))
  if arr == 0 {
    return false
  }
  var k i64 = ovid/json.Child(arr)
  while k != 0 {
    var nm i64 = SGet(k, strptr("name"), strlen("name"))
    if ovid/json.IsLit(nm, np, nn) {
      return true
    }
    k = ovid/json.Next(k)
  }
  return false
}

func Imported(c *Ch, pp i64, pn i64) bool {
  if ovid/mem.Eq(c.pathp, c.pathn, pp, pn) {
    return true
  }
  var arr i64 = SGet(c.pkg, strptr("imports"), strlen("imports"))
  if arr == 0 {
    return false
  }
  var k i64 = ovid/json.Child(arr)
  while k != 0 {
    var path i64 = SGet(k, strptr("path"), strlen("path"))
    if ovid/json.IsLit(path, pp, pn) {
      return true
    }
    k = ovid/json.Next(k)
  }
  return false
}

func FieldTy(c *Ch, tp i64, tn i64, fp i64, fn i64) i64 {
  if tn < 2 {
    return -1
  }
  if load8(tp) != 42 {
    return -1
  }
  var p i64 = tp + 1
  var n i64 = tn - 1
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return -1
  }
  var pkg i64 = FindPkg(c, p, dot)
  if pkg == 0 {
    return -1
  }
  var tnp i64 = (p + dot) + 1
  var tnn i64 = (n - dot) - 1
  var types i64 = SGet(pkg, strptr("types"), strlen("types"))
  if types == 0 {
    return -1
  }
  var t i64 = ovid/json.Child(types)
  while t != 0 {
    var nm i64 = SGet(t, strptr("name"), strlen("name"))
    if ovid/json.IsLit(nm, tnp, tnn) {
      var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
      if fields == 0 {
        return -1
      }
      var f i64 = ovid/json.Child(fields)
      while f != 0 {
        var fnm i64 = SGet(f, strptr("name"), strlen("name"))
        if ovid/json.IsLit(fnm, fp, fn) {
          var fty i64 = SGet(f, strptr("type"), strlen("type"))
          SetTy(c, JStrP(fty), JStrN(fty))
          return 0
        }
        f = ovid/json.Next(f)
      }
      return -1
    }
    t = ovid/json.Next(t)
  }
  return -1
}

func Leaf(op i64) bool {
  if ovid/json.IsLit(op, strptr("int"), strlen("int")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("strptr"), strlen("strptr")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("strlen"), strlen("strlen")) {
    return true
  }
  return false
}

func Arith(op i64) bool {
  if ovid/json.IsLit(op, strptr("add"), strlen("add")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("sub"), strlen("sub")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("mul"), strlen("mul")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("div"), strlen("div")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("mod"), strlen("mod")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("and"), strlen("and")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("or"), strlen("or")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("xor"), strlen("xor")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("shl"), strlen("shl")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("shr"), strlen("shr")) {
    return true
  }
  return false
}

func CmpEq(op i64) bool {
  if ovid/json.IsLit(op, strptr("eq"), strlen("eq")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("ne"), strlen("ne")) {
    return true
  }
  return false
}

func CmpOrd(op i64) bool {
  if ovid/json.IsLit(op, strptr("lt"), strlen("lt")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("le"), strlen("le")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("gt"), strlen("gt")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("ge"), strlen("ge")) {
    return true
  }
  return false
}

func CheckExpr(c *Ch, n i64) i64 {
  if n == 0 {
    Err(c, strptr("missing_expr"), strlen("missing_expr"), strptr("empty"), strlen("empty"))
    return SetBad(c)
  }
  Here(c, n)
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if Leaf(op) {
    var val i64 = SGet(n, strptr("value"), strlen("value"))
    var want i64 = 3
    if ovid/json.IsLit(op, strptr("int"), strlen("int")) {
      want = 2
    }
    if val == 0 {
      Err(c, strptr("bad_op"), strlen("bad_op"), strptr("missing literal value"), strlen("missing literal value"))
      return SetBad(c)
    }
    if ovid/json.Kind(val) != want {
      Err(c, strptr("bad_op"), strlen("bad_op"), strptr("invalid literal value"), strlen("invalid literal value"))
      return SetBad(c)
    }
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("bool"), strlen("bool")) {
    var val i64 = SGet(n, strptr("value"), strlen("value"))
    if val == 0 {
      Err(c, strptr("bad_op"), strlen("bad_op"), strptr("missing literal value"), strlen("missing literal value"))
      return SetBad(c)
    }
    if ovid/json.Kind(val) != 1 {
      Err(c, strptr("bad_op"), strlen("bad_op"), strptr("invalid literal value"), strlen("invalid literal value"))
      return SetBad(c)
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("name"), strlen("name")) {
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    var loc i64 = Lookup(c, JStrP(nm), JStrN(nm))
    if loc != 0 {
      return SetTy(c, load64(loc + 16), load64(loc + 24))
    }
    if FindConst(c, JStrP(nm), JStrN(nm)) {
      return SetI64(c)
    }
    Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
    return SetBad(c)
  }
  if Arith(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lp i64 = c.typ
    var ln i64 = c.tyn
    var lb bool = Bad(c)
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    var rb bool = Bad(c)
    if !lb {
      if !TyEq(lp, ln, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("left"), strlen("left")), strptr("i64"), strlen("i64"), lp, ln)
      }
    }
    if !rb {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("right"), strlen("right")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    return SetI64(c)
  }
  if CmpEq(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lp i64 = c.typ
    var ln i64 = c.tyn
    var lb bool = Bad(c)
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    if !lb {
      if !Bad(c) {
        if !TyEq(lp, ln, c.typ, c.tyn) {
          Mismatch(c, SGet(n, strptr("right"), strlen("right")), lp, ln, c.typ, c.tyn)
        }
      }
    }
    return SetBool(c)
  }
  if CmpOrd(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lb bool = Bad(c)
    var lp i64 = c.typ
    var ln i64 = c.tyn
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    if !lb {
      if !TyEq(lp, ln, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("left"), strlen("left")), strptr("i64"), strlen("i64"), lp, ln)
      }
    }
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("right"), strlen("right")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("land"), strlen("land")) || ovid/json.IsLit(op, strptr("lor"), strlen("lor")) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lb bool = Bad(c)
    var lbool bool = IsTy(c, strptr("bool"), strlen("bool"))
    var lp i64 = c.typ
    var ln i64 = c.tyn
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    var rb bool = Bad(c)
    var rbool bool = IsTy(c, strptr("bool"), strlen("bool"))
    if !lb {
      if !lbool {
        Mismatch(c, SGet(n, strptr("left"), strlen("left")), strptr("bool"), strlen("bool"), lp, ln)
      }
    }
    if !rb {
      if !rbool {
        Mismatch(c, SGet(n, strptr("right"), strlen("right")), strptr("bool"), strlen("bool"), c.typ, c.tyn)
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("not"), strlen("not")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Mismatch(c, SGet(n, strptr("arg"), strlen("arg")), strptr("bool"), strlen("bool"), c.typ, c.tyn)
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("neg"), strlen("neg")) || ovid/json.IsLit(op, strptr("bnot"), strlen("bnot")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("arg"), strlen("arg")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("load8"), strlen("load8")) || ovid/json.IsLit(op, strptr("load32"), strlen("load32")) || ovid/json.IsLit(op, strptr("load64"), strlen("load64")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(n, strptr("arg"), strlen("arg")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("cast"), strlen("cast")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    var ty i64 = SGet(n, strptr("type"), strlen("type"))
    if !KnownStorageType(c, JStrP(ty), JStrN(ty)) {
      Here(c, n)
      Err(c, strptr("bad_type"), strlen("bad_type"), JStrP(ty), JStrN(ty))
      return SetBad(c)
    }
    return SetTy(c, JStrP(ty), JStrN(ty))
  }
  if ovid/json.IsLit(op, strptr("field"), strlen("field")) {
    CheckExpr(c, SGet(n, strptr("base"), strlen("base")))
    if Bad(c) {
      return SetBad(c)
    }
    var tp i64 = c.typ
    var tn i64 = c.tyn
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    if FieldTy(c, tp, tn, JStrP(nm), JStrN(nm)) != 0 {
      Err(c, strptr("unknown_field"), strlen("unknown_field"), JStrP(nm), JStrN(nm))
      return SetBad(c)
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("call"), strlen("call")) {
    var pp i64 = c.pathp
    var pn i64 = c.pathn
    var pk i64 = SGet(n, strptr("pkg"), strlen("pkg"))
    if pk != 0 {
      pp = JStrP(pk)
      pn = JStrN(pk)
      if !Imported(c, pp, pn) {
        Err(c, strptr("unknown_package"), strlen("unknown_package"), pp, pn)
      }
    }
    var nm i64 = SGet(n, strptr("func"), strlen("func"))
    var fn i64 = FindFunc(c, pp, pn, JStrP(nm), JStrN(nm))
    var args i64 = SGet(n, strptr("args"), strlen("args"))
    var nargs i64 = 0
    if args != 0 {
      nargs = ovid/json.Count(args)
    }
    if fn == 0 {
      Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
      var a i64 = 0
      if args != 0 {
        a = ovid/json.Child(args)
      }
      while a != 0 {
        CheckExpr(c, a)
        a = ovid/json.Next(a)
      }
      return SetBad(c)
    }
    var params i64 = SGet(fn, strptr("params"), strlen("params"))
    var nparam i64 = 0
    if params != 0 {
      nparam = ovid/json.Count(params)
    }
    if nargs != nparam {
      Err(c, strptr("arity"), strlen("arity"), JStrP(nm), JStrN(nm))
    }
    var i i64 = 0
    var a i64 = 0
    if args != 0 {
      a = ovid/json.Child(args)
    }
    var p i64 = 0
    if params != 0 {
      p = ovid/json.Child(params)
    }
    while a != 0 {
      CheckExpr(c, a)
      if p != 0 {
        if !Bad(c) {
          var ty i64 = SGet(p, strptr("type"), strlen("type"))
          if !IsTy(c, JStrP(ty), JStrN(ty)) {
            Mismatch(c, a, JStrP(ty), JStrN(ty), c.typ, c.tyn)
          }
        }
        p = ovid/json.Next(p)
      }
      i = i + 1
      a = ovid/json.Next(a)
    }
    var rs i64 = SGet(fn, strptr("result"), strlen("result"))
    return SetTy(c, JStrP(rs), JStrN(rs))
  }
  if ovid/json.IsLit(op, strptr("syscall"), strlen("syscall")) {
    if !ovid/mem.Eq(c.pathp, c.pathn, strptr("ovid/io"), strlen("ovid/io")) {
      Err(c, strptr("syscall_forbidden"), strlen("syscall_forbidden"), strptr("only ovid/io"), strlen("only ovid/io"))
    }
    var args i64 = SGet(n, strptr("args"), strlen("args"))
    var nargs i64 = 0
    if args != 0 {
      nargs = ovid/json.Count(args)
    }
    if nargs != 7 {
      Err(c, strptr("arity"), strlen("arity"), strptr("syscall"), strlen("syscall"))
    }
    var a i64 = 0
    if args != 0 {
      a = ovid/json.Child(args)
    }
    while a != 0 {
      CheckExpr(c, a)
      if !Bad(c) {
        if !IsTy(c, strptr("i64"), strlen("i64")) {
          Mismatch(c, a, strptr("i64"), strlen("i64"), c.typ, c.tyn)
        }
      }
      a = ovid/json.Next(a)
    }
    return SetI64(c)
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("expr"), strlen("expr"))
  return SetBad(c)
}

func Paths(arr i64) bool {
  if arr == 0 {
    return false
  }
  if ovid/json.Count(arr) == 0 {
    return false
  }
  var last i64 = 0
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    last = s
    s = ovid/json.Next(s)
  }
  var op i64 = SGet(last, strptr("op"), strlen("op"))
  if ovid/json.IsLit(op, strptr("return"), strlen("return")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("if"), strlen("if")) {
    var el i64 = SGet(last, strptr("else"), strlen("else"))
    if el == 0 {
      return false
    }
    if ovid/json.Count(el) == 0 {
      return false
    }
    if Paths(SGet(last, strptr("then"), strlen("then"))) {
      if Paths(el) {
        return true
      }
    }
    return false
  }
  return false
}

func CheckStmts(c *Ch, arr i64) i64 {
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    CheckStmt(c, s)
    s = ovid/json.Next(s)
  }
  return 0
}

func CheckStmt(c *Ch, s i64) i64 {
  if s == 0 {
    return 0
  }
  Here(c, s)
  var op i64 = SGet(s, strptr("op"), strlen("op"))
  if ovid/json.IsLit(op, strptr("var"), strlen("var")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var ty i64 = SGet(s, strptr("type"), strlen("type"))
    var tp i64 = JStrP(ty)
    var tn i64 = JStrN(ty)
    if !KnownStorageType(c, tp, tn) {
      Err(c, strptr("bad_type"), strlen("bad_type"), tp, tn)
    }
    var ok bool = false
    if TyEq(tp, tn, strptr("i64"), strlen("i64")) {
      ok = true
    }
    if TyEq(tp, tn, strptr("bool"), strlen("bool")) {
      ok = true
    }
    if tn > 0 {
      if load8(tp) == 42 {
        ok = true
      }
    }
    if !ok {
      Err(c, strptr("struct_value"), strlen("struct_value"), JStrP(nm), JStrN(nm))
    }
    Define(c, JStrP(nm), JStrN(nm), tp, tn)
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val != 0 {
      CheckExpr(c, val)
      if !Bad(c) {
        if !IsTy(c, tp, tn) {
          Mismatch(c, SGet(s, strptr("val"), strlen("val")), tp, tn, c.typ, c.tyn)
        }
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("assign"), strlen("assign")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var loc i64 = Lookup(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
      CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
      return 0
    }
    var tp i64 = load64(loc + 16)
    var tn i64 = load64(loc + 24)
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !Bad(c) {
      if !IsTy(c, tp, tn) {
        Mismatch(c, SGet(s, strptr("val"), strlen("val")), tp, tn, c.typ, c.tyn)
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("setfield"), strlen("setfield")) {
    var base i64 = SGet(s, strptr("base"), strlen("base"))
    CheckExpr(c, base)
    var tp i64 = c.typ
    var tn i64 = c.tyn
    var was bool = Bad(c)
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var fp i64 = 0
    var fn i64 = 0
    if !was {
      if FieldTy(c, tp, tn, JStrP(nm), JStrN(nm)) != 0 {
        Err(c, strptr("unknown_field"), strlen("unknown_field"), JStrP(nm), JStrN(nm))
        was = true
      } else {
        fp = c.typ
        fn = c.tyn
      }
    }
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !was {
      if !Bad(c) {
        if !IsTy(c, fp, fn) {
          Mismatch(c, SGet(s, strptr("val"), strlen("val")), fp, fn, c.typ, c.tyn)
        }
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("store8"), strlen("store8")) || ovid/json.IsLit(op, strptr("store64"), strlen("store64")) {
    CheckExpr(c, SGet(s, strptr("addr"), strlen("addr")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(s, strptr("addr"), strlen("addr")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Mismatch(c, SGet(s, strptr("val"), strlen("val")), strptr("i64"), strlen("i64"), c.typ, c.tyn)
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("expr"), strlen("expr")) {
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    return 0
  }
  if ovid/json.IsLit(op, strptr("return"), strlen("return")) {
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val == 0 {
      Mismatch(c, s, c.resp, c.resn, strptr("void"), strlen("void"))
      return 0
    }
    CheckExpr(c, val)
    if !Bad(c) {
      if !IsTy(c, c.resp, c.resn) {
        Mismatch(c, SGet(s, strptr("val"), strlen("val")), c.resp, c.resn, c.typ, c.tyn)
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("if"), strlen("if")) {
    CheckExpr(c, SGet(s, strptr("cond"), strlen("cond")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Mismatch(c, SGet(s, strptr("cond"), strlen("cond")), strptr("bool"), strlen("bool"), c.typ, c.tyn)
      }
    }
    Push(c)
    CheckStmts(c, SGet(s, strptr("then"), strlen("then")))
    Pop(c)
    Push(c)
    CheckStmts(c, SGet(s, strptr("else"), strlen("else")))
    Pop(c)
    return 0
  }
  if ovid/json.IsLit(op, strptr("while"), strlen("while")) {
    CheckExpr(c, SGet(s, strptr("cond"), strlen("cond")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Mismatch(c, SGet(s, strptr("cond"), strlen("cond")), strptr("bool"), strlen("bool"), c.typ, c.tyn)
      }
    }
    Push(c)
    CheckStmts(c, SGet(s, strptr("body"), strlen("body")))
    Pop(c)
    return 0
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("stmt"), strlen("stmt"))
  return 0
}

func CheckFunc(c *Ch, fn i64) i64 {
  c.nenv = 0
  c.nmark = 0
  var nm i64 = SGet(fn, strptr("name"), strlen("name"))
  c.fnp = JStrP(nm)
  c.fnn = JStrN(nm)
  var rs i64 = SGet(fn, strptr("result"), strlen("result"))
  c.resp = JStrP(rs)
  c.resn = JStrN(rs)
  Here(c, fn)
  Push(c)
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  if nparam > 6 {
    Err(c, strptr("arity"), strlen("arity"), strptr("more than 6 params"), strlen("more than 6 params"))
  }
  var p i64 = 0
  if params != 0 {
    p = ovid/json.Child(params)
  }
  while p != 0 {
    Here(c, p)
    var pnm i64 = SGet(p, strptr("name"), strlen("name"))
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    Define(c, JStrP(pnm), JStrN(pnm), JStrP(ty), JStrN(ty))
    p = ovid/json.Next(p)
  }
  Here(c, fn)
  var body i64 = SGet(fn, strptr("body"), strlen("body"))
  CheckStmts(c, body)
  if !Paths(body) {
    Err(c, strptr("missing_return"), strlen("missing_return"), c.fnp, c.fnn)
  }
  Pop(c)
  WLit(c, strptr("{\"fact\":\"func\",\"name\":"), strlen("{\"fact\":\"func\",\"name\":"))
  WStr(c, c.fnp, c.fnn)
  WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
  WStr(c, c.pathp, c.pathn)
  WLit(c, strptr(",\"params\":"), strlen(",\"params\":"))
  WNum(c, nparam)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  c.nfunc = c.nfunc + 1
  return 0
}

func Join(io *ovid/io.Cap, dir i64, dirn i64, suf i64, sufn i64) i64 {
  var n i64 = (dirn + 1) + sufn
  var p i64 = ovid/io.Alloc(io, n + 1)
  ovid/mem.Copy(p, dir, dirn)
  store8(p + dirn, 47)
  ovid/mem.Copy(p + dirn + 1, suf, sufn)
  store8(p + n, 0)
  return p
}

// Check that a storage type denotes a scalar or one pointer to a declared
// struct. This intentionally does not require a draft's expressions to agree.
func KnownStorageType(c *Ch, tp i64, tn i64) bool {
  if TyEq(tp, tn, strptr("i64"), strlen("i64")) || TyEq(tp, tn, strptr("bool"), strlen("bool")) { return true }
  if tn < 2 { return false }
  if load8(tp) != 42 { return false }
  var p i64 = tp + 1
  var n i64 = tn - 1
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 { dot = i }
    i = i + 1
  }
  var pkg i64 = c.pkg
  var namep i64 = p
  var namen i64 = n
  if dot >= 0 {
    pkg = FindPkg(c, p, dot)
    namep = p + dot + 1
    namen = n - dot - 1
  }
  if pkg == 0 { return false }
  var arr i64 = SGet(pkg, strptr("types"), strlen("types"))
  if arr == 0 { return false }
  var t i64 = ovid/json.Child(arr)
  while t != 0 {
    if ovid/json.IsLit(SGet(t, strptr("name"), strlen("name")), namep, namen) { return true }
    t = ovid/json.Next(t)
  }
  return false
}

func CheckDeclaredType(c *Ch, node i64, key i64) i64 {
  var ty i64 = SGet(node, key, ovid/io.CLen(key))
  if !KnownStorageType(c, JStrP(ty), JStrN(ty)) {
    Here(c, node)
    Err(c, strptr("bad_type"), strlen("bad_type"), JStrP(ty), JStrN(ty))
  }
  return 0
}

func DuplicateNames(c *Ch, arr i64, key i64, code i64) i64 {
  if arr == 0 { return 0 }
  var node i64 = ovid/json.Child(arr)
  while node != 0 {
    var name i64 = SGet(node, key, ovid/io.CLen(key))
    var prev i64 = ovid/json.Child(arr)
    var duplicate bool = false
    while prev != node {
      var other i64 = SGet(prev, key, ovid/io.CLen(key))
      if ovid/json.IsLit(other, JStrP(name), JStrN(name)) { duplicate = true }
      prev = ovid/json.Next(prev)
    }
    if duplicate {
      Here(c, node)
      Err(c, code, ovid/io.CLen(code), JStrP(name), JStrN(name))
    }
    node = ovid/json.Next(node)
  }
  return 0
}

func CheckDeclarations(c *Ch) i64 {
  c.pathp = 0
  c.pathn = 0
  c.fnp = 0
  c.fnn = 0
  DuplicateNames(c, SGet(c.root, strptr("packages"), strlen("packages")), strptr("path"), strptr("duplicate_package"))
  var i i64 = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    c.pkg = pkg
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    c.pathp = JStrP(path)
    c.pathn = JStrN(path)
    var types i64 = SGet(pkg, strptr("types"), strlen("types"))
    DuplicateNames(c, types, strptr("name"), strptr("duplicate_type"))
    if types != 0 {
      var ty i64 = ovid/json.Child(types)
      while ty != 0 {
        var fields i64 = SGet(ty, strptr("fields"), strlen("fields"))
        DuplicateNames(c, fields, strptr("name"), strptr("duplicate_field"))
        if fields != 0 {
          var f i64 = ovid/json.Child(fields)
          while f != 0 {
            CheckDeclaredType(c, f, strptr("type"))
            f = ovid/json.Next(f)
          }
        }
        ty = ovid/json.Next(ty)
      }
    }
    var consts i64 = SGet(pkg, strptr("consts"), strlen("consts"))
    DuplicateNames(c, consts, strptr("name"), strptr("duplicate_const"))
    if consts != 0 {
      var k i64 = ovid/json.Child(consts)
      while k != 0 {
        var kt i64 = SGet(k, strptr("type"), strlen("type"))
        if !ovid/json.IsLit(kt, strptr("i64"), strlen("i64")) {
          Here(c, k)
          Err(c, strptr("bad_type"), strlen("bad_type"), strptr("const must be i64"), strlen("const must be i64"))
        }
        k = ovid/json.Next(k)
      }
    }
    var funcs i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
    DuplicateNames(c, funcs, strptr("name"), strptr("duplicate_func"))
    if funcs != 0 {
      var fn i64 = ovid/json.Child(funcs)
      while fn != 0 {
        var name i64 = SGet(fn, strptr("name"), strlen("name"))
        c.fnp = JStrP(name)
        c.fnn = JStrN(name)
        CheckDeclaredType(c, fn, strptr("result"))
        var params i64 = SGet(fn, strptr("params"), strlen("params"))
        if params != 0 {
          var pa i64 = ovid/json.Child(params)
          while pa != 0 {
            CheckDeclaredType(c, pa, strptr("type"))
            pa = ovid/json.Next(pa)
          }
        }
        fn = ovid/json.Next(fn)
      }
    }
    c.fnp = 0
    c.fnn = 0
    i = i + 1
  }
  return 0
}

func ABIField(fields i64, index i64, name i64) bool {
  var field i64 = ovid/json.At(fields, index)
  if field == 0 { return false }
  if !ovid/json.IsLit(SGet(field, strptr("name"), strlen("name")), name, ovid/io.CLen(name)) { return false }
  return ovid/json.IsLit(SGet(field, strptr("type"), strlen("type")), strptr("i64"), strlen("i64"))
}

func CheckABI(c *Ch) i64 {
  c.pathp = strptr("ovid/io")
  c.pathn = strlen("ovid/io")
  c.fnp = 0
  c.fnn = 0
  c.idp = 0
  c.idn = 0
  var pkg i64 = FindPkg(c, c.pathp, c.pathn)
  if pkg == 0 {
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("missing package ovid/io"), strlen("missing package ovid/io"))
    return 0
  }
  Here(c, pkg)
  var types i64 = SGet(pkg, strptr("types"), strlen("types"))
  var cap i64 = 0
  if types != 0 {
    var ty i64 = ovid/json.Child(types)
    while ty != 0 {
      if ovid/json.IsLit(SGet(ty, strptr("name"), strlen("name")), strptr("Cap"), strlen("Cap")) { cap = ty }
      ty = ovid/json.Next(ty)
    }
  }
  if cap == 0 {
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("missing Cap"), strlen("missing Cap"))
    return 0
  }
  Here(c, cap)
  var fields i64 = SGet(cap, strptr("fields"), strlen("fields"))
  var valid bool = false
  if fields != 0 {
    if ovid/json.Count(fields) == 5 {
      valid = ABIField(fields, 0, strptr("argc")) && ABIField(fields, 1, strptr("argv")) && ABIField(fields, 2, strptr("heap")) && ABIField(fields, 3, strptr("used")) && ABIField(fields, 4, strptr("size"))
    }
  }
  if !valid {
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("Cap must have argc, argv, heap, used, size as i64 in that order"), strlen("Cap must have argc, argv, heap, used, size as i64 in that order"))
  }
  return 0
}

func CheckMain(c *Ch) i64 {
  var ent i64 = SGet(c.root, strptr("entry"), strlen("entry"))
  var pkg i64 = FindPkg(c, JStrP(ent), JStrN(ent))
  if pkg == 0 {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    c.fnp = 0
    c.fnn = 0
    c.idp = 0
    c.idn = 0
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("missing entry package"), strlen("missing entry package"))
    return 0
  }
  var fn i64 = FindFunc(c, JStrP(ent), JStrN(ent), strptr("main"), strlen("main"))
  if fn == 0 {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("entry package has no main"), strlen("entry package has no main"))
    return 0
  }
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  var rs i64 = SGet(fn, strptr("result"), strlen("result"))
  var ok bool = false
  if nparam == 1 {
    var p i64 = ovid/json.Child(params)
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    if ovid/json.IsLit(ty, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap")) {
      if ovid/json.IsLit(rs, strptr("i64"), strlen("i64")) {
        ok = true
      }
    }
  }
  if !ok {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    c.fnp = strptr("main")
    c.fnn = strlen("main")
    Here(c, fn)
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("main must be (io *ovid/io.Cap) i64"), strlen("main must be (io *ovid/io.Cap) i64"))
  }
  return 0
}

func Run(io *ovid/io.Cap, root i64, file i64, filen i64, dir i64, dirn i64) i64 {
  return RunMode(io, root, file, filen, 2)
}

func RunFacts(io *ovid/io.Cap, root i64, file i64, filen i64) i64 {
  return RunMode(io, root, file, filen, 1)
}

func RunQuiet(io *ovid/io.Cap, root i64, file i64, filen i64) i64 {
  return RunMode(io, root, file, filen, 0)
}

func RunMode(io *ovid/io.Cap, root i64, file i64, filen i64, emit i64) i64 {
  var raw i64 = ovid/io.Alloc(io, 320)
  Zero(raw, 320)
  var c *Ch = raw as *Ch
  c.io = io
  c.root = root
  c.file = file
  c.filen = filen
  c.emit = emit
  c.tabsz = 262144
  c.b = ovid/mem.New(io, 4096)
  c.env = ovid/io.Alloc(io, 4096 * 32)
  c.mark = ovid/io.Alloc(io, 256 * 8)
  c.tab = ovid/io.Alloc(io, c.tabsz * 16)
  Zero(c.tab, c.tabsz * 16)
  var stored i64 = ovid/io.Alloc(io, 64)
  var comp i64 = ovid/io.Alloc(io, 64)
  Zero(stored, 64)
  Zero(comp, 64)
  if Hash(io, file, filen, stored, comp) < 0 {
    var z i64 = 0
    while z < 64 {
      store8(comp + z, 48)
      z = z + 1
    }
    Err(c, strptr("revision"), strlen("revision"), strptr("missing revision"), strlen("missing revision"))
  } else {
    if !ovid/mem.Eq(stored, 64, comp, 64) {
      Err(c, strptr("revision_mismatch"), strlen("revision_mismatch"), strptr("stored revision does not match file bytes"), strlen("stored revision does not match file bytes"))
    }
  }
  var mod i64 = SGet(root, strptr("module"), strlen("module"))
  var ent i64 = SGet(root, strptr("entry"), strlen("entry"))
  var pkgs i64 = SGet(root, strptr("packages"), strlen("packages"))
  if pkgs != 0 {
    c.npkg = ovid/json.Count(pkgs)
  }
  c.pkgs = ovid/io.Alloc(io, (c.npkg + 1) * 8)
  WLit(c, strptr("{\"fact\":\"module\",\"revision\":\""), strlen("{\"fact\":\"module\",\"revision\":\""))
  ovid/mem.WBytes(c.io, c.b, comp, 64)
  WLit(c, strptr("\",\"module\":"), strlen("\",\"module\":"))
  WStr(c, JStrP(mod), JStrN(mod))
  WLit(c, strptr(",\"entry\":"), strlen(",\"entry\":"))
  WStr(c, JStrP(ent), JStrN(ent))
  WLit(c, strptr(",\"packages\":"), strlen(",\"packages\":"))
  WNum(c, c.npkg)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  var fi i64 = 0
  var fp i64 = 0
  if pkgs != 0 {
    fp = ovid/json.Child(pkgs)
  }
  while fp != 0 {
    store64(c.pkgs + (fi * 8), fp)
    fi = fi + 1
    fp = ovid/json.Next(fp)
  }
  var i i64 = 0
  var p i64 = 0
  if pkgs != 0 {
    p = ovid/json.Child(pkgs)
  }
  while p != 0 {
    store64(c.pkgs + (i * 8), p)
    var id i64 = SGet(p, strptr("id"), strlen("id"))
    Claim(c, JStrP(id), JStrN(id))
    var path i64 = SGet(p, strptr("path"), strlen("path"))
    WLit(c, strptr("{\"fact\":\"package\",\"id\":"), strlen("{\"fact\":\"package\",\"id\":"))
    WStr(c, JStrP(id), JStrN(id))
    WLit(c, strptr(",\"path\":"), strlen(",\"path\":"))
    WStr(c, JStrP(path), JStrN(path))
    ovid/mem.WByte(c.io, c.b, 125)
    Line(c)
    var ims i64 = SGet(p, strptr("imports"), strlen("imports"))
    if ims != 0 {
      var im i64 = ovid/json.Child(ims)
      while im != 0 {
        var iid i64 = SGet(im, strptr("id"), strlen("id"))
        Claim(c, JStrP(iid), JStrN(iid))
        var ip i64 = SGet(im, strptr("path"), strlen("path"))
        WLit(c, strptr("{\"fact\":\"import\",\"pkg\":"), strlen("{\"fact\":\"import\",\"pkg\":"))
        WStr(c, JStrP(path), JStrN(path))
        WLit(c, strptr(",\"path\":"), strlen(",\"path\":"))
        WStr(c, JStrP(ip), JStrN(ip))
        ovid/mem.WByte(c.io, c.b, 125)
        Line(c)
        if ovid/json.IsLit(ip, JStrP(path), JStrN(path)) {
          c.pathp = JStrP(path)
          c.pathn = JStrN(path)
          c.idp = JStrP(iid)
          c.idn = JStrN(iid)
          Err(c, strptr("import_self"), strlen("import_self"), JStrP(ip), JStrN(ip))
        }
        if FindPkg(c, JStrP(ip), JStrN(ip)) == 0 {
          c.pathp = JStrP(path)
          c.pathn = JStrN(path)
          c.idp = JStrP(iid)
          c.idn = JStrN(iid)
          Err(c, strptr("unknown_package"), strlen("unknown_package"), JStrP(ip), JStrN(ip))
        }
        im = ovid/json.Next(im)
      }
    }
    var tys i64 = SGet(p, strptr("types"), strlen("types"))
    if tys != 0 {
      var t i64 = ovid/json.Child(tys)
      while t != 0 {
        var tid i64 = SGet(t, strptr("id"), strlen("id"))
        Claim(c, JStrP(tid), JStrN(tid))
        var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
        if fields != 0 {
          var f i64 = ovid/json.Child(fields)
          while f != 0 {
            var fid i64 = SGet(f, strptr("id"), strlen("id"))
            Claim(c, JStrP(fid), JStrN(fid))
            f = ovid/json.Next(f)
          }
        }
        var tnm i64 = SGet(t, strptr("name"), strlen("name"))
        var nf i64 = 0
        if fields != 0 {
          nf = ovid/json.Count(fields)
        }
        WLit(c, strptr("{\"fact\":\"type\",\"name\":"), strlen("{\"fact\":\"type\",\"name\":"))
        WStr(c, JStrP(tnm), JStrN(tnm))
        WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
        WStr(c, JStrP(path), JStrN(path))
        WLit(c, strptr(",\"fields\":"), strlen(",\"fields\":"))
        WNum(c, nf)
        WLit(c, strptr(",\"size\":"), strlen(",\"size\":"))
        WNum(c, nf * 8)
        ovid/mem.WByte(c.io, c.b, 125)
        Line(c)
        t = ovid/json.Next(t)
      }
    }
    var cs i64 = SGet(p, strptr("consts"), strlen("consts"))
    if cs != 0 {
      var k i64 = ovid/json.Child(cs)
      while k != 0 {
        var cid i64 = SGet(k, strptr("id"), strlen("id"))
        Claim(c, JStrP(cid), JStrN(cid))
        k = ovid/json.Next(k)
      }
    }
    var fns i64 = SGet(p, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        var fid i64 = SGet(f, strptr("id"), strlen("id"))
        Claim(c, JStrP(fid), JStrN(fid))
        var params i64 = SGet(f, strptr("params"), strlen("params"))
        if params != 0 {
          var pa i64 = ovid/json.Child(params)
          while pa != 0 {
            var pid i64 = SGet(pa, strptr("id"), strlen("id"))
            Claim(c, JStrP(pid), JStrN(pid))
            pa = ovid/json.Next(pa)
          }
        }
        ClaimArr(c, SGet(f, strptr("body"), strlen("body")))
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
    p = ovid/json.Next(p)
  }
  CheckDeclarations(c)
  CheckABI(c)
  CheckMain(c)
  i = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    c.pkg = pkg
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    c.pathp = JStrP(path)
    c.pathn = JStrN(path)
    var fns i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        CheckFunc(c, f)
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
  }
  WLit(c, strptr("{\"fact\":\"summary\",\"ok\":"), strlen("{\"fact\":\"summary\",\"ok\":"))
  if c.errs == 0 {
    WLit(c, strptr("true"), strlen("true"))
  } else {
    WLit(c, strptr("false"), strlen("false"))
  }
  WLit(c, strptr(",\"errors\":"), strlen(",\"errors\":"))
  WNum(c, c.errs)
  WLit(c, strptr(",\"packages\":"), strlen(",\"packages\":"))
  WNum(c, c.npkg)
  WLit(c, strptr(",\"funcs\":"), strlen(",\"funcs\":"))
  WNum(c, c.nfunc)
  WLit(c, strptr(",\"revision\":"), strlen(",\"revision\":"))
  WStr(c, comp, 64)
  ovid/mem.WByte(c.io, c.b, 125)
  if c.emit == 2 {
    c.emit = 1
  }
  Line(c)
  return c.errs
}
