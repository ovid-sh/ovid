package demo
import ovid/io
// X: the bytes type itself (POC compiler): a token is b[start:i].
const N i64 = 67108864

func Fill(b bytes) i64 {
  var i i64 = 0
  var n i64 = len(b)
  while i < n {
    if i % 8 == 7 {
      b[i] = 32
    } else {
      b[i] = 97 + (i % 7)
    }
    i = i + 1
  }
  return 0
}

func Score(t bytes) i64 {
  if len(t) == 0 {
    return 0
  }
  return t[0] + len(t)
}

func Tokens(b bytes) i64 {
  var total i64 = 0
  var start i64 = 0
  var i i64 = 0
  var n i64 = len(b)
  while i <= n {
    var c i64 = 32
    if i < n {
      c = b[i]
    }
    if c == 32 {
      total = total + Score(b[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return total
}

func main(io *ovid/io.Cap) i64 {
  var b bytes = bytes(ovid/io.Alloc(io, N), N)
  Fill(b)
  ovid/io.PrintInt(io, Tokens(b))
  return 0
}
