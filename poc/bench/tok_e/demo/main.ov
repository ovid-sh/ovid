package demo
import ovid/io
// E: D with the exact checks the compiler would emit (chk is cmp; jae trap).
const N i64 = 67108864
const Trap [1]i64 = {0}

func Fill(p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    chk(i, n)
    if i % 8 == 7 {
      store8(p + i, 32)
    } else {
      store8(p + i, 97 + (i % 7))
    }
    i = i + 1
  }
  return 0
}

func Score(p i64, n i64) i64 {
  if n == 0 {
    return 0
  }
  chk(0, n)
  return load8(p) + n
}

func Tokens(p i64, n i64) i64 {
  var total i64 = 0
  var start i64 = 0
  var i i64 = 0
  while i <= n {
    var c i64 = 32
    if i < n {
      chk(i, n)
      c = load8(p + i)
    }
    if c == 32 {
      // b[start:i]: the check the compiler would emit for a subrange.
      chk(i, n + 1)
      chk(start, i + 1)
      total = total + Score(p + start, i - start)
      start = i + 1
    }
    i = i + 1
  }
  return total
}

func main(io *ovid/io.Cap) i64 {
  var p i64 = ovid/io.Alloc(io, N)
  Fill(p, N)
  ovid/io.PrintInt(io, Tokens(p, N))
  return 0
}
