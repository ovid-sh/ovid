package demo
import ovid/io
// C: a one-word bytes value, the address of a {p, n} header, written out
// by hand: b[i] is two header loads, the check, and the load.
const N i64 = 67108864
const Passes i64 = 8
const Trap [1]i64 = {0}

func New(io *ovid/io.Cap, p i64, n i64) i64 {
  var h i64 = ovid/io.Alloc(io, 16)
  store64(h, p)
  store64(h + 8, n)
  return h
}

func Fill(h i64) i64 {
  var i i64 = 0
  var n i64 = load64(h + 8)
  while i < n {
    if !ult(i, load64(h + 8)) {
      return Trap[i]
    }
    store8(load64(h) + i, i & 255)
    i = i + 1
  }
  return 0
}

func Sum(h i64) i64 {
  var s i64 = 0
  var i i64 = 0
  var n i64 = load64(h + 8)
  while i < n {
    if !ult(i, load64(h + 8)) {
      return Trap[i]
    }
    s = s + load8(load64(h) + i)
    i = i + 1
  }
  return s
}

func main(io *ovid/io.Cap) i64 {
  var h i64 = New(io, ovid/io.Alloc(io, N), N)
  Fill(h)
  var t i64 = 0
  var k i64 = 0
  while k < Passes {
    t = t + Sum(h)
    k = k + 1
  }
  ovid/io.PrintInt(io, t)
  return 0
}
