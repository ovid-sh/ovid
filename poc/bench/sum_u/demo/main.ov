func Sum(p i64) i64 {
  var s i64 = 0
  var i i64 = 0
  while i < 4096 {
    s = s + load64(p + i * 8)
    i = i + 1
  }
  return s
}

func main(io *ovid/io.Cap) i64 {
  var p i64 = ovid/io.Alloc(io, 4096 * 8)
  var j i64 = 0
  while j < 4096 {
    store64(p + j * 8, Tab[j])
    j = j + 1
  }
  var t i64 = 0
  var k i64 = 0
  while k < Passes {
    t = t + Sum(p)
    k = k + 1
  }
  ovid/io.PrintInt(io, t)
  return 0
}
