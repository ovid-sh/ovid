package demo
import ovid/io
// B: a library convention. Bytes is a heap struct; At checks and loads
// through a call.
const N i64 = 67108864
const Passes i64 = 8
const Trap [1]i64 = {0}

type Bytes struct {
  p i64
  n i64
}

func New(io *ovid/io.Cap, p i64, n i64) *Bytes {
  var b *Bytes = ovid/io.Alloc(io, sizeof(Bytes)) as *Bytes
  b.p = p
  b.n = n
  return b
}

func At(b *Bytes, i i64) i64 {
  if !ult(i, b.n) {
    return Trap[i]
  }
  return load8(b.p + i)
}

func Set(b *Bytes, i i64, v i64) i64 {
  if !ult(i, b.n) {
    return Trap[i]
  }
  store8(b.p + i, v)
  return 0
}

func Fill(b *Bytes) i64 {
  var i i64 = 0
  var n i64 = b.n
  while i < n {
    Set(b, i, i & 255)
    i = i + 1
  }
  return 0
}

func Sum(b *Bytes) i64 {
  var s i64 = 0
  var i i64 = 0
  var n i64 = b.n
  while i < n {
    s = s + At(b, i)
    i = i + 1
  }
  return s
}

func main(io *ovid/io.Cap) i64 {
  var b *Bytes = New(io, ovid/io.Alloc(io, N), N)
  Fill(b)
  var t i64 = 0
  var k i64 = 0
  while k < Passes {
    t = t + Sum(b)
    k = k + 1
  }
  ovid/io.PrintInt(io, t)
  return 0
}
