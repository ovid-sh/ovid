package demo
import ovid/io
// X: the bytes type itself (POC compiler).
const N i64 = 67108864
const Passes i64 = 8

func Fill(b bytes) i64 {
  var i i64 = 0
  var n i64 = len(b)
  while i < n {
    b[i] = i & 255
    i = i + 1
  }
  return 0
}

func Sum(b bytes) i64 {
  var s i64 = 0
  var i i64 = 0
  var n i64 = len(b)
  while i < n {
    s = s + b[i]
    i = i + 1
  }
  return s
}

func Make(io *ovid/io.Cap, n i64) bytes {
  var p i64 = ovid/io.Alloc(io, n)
  return bytes(p, n)
}

func main(io *ovid/io.Cap) i64 {
  var b bytes = Make(io, N)
  Fill(b)
  var t i64 = 0
  var k i64 = 0
  while k < Passes {
    t = t + Sum(b)
    k = k + 1
  }
  ovid/io.PrintInt(io, t)
  return 0
}
