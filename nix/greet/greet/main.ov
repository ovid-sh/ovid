package greet

import ovid/io
import ovid/http

// handle greets whoever the query names: an HTTP handler with no main, so
// the toolchain writes the stdio host, which systemd's socket activation
// connects to each accepted connection.
func handle(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64 {
  if !ovid/http.PathIs(req, strptr("/hello"), strlen("/hello")) {
    ovid/http.SetStatus(res, 404)
    return 0
  }
  ovid/http.SetHeader(io, res, strptr("Content-Type"), strlen("Content-Type"), strptr("text/plain"), strlen("text/plain"))
  ovid/http.Write(io, res, strptr("hello, "), strlen("hello, "))
  ovid/http.Write(io, res, ovid/http.Query(req), ovid/http.QueryLen(req))
  ovid/http.Write(io, res, strptr("\n"), strlen("\n"))
  return 0
}
