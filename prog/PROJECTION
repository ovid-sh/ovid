  return 0
}

func Peek(d *Doc) i64 {
  Skip(d)
  if d.pos >= d.n {
    return -1
  }
  return load8(d.data + d.pos)
}

func Bump(d *Doc) i64 {
  var c i64 = load8(d.data + d.pos)
  d.pos = d.pos + 1
  return c
}

func NewVal(io *ovid/io.Cap, kind i64, src i64) i64 {
  var v i64 = ovid/io.Alloc(io, 80)
  if v == 0 {
    return 0
  }
  store64(v + 0, kind)
  store64(v + 8, 0)
  store64(v + 16, 0)
  store64(v + 24, 0)
  store64(v + 32, 0)
  store64(v + 40, 0)
  store64(v + 48, 0)
  store64(v + 56, src)
  store64(v + 64, 0)
  return v
}

func EndVal(v i64, d *Doc) i64 {
  store64(v + 64, d.pos - load64(v + 56))
  return 0
}

func Kind(v i64) i64 {
  return load64(v + 0)
}

func Int(v i64) i64 {
  return load64(v + 8)
}

func StrP(v i64) i64 {
  return load64(v + 16)
}

func StrN(v i64) i64 {
