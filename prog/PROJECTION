}

func At(arr i64, i i64) i64 {
  if arr == 0 {
    return 0
  }
  var c i64 = Child(arr)
  var k i64 = 0
  while c != 0 {
    if k == i {
      return c
    }
    k = k + 1
    c = Next(c)
  }
  return 0
}

func IsLit(v i64, lit i64, n i64) bool {
  if v == 0 {
    return false
  }
  if Kind(v) != 3 {
    return false
  }
  return ovid/mem.Eq(StrP(v), StrN(v), lit, n)
}

