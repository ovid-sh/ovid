  return 0
}

func Lit(d *Doc, p i64, n i64) bool {
  var i i64 = 0
  while i < n {
    if d.pos >= d.n {
      return false
    }
    if load8(d.data + d.pos) != load8(p + i) {
      return false
    }
    d.pos = d.pos + 1
    i = i + 1
  }
  return true
}

func HexVal(c i64) i64 {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return (c - 97) + 10
  }
  if c >= 65 && c <= 70 {
    return (c - 65) + 10
  }
  return -1
}

func PushB(io *ovid/io.Cap, meta i64, c i64) i64 {
  var buf i64 = load64(meta + 0)
  var n i64 = load64(meta + 8)
  var cap i64 = load64(meta + 16)
  if (n + 1) >= cap {
    var nc i64 = cap * 2
    var nb i64 = ovid/io.Alloc(io, nc)
    if nb == 0 {
      return -1
    }
    ovid/mem.Copy(nb, buf, n)
    buf = nb
    cap = nc
    store64(meta + 0, buf)
    store64(meta + 16, cap)
  }
  store8(buf + n, c)
  store64(meta + 8, n + 1)
  return 0
}

func PushCP(io *ovid/io.Cap, meta i64, cp i64) i64 {
  if cp < 128 {
    return PushB(io, meta, cp)
  }
  if cp >= 0xD800 && cp <= 0xDFFF {
    return PushB(io, meta, 63)
  }
  if cp < 2048 {
    if PushB(io, meta, 192 + (cp >> 6)) != 0 {
      return -1
    }
    return PushB(io, meta, 128 + (cp & 63))
  }
  if PushB(io, meta, 224 + (cp >> 12)) != 0 {
    return -1
  }
  if PushB(io, meta, 128 + ((cp >> 6) & 63)) != 0 {
    return -1
  }
  return PushB(io, meta, 128 + (cp & 63))
}

func ParseString(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  if Bump(d) != 34 {
    return Fail(d)
  }
  var meta i64 = ovid/io.Alloc(io, 24)
  var buf i64 = ovid/io.Alloc(io, 16)
  if meta == 0 || buf == 0 {
    return Fail(d)
  }
  store64(meta + 0, buf)
  store64(meta + 8, 0)
  store64(meta + 16, 16)
  while d.pos < d.n {
    var c i64 = Bump(d)
    if c == 34 {
      var v i64 = NewVal(io, 3, src)
      if v == 0 {
        return Fail(d)
      }
      store64(v + 16, load64(meta + 0))
      store64(v + 24, load64(meta + 8))
      EndVal(v, d)
      return v
    }
    if c == 92 {
      if d.pos >= d.n {
        return Fail(d)
      }
      var e i64 = Bump(d)
      if e == 117 {
        var cp i64 = 0
        var k i64 = 0
        while k < 4 {
          if d.pos >= d.n {
            return Fail(d)
          }
          var hv i64 = HexVal(Bump(d))
          if hv < 0 {
            return Fail(d)
          }
          cp = (cp * 16) + hv
          k = k + 1
        }
        if PushCP(io, meta, cp) != 0 {
          return Fail(d)
        }
      } else {
        var bit i64 = -1
        if e == 110 {
          bit = 10
        }
        if e == 116 {
          bit = 9
        }
        if e == 114 {
          bit = 13
        }
        if e == 98 {
          bit = 8
        }
        if e == 102 {
          bit = 12
        }
        if e == 34 || e == 92 || e == 47 {
          bit = e
        }
        if bit < 0 {
          return Fail(d)
        }
        if PushB(io, meta, bit) != 0 {
          return Fail(d)
        }
      }
    } else {
      if PushB(io, meta, c) != 0 {
        return Fail(d)
      }
    }
  }
  return Fail(d)
}

func ParseNum(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  var neg bool = false
  if Peek(d) == 45 {
    neg = true
    Bump(d)
  }
  if Peek(d) < 48 || Peek(d) > 57 {
    return Fail(d)
  }
  var val i64 = 0
  while Peek(d) >= 48 && Peek(d) <= 57 {
    val = (val * 10) + (Bump(d) - 48)
  }
  if neg {
    val = 0 - val
  }
  var v i64 = NewVal(io, 2, src)
  store64(v + 8, val)
  EndVal(v, d)
  return v
}

func ParseValue(io *ovid/io.Cap, d *Doc) i64 {
  var c i64 = Peek(d)
  if c < 0 {
    return Fail(d)
  }
  var src i64 = d.pos
  if c == 110 {
    if !Lit(d, strptr("null"), strlen("null")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 0, src)
    EndVal(v, d)
    return v
  }
  if c == 116 {
    if !Lit(d, strptr("true"), strlen("true")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 1, src)
    store64(v + 8, 1)
    EndVal(v, d)
    return v
  }
  if c == 102 {
    if !Lit(d, strptr("false"), strlen("false")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 1, src)
    store64(v + 8, 0)
    EndVal(v, d)
    return v
  }
  if c == 34 {
    return ParseString(io, d)
  }
  if c == 45 || (c >= 48 && c <= 57) {
    return ParseNum(io, d)
  }
  if c == 91 {
    return ParseArr(io, d)
  }
  if c == 123 {
    return ParseObj(io, d)
  }
  return Fail(d)
}

func AddChild(parent i64, prev i64, child i64, count i64) i64 {
  store64(child + 32, 0)
  if prev == 0 {
    store64(parent + 16, child)
  } else {
    store64(prev + 32, child)
  }
  store64(parent + 24, count)
  return child
}

func ParseArr(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  Bump(d)
  var v i64 = NewVal(io, 4, src)
  var prev i64 = 0
  var count i64 = 0
  if Peek(d) == 93 {
    Bump(d)
    EndVal(v, d)
    return v
  }
  while true {
    var child i64 = ParseValue(io, d)
    if child == 0 {
      return Fail(d)
    }
    count = count + 1
    prev = AddChild(v, prev, child, count)
    var p i64 = Peek(d)
    if p == 93 {
      Bump(d)
      EndVal(v, d)
      return v
    }
    if p != 44 {
      return Fail(d)
    }
    Bump(d)
  }
  return Fail(d)
}

func ParseObj(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  Bump(d)
  var v i64 = NewVal(io, 5, src)
  var prev i64 = 0
  var count i64 = 0
  if Peek(d) == 125 {
    Bump(d)
    EndVal(v, d)
    return v
  }
  while true {
    if Peek(d) != 34 {
      return Fail(d)
    }
    var key i64 = ParseString(io, d)
    if key == 0 {
      return Fail(d)
    }
    if Peek(d) != 58 {
      return Fail(d)
    }
    Bump(d)
    var child i64 = ParseValue(io, d)
    if child == 0 {
      return Fail(d)
    }
    store64(child + 40, StrP(key))
    store64(child + 48, StrN(key))
    count = count + 1
    prev = AddChild(v, prev, child, count)
    var p i64 = Peek(d)
    if p == 125 {
      Bump(d)
      EndVal(v, d)
      return v
    }
    if p != 44 {
      return Fail(d)
    }
    Bump(d)
  }
  return Fail(d)
}

func Parse(io *ovid/io.Cap, data i64, n i64) i64 {
  var raw i64 = ovid/io.Alloc(io, 32)
  var d *Doc = raw as *Doc
  d.data = data
  d.n = n
  d.pos = 0
  d.err = 0
  var v i64 = ParseValue(io, d)
  if v == 0 || d.err != 0 {
