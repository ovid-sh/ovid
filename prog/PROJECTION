  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  ovid/mem.WByte(io, b, 0)
  W32(b, io, 1)
  W32(b, io, 7)
  W64(b, io, 0)
  W64(b, io, 4194304)
  W64(b, io, 4194304)
  W64(b, io, filesz)
  W64(b, io, filesz)
  W64(b, io, 4096)
