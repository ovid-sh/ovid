func StoreBE(p i64, v i64) i64 {
  store8(p, (v >> 24) & 255)
  store8(p + 1, (v >> 16) & 255)
  store8(p + 2, (v >> 8) & 255)
  store8(p + 3, v & 255)
  return 0
}

func HexDig(c i64) i64 {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return (c - 97) + 10
  }
  if c >= 65 && c <= 70 {
    return (c - 65) + 10
  }
  return 0
