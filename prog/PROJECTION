// Ovid projection. Canonical program is ovid.json.
// entry ovid/cli

// ----- ovid/asm -----

package ovid/asm

import ovid/io

type Code struct {
  data i64
  len i64
  cap i64
  nlab i64
  labs i64
  nfix i64
  fixes i64
  nabs i64
  abss i64
  ro i64
  ron i64
  rocap i64
}

func New(io *ovid/io.Cap) *Code {
  var raw i64 = ovid/io.Alloc(io, 96)
  var c *Code = raw as *Code
  c.cap = 8388608
  c.data = ovid/io.Alloc(io, c.cap)
  c.len = 0
  c.nlab = 0
  c.labs = ovid/io.Alloc(io, 1600000)
  c.nfix = 0
  c.fixes = ovid/io.Alloc(io, 4800000)
  c.nabs = 0
  c.abss = ovid/io.Alloc(io, 640000)
  c.rocap = 2097152
  c.ro = ovid/io.Alloc(io, c.rocap)
  c.ron = 0
  return c
}

func E(c *Code, b i64) i64 {
  if c.len >= c.cap {
    return -1
  }
  store8(c.data + c.len, b & 255)
  c.len = c.len + 1
  return 0
}

func EU32(c *Code, v i64) i64 {
  E(c, v)
  E(c, v >> 8)
  E(c, v >> 16)
  E(c, v >> 24)
  return 0
}

func EU64(c *Code, v i64) i64 {
  EU32(c, v)
  EU32(c, v >> 32)
  return 0
}

func PutU32(p i64, v i64) i64 {
  store8(p, v)
  store8(p + 1, v >> 8)
  store8(p + 2, v >> 16)
  store8(p + 3, v >> 24)
  return 0
}

func PutU64(p i64, v i64) i64 {
  PutU32(p, v)
  PutU32(p + 4, v >> 32)
  return 0
}

func NewLabel(c *Code) i64 {
  var id i64 = c.nlab
  store64(c.labs + (id * 8), 0 - 1)
  c.nlab = id + 1
  return id
}

func Mark(c *Code, id i64) i64 {
  store64(c.labs + (id * 8), c.len)
  return 0
}

func AddFix(c *Code, at i64, end i64, lab i64) i64 {
  var p i64 = c.fixes + (c.nfix * 24)
  store64(p, at)
  store64(p + 8, end)
  store64(p + 16, lab)
  c.nfix = c.nfix + 1
  return 0
}

func Rel(c *Code, op i64, op2 i64, n i64, lab i64) i64 {
  if n == 1 {
    E(c, op)
  } else {
    E(c, op)
    E(c, op2)
  }
  var at i64 = c.len
  EU32(c, 0)
  AddFix(c, at, c.len, lab)
  return 0
}

func Jmp(c *Code, lab i64) i64 {
  return Rel(c, 0xE9, 0, 1, lab)
}

func Call(c *Code, lab i64) i64 {
  return Rel(c, 0xE8, 0, 1, lab)
}

func Jcc(c *Code, cc i64, lab i64) i64 {
  return Rel(c, 0x0F, cc, 2, lab)
}

func Jz(c *Code, lab i64) i64 {
  return Jcc(c, 0x84, lab)
}

func Jnz(c *Code, lab i64) i64 {
  return Jcc(c, 0x85, lab)
}

func Jl(c *Code, lab i64) i64 {
  return Jcc(c, 0x8C, lab)
}

func MovRegImm(c *Code, reg i64, imm i64) i64 {
  var rex i64 = 0x48
  if reg >= 8 {
    rex = 0x49
  }
  E(c, rex)
  E(c, 0xB8 + (reg & 7))
  EU64(c, imm)
  return 0
}

func AbsHere(c *Code, roOff i64) i64 {
  var p i64 = c.abss + (c.nabs * 16)
  store64(p, c.len - 8)
  store64(p + 8, roOff)
  c.nabs = c.nabs + 1
  return 0
}

func MovRegReg(c *Code, dst i64, src i64) i64 {
  var rex i64 = 0x48
  if src >= 8 {
    rex = rex + 4
  }
  if dst >= 8 {
    rex = rex + 1
  }
  E(c, rex)
  E(c, 0x89)
  E(c, (192 + ((src & 7) * 8)) + (dst & 7))
  return 0
}

func PushReg(c *Code, reg i64) i64 {
  if reg >= 8 {
    E(c, 0x41)
  }
  E(c, 0x50 + (reg & 7))
  return 0
}

func PopReg(c *Code, reg i64) i64 {
  if reg >= 8 {
    E(c, 0x41)
  }
  E(c, 0x58 + (reg & 7))
  return 0
}

func Ret(c *Code) i64 {
