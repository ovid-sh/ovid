  }
  if Lit(op, strptr("load64"), strlen("load64")) {
    return SetI64(c)
  }
  if Lit(op, strptr("syscall"), strlen("syscall")) {
    return SetI64(c)
  }
  if Lit(op, strptr("bool"), strlen("bool")) {
    return SetBool(c)
  }
  if CmpOp(op) {
    return SetBool(c)
  }
  if Lit(op, strptr("land"), strlen("land")) {
    return SetBool(c)
  }
  if Lit(op, strptr("lor"), strlen("lor")) {
    return SetBool(c)
  }
  if Lit(op, strptr("not"), strlen("not")) {
    return SetBool(c)
