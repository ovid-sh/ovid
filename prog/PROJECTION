func Add(a i64, b i64) i64 {
  return (a + b) & 0xFFFFFFFF
}

func Not32(x i64) i64 {
  return (x ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

func Rotr(x i64, n i64) i64 {
  var v i64 = x & 0xFFFFFFFF
  if n == 0 {
    return v
  }
  var r i64 = (v >> n) & 0xFFFFFFFF
  var l i64 = (v << (32 - n)) & 0xFFFFFFFF
  return (r | l) & 0xFFFFFFFF
}

func Shr(x i64, n i64) i64 {
  return (x >> n) & 0xFFFFFFFF
}

func LoadBE(p i64) i64 {
  var b0 i64 = load8(p)
  var b1 i64 = load8(p + 1)
  var b2 i64 = load8(p + 2)
  var b3 i64 = load8(p + 3)
  return (((b0 << 24) | (b1 << 16)) | ((b2 << 8) | b3)) & 0xFFFFFFFF
