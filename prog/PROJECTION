func Skip(d *Doc) i64 {
  while d.pos < d.n {
    var c i64 = load8(d.data + d.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      d.pos = d.pos + 1
    } else {
      return 0
    }
