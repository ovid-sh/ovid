func CheckExpr(c *Ch, n i64) i64 {
  if n == 0 {
    Err(c, strptr("missing_expr"), strlen("missing_expr"), strptr("empty"), strlen("empty"))
    return SetBad(c)
  }
  Here(c, n)
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if Leaf(op) {
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("bool"), strlen("bool")) {
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("name"), strlen("name")) {
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    var loc i64 = Lookup(c, JStrP(nm), JStrN(nm))
    if loc != 0 {
      return SetTy(c, load64(loc + 16), load64(loc + 24))
    }
    if FindConst(c, JStrP(nm), JStrN(nm)) {
      return SetI64(c)
    }
    Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
    return SetBad(c)
  }
  if Arith(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lp i64 = c.typ
    var ln i64 = c.tyn
    var lb bool = Bad(c)
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    var rb bool = Bad(c)
    if !lb {
      if !TyEq(lp, ln, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("arith needs i64"), strlen("arith needs i64"))
      }
    }
    if !rb {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("arith needs i64"), strlen("arith needs i64"))
      }
    }
    return SetI64(c)
  }
  if CmpEq(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lp i64 = c.typ
    var ln i64 = c.tyn
    var lb bool = Bad(c)
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    if !lb {
      if !Bad(c) {
        if !TyEq(lp, ln, c.typ, c.tyn) {
          Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("comparison types differ"), strlen("comparison types differ"))
        }
      }
    }
    return SetBool(c)
  }
  if CmpOrd(op) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lb bool = Bad(c)
    var lp i64 = c.typ
    var ln i64 = c.tyn
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    if !lb {
      if !TyEq(lp, ln, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("order needs i64"), strlen("order needs i64"))
      }
    }
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("order needs i64"), strlen("order needs i64"))
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("land"), strlen("land")) || ovid/json.IsLit(op, strptr("lor"), strlen("lor")) {
    CheckExpr(c, SGet(n, strptr("left"), strlen("left")))
    var lb bool = Bad(c)
    var lbool bool = IsTy(c, strptr("bool"), strlen("bool"))
    CheckExpr(c, SGet(n, strptr("right"), strlen("right")))
    var rb bool = Bad(c)
    var rbool bool = IsTy(c, strptr("bool"), strlen("bool"))
    if !lb {
      if !lbool {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("logic needs bool"), strlen("logic needs bool"))
      }
    }
    if !rb {
      if !rbool {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("logic needs bool"), strlen("logic needs bool"))
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("not"), strlen("not")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("not needs bool"), strlen("not needs bool"))
      }
    }
    return SetBool(c)
  }
  if ovid/json.IsLit(op, strptr("neg"), strlen("neg")) || ovid/json.IsLit(op, strptr("bnot"), strlen("bnot")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("unary needs i64"), strlen("unary needs i64"))
      }
    }
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("load8"), strlen("load8")) || ovid/json.IsLit(op, strptr("load32"), strlen("load32")) || ovid/json.IsLit(op, strptr("load64"), strlen("load64")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("load needs i64"), strlen("load needs i64"))
      }
    }
    return SetI64(c)
  }
  if ovid/json.IsLit(op, strptr("cast"), strlen("cast")) {
    CheckExpr(c, SGet(n, strptr("arg"), strlen("arg")))
    var ty i64 = SGet(n, strptr("type"), strlen("type"))
    return SetTy(c, JStrP(ty), JStrN(ty))
  }
  if ovid/json.IsLit(op, strptr("field"), strlen("field")) {
    CheckExpr(c, SGet(n, strptr("base"), strlen("base")))
    if Bad(c) {
      return SetBad(c)
    }
    var tp i64 = c.typ
    var tn i64 = c.tyn
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    if FieldTy(c, tp, tn, JStrP(nm), JStrN(nm)) != 0 {
      Err(c, strptr("unknown_field"), strlen("unknown_field"), JStrP(nm), JStrN(nm))
      return SetBad(c)
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("call"), strlen("call")) {
    var pp i64 = c.pathp
    var pn i64 = c.pathn
    var pk i64 = SGet(n, strptr("pkg"), strlen("pkg"))
    if pk != 0 {
      pp = JStrP(pk)
      pn = JStrN(pk)
      if !Imported(c, pp, pn) {
        Err(c, strptr("unknown_package"), strlen("unknown_package"), pp, pn)
      }
    }
    var nm i64 = SGet(n, strptr("func"), strlen("func"))
    var fn i64 = FindFunc(c, pp, pn, JStrP(nm), JStrN(nm))
    var args i64 = SGet(n, strptr("args"), strlen("args"))
    var nargs i64 = 0
    if args != 0 {
      nargs = ovid/json.Count(args)
    }
    if fn == 0 {
      Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
      var a i64 = 0
      if args != 0 {
        a = ovid/json.Child(args)
      }
      while a != 0 {
        CheckExpr(c, a)
        a = ovid/json.Next(a)
      }
      return SetBad(c)
    }
    var params i64 = SGet(fn, strptr("params"), strlen("params"))
    var nparam i64 = 0
    if params != 0 {
      nparam = ovid/json.Count(params)
    }
    if nargs != nparam {
      Err(c, strptr("arity"), strlen("arity"), JStrP(nm), JStrN(nm))
    }
    var i i64 = 0
    var a i64 = 0
    if args != 0 {
      a = ovid/json.Child(args)
    }
    var p i64 = 0
    if params != 0 {
      p = ovid/json.Child(params)
    }
    while a != 0 {
      CheckExpr(c, a)
      if p != 0 {
        if !Bad(c) {
          var ty i64 = SGet(p, strptr("type"), strlen("type"))
          if !IsTy(c, JStrP(ty), JStrN(ty)) {
            Err(c, strptr("type_mismatch"), strlen("type_mismatch"), JStrP(nm), JStrN(nm))
          }
        }
        p = ovid/json.Next(p)
      }
      i = i + 1
      a = ovid/json.Next(a)
    }
    var rs i64 = SGet(fn, strptr("result"), strlen("result"))
    return SetTy(c, JStrP(rs), JStrN(rs))
  }
  if ovid/json.IsLit(op, strptr("syscall"), strlen("syscall")) {
    if !ovid/mem.Eq(c.pathp, c.pathn, strptr("ovid/io"), strlen("ovid/io")) {
      Err(c, strptr("syscall_forbidden"), strlen("syscall_forbidden"), strptr("only ovid/io"), strlen("only ovid/io"))
    }
    var args i64 = SGet(n, strptr("args"), strlen("args"))
    var nargs i64 = 0
    if args != 0 {
      nargs = ovid/json.Count(args)
    }
    if nargs != 7 {
      Err(c, strptr("arity"), strlen("arity"), strptr("syscall"), strlen("syscall"))
    }
    var a i64 = 0
    if args != 0 {
      a = ovid/json.Child(args)
    }
    while a != 0 {
      CheckExpr(c, a)
      if !Bad(c) {
        if !IsTy(c, strptr("i64"), strlen("i64")) {
          Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("syscall arg"), strlen("syscall arg"))
        }
      }
      a = ovid/json.Next(a)
    }
    return SetI64(c)
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("expr"), strlen("expr"))
  return SetBad(c)
}

func Paths(arr i64) bool {
  if arr == 0 {
    return false
  }
  if ovid/json.Count(arr) == 0 {
    return false
  }
  var last i64 = 0
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    last = s
    s = ovid/json.Next(s)
  }
  var op i64 = SGet(last, strptr("op"), strlen("op"))
  if ovid/json.IsLit(op, strptr("return"), strlen("return")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("if"), strlen("if")) {
    var el i64 = SGet(last, strptr("else"), strlen("else"))
    if el == 0 {
      return false
    }
    if ovid/json.Count(el) == 0 {
      return false
    }
    if Paths(SGet(last, strptr("then"), strlen("then"))) {
      if Paths(el) {
        return true
      }
    }
    return false
  }
  return false
}

func CheckStmts(c *Ch, arr i64) i64 {
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    CheckStmt(c, s)
    s = ovid/json.Next(s)
  }
  return 0
}

func CheckStmt(c *Ch, s i64) i64 {
  if s == 0 {
    return 0
  }
  Here(c, s)
  var op i64 = SGet(s, strptr("op"), strlen("op"))
  if ovid/json.IsLit(op, strptr("var"), strlen("var")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var ty i64 = SGet(s, strptr("type"), strlen("type"))
    var tp i64 = JStrP(ty)
    var tn i64 = JStrN(ty)
    var ok bool = false
    if TyEq(tp, tn, strptr("i64"), strlen("i64")) {
      ok = true
    }
    if TyEq(tp, tn, strptr("bool"), strlen("bool")) {
      ok = true
    }
    if tn > 0 {
      if load8(tp) == 42 {
        ok = true
      }
    }
    if !ok {
      Err(c, strptr("struct_value"), strlen("struct_value"), JStrP(nm), JStrN(nm))
    }
    Define(c, JStrP(nm), JStrN(nm), tp, tn)
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val != 0 {
      CheckExpr(c, val)
      if !Bad(c) {
        if !IsTy(c, tp, tn) {
          Err(c, strptr("type_mismatch"), strlen("type_mismatch"), JStrP(nm), JStrN(nm))
        }
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("assign"), strlen("assign")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var loc i64 = Lookup(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      Err(c, strptr("unknown_name"), strlen("unknown_name"), JStrP(nm), JStrN(nm))
      CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
      return 0
    }
    var tp i64 = load64(loc + 16)
    var tn i64 = load64(loc + 24)
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !Bad(c) {
      if !IsTy(c, tp, tn) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), JStrP(nm), JStrN(nm))
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("setfield"), strlen("setfield")) {
    var base i64 = SGet(s, strptr("base"), strlen("base"))
    CheckExpr(c, base)
    var tp i64 = c.typ
    var tn i64 = c.tyn
    var was bool = Bad(c)
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var fp i64 = 0
    var fn i64 = 0
    if !was {
      if FieldTy(c, tp, tn, JStrP(nm), JStrN(nm)) != 0 {
        Err(c, strptr("unknown_field"), strlen("unknown_field"), JStrP(nm), JStrN(nm))
        was = true
      } else {
        fp = c.typ
        fn = c.tyn
      }
    }
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !was {
      if !Bad(c) {
        if !IsTy(c, fp, fn) {
          Err(c, strptr("type_mismatch"), strlen("type_mismatch"), JStrP(nm), JStrN(nm))
        }
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("store8"), strlen("store8")) || ovid/json.IsLit(op, strptr("store64"), strlen("store64")) {
    CheckExpr(c, SGet(s, strptr("addr"), strlen("addr")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("store address"), strlen("store address"))
      }
    }
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    if !Bad(c) {
      if !IsTy(c, strptr("i64"), strlen("i64")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("store value"), strlen("store value"))
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("expr"), strlen("expr")) {
    CheckExpr(c, SGet(s, strptr("val"), strlen("val")))
    return 0
  }
  if ovid/json.IsLit(op, strptr("return"), strlen("return")) {
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val == 0 {
      Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("missing return value"), strlen("missing return value"))
      return 0
    }
    CheckExpr(c, val)
    if !Bad(c) {
      if !IsTy(c, c.resp, c.resn) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("return type"), strlen("return type"))
      }
    }
    return 0
  }
  if ovid/json.IsLit(op, strptr("if"), strlen("if")) {
    CheckExpr(c, SGet(s, strptr("cond"), strlen("cond")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("if needs bool"), strlen("if needs bool"))
      }
    }
    Push(c)
    CheckStmts(c, SGet(s, strptr("then"), strlen("then")))
    Pop(c)
    Push(c)
    CheckStmts(c, SGet(s, strptr("else"), strlen("else")))
    Pop(c)
    return 0
  }
  if ovid/json.IsLit(op, strptr("while"), strlen("while")) {
    CheckExpr(c, SGet(s, strptr("cond"), strlen("cond")))
    if !Bad(c) {
      if !IsTy(c, strptr("bool"), strlen("bool")) {
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("while needs bool"), strlen("while needs bool"))
      }
    }
    Push(c)
    CheckStmts(c, SGet(s, strptr("body"), strlen("body")))
    Pop(c)
    return 0
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("stmt"), strlen("stmt"))
  return 0
}

func CheckFunc(c *Ch, fn i64) i64 {
  c.nenv = 0
  c.nmark = 0
  var nm i64 = SGet(fn, strptr("name"), strlen("name"))
  c.fnp = JStrP(nm)
  c.fnn = JStrN(nm)
  var rs i64 = SGet(fn, strptr("result"), strlen("result"))
  c.resp = JStrP(rs)
  c.resn = JStrN(rs)
  Here(c, fn)
  Push(c)
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  if nparam > 6 {
    Err(c, strptr("arity"), strlen("arity"), strptr("more than 6 params"), strlen("more than 6 params"))
  }
  var p i64 = 0
  if params != 0 {
    p = ovid/json.Child(params)
  }
  while p != 0 {
    Here(c, p)
    var pnm i64 = SGet(p, strptr("name"), strlen("name"))
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    Define(c, JStrP(pnm), JStrN(pnm), JStrP(ty), JStrN(ty))
    p = ovid/json.Next(p)
  }
  Here(c, fn)
  var body i64 = SGet(fn, strptr("body"), strlen("body"))
  CheckStmts(c, body)
  if !Paths(body) {
    Err(c, strptr("missing_return"), strlen("missing_return"), c.fnp, c.fnn)
  }
  Pop(c)
  WLit(c, strptr("{\"fact\":\"func\",\"name\":"), strlen("{\"fact\":\"func\",\"name\":"))
  WStr(c, c.fnp, c.fnn)
  WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
  WStr(c, c.pathp, c.pathn)
  WLit(c, strptr(",\"params\":"), strlen(",\"params\":"))
  WNum(c, nparam)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  c.nfunc = c.nfunc + 1
  return 0
}

func Join(io *ovid/io.Cap, dir i64, dirn i64, suf i64, sufn i64) i64 {
  var n i64 = (dirn + 1) + sufn
  var p i64 = ovid/io.Alloc(io, n + 1)
  ovid/mem.Copy(p, dir, dirn)
  store8(p + dirn, 47)
  ovid/mem.Copy(p + dirn + 1, suf, sufn)
  store8(p + n, 0)
  return p
}

func CheckMain(c *Ch) i64 {
  var ent i64 = SGet(c.root, strptr("entry"), strlen("entry"))
  var pkg i64 = FindPkg(c, JStrP(ent), JStrN(ent))
  if pkg == 0 {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    c.fnp = 0
    c.fnn = 0
    c.idp = 0
    c.idn = 0
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("missing entry package"), strlen("missing entry package"))
    return 0
  }
  var fn i64 = FindFunc(c, JStrP(ent), JStrN(ent), strptr("main"), strlen("main"))
  if fn == 0 {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("entry package has no main"), strlen("entry package has no main"))
    return 0
  }
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  var rs i64 = SGet(fn, strptr("result"), strlen("result"))
  var ok bool = false
  if nparam == 1 {
    var p i64 = ovid/json.Child(params)
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    if ovid/json.IsLit(ty, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap")) {
      if ovid/json.IsLit(rs, strptr("i64"), strlen("i64")) {
        ok = true
      }
    }
  }
  if !ok {
    c.pathp = JStrP(ent)
    c.pathn = JStrN(ent)
    c.fnp = strptr("main")
    c.fnn = strlen("main")
    Here(c, fn)
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("main must be (io *ovid/io.Cap) i64"), strlen("main must be (io *ovid/io.Cap) i64"))
  }
  return 0
}

func Run(io *ovid/io.Cap, root i64, file i64, filen i64, dir i64, dirn i64) i64 {
  var raw i64 = ovid/io.Alloc(io, 256)
  Zero(raw, 256)
  var c *Ch = raw as *Ch
  c.io = io
  c.root = root
  c.file = file
  c.filen = filen
  c.dir = dir
  c.dirn = dirn
  c.tabsz = 262144
  c.b = ovid/mem.New(io, 4096)
  c.env = ovid/io.Alloc(io, 4096 * 32)
  c.mark = ovid/io.Alloc(io, 256 * 8)
  c.tab = ovid/io.Alloc(io, c.tabsz * 16)
  Zero(c.tab, c.tabsz * 16)
  var stored i64 = ovid/io.Alloc(io, 64)
  var comp i64 = ovid/io.Alloc(io, 64)
  Zero(stored, 64)
  Zero(comp, 64)
  if Hash(io, file, filen, stored, comp) < 0 {
    var z i64 = 0
    while z < 64 {
      store8(comp + z, 48)
      z = z + 1
    }
    Err(c, strptr("revision"), strlen("revision"), strptr("missing revision"), strlen("missing revision"))
  } else {
    if !ovid/mem.Eq(stored, 64, comp, 64) {
      Err(c, strptr("revision_mismatch"), strlen("revision_mismatch"), strptr("stored revision does not match file bytes"), strlen("stored revision does not match file bytes"))
    }
  }
  var mod i64 = SGet(root, strptr("module"), strlen("module"))
  var ent i64 = SGet(root, strptr("entry"), strlen("entry"))
  var pkgs i64 = SGet(root, strptr("packages"), strlen("packages"))
  if pkgs != 0 {
    c.npkg = ovid/json.Count(pkgs)
  }
  c.pkgs = ovid/io.Alloc(io, (c.npkg + 1) * 8)
  WLit(c, strptr("{\"fact\":\"module\",\"revision\":\""), strlen("{\"fact\":\"module\",\"revision\":\""))
  ovid/mem.WBytes(c.io, c.b, comp, 64)
  WLit(c, strptr("\",\"module\":"), strlen("\",\"module\":"))
  WStr(c, JStrP(mod), JStrN(mod))
  WLit(c, strptr(",\"entry\":"), strlen(",\"entry\":"))
  WStr(c, JStrP(ent), JStrN(ent))
  WLit(c, strptr(",\"packages\":"), strlen(",\"packages\":"))
  WNum(c, c.npkg)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  var proj i64 = Join(io, dir, dirn, strptr("PROJECTION"), strlen("PROJECTION"))
  var st i64 = ovid/io.Alloc(io, 256)
  var present i64 = 0
  if ovid/io.FstatAt(proj, st) >= 0 {
    present = 1
  }
  WLit(c, strptr("{\"fact\":\"projection\",\"path\":\"PROJECTION\",\"present\":"), strlen("{\"fact\":\"projection\",\"path\":\"PROJECTION\",\"present\":"))
  if present == 1 {
    WLit(c, strptr("true}"), strlen("true}"))
  } else {
    WLit(c, strptr("false}"), strlen("false}"))
  }
  Line(c)
  if present == 0 {
    Err(c, strptr("missing_projection"), strlen("missing_projection"), strptr("PROJECTION is not in the module directory"), strlen("PROJECTION is not in the module directory"))
  }
  var fi i64 = 0
  var fp i64 = 0
  if pkgs != 0 {
    fp = ovid/json.Child(pkgs)
  }
  while fp != 0 {
    store64(c.pkgs + (fi * 8), fp)
    fi = fi + 1
    fp = ovid/json.Next(fp)
  }
  var i i64 = 0
  var p i64 = 0
  if pkgs != 0 {
    p = ovid/json.Child(pkgs)
  }
  while p != 0 {
    store64(c.pkgs + (i * 8), p)
    var id i64 = SGet(p, strptr("id"), strlen("id"))
    Claim(c, JStrP(id), JStrN(id))
    var path i64 = SGet(p, strptr("path"), strlen("path"))
    var dirp i64 = Join(io, dir, dirn, JStrP(path), JStrN(path))
    var isdir i64 = ovid/io.IsDir(io, dirp, ovid/io.CLen(dirp))
    WLit(c, strptr("{\"fact\":\"package\",\"path\":"), strlen("{\"fact\":\"package\",\"path\":"))
    WStr(c, JStrP(path), JStrN(path))
    WLit(c, strptr(",\"dir\":"), strlen(",\"dir\":"))
    if isdir == 1 {
      WLit(c, strptr("true}"), strlen("true}"))
    } else {
      WLit(c, strptr("false}"), strlen("false}"))
    }
    Line(c)
    if isdir == 0 {
      c.pathp = JStrP(path)
      c.pathn = JStrN(path)
      c.idp = JStrP(id)
      c.idn = JStrN(id)
      Err(c, strptr("missing_dir"), strlen("missing_dir"), JStrP(path), JStrN(path))
    }
    var ims i64 = SGet(p, strptr("imports"), strlen("imports"))
    if ims != 0 {
      var im i64 = ovid/json.Child(ims)
      while im != 0 {
        var iid i64 = SGet(im, strptr("id"), strlen("id"))
        Claim(c, JStrP(iid), JStrN(iid))
        var ip i64 = SGet(im, strptr("path"), strlen("path"))
        WLit(c, strptr("{\"fact\":\"import\",\"pkg\":"), strlen("{\"fact\":\"import\",\"pkg\":"))
        WStr(c, JStrP(path), JStrN(path))
        WLit(c, strptr(",\"path\":"), strlen(",\"path\":"))
        WStr(c, JStrP(ip), JStrN(ip))
        ovid/mem.WByte(c.io, c.b, 125)
        Line(c)
        if ovid/json.IsLit(ip, JStrP(path), JStrN(path)) {
          c.pathp = JStrP(path)
          c.pathn = JStrN(path)
          c.idp = JStrP(iid)
          c.idn = JStrN(iid)
          Err(c, strptr("import_self"), strlen("import_self"), JStrP(ip), JStrN(ip))
        }
        if FindPkg(c, JStrP(ip), JStrN(ip)) == 0 {
          c.pathp = JStrP(path)
          c.pathn = JStrN(path)
          c.idp = JStrP(iid)
          c.idn = JStrN(iid)
          Err(c, strptr("unknown_package"), strlen("unknown_package"), JStrP(ip), JStrN(ip))
        }
        im = ovid/json.Next(im)
      }
    }
    var tys i64 = SGet(p, strptr("types"), strlen("types"))
    if tys != 0 {
      var t i64 = ovid/json.Child(tys)
      while t != 0 {
        var tid i64 = SGet(t, strptr("id"), strlen("id"))
        Claim(c, JStrP(tid), JStrN(tid))
        var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
        if fields != 0 {
          var f i64 = ovid/json.Child(fields)
          while f != 0 {
            var fid i64 = SGet(f, strptr("id"), strlen("id"))
            Claim(c, JStrP(fid), JStrN(fid))
            f = ovid/json.Next(f)
          }
        }
        var tnm i64 = SGet(t, strptr("name"), strlen("name"))
        var nf i64 = 0
        if fields != 0 {
          nf = ovid/json.Count(fields)
        }
        WLit(c, strptr("{\"fact\":\"type\",\"name\":"), strlen("{\"fact\":\"type\",\"name\":"))
        WStr(c, JStrP(tnm), JStrN(tnm))
        WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
        WStr(c, JStrP(path), JStrN(path))
        WLit(c, strptr(",\"fields\":"), strlen(",\"fields\":"))
        WNum(c, nf)
        WLit(c, strptr(",\"size\":"), strlen(",\"size\":"))
        WNum(c, nf * 8)
        ovid/mem.WByte(c.io, c.b, 125)
        Line(c)
        t = ovid/json.Next(t)
      }
    }
    var cs i64 = SGet(p, strptr("consts"), strlen("consts"))
    if cs != 0 {
      var k i64 = ovid/json.Child(cs)
      while k != 0 {
        var cid i64 = SGet(k, strptr("id"), strlen("id"))
        Claim(c, JStrP(cid), JStrN(cid))
        k = ovid/json.Next(k)
      }
    }
    var fns i64 = SGet(p, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        var fid i64 = SGet(f, strptr("id"), strlen("id"))
        Claim(c, JStrP(fid), JStrN(fid))
        var params i64 = SGet(f, strptr("params"), strlen("params"))
        if params != 0 {
          var pa i64 = ovid/json.Child(params)
          while pa != 0 {
            var pid i64 = SGet(pa, strptr("id"), strlen("id"))
            Claim(c, JStrP(pid), JStrN(pid))
            pa = ovid/json.Next(pa)
          }
        }
        ClaimArr(c, SGet(f, strptr("body"), strlen("body")))
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
    p = ovid/json.Next(p)
  }
  CheckMain(c)
  i = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    c.pkg = pkg
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    c.pathp = JStrP(path)
    c.pathn = JStrN(path)
    var fns i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        CheckFunc(c, f)
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
  }
  WLit(c, strptr("{\"fact\":\"summary\",\"ok\":"), strlen("{\"fact\":\"summary\",\"ok\":"))
  if c.errs == 0 {
    WLit(c, strptr("true"), strlen("true"))
  } else {
    WLit(c, strptr("false"), strlen("false"))
  }
  WLit(c, strptr(",\"errors\":"), strlen(",\"errors\":"))
  WNum(c, c.errs)
  WLit(c, strptr(",\"packages\":"), strlen(",\"packages\":"))
  WNum(c, c.npkg)
  WLit(c, strptr(",\"funcs\":"), strlen(",\"funcs\":"))
  WNum(c, c.nfunc)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  return c.errs
}

// ----- ovid/cli -----

package ovid/cli

import ovid/io
import ovid/json
import ovid/mem
import ovid/check
import ovid/cg

type Q struct {
  io *ovid/io.Cap
  b *ovid/mem.Buf
  file i64
  idp i64
  idn i64
  namep i64
  namen i64
  pkgp i64
  pkgn i64
  kindp i64
  kindn i64
  gkp i64
  gkn i64
  full i64
  first i64
}

func SGet(obj i64, lit i64, n i64) i64 {
  if obj == 0 {
    return 0
  }
  return ovid/json.GetLit(obj, lit, n)
}

func JStrP(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrP(v)
}

func JStrN(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrN(v)
}

func ArgEq(io *ovid/io.Cap, i i64, lit i64, n i64) bool {
  var a i64 = ovid/io.Arg(io, i)
  return ovid/mem.Eq(a, ovid/io.CLen(a), lit, n)
}

func Join(io *ovid/io.Cap, dir i64, dirn i64, suf i64, sufn i64) i64 {
  var n i64 = (dirn + 1) + sufn
  var p i64 = ovid/io.Alloc(io, n + 1)
  ovid/mem.Copy(p, dir, dirn)
  store8(p + dirn, 47)
  ovid/mem.Copy((p + dirn) + 1, suf, sufn)
  store8(p + n, 0)
  return p
}

func Usage(io *ovid/io.Cap) i64 {
  ovid/io.Stdout(strptr("{\"ok\":false,\"error\":\"usage\",\"detail\":\"ovid check <dir> | query <dir> [--id|--name|--pkg|--kind] | patch <dir> <file> | build <dir> -o <file>\"}\n"), strlen("{\"ok\":false,\"error\":\"usage\",\"detail\":\"ovid check <dir> | query <dir> [--id|--name|--pkg|--kind] | patch <dir> <file> | build <dir> -o <file>\"}\n"))
  return 1
}

func Fail(io *ovid/io.Cap, code i64, coden i64, detail i64, dn i64) i64 {
  ovid/io.Stdout(strptr("{\"ok\":false,\"error\":"), strlen("{\"ok\":false,\"error\":"))
  var b *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WByte(io, b, 34)
  ovid/mem.WBytes(io, b, code, coden)
  ovid/mem.WByte(io, b, 34)
  ovid/io.Stdout(b.data, b.len)
  ovid/io.Stdout(strptr(",\"detail\":"), strlen(",\"detail\":"))
  b.len = 0
  ovid/mem.WByte(io, b, 34)
  ovid/mem.WBytes(io, b, detail, dn)
  ovid/mem.WByte(io, b, 34)
  ovid/mem.WByte(io, b, 125)
  ovid/mem.WByte(io, b, 10)
  ovid/io.Stdout(b.data, b.len)
  return 1
}

func Read(io *ovid/io.Cap, path i64, pp i64, nn i64) i64 {
  return ovid/io.ReadFile(io, path, ovid/io.CLen(path), pp, nn)
}

func CmdCheck(io *ovid/io.Cap, dir i64) i64 {
  var path i64 = Join(io, dir, ovid/io.CLen(dir), strptr("ovid.json"), strlen("ovid.json"))
  var pp i64 = ovid/io.Alloc(io, 8)
  var nn i64 = ovid/io.Alloc(io, 8)
  if Read(io, path, pp, nn) != 0 {
    return Fail(io, strptr("read"), strlen("read"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var root i64 = ovid/json.Parse(io, load64(pp), load64(nn))
  if root == 0 {
    return Fail(io, strptr("parse"), strlen("parse"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var nerr i64 = ovid/check.Run(io, root, load64(pp), load64(nn), dir, ovid/io.CLen(dir))
  if nerr != 0 {
    return 1
  }
  return 0
}

func WLitQ(q *Q, p i64, n i64) i64 {
  return ovid/mem.WBytes(q.io, q.b, p, n)
}

func WStrQ(q *Q, v i64) i64 {
  ovid/mem.WByte(q.io, q.b, 34)
  var p i64 = JStrP(v)
  var n i64 = JStrN(v)
  var i i64 = 0
  while i < n {
    var ch i64 = load8(p + i)
    if ch == 34 || ch == 92 {
      ovid/mem.WByte(q.io, q.b, 92)
      ovid/mem.WByte(q.io, q.b, ch)
    } else {
      if ch == 10 {
        ovid/mem.WByte(q.io, q.b, 92)
        ovid/mem.WByte(q.io, q.b, 110)
      } else {
        ovid/mem.WByte(q.io, q.b, ch)
      }
    }
    i = i + 1
  }
  ovid/mem.WByte(q.io, q.b, 34)
  return 0
}

func SetKind(q *Q, p i64, n i64) i64 {
  q.gkp = p
  q.gkn = n
  return 0
}

func Pass(q *Q, idv i64, namev i64, pkgv i64) bool {
  if q.idn != 0 {
    if !ovid/json.IsLit(idv, q.idp, q.idn) {
      return false
    }
  }
  if q.namen != 0 {
    if !ovid/json.IsLit(namev, q.namep, q.namen) {
      return false
    }
  }
  if q.pkgn != 0 {
    if !ovid/json.IsLit(pkgv, q.pkgp, q.pkgn) {
      return false
    }
  }
  if q.kindn != 0 {
    if !ovid/mem.Eq(q.kindp, q.kindn, q.gkp, q.gkn) {
      return false
    }
  }
  if q.full == 0 {
    if ovid/mem.Eq(q.gkp, q.gkn, strptr("stmt"), strlen("stmt")) {
      return false
    }
    if ovid/mem.Eq(q.gkp, q.gkn, strptr("expr"), strlen("expr")) {
      return false
    }
    if ovid/mem.Eq(q.gkp, q.gkn, strptr("param"), strlen("param")) {
      return false
    }
    if ovid/mem.Eq(q.gkp, q.gkn, strptr("field"), strlen("field")) {
      return false
    }
    if ovid/mem.Eq(q.gkp, q.gkn, strptr("import"), strlen("import")) {
      return false
    }
  }
  return true
}

func Emit(q *Q, idv i64, namev i64, pkgv i64, node i64) i64 {
  if !Pass(q, idv, namev, pkgv) {
    return 0
  }
  if q.first == 0 {
    ovid/io.Stdout(strptr(","), strlen(","))
  }
  q.first = 0
  q.b.len = 0
  WLitQ(q, strptr("{\"id\":"), strlen("{\"id\":"))
  WStrQ(q, idv)
  WLitQ(q, strptr(",\"kind\":"), strlen(",\"kind\":"))
  ovid/mem.WByte(q.io, q.b, 34)
  ovid/mem.WBytes(q.io, q.b, q.gkp, q.gkn)
  ovid/mem.WByte(q.io, q.b, 34)
  WLitQ(q, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
  WStrQ(q, pkgv)
  WLitQ(q, strptr(",\"name\":"), strlen(",\"name\":"))
  WStrQ(q, namev)
  if q.full != 0 {
    if node != 0 {
      WLitQ(q, strptr(",\"node\":"), strlen(",\"node\":"))
      ovid/mem.WBytes(q.io, q.b, q.file + ovid/json.Src(node), ovid/json.SrcN(node))
    }
  }
  ovid/mem.WByte(q.io, q.b, 125)
  ovid/io.Stdout(q.b.data, q.b.len)
  return 0
}

func StmtKind(op i64) bool {
  if ovid/json.IsLit(op, strptr("var"), strlen("var")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("assign"), strlen("assign")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("setfield"), strlen("setfield")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("store8"), strlen("store8")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("store64"), strlen("store64")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("return"), strlen("return")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("if"), strlen("if")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("while"), strlen("while")) {
    return true
  }
  if ovid/json.IsLit(op, strptr("expr"), strlen("expr")) {
    return true
  }
  return false
}

func WalkArr(q *Q, arr i64, pkgv i64) i64 {
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    WalkNode(q, s, pkgv)
    s = ovid/json.Next(s)
  }
  return 0
}

func WalkNode(q *Q, n i64, pkgv i64) i64 {
  if n == 0 {
    return 0
  }
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if op != 0 {
    if StmtKind(op) {
      SetKind(q, strptr("stmt"), strlen("stmt"))
    } else {
      SetKind(q, strptr("expr"), strlen("expr"))
    }
    Emit(q, SGet(n, strptr("id"), strlen("id")), SGet(n, strptr("name"), strlen("name")), pkgv, n)
  }
  WalkNode(q, SGet(n, strptr("left"), strlen("left")), pkgv)
  WalkNode(q, SGet(n, strptr("right"), strlen("right")), pkgv)
  WalkNode(q, SGet(n, strptr("arg"), strlen("arg")), pkgv)
  WalkNode(q, SGet(n, strptr("base"), strlen("base")), pkgv)
  WalkNode(q, SGet(n, strptr("addr"), strlen("addr")), pkgv)
  WalkNode(q, SGet(n, strptr("val"), strlen("val")), pkgv)
  WalkNode(q, SGet(n, strptr("cond"), strlen("cond")), pkgv)
  WalkArr(q, SGet(n, strptr("args"), strlen("args")), pkgv)
  WalkArr(q, SGet(n, strptr("then"), strlen("then")), pkgv)
  WalkArr(q, SGet(n, strptr("else"), strlen("else")), pkgv)
  WalkArr(q, SGet(n, strptr("body"), strlen("body")), pkgv)
  return 0
}

func QueryProg(q *Q, root i64) i64 {
  var pkgs i64 = SGet(root, strptr("packages"), strlen("packages"))
  if pkgs == 0 {
    return 0
  }
  var p i64 = ovid/json.Child(pkgs)
  while p != 0 {
    var path i64 = SGet(p, strptr("path"), strlen("path"))
    SetKind(q, strptr("package"), strlen("package"))
    Emit(q, SGet(p, strptr("id"), strlen("id")), path, path, p)
    var ims i64 = SGet(p, strptr("imports"), strlen("imports"))
    if ims != 0 {
      var im i64 = ovid/json.Child(ims)
      while im != 0 {
        SetKind(q, strptr("import"), strlen("import"))
        Emit(q, SGet(im, strptr("id"), strlen("id")), SGet(im, strptr("path"), strlen("path")), path, im)
        im = ovid/json.Next(im)
      }
    }
    var tys i64 = SGet(p, strptr("types"), strlen("types"))
    if tys != 0 {
      var t i64 = ovid/json.Child(tys)
      while t != 0 {
        SetKind(q, strptr("type"), strlen("type"))
        Emit(q, SGet(t, strptr("id"), strlen("id")), SGet(t, strptr("name"), strlen("name")), path, t)
        var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
        if fields != 0 {
          var f i64 = ovid/json.Child(fields)
          while f != 0 {
            SetKind(q, strptr("field"), strlen("field"))
            Emit(q, SGet(f, strptr("id"), strlen("id")), SGet(f, strptr("name"), strlen("name")), path, f)
            f = ovid/json.Next(f)
          }
        }
        t = ovid/json.Next(t)
      }
    }
    var cs i64 = SGet(p, strptr("consts"), strlen("consts"))
    if cs != 0 {
      var k i64 = ovid/json.Child(cs)
      while k != 0 {
        SetKind(q, strptr("const"), strlen("const"))
        Emit(q, SGet(k, strptr("id"), strlen("id")), SGet(k, strptr("name"), strlen("name")), path, k)
        k = ovid/json.Next(k)
      }
    }
    var fns i64 = SGet(p, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        SetKind(q, strptr("func"), strlen("func"))
        Emit(q, SGet(f, strptr("id"), strlen("id")), SGet(f, strptr("name"), strlen("name")), path, f)
        var params i64 = SGet(f, strptr("params"), strlen("params"))
        if params != 0 {
          var pa i64 = ovid/json.Child(params)
          while pa != 0 {
            SetKind(q, strptr("param"), strlen("param"))
            Emit(q, SGet(pa, strptr("id"), strlen("id")), SGet(pa, strptr("name"), strlen("name")), path, pa)
            pa = ovid/json.Next(pa)
          }
        }
        if q.full != 0 {
          WalkArr(q, SGet(f, strptr("body"), strlen("body")), path)
        }
        f = ovid/json.Next(f)
      }
    }
    p = ovid/json.Next(p)
  }
  return 0
}

func CmdQuery(io *ovid/io.Cap, dir i64) i64 {
  var path i64 = Join(io, dir, ovid/io.CLen(dir), strptr("ovid.json"), strlen("ovid.json"))
  var pp i64 = ovid/io.Alloc(io, 8)
  var nn i64 = ovid/io.Alloc(io, 8)
  if Read(io, path, pp, nn) != 0 {
    return Fail(io, strptr("read"), strlen("read"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var root i64 = ovid/json.Parse(io, load64(pp), load64(nn))
  if root == 0 {
    return Fail(io, strptr("parse"), strlen("parse"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var stored i64 = ovid/io.Alloc(io, 64)
  var comp i64 = ovid/io.Alloc(io, 64)
  if ovid/check.Hash(io, load64(pp), load64(nn), stored, comp) < 0 {
    return Fail(io, strptr("revision"), strlen("revision"), strptr("missing revision"), strlen("missing revision"))
  }
  var raw i64 = ovid/io.Alloc(io, 128)
  var i i64 = 0
  while i < 128 {
    store8(raw + i, 0)
    i = i + 1
  }
  var q *Q = raw as *Q
  q.io = io
  q.b = ovid/mem.New(io, 1048576)
  q.file = load64(pp)
  q.first = 1
  i = 3
  while i < ovid/io.Argc(io) {
    if ArgEq(io, i, strptr("--id"), strlen("--id")) {
      i = i + 1
      if i >= ovid/io.Argc(io) {
        return Usage(io)
      }
      q.idp = ovid/io.Arg(io, i)
      q.idn = ovid/io.CLen(q.idp)
    } else {
      if ArgEq(io, i, strptr("--name"), strlen("--name")) {
        i = i + 1
        if i >= ovid/io.Argc(io) {
          return Usage(io)
        }
        q.namep = ovid/io.Arg(io, i)
        q.namen = ovid/io.CLen(q.namep)
      } else {
        if ArgEq(io, i, strptr("--pkg"), strlen("--pkg")) {
          i = i + 1
          if i >= ovid/io.Argc(io) {
            return Usage(io)
          }
          q.pkgp = ovid/io.Arg(io, i)
          q.pkgn = ovid/io.CLen(q.pkgp)
        } else {
          if ArgEq(io, i, strptr("--kind"), strlen("--kind")) {
            i = i + 1
            if i >= ovid/io.Argc(io) {
              return Usage(io)
            }
            q.kindp = ovid/io.Arg(io, i)
            q.kindn = ovid/io.CLen(q.kindp)
          } else {
            return Usage(io)
          }
        }
      }
    }
    i = i + 1
  }
  if q.idn != 0 {
    q.full = 1
  }
  if q.namen != 0 {
    q.full = 1
  }
  if q.pkgn != 0 {
    q.full = 1
  }
  if q.kindn != 0 {
    q.full = 1
  }
  ovid/io.Stdout(strptr("{\"revision\": \""), strlen("{\"revision\": \""))
  ovid/io.Stdout(comp, 64)
  ovid/io.Stdout(strptr("\",\"matches\":["), strlen("\",\"matches\":["))
  QueryProg(q, root)
  ovid/io.Stdout(strptr("]}\n"), strlen("]}\n"))
  return 0
}

func FindID(n i64, idp i64, idn i64) i64 {
  if n == 0 {
    return 0
  }
  var k i64 = ovid/json.Kind(n)
  if k == 5 {
    var id i64 = SGet(n, strptr("id"), strlen("id"))
    if ovid/json.IsLit(id, idp, idn) {
      return n
    }
    var c i64 = ovid/json.Child(n)
    while c != 0 {
      var f i64 = FindID(c, idp, idn)
      if f != 0 {
        return f
      }
      c = ovid/json.Next(c)
    }
    return 0
  }
  if k == 4 {
    var c i64 = ovid/json.Child(n)
    while c != 0 {
      var f i64 = FindID(c, idp, idn)
      if f != 0 {
        return f
      }
      c = ovid/json.Next(c)
    }
  }
  return 0
}

func Splice(io *ovid/io.Cap, file i64, n i64, at i64, meta i64) i64 {
  var oldn i64 = load64(meta)
  var repl i64 = load64(meta + 8)
  var repln i64 = load64(meta + 16)
  var nn i64 = (n - oldn) + repln
  var buf i64 = ovid/io.Alloc(io, nn + 1)
  if buf == 0 {
    return 0
  }
  ovid/mem.Copy(buf, file, at)
  ovid/mem.Copy(buf + at, repl, repln)
  var rest i64 = n - (at + oldn)
  ovid/mem.Copy((buf + at) + repln, (file + at) + oldn, rest)
  store8(buf + nn, 0)
  store64(load64(meta + 24), nn)
  return buf
}

func MkParent(io *ovid/io.Cap, path i64) i64 {
  var n i64 = ovid/io.CLen(path)
  var i i64 = n - 1
  while i >= 0 {
    if load8(path + i) == 47 {
      var p i64 = ovid/io.Alloc(io, i + 1)
      ovid/mem.Copy(p, path, i)
      store8(p + i, 0)
      ovid/io.Mkdir(p)
      return 0
    }
    i = i - 1
  }
  return 0
}

func CmdPatch(io *ovid/io.Cap, dir i64, patch i64) i64 {
  var path i64 = Join(io, dir, ovid/io.CLen(dir), strptr("ovid.json"), strlen("ovid.json"))
  var pp i64 = ovid/io.Alloc(io, 8)
  var nn i64 = ovid/io.Alloc(io, 8)
  if Read(io, path, pp, nn) != 0 {
    return Fail(io, strptr("read"), strlen("read"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var file i64 = load64(pp)
  var filen i64 = load64(nn)
  var root i64 = ovid/json.Parse(io, file, filen)
  if root == 0 {
    return Fail(io, strptr("parse"), strlen("parse"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var stored i64 = ovid/io.Alloc(io, 64)
  var comp i64 = ovid/io.Alloc(io, 64)
  if ovid/check.Hash(io, file, filen, stored, comp) < 0 {
    return Fail(io, strptr("revision"), strlen("revision"), strptr("missing revision"), strlen("missing revision"))
  }
  var ppp i64 = ovid/io.Alloc(io, 8)
  var pnn i64 = ovid/io.Alloc(io, 8)
  if Read(io, patch, ppp, pnn) != 0 {
    return Fail(io, strptr("read"), strlen("read"), strptr("patch"), strlen("patch"))
  }
  var proot i64 = ovid/json.Parse(io, load64(ppp), load64(pnn))
  if proot == 0 {
    return Fail(io, strptr("parse"), strlen("parse"), strptr("patch"), strlen("patch"))
  }
  var base i64 = SGet(proot, strptr("baseRevision"), strlen("baseRevision"))
  if base == 0 {
    return Fail(io, strptr("bad_patch"), strlen("bad_patch"), strptr("missing baseRevision"), strlen("missing baseRevision"))
  }
  if !ovid/json.IsLit(base, comp, 64) {
    ovid/io.Stdout(strptr("{\"ok\":false,\"error\":\"stale_patch\",\"revision\":\""), strlen("{\"ok\":false,\"error\":\"stale_patch\",\"revision\":\""))
    ovid/io.Stdout(comp, 64)
    ovid/io.Stdout(strptr("\"}\n"), strlen("\"}\n"))
    return 2
  }
  var ops i64 = SGet(proot, strptr("ops"), strlen("ops"))
  if ops == 0 {
    return Fail(io, strptr("bad_patch"), strlen("bad_patch"), strptr("missing ops"), strlen("missing ops"))
  }
  if ovid/json.Count(ops) == 0 {
    return Fail(io, strptr("bad_patch"), strlen("bad_patch"), strptr("missing ops"), strlen("missing ops"))
  }
  var cur i64 = file
  var cn i64 = filen
  var op i64 = ovid/json.Child(ops)
  while op != 0 {
    var kind i64 = SGet(op, strptr("op"), strlen("op"))
    if !ovid/json.IsLit(kind, strptr("replace"), strlen("replace")) {
      return Fail(io, strptr("bad_patch"), strlen("bad_patch"), strptr("only replace is supported"), strlen("only replace is supported"))
    }
    var id i64 = SGet(op, strptr("id"), strlen("id"))
    var node i64 = SGet(op, strptr("node"), strlen("node"))
    if node == 0 {
      return Fail(io, strptr("bad_patch"), strlen("bad_patch"), strptr("missing node"), strlen("missing node"))
    }
    var nid i64 = SGet(node, strptr("id"), strlen("id"))
    if !ovid/json.IsLit(nid, JStrP(id), JStrN(id)) {
      return Fail(io, strptr("id_mismatch"), strlen("id_mismatch"), JStrP(id), JStrN(id))
    }
    var found i64 = FindID(root, JStrP(id), JStrN(id))
    if found == 0 {
      return Fail(io, strptr("not_found"), strlen("not_found"), JStrP(id), JStrN(id))
    }
    var at i64 = ovid/json.Src(found)
    var meta i64 = ovid/io.Alloc(io, 32)
    store64(meta, ovid/json.SrcN(found))
    store64(meta + 8, load64(ppp) + ovid/json.Src(node))
    store64(meta + 16, ovid/json.SrcN(node))
    var outn i64 = ovid/io.Alloc(io, 8)
    store64(meta + 24, outn)
    var next i64 = Splice(io, cur, cn, at, meta)
    if next == 0 {
      return Fail(io, strptr("splice"), strlen("splice"), strptr("alloc"), strlen("alloc"))
    }
    cur = next
    cn = load64(outn)
    root = ovid/json.Parse(io, cur, cn)
    if root == 0 {
      return Fail(io, strptr("parse"), strlen("parse"), strptr("spliced program"), strlen("spliced program"))
    }
    op = ovid/json.Next(op)
  }
  var st i64 = ovid/io.Alloc(io, 64)
  var cp i64 = ovid/io.Alloc(io, 64)
  var start i64 = ovid/check.Hash(io, cur, cn, st, cp)
  if start < 0 {
    return Fail(io, strptr("revision"), strlen("revision"), strptr("stamp"), strlen("stamp"))
  }
  var i i64 = 0
  while i < 64 {
    store8((cur + start) + i, load8(cp + i))
    i = i + 1
  }
  if ovid/io.WriteFile(io, path, ovid/io.CLen(path), cur, cn, 420) != 0 {
    return Fail(io, strptr("write"), strlen("write"), strptr("ovid.json"), strlen("ovid.json"))
  }
  ovid/io.Stdout(strptr("{\"ok\":true,\"revision\":\""), strlen("{\"ok\":true,\"revision\":\""))
  ovid/io.Stdout(cp, 64)
  ovid/io.Stdout(strptr("\"}\n"), strlen("\"}\n"))
  return 0
}

func CmdBuild(io *ovid/io.Cap, dir i64, out i64) i64 {
  var path i64 = Join(io, dir, ovid/io.CLen(dir), strptr("ovid.json"), strlen("ovid.json"))
  var pp i64 = ovid/io.Alloc(io, 8)
  var nn i64 = ovid/io.Alloc(io, 8)
  if Read(io, path, pp, nn) != 0 {
    return Fail(io, strptr("read"), strlen("read"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var root i64 = ovid/json.Parse(io, load64(pp), load64(nn))
  if root == 0 {
    return Fail(io, strptr("parse"), strlen("parse"), strptr("ovid.json"), strlen("ovid.json"))
  }
  var nerr i64 = ovid/check.Run(io, root, load64(pp), load64(nn), dir, ovid/io.CLen(dir))
  if nerr != 0 {
    return 1
  }
  var errp i64 = ovid/io.Alloc(io, 8)
  store64(errp, 0)
  var b *ovid/mem.Buf = ovid/cg.Compile(io, root, errp)
  if load64(errp) != 0 {
    var tmp i64 = ovid/io.Alloc(io, 64)
    var en i64 = ovid/mem.FormatI64(tmp, load64(errp))
    return Fail(io, strptr("compile"), strlen("compile"), tmp, en)
  }
  MkParent(io, out)
  if ovid/io.WriteFile(io, out, ovid/io.CLen(out), b.data, b.len, 493) != 0 {
    return Fail(io, strptr("write"), strlen("write"), out, ovid/io.CLen(out))
  }
  ovid/io.Stdout(strptr("{\"ok\":true,\"output\":"), strlen("{\"ok\":true,\"output\":"))
  var qb *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WByte(io, qb, 34)
  ovid/mem.WBytes(io, qb, out, ovid/io.CLen(out))
  ovid/mem.WByte(io, qb, 34)
  ovid/io.Stdout(qb.data, qb.len)
  ovid/io.Stdout(strptr(",\"bytes\":"), strlen(",\"bytes\":"))
  var nb i64 = ovid/io.Alloc(io, 64)
  var nlen i64 = ovid/mem.FormatI64(nb, b.len)
  ovid/io.Stdout(nb, nlen)
  ovid/io.Stdout(strptr("}\n"), strlen("}\n"))
  return 0
}

func main(io *ovid/io.Cap) i64 {
  if ovid/io.Argc(io) < 2 {
    return Usage(io)
  }
  if ArgEq(io, 1, strptr("check"), strlen("check")) {
    if ovid/io.Argc(io) != 3 {
      return Usage(io)
    }
    return CmdCheck(io, ovid/io.Arg(io, 2))
  }
  if ArgEq(io, 1, strptr("query"), strlen("query")) {
    if ovid/io.Argc(io) < 3 {
      return Usage(io)
    }
    return CmdQuery(io, ovid/io.Arg(io, 2))
  }
  if ArgEq(io, 1, strptr("patch"), strlen("patch")) {
    if ovid/io.Argc(io) != 4 {
      return Usage(io)
    }
    return CmdPatch(io, ovid/io.Arg(io, 2), ovid/io.Arg(io, 3))
  }
  if ArgEq(io, 1, strptr("build"), strlen("build")) {
    var dir i64 = 0
    var out i64 = 0
    var i i64 = 2
    while i < ovid/io.Argc(io) {
      if ArgEq(io, i, strptr("-o"), strlen("-o")) {
        i = i + 1
        if i >= ovid/io.Argc(io) {
          return Usage(io)
        }
        out = ovid/io.Arg(io, i)
      } else {
        if dir != 0 {
          return Usage(io)
        }
        dir = ovid/io.Arg(io, i)
      }
      i = i + 1
    }
    if dir == 0 {
      return Usage(io)
    }
    if out == 0 {
      return Usage(io)
    }
    return CmdBuild(io, dir, out)
  }
  return Usage(io)
}

