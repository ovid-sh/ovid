  Init(h)
  var off i64 = 0
  while (off + 64) <= n {
    Block(h, data + off, w)
    off = off + 64
  }
  var tlen i64 = n - off
  ovid/mem.Copy(pad, data + off, tlen)
  store8(pad + tlen, 128)
  tlen = tlen + 1
  if tlen > 56 {
    while tlen < 64 {
      store8(pad + tlen, 0)
      tlen = tlen + 1
