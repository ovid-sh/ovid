func FormatI64(dst i64, v i64) i64 {
  if v == 0 {
    store8(dst, 48)
    return 1
  }
  var neg bool = false
  var x i64 = v
  if v < 0 {
    neg = true
    x = 0 - v
  }
  var tmp i64 = dst + 32
  var n i64 = 0
  while x > 0 {
    var d i64 = x % 10
    store8(tmp + n, 48 + d)
    n = n + 1
    x = x / 10
  }
  var o i64 = 0
  if neg {
    store8(dst, 45)
    o = 1
  }
  var i i64 = 0
  while i < n {
    store8((dst + o) + i, load8(((tmp + n) - 1) - i))
    i = i + 1
  }
  return o + n
}

func HexOut(dst i64, v i64, width i64) i64 {
  var i i64 = width - 1
  while i >= 0 {
    var nib i64 = v & 15
    var ch i64 = 48 + nib
    if nib >= 10 {
      ch = 87 + nib
    }
    store8(dst + i, ch)
    v = v >> 4
    i = i - 1
  }
  return width
}

