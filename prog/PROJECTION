  if CmpOp(op) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv + 1)
    return Max(l, Max(r, lv))
  }
  if Lit(op, strptr("land"), strlen("land")) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv)
    return Max(l, r)
