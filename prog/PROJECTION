}

func Src(v i64) i64 {
  return load64(v + 56)
}

func SrcN(v i64) i64 {
  return load64(v + 64)
}

func Child(v i64) i64 {
  return load64(v + 16)
}

func Next(v i64) i64 {
  return load64(v + 32)
}

func Count(v i64) i64 {
