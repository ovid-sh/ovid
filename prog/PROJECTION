  E(c, 0x6C)
  E(c, 0x24)
  E(c, 0x08)
  return 0
}

func MovR12MemRsp(c *Code) i64 {
  E(c, 0x4C)
  E(c, 0x8B)
  E(c, 0x24)
  E(c, 0x24)
  return 0
}

func Intern(c *Code, p i64, n i64) i64 {
  var i i64 = 0
  while i + n < c.ron {
    if ovidMemEq(c.ro + i, n, p, n) {
      return i
    }
    i = i + 1
  }
  var off i64 = c.ron
  var k i64 = 0
  while k < n {
    store8(c.ro + off + k, load8(p + k))
    k = k + 1
  }
  store8(c.ro + off + n, 0)
  c.ron = off + n + 1
  return off
}

func ovidMemEq(a i64, an i64, b i64, bn i64) bool {
  if an != bn {
    return false
  }
  var i i64 = 0
  while i < an {
    if load8(a + i) != load8(b + i) {
      return false
    }
    i = i + 1
  }
  return true
}

func Patch(c *Code) i64 {
  var i i64 = 0
  while i < c.nfix {
    var fp i64 = c.fixes + (i * 24)
    var at i64 = load64(fp)
    var end i64 = load64(fp + 8)
    var lab i64 = load64(fp + 16)
    var target i64 = load64(c.labs + (lab * 8))
    var rel i64 = target - end
    PutU32(c.data + at, rel)
    i = i + 1
  }
  var base i64 = 4194424 + c.len
  i = 0
  while i < c.nabs {
    var ap i64 = c.abss + (i * 16)
    var at i64 = load64(ap)
    var ro i64 = load64(ap + 8)
    PutU64(c.data + at, base + ro)
    i = i + 1
  }
  return 0
}

// ----- ovid/cg -----

package ovid/cg

import ovid/io
import ovid/json
import ovid/mem
import ovid/asm
import ovid/elf

const HEAP i64 = 128 << 20
const MAXLOC i64 = 1024

type C struct {
  io *ovid/io.Cap
  code *ovid/asm.Code
  root i64
  pkgs i64
  npkg i64
  fns i64
  nfn i64
  pathp i64
  pathn i64
  fn i64
  locs i64
  nloc i64
  localBytes i64
  cons i64
  ncon i64
  epi i64
  err i64
  peak i64
  typ i64
  tyn i64
}

func Zero(p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    store8(p + i, 0)
    i = i + 1
  }
  return 0
}

func Fail(c *C, code i64) i64 {
  if c.err == 0 {
    c.err = code
  }
  return c.err
}

func Max(a i64, b i64) i64 {
  if a > b {
    return a
  }
  return b
}

func SGet(obj i64, lit i64, n i64) i64 {
  if obj == 0 {
    return 0
  }
  return ovid/json.GetLit(obj, lit, n)
}

func JStrP(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrP(v)
}

func JStrN(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrN(v)
}

func Lit(op i64, s i64, n i64) bool {
  return ovid/json.IsLit(op, s, n)
}

func LeafOp(op i64) bool {
  if Lit(op, strptr("int"), strlen("int")) {
    return true
  }
  if Lit(op, strptr("strptr"), strlen("strptr")) {
    return true
  }
  if Lit(op, strptr("strlen"), strlen("strlen")) {
    return true
  }
  return false
}

func ArithOp(op i64) bool {
  if Lit(op, strptr("add"), strlen("add")) {
    return true
  }
  if Lit(op, strptr("sub"), strlen("sub")) {
    return true
  }
  if Lit(op, strptr("mul"), strlen("mul")) {
    return true
  }
  if Lit(op, strptr("div"), strlen("div")) {
    return true
  }
  if Lit(op, strptr("mod"), strlen("mod")) {
    return true
  }
  if Lit(op, strptr("and"), strlen("and")) {
    return true
  }
  if Lit(op, strptr("or"), strlen("or")) {
    return true
  }
  if Lit(op, strptr("xor"), strlen("xor")) {
    return true
  }
  if Lit(op, strptr("shl"), strlen("shl")) {
    return true
  }
  if Lit(op, strptr("shr"), strlen("shr")) {
    return true
  }
  return false
}

func CmpOp(op i64) bool {
  if Lit(op, strptr("eq"), strlen("eq")) {
    return true
  }
  if Lit(op, strptr("ne"), strlen("ne")) {
    return true
  }
  if Lit(op, strptr("lt"), strlen("lt")) {
    return true
  }
  if Lit(op, strptr("le"), strlen("le")) {
    return true
  }
  if Lit(op, strptr("gt"), strlen("gt")) {
    return true
  }
  if Lit(op, strptr("ge"), strlen("ge")) {
    return true
  }
  return false
}

func UnaryOp(op i64) bool {
  if Lit(op, strptr("not"), strlen("not")) {
    return true
  }
  if Lit(op, strptr("neg"), strlen("neg")) {
    return true
  }
  if Lit(op, strptr("bnot"), strlen("bnot")) {
    return true
  }
  if Lit(op, strptr("cast"), strlen("cast")) {
    return true
  }
  if Lit(op, strptr("load8"), strlen("load8")) {
    return true
  }
  if Lit(op, strptr("load32"), strlen("load32")) {
    return true
  }
  if Lit(op, strptr("load64"), strlen("load64")) {
    return true
  }
  return false
}

func FindPkg(c *C, pp i64, pn i64) i64 {
  var i i64 = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    if Lit(path, pp, pn) {
      return pkg
    }
    i = i + 1
  }
  return 0
}

func FindFnRec(c *C, pp i64, pn i64, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.nfn {
    var rec i64 = c.fns + (i * 64)
    if ovid/mem.Eq(load64(rec + 32), load64(rec + 40), pp, pn) {
      if ovid/mem.Eq(load64(rec + 16), load64(rec + 24), np, nn) {
        return rec
      }
    }
    i = i + 1
  }
  return 0
}

func AddFn(c *C, pkg i64, f i64, pp i64, pn i64) i64 {
  var nm i64 = SGet(f, strptr("name"), strlen("name"))
  var np i64 = JStrP(nm)
  var nn i64 = JStrN(nm)
  if FindFnRec(c, pp, pn, np, nn) != 0 {
    return Fail(c, 3)
  }
  var rec i64 = c.fns + (c.nfn * 64)
  store64(rec + 0, pkg)
  store64(rec + 8, f)
  store64(rec + 16, np)
  store64(rec + 24, nn)
  store64(rec + 32, pp)
  store64(rec + 40, pn)
  store64(rec + 48, ovid/asm.NewLabel(c.code))
  var params i64 = SGet(f, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  store64(rec + 56, nparam)
  c.nfn = c.nfn + 1
  return 0
}

func IndexProg(c *C) i64 {
  var pkgs i64 = SGet(c.root, strptr("packages"), strlen("packages"))
  if pkgs == 0 {
    return Fail(c, 1)
  }
  c.npkg = ovid/json.Count(pkgs)
  if c.npkg <= 0 {
    return Fail(c, 1)
  }
  c.pkgs = ovid/io.Alloc(c.io, c.npkg * 8)
  c.locs = ovid/io.Alloc(c.io, MAXLOC * 40)
  c.cons = ovid/io.Alloc(c.io, MAXLOC * 24)
  var total i64 = 0
  var i i64 = 0
  var p i64 = ovid/json.Child(pkgs)
  while p != 0 {
    store64(c.pkgs + (i * 8), p)
    var fns i64 = SGet(p, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      total = total + ovid/json.Count(fns)
    }
    i = i + 1
    p = ovid/json.Next(p)
  }
  c.nfn = 0
  c.fns = ovid/io.Alloc(c.io, (total + 1) * 64)
  i = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    var fns i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        if AddFn(c, pkg, f, JStrP(path), JStrN(path)) != 0 {
          return c.err
        }
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
  }
  return 0
}

func FindLoc(c *C, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.nloc {
    var rec i64 = c.locs + (i * 40)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      return rec
    }
    i = i + 1
  }
  return 0
}

func AddLoc(c *C, np i64, nn i64, tp i64, tn i64) i64 {
  var rec i64 = FindLoc(c, np, nn)
  if rec != 0 {
    store64(rec + 24, tp)
    store64(rec + 32, tn)
    return 0
  }
  if c.nloc >= MAXLOC {
    return Fail(c, 6)
  }
  rec = c.locs + (c.nloc * 40)
  store64(rec + 0, np)
  store64(rec + 8, nn)
  store64(rec + 16, 0 - ((c.nloc + 1) * 8))
  store64(rec + 24, tp)
  store64(rec + 32, tn)
  c.nloc = c.nloc + 1
  return 0
}

func FindCon(c *C, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.ncon {
    var rec i64 = c.cons + (i * 24)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      return rec
    }
    i = i + 1
  }
  return 0
}

func LoadConsts(c *C, pkg i64) i64 {
  c.ncon = 0
  var arr i64 = SGet(pkg, strptr("consts"), strlen("consts"))
  if arr == 0 {
    return 0
  }
  var k i64 = ovid/json.Child(arr)
  while k != 0 {
    if c.ncon >= MAXLOC {
      return Fail(c, 6)
    }
    var rec i64 = c.cons + (c.ncon * 24)
    var nm i64 = SGet(k, strptr("name"), strlen("name"))
    var vl i64 = SGet(k, strptr("value"), strlen("value"))
    var iv i64 = 0
    if vl != 0 {
      iv = ovid/json.Int(vl)
    }
    store64(rec + 0, JStrP(nm))
    store64(rec + 8, JStrN(nm))
    store64(rec + 16, iv)
    c.ncon = c.ncon + 1
    k = ovid/json.Next(k)
  }
  return 0
}

func CollectParams(c *C, fn i64) i64 {
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  if params == 0 {
    return 0
  }
  var p i64 = ovid/json.Child(params)
  while p != 0 {
    var nm i64 = SGet(p, strptr("name"), strlen("name"))
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    AddLoc(c, JStrP(nm), JStrN(nm), JStrP(ty), JStrN(ty))
    p = ovid/json.Next(p)
  }
  return 0
}

