package ovid/asm

import ovid/io
import ovid/mem

// BytesAre reports whether c holds exactly the n bytes at want.
func BytesAre(io *ovid/io.Cap, c *Code, want i64, n i64) bool {
  if ovid/mem.Eq(c.data, c.len, want, n) {
    return true
  }
  var h i64 = ovid/io.Alloc(io, 2)
  var i i64 = 0
  ovid/io.Eprint(strptr("got"))
  while i < c.len {
    ovid/io.Eprint(strptr(" "))
    ovid/mem.HexOut(h, load8(c.data + i), 2)
    ovid/io.Stderr(h, 2)
    i = i + 1
  }
  ovid/io.Eprint(strptr("\n"))
  return false
}

func TestMovRegImm(io *ovid/io.Cap) i64 {
  var c *Code = New(io)
  MovRegImm64(c, 0, 1)
  if !BytesAre(io, c, strptr("\x48\xb8\x01\x00\x00\x00\x00\x00\x00\x00"), 10) {
    return 1
  }
  c = New(io)
  MovRegImm64(c, 9, -1)
  if !BytesAre(io, c, strptr("\x49\xb9\xff\xff\xff\xff\xff\xff\xff\xff"), 10) {
    return 2
  }
  return 0
}

// A forward jump is patched once its label is marked; a backward one
// gets a negative displacement.
func TestJmpPatch(io *ovid/io.Cap) i64 {
  var c *Code = New(io)
  var fwd i64 = NewLabel(c)
  Jmp(c, fwd)
  Ret(c)
  Mark(c, fwd)
  Patch(c)
  if !BytesAre(io, c, strptr("\xe9\x01\x00\x00\x00\xc3"), 6) {
    return 1
  }
  c = New(io)
  var back i64 = NewLabel(c)
  Mark(c, back)
  Jmp(c, back)
  Patch(c)
  if !BytesAre(io, c, strptr("\xe9\xfb\xff\xff\xff"), 5) {
    return 2
  }
  return 0
}
