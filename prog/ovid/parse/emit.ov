package ovid/parse

import ovid/io
import ovid/mem

// E writes the program tree as compact JSON in the shape of `ovid dump`
// (internal/ir Marshal).
type E struct {
  io *ovid/io.Cap
  b *ovid/mem.Buf
  m *Mod
  pkg bytes
  fn bytes
}

func WL(e *E, s bytes) i64 {
  return ovid/mem.WBytes(e.io, e.b, s)
}

func WC(e *E, c i64) i64 {
  return ovid/mem.WByte(e.io, e.b, c)
}

func WInt(io *ovid/io.Cap, b *ovid/mem.Buf, v i64) i64 {
  var tmp i64 = ovid/io.Alloc(io, 64)
  if v == -9223372036854775807 - 1 {
    return ovid/mem.WBytes(io, b, "-9223372036854775808")
  }
  var n i64 = ovid/mem.FormatI64(tmp, v)
  return ovid/mem.WBytes(io, b, bytes(tmp, n))
}

// ValidUtf8 reports whether s is all valid UTF-8.
func ValidUtf8(s bytes) bool {
  var i i64 = 0
  while i < len(s) {
    var sz i64 = Utf8Len(s[i:len(s)])
    if sz == 0 {
      return false
    }
    i = i + sz
  }
  return true
}

// WStr writes s as a JSON string. Valid UTF-8 passes through as is;
// each byte that is not part of it becomes \ufffd, as Go's encoder does, so
// the output is always valid JSON.
func WStr(io *ovid/io.Cap, b *ovid/mem.Buf, text bytes) i64 {
  ovid/mem.WByte(io, b, 34)
  var i i64 = 0
  var s i64 = 0
  while i < len(text) {
    var c i64 = load8(ptr(text) + i)
    var sz i64 = 1
    if c >= 128 {
      sz = Utf8Len(text[i:len(text)])
      if sz == 0 {
        ovid/mem.WBytes(io, b, text[s:i])
        ovid/mem.WBytes(io, b, bytes(strptr("\\ufffd"), 6))
        s = i + 1
        sz = 1
      }
    } else if c == 34 || c == 92 || c < 32 {
      ovid/mem.WBytes(io, b, text[s:i])
      ovid/mem.WByte(io, b, 92)
      if c == 34 || c == 92 {
        ovid/mem.WByte(io, b, c)
      } else if c == 10 {
        ovid/mem.WByte(io, b, 110)
      } else if c == 13 {
        ovid/mem.WByte(io, b, 114)
      } else if c == 9 {
        ovid/mem.WByte(io, b, 116)
      } else {
        ovid/mem.WBytes(io, b, "u00")
        var hx i64 = ovid/io.Alloc(io, 8)
        ovid/mem.HexOut(hx, c, 2)
        ovid/mem.WBytes(io, b, bytes(hx, 2))
      }
      s = i + 1
    }
    i = i + sz
  }
  ovid/mem.WBytes(io, b, text[s:len(text)])
  ovid/mem.WByte(io, b, 34)
  return 0
}

func WS(e *E, s bytes) i64 {
  return WStr(e.io, e.b, s)
}

// IdOpen writes `"id":"` plus a prefix.
func IdOpen(e *E, pre bytes) i64 {
  WL(e, bytes(strptr("\"id\":\""), 6))
  return WL(e, pre)
}

func WOp(e *E, op i64) i64 {
  if op == OP_VAR {
    return WL(e, "var")
  }
  if op == OP_VAR2 {
    return WL(e, "var2")
  }
  if op == OP_ASSIGN2 {
    return WL(e, "assign2")
  }
  if op == OP_ASSIGN {
    return WL(e, "assign")
  }
  if op == OP_SETFIELD {
    return WL(e, "setfield")
  }
  if op == OP_STORE8 {
    return WL(e, "store8")
  }
  if op == OP_STORE16 {
    return WL(e, "store16")
  }
  if op == OP_STORE32 {
    return WL(e, "store32")
  }
  if op == OP_STORE64 {
    return WL(e, "store64")
  }
  if op == OP_RETURN {
    return WL(e, "return")
  }
  if op == OP_IF {
    return WL(e, "if")
  }
  if op == OP_WHILE {
    return WL(e, "while")
  }
  if op == OP_BREAK {
    return WL(e, "break")
  }
  if op == OP_CONTINUE {
    return WL(e, "continue")
  }
  if op == OP_EXPR {
    return WL(e, "expr")
  }
  if op == OP_INT {
    return WL(e, "int")
  }
  if op == OP_BOOL {
    return WL(e, "bool")
  }
  if op == OP_NAME {
    return WL(e, "name")
  }
  if op == OP_CALL {
    return WL(e, "call")
  }
  if op == OP_SYSCALL {
    return WL(e, "syscall")
  }
  if op == OP_FIELD {
    return WL(e, "field")
  }
  if op == OP_CAST {
    return WL(e, "cast")
  }
  if op == OP_NOT {
    return WL(e, "not")
  }
  if op == OP_NEG {
    return WL(e, "neg")
  }
  if op == OP_BNOT {
    return WL(e, "bnot")
  }
  if op == OP_LOAD8 {
    return WL(e, "load8")
  }
  if op == OP_LOAD16 {
    return WL(e, "load16")
  }
  if op == OP_LOAD32 {
    return WL(e, "load32")
  }
  if op == OP_BSWAP16 {
    return WL(e, "bswap16")
  }
  if op == OP_BSWAP32 {
    return WL(e, "bswap32")
  }
  if op == OP_BSWAP64 {
    return WL(e, "bswap64")
  }
  if op == OP_USHR {
    return WL(e, "ushr")
  }
  if op == OP_UMULHI {
    return WL(e, "umulhi")
  }
  if op == OP_UDIV {
    return WL(e, "udiv")
  }
  if op == OP_UREM {
    return WL(e, "urem")
  }
  if op == OP_ULT {
    return WL(e, "ult")
  }
  if op == OP_INDEX {
    return WL(e, "index")
  }
  if op == OP_SETBYTE {
    return WL(e, "setbyte")
  }
  if op == OP_STR {
    return WL(e, "str")
  }
  if op == OP_BYTES {
    return WL(e, "bytes")
  }
  if op == OP_BYTE {
    return WL(e, "byte")
  }
  if op == OP_SLICE {
    return WL(e, "slice")
  }
  if op == OP_BLEN {
    return WL(e, "blen")
  }
  if op == OP_PTR {
    return WL(e, "ptr")
  }
  if op == OP_LEN {
    return WL(e, "len")
  }
  if op == OP_LOAD64 {
    return WL(e, "load64")
  }
  if op == OP_STRPTR {
    return WL(e, "strptr")
  }
  if op == OP_STRLEN {
    return WL(e, "strlen")
  }
  if op == OP_SIZEOF {
    return WL(e, "sizeof")
  }
  if op == OP_LOR {
    return WL(e, "lor")
  }
  if op == OP_LAND {
    return WL(e, "land")
  }
  if op == OP_EQ {
    return WL(e, "eq")
  }
  if op == OP_NE {
    return WL(e, "ne")
  }
  if op == OP_LT {
    return WL(e, "lt")
  }
  if op == OP_LE {
    return WL(e, "le")
  }
  if op == OP_GT {
    return WL(e, "gt")
  }
  if op == OP_GE {
    return WL(e, "ge")
  }
  if op == OP_ADD {
    return WL(e, "add")
  }
  if op == OP_SUB {
    return WL(e, "sub")
  }
  if op == OP_OR {
    return WL(e, "or")
  }
  if op == OP_XOR {
    return WL(e, "xor")
  }
  if op == OP_MUL {
    return WL(e, "mul")
  }
  if op == OP_DIV {
    return WL(e, "div")
  }
  if op == OP_MOD {
    return WL(e, "mod")
  }
  if op == OP_AND {
    return WL(e, "and")
  }
  if op == OP_SHL {
    return WL(e, "shl")
  }
  return WL(e, "shr")
}

func ESub(e *E, key bytes, n *Node) i64 {
  if n == 0 as *Node {
    return 0
  }
  WL(e, key)
  return ENode(e, n)
}

func EList(e *E, key bytes, n *Node) i64 {
  if n == 0 as *Node {
    return 0
  }
  WL(e, key)
  while n != 0 as *Node {
    ENode(e, n)
    n = n.next
    if n != 0 as *Node {
      WC(e, 44)
    }
  }
  WC(e, 93)
  return 0
}

func ENode(e *E, n *Node) i64 {
  WC(e, 123)
  if IsStmt(n.op) {
    IdOpen(e, "st:")
  } else {
    IdOpen(e, "ex:")
  }
  WL(e, e.pkg)
  WC(e, 46)
  WL(e, e.fn)
  WC(e, 58)
  WInt(e.io, e.b, n.num)
  WC(e, 34)
  WL(e, bytes(strptr(",\"op\":\""), 7))
  WOp(e, n.op)
  WC(e, 34)
  if len(n.name) != 0 {
    WL(e, bytes(strptr(",\"name\":"), 8))
    WS(e, n.name)
  }
  if len(n.typ) != 0 {
    WL(e, bytes(strptr(",\"type\":"), 8))
    WS(e, n.typ)
  }
  if len(n.name2) != 0 {
    WL(e, ",\"name2\":")
    WS(e, n.name2)
  }
  if len(n.typ2) != 0 {
    WL(e, ",\"type2\":")
    WS(e, n.typ2)
  }
  if len(n.pkg) != 0 {
    WL(e, bytes(strptr(",\"pkg\":"), 7))
    WS(e, n.pkg)
  }
  if len(n.fn) != 0 {
    WL(e, bytes(strptr(",\"func\":"), 8))
    WS(e, n.fn)
  }
  if n.valk == 1 {
    WL(e, bytes(strptr(",\"value\":"), 9))
    WInt(e.io, e.b, n.ival)
  } else if n.valk == 2 {
    if n.ival != 0 {
      WL(e, bytes(strptr(",\"value\":true"), 13))
    } else {
      WL(e, bytes(strptr(",\"value\":false"), 14))
    }
  } else if n.valk == 3 && ValidUtf8(n.str) {
    WL(e, bytes(strptr(",\"value\":"), 9))
    WS(e, n.str)
  } else if n.valk == 3 {
    // Bytes JSON cannot carry: hex, so nothing is lost.
    WL(e, bytes(strptr(",\"value_hex\":\""), 14))
    var hx i64 = ovid/io.Alloc(e.io, 8)
    var i i64 = 0
    while i < len(n.str) {
      ovid/mem.HexOut(hx, load8(ptr(n.str) + i), 2)
      ovid/mem.WBytes(e.io, e.b, bytes(hx, 2))
      i = i + 1
    }
    WL(e, bytes(strptr("\""), 1))
  }
  ESub(e, bytes(strptr(",\"left\":"), 8), n.left)
  ESub(e, bytes(strptr(",\"right\":"), 9), n.right)
  ESub(e, bytes(strptr(",\"arg\":"), 7), n.arg)
  ESub(e, bytes(strptr(",\"base\":"), 8), n.base)
  ESub(e, bytes(strptr(",\"addr\":"), 8), n.addr)
  ESub(e, bytes(strptr(",\"val\":"), 7), n.val)
  ESub(e, ",\"val2\":", n.val2)
  ESub(e, bytes(strptr(",\"cond\":"), 8), n.cond)
  EList(e, bytes(strptr(",\"args\":["), 9), n.args)
  EList(e, bytes(strptr(",\"then\":["), 9), n.then)
  EList(e, bytes(strptr(",\"else\":["), 9), n.els)
  EList(e, bytes(strptr(",\"body\":["), 9), n.body)
  WC(e, 125)
  return 0
}

// EDeclId writes "id":"<pre><pkg>.<name>" for decl d.
func EDeclId(e *E, pre bytes, d *Decl) i64 {
  IdOpen(e, pre)
  WL(e, e.pkg)
  WC(e, 46)
  WL(e, d.name)
  WC(e, 34)
  WL(e, bytes(strptr(",\"name\":"), 8))
  WS(e, d.name)
  return 0
}

func EPkg(e *E, k *Pkg) i64 {
  e.pkg = k.path
  WC(e, 123)
  IdOpen(e, "pkg:")
  WL(e, k.path)
  WC(e, 34)
  WL(e, bytes(strptr(",\"path\":"), 8))
  WS(e, k.path)
  var d *Decl = k.ims
  if d != 0 as *Decl {
    WL(e, bytes(strptr(",\"imports\":["), 12))
    while d != 0 as *Decl {
      WC(e, 123)
      IdOpen(e, "im:")
      WL(e, k.path)
      WC(e, 58)
      WL(e, d.name)
      WC(e, 34)
      WL(e, bytes(strptr(",\"path\":"), 8))
      WS(e, d.name)
      WC(e, 125)
      d = d.next
      if d != 0 as *Decl {
        WC(e, 44)
      }
    }
    WC(e, 93)
  }
  d = k.cs
  if d != 0 as *Decl {
    WL(e, bytes(strptr(",\"consts\":["), 11))
    while d != 0 as *Decl {
      WC(e, 123)
      EDeclId(e, "cn:", d)
      if d.istab != 0 {
        WL(e, bytes(strptr(",\"type\":\"["), 10))
        WInt(e.io, e.b, d.tabn)
        WL(e, "]i64\",\"value\":0,\"table\":true")
        // An empty table has no values key, as the Go dump omits it.
        if d.tabn > 0 {
          WL(e, ",\"values\":[")
          var vi i64 = 0
          while vi < d.tabn {
            if vi > 0 {
              WC(e, 44)
            }
            WInt(e.io, e.b, load64(d.tab + (vi * 8)))
            vi = vi + 1
          }
          WC(e, 93)
        }
      } else {
        WL(e, ",\"type\":\"")
        WL(e, d.typ)
        WL(e, "\",\"value\":")
        WInt(e.io, e.b, d.val)
      }
      WC(e, 125)
      d = d.next
      if d != 0 as *Decl {
        WC(e, 44)
      }
    }
    WC(e, 93)
  }
  d = k.ts
  if d != 0 as *Decl {
    WL(e, bytes(strptr(",\"types\":["), 10))
    while d != 0 as *Decl {
      WC(e, 123)
      EDeclId(e, "ty:", d)
      WL(e, bytes(strptr(",\"fields\":"), 10))
      var f *Decl = d.sub
      if f == 0 as *Decl {
        WL(e, "null")
      } else {
        WC(e, 91)
        while f != 0 as *Decl {
          WC(e, 123)
          IdOpen(e, "fld:")
          WL(e, k.path)
          WC(e, 46)
          WL(e, d.name)
          WC(e, 46)
          WL(e, f.name)
          WC(e, 34)
          WL(e, bytes(strptr(",\"name\":"), 8))
          WS(e, f.name)
          WL(e, bytes(strptr(",\"type\":"), 8))
          WS(e, f.typ)
          WC(e, 125)
          f = f.next
          if f != 0 as *Decl {
            WC(e, 44)
          }
        }
        WC(e, 93)
      }
      WC(e, 125)
      d = d.next
      if d != 0 as *Decl {
        WC(e, 44)
      }
    }
    WC(e, 93)
  }
  d = k.fs
  if d != 0 as *Decl {
    WL(e, bytes(strptr(",\"funcs\":["), 10))
    while d != 0 as *Decl {
      WC(e, 123)
      EDeclId(e, "fn:", d)
      var pa *Decl = d.sub
      if pa != 0 as *Decl {
        WL(e, bytes(strptr(",\"params\":["), 11))
        while pa != 0 as *Decl {
          WC(e, 123)
          IdOpen(e, "pa:")
          WL(e, k.path)
          WC(e, 46)
          WL(e, d.name)
          WC(e, 46)
          WL(e, pa.name)
          WC(e, 34)
          WL(e, bytes(strptr(",\"name\":"), 8))
          WS(e, pa.name)
          WL(e, bytes(strptr(",\"type\":"), 8))
          WS(e, pa.typ)
          WC(e, 125)
          pa = pa.next
          if pa != 0 as *Decl {
            WC(e, 44)
          }
        }
        WC(e, 93)
      }
      WL(e, bytes(strptr(",\"result\":"), 10))
      WS(e, d.typ)
      if len(d.typ2) != 0 {
        WL(e, ",\"result2\":")
        WS(e, d.typ2)
      }
      e.fn = d.name
      EList(e, bytes(strptr(",\"body\":["), 9), d.body)
      WC(e, 125)
      d = d.next
      if d != 0 as *Decl {
        WC(e, 44)
      }
    }
    WC(e, 93)
  }
  WC(e, 125)
  return 0
}

// Emit writes the whole program to m.json.
func Emit(m *Mod) i64 {
  var e *E = ovid/io.Alloc(m.io, sizeof(E)) as *E
  e.io = m.io
  e.m = m
  e.b = ovid/mem.New(m.io, 1 << 20)
  m.json = e.b
  WL(e, bytes(strptr("{\"revision\":\""), 13))
  WL(e, bytes(Revision(m), 16))
  WL(e, bytes(strptr("\",\"module\":"), 11))
  WS(e, m.name)
  WL(e, bytes(strptr(",\"entry\":"), 9))
  WS(e, m.entry)
  WL(e, bytes(strptr(",\"packages\":"), 12))
  var k *Pkg = m.pkgs
  if k == 0 as *Pkg {
    WL(e, "null")
  } else {
    WC(e, 91)
    while k != 0 as *Pkg {
      EPkg(e, k)
      k = k.next
      if k != 0 as *Pkg {
        WC(e, 44)
      }
    }
    WC(e, 93)
  }
  WL(e, bytes(strptr("}\n"), 2))
  return 0
}

// WPos appends ,"file":..,"line":..,"col":..,"source":.. for offset off of f.
func WPos(io *ovid/io.Cap, b *ovid/mem.Buf, f *File, off i64) i64 {
  var line i64 = 1
  var ls i64 = 0
  var i i64 = 0
  while i < off && i < len(f.src) {
    if load8(ptr(f.src) + i) == 10 {
      line = line + 1
      ls = i + 1
    }
    i = i + 1
  }
  var le i64 = ls
  while le < len(f.src) && load8(ptr(f.src) + le) != 10 {
    le = le + 1
  }
  ovid/mem.WBytes(io, b, bytes(strptr(",\"file\":"), 8))
  WStr(io, b, f.disp)
  ovid/mem.WBytes(io, b, bytes(strptr(",\"line\":"), 8))
  WInt(io, b, line)
  ovid/mem.WBytes(io, b, bytes(strptr(",\"col\":"), 7))
  WInt(io, b, (off - ls) + 1)
  ovid/mem.WBytes(io, b, bytes(strptr(",\"source\":"), 10))
  WStr(io, b, f.src[ls:le])
  return 0
}
