package ovid/parse

import ovid/io
import ovid/mem
import ovid/sha

// Mod is a loaded module: ovid.mod and its packages (sorted by path, shipped
// ones from the std dir included). json is set by Emit; ftab/fmask are the
// func index (see IndexFuncs).
// nerr counts load errors (bad ovid.mod, syntax, layout); they have already
// been printed as JSON lines.
type Mod struct {
  io *ovid/io.Cap
  dirp i64
  dirn i64
  notests bool
  namep i64
  namen i64
  entryp i64
  entryn i64
  stdp i64
  stdn i64
  sys i64
  sysunk i64
  pkgs *Pkg
  files *File
  ftail *File
  nerr i64
  out *ovid/mem.Buf
  json *ovid/mem.Buf
  modsrc i64
  uses *Use
  usest *Use
  nuses i64
  modlen i64
  ftab i64
  fmask i64
  rev i64
  npkg i64
  nmissing i64
  missing i64
  hint *ovid/mem.Buf
}

// Cmp compares byte strings like Go's < on strings: -1, 0, or 1.
func Cmp(a i64, an i64, b i64, bn i64) i64 {
  var i i64 = 0
  while i < an && i < bn {
    var x i64 = load8(a + i)
    var y i64 = load8(b + i)
    if x < y {
      return -1
    }
    if x > y {
      return 1
    }
    i = i + 1
  }
  if an < bn {
    return -1
  }
  if an > bn {
    return 1
  }
  return 0
}

// Path joins dir and name with "/" into a NUL-terminated string.
func Path(io *ovid/io.Cap, dp i64, dn i64, np i64, nn i64) i64 {
  if dn == 0 {
    return Cat(io, np, nn, 0, 0)
  }
  var t i64 = Cat(io, dp, dn, strptr("/"), 1)
  return Cat(io, t, dn + 1, np, nn)
}

// LoadErr prints one load error line: code, message, and the position of
// off in f when f is set.
func LoadErr(m *Mod, code i64, cn i64, f *File, off i64, msg *ovid/mem.Buf) i64 {
  m.nerr = m.nerr + 1
  var b *ovid/mem.Buf = m.out
  b.len = 0
  ovid/mem.WBytes(m.io, b, strptr("{\"fact\":\"error\",\"code\":"), 23)
  WStr(m.io, b, code, cn)
  ovid/mem.WBytes(m.io, b, strptr(",\"message\":"), 11)
  WStr(m.io, b, msg.data, msg.len)
  if m.hint != 0 as *ovid/mem.Buf {
    ovid/mem.WBytes(m.io, b, strptr(",\"hint\":"), 8)
    WStr(m.io, b, m.hint.data, m.hint.len)
    m.hint = 0 as *ovid/mem.Buf
  }
  if f != 0 as *File {
    WPos(m.io, b, f, off)
  }
  ovid/mem.WBytes(m.io, b, strptr("}\n"), 2)
  ovid/io.Stdout(b.data, b.len)
  return 0
}

func Msg(io *ovid/io.Cap, p i64, n i64) *ovid/mem.Buf {
  var b *ovid/mem.Buf = ovid/mem.New(io, n + 64)
  ovid/mem.WBytes(io, b, p, n)
  return b
}

func IsSpace(c i64) bool {
  return c == 32 || c == 9 || c == 13 || c == 11 || c == 12
}

// ReadMod parses ovid.mod: module and entry lines; // comments. The
// standard library is the directory --std names (stdp/stdn), never the
// module's choice.
func ReadMod(m *Mod, src i64, n i64, stdp i64, stdn i64) i64 {
  var i i64 = 0
  while i < n {
    var ls i64 = i
    while i < n && load8(src + i) != 10 {
      i = i + 1
    }
    var le i64 = i
    i = i + 1
    var nf i64 = 0
    var f0 i64 = 0
    var f0n i64 = 0
    var f1 i64 = 0
    var f1n i64 = 0
    var j i64 = ls
    while j < le {
      while j < le && IsSpace(load8(src + j)) {
        j = j + 1
      }
      if j < le {
        var fs i64 = j
        while j < le && !IsSpace(load8(src + j)) {
          j = j + 1
        }
        if nf == 0 {
          f0 = src + fs
          f0n = j - fs
        } else if nf == 1 {
          f1 = src + fs
          f1n = j - fs
        }
        nf = nf + 1
      }
    }
    var comment bool = f0n >= 2 && load8(f0) == 47 && load8(f0 + 1) == 47
    if nf != 0 && !comment {
      if nf != 2 {
        var b *ovid/mem.Buf = Msg(m.io, strptr("ovid.mod: bad line "), 19)
        WStr(m.io, b, src + ls, le - ls)
        ovid/mem.WBytes(m.io, b, strptr("; want `module <name>` or `entry <pkg>`"), strlen("; want `module <name>` or `entry <pkg>`"))
        LoadErr(m, strptr("mod"), 3, 0 as *File, 0, b)
      } else if ovid/mem.Eq(f0, f0n, strptr("module"), 6) {
        m.namep = f1
        m.namen = f1n
      } else if ovid/mem.Eq(f0, f0n, strptr("entry"), 5) {
        m.entryp = f1
        m.entryn = f1n
      } else if ovid/mem.Eq(f0, f0n, strptr("std"), 3) {
        // A module once could name its own standard library here, and with
        // it take the right to call syscall.
        var sb *ovid/mem.Buf = Msg(m.io, strptr("ovid.mod: the std line is no longer supported: the standard library is the directory --std names on the command line; delete the line"), strlen("ovid.mod: the std line is no longer supported: the standard library is the directory --std names on the command line; delete the line"))
        LoadErr(m, strptr("mod"), 3, 0 as *File, 0, sb)
      } else {
        var u *ovid/mem.Buf = Msg(m.io, strptr("ovid.mod: unknown directive "), 28)
        WStr(m.io, u, f0, f0n)
        LoadErr(m, strptr("mod"), 3, 0 as *File, 0, u)
      }
    }
  }
  m.stdp = stdp
  m.stdn = stdn
  return 0
}

// StdHas reports whether the standard library holds a package of this
// path: a directory there with a .ov file in it.
func StdHas(m *Mod, pathp i64, pathn i64) bool {
  if m.stdn == 0 {
    return false
  }
  var dir i64 = Path(m.io, m.stdp, m.stdn, pathp, pathn)
  var e *File = ListDir(m.io, dir)
  while e != 0 as *File {
    if !EntIsDir(m.io, dir, e) && HasOvSuffix(e.relp, e.reln) {
      return true
    }
    e = e.next
  }
  return false
}

// ListDir returns the entries of a directory as a list of Files used as
// (name = relp/reln, std = d_type), sorted by name, without . and ..
// It uses getdents64 through ovid/io.Getdents.
func ListDir(io *ovid/io.Cap, path i64) *File {
  var fd i64, e i64 = ovid/io.Open(path, 65536, 0)
  if e != 0 {
    return 0 as *File
  }
  var head *File = 0 as *File
  var buf i64 = ovid/io.Alloc(io, 32768)
  var r i64, _ = ovid/io.Getdents(fd, buf, 32768)
  while r > 0 {
    var o i64 = 0
    while o < r {
      var rec i64 = buf + o
      var reclen i64 = load8(rec + 16) | (load8(rec + 17) << 8)
      var nm i64 = rec + 19
      var nn i64 = ovid/io.CLen(nm)
      var dot bool = (nn == 1 && load8(nm) == 46) || (nn == 2 && load8(nm) == 46 && load8(nm + 1) == 46)
      if !dot {
        var f *File = ovid/io.Alloc(io, sizeof(File)) as *File
        f.relp = Cat(io, nm, nn, 0, 0)
        f.reln = nn
        f.std = load8(rec + 18)
        head = InsertByName(head, f)
      }
      o = o + reclen
    }
    r, _ = ovid/io.Getdents(fd, buf, 32768)
  }
  ovid/io.Close(fd)
  return head
}

// InsertByName inserts f into the list sorted by relp.
func InsertByName(head *File, f *File) *File {
  if head == 0 as *File || Cmp(f.relp, f.reln, head.relp, head.reln) < 0 {
    f.next = head
    return f
  }
  var c *File = head
  while c.next != 0 as *File && Cmp(c.next.relp, c.next.reln, f.relp, f.reln) <= 0 {
    c = c.next
  }
  f.next = c.next
  c.next = f
  return head
}

func EntIsDir(io *ovid/io.Cap, dir i64, e *File) bool {
  if e.std == 4 {
    return true
  }
  if e.std == 0 {
    var full i64 = Path(io, dir, ovid/io.CLen(dir), e.relp, e.reln)
    var isdir bool, _ = ovid/io.IsDir(io, full, ovid/io.CLen(full))
    return isdir
  }
  return false
}

func HasOvSuffix(p i64, n i64) bool {
  return n >= 3 && ovid/mem.Eq((p + n) - 3, 3, strptr(".ov"), 3)
}

func IsTestFile(p i64, n i64) bool {
  return n >= 8 && ovid/mem.Eq((p + n) - 8, 8, strptr("_test.ov"), 8)
}

// GroupFor finds or makes the package for path p[0:n], keeping m.pkgs
// sorted by path.
func GroupFor(m *Mod, p i64, n i64) *Pkg {
  var prev *Pkg = 0 as *Pkg
  var c *Pkg = m.pkgs
  while c != 0 as *Pkg && Cmp(c.pathp, c.pathn, p, n) < 0 {
    prev = c
    c = c.next
  }
  if c != 0 as *Pkg && Cmp(c.pathp, c.pathn, p, n) == 0 {
    return c
  }
  var k *Pkg = ovid/io.Alloc(m.io, sizeof(Pkg)) as *Pkg
  k.pathp = p
  k.pathn = n
  k.next = c
  if prev == 0 as *Pkg {
    m.pkgs = k
  } else {
    prev.next = k
  }
  return k
}

// Walk adds every .ov file under abs (relative path rel) to its package,
// skipping dot directories and nested modules, like filepath.WalkDir.
func Walk(m *Mod, abs i64, relp i64, reln i64) i64 {
  var e *File = ListDir(m.io, abs)
  while e != 0 as *File {
    var next *File = e.next
    var full i64 = Path(m.io, abs, ovid/io.CLen(abs), e.relp, e.reln)
    var crel i64 = Path(m.io, relp, reln, e.relp, e.reln)
    var creln i64 = e.reln
    if reln != 0 {
      creln = (reln + 1) + e.reln
    }
    if EntIsDir(m.io, abs, e) {
      var modf i64 = Path(m.io, full, ovid/io.CLen(full), strptr("ovid.mod"), 8)
      var st i64 = ovid/io.Alloc(m.io, 256)
      if load8(e.relp) != 46 && ovid/io.FstatAt(modf, st) != 0 {
        Walk(m, full, crel, creln)
      }
    } else if HasOvSuffix(e.relp, e.reln) && !(m.notests && IsTestFile(e.relp, e.reln)) {
      var pn i64 = ovid/io.Alloc(m.io, 8)
      var src i64, re i64 = ovid/io.ReadFile(m.io, full, ovid/io.CLen(full), pn)
      if re == 0 {
        var f *File = ovid/io.Alloc(m.io, sizeof(File)) as *File
        f.relp = crel
        f.reln = creln
        if m.dirn == 1 && load8(m.dirp) == 46 {
          f.dispp = crel
          f.dispn = creln
        } else {
          f.dispp = full
          f.dispn = ovid/io.CLen(full)
        }
        f.src = src
        f.n = load64(pn)
        var k *Pkg = GroupFor(m, relp, reln)
        k.files = InsertByName(k.files, f)
      } else {
        var b *ovid/mem.Buf = Msg(m.io, strptr("cannot read "), 12)
        ovid/mem.WBytes(m.io, b, full, ovid/io.CLen(full))
        LoadErr(m, strptr("read"), 4, 0 as *File, 0, b)
      }
    }
    e = next
  }
  return 0
}

func AddFileM(m *Mod, f *File) i64 {
  if m.ftail == 0 as *File {
    m.files = f
  } else {
    m.ftail.mnext = f
  }
  m.ftail = f
  return 0
}

// AddPackage parses each file of k and merges them: imports deduplicated
// by path, everything else concatenated in file order.
func AddPackage(m *Mod, k *Pkg) i64 {
  var f *File = k.files
  while f != 0 as *File {
    AddFileM(m, f)
    if k.pathn == 0 {
      var b *ovid/mem.Buf = Msg(m.io, strptr("source file is in the module root; put it in a package directory such as "), strlen("source file is in the module root; put it in a package directory such as "))
      ovid/mem.WBytes(m.io, b, f.relp, f.reln - 3)
      ovid/mem.WByte(m.io, b, 47)
      LoadErr(m, strptr("layout"), 6, f, 0, b)
    } else {
      var p *P = NewP(m.io, f)
      var one *Pkg = ParseFile(p)
      if p.err != 0 {
        LoadErr(m, strptr("syntax"), 6, f, p.eoff, p.emsg)
      } else if !ovid/mem.Eq(one.pathp, one.pathn, k.pathp, k.pathn) {
        var lb *ovid/mem.Buf = Msg(m.io, strptr("file says `package "), 19)
        ovid/mem.WBytes(m.io, lb, one.pathp, one.pathn)
        ovid/mem.WBytes(m.io, lb, strptr("` but sits in directory "), 24)
        ovid/mem.WBytes(m.io, lb, k.pathp, k.pathn)
        m.hint = Msg(m.io, strptr("the package path is the directory path; write `package "), strlen("the package path is the directory path; write `package "))
        ovid/mem.WBytes(m.io, m.hint, k.pathp, k.pathn)
        ovid/mem.WByte(m.io, m.hint, 96)
        LoadErr(m, strptr("layout"), 6, f, one.off, lb)
      } else if k.ok == 0 {
        if k.std == 0 && StdHas(m, k.pathp, k.pathn) {
          // Once for the package, at its first file's package clause.
          var rb *ovid/mem.Buf = Msg(m.io, strptr("package "), 8)
          ovid/mem.WBytes(m.io, rb, k.pathp, k.pathn)
          ovid/mem.WBytes(m.io, rb, strptr(" is one the toolchain ships; a module may not have its own"), strlen(" is one the toolchain ships; a module may not have its own"))
          m.hint = Msg(m.io, strptr("move these files to a package path of the module's own, and import "), strlen("move these files to a package path of the module's own, and import "))
          ovid/mem.WBytes(m.io, m.hint, k.pathp, k.pathn)
          ovid/mem.WBytes(m.io, m.hint, strptr(" for the shipped one"), strlen(" for the shipped one"))
          LoadErr(m, strptr("reserved_path"), 13, f, one.off, rb)
        }
        k.ok = 1
        k.file = one.file
        k.off = one.off
        k.ims = one.ims
        k.imt = one.imt
        k.cs = one.cs
        k.ct = one.ct
        k.ts = one.ts
        k.tt = one.tt
        k.fs = one.fs
        k.ft = one.ft
      } else {
        Merge(k, one)
      }
    }
    f = f.next
  }
  return 0
}

func Merge(k *Pkg, one *Pkg) i64 {
  var im *Decl = one.ims
  while im != 0 as *Decl {
    var next *Decl = im.next
    var seen bool = false
    var c *Decl = k.ims
    while c != 0 as *Decl && !seen {
      if ovid/mem.Eq(c.namep, c.namen, im.namep, im.namen) {
        seen = true
      }
      c = c.next
    }
    if !seen {
      im.next = 0 as *Decl
      AddImport(k, im)
    }
    im = next
  }
  if one.cs != 0 as *Decl {
    if k.ct == 0 as *Decl {
      k.cs = one.cs
    } else {
      k.ct.next = one.cs
    }
    k.ct = one.ct
  }
  if one.ts != 0 as *Decl {
    if k.tt == 0 as *Decl {
      k.ts = one.ts
    } else {
      k.tt.next = one.ts
    }
    k.tt = one.tt
  }
  if one.fs != 0 as *Decl {
    if k.ft == 0 as *Decl {
      k.fs = one.fs
    } else {
      k.ft.next = one.fs
    }
    k.ft = one.ft
  }
  return 0
}

func HavePkg(m *Mod, p i64, n i64) bool {
  var k *Pkg = m.pkgs
  while k != 0 as *Pkg {
    if ovid/mem.Eq(k.pathp, k.pathn, p, n) {
      return true
    }
    k = k.next
  }
  var i i64 = 0
  while i < m.nmissing {
    var r i64 = m.missing + (i * 16)
    if ovid/mem.Eq(load64(r), load64(r + 8), p, n) {
      return true
    }
    i = i + 1
  }
  return false
}

// StdPass adds, in path order, every imported package the module does not
// have, from the std dir. It returns how many were looked for.
func StdPass(m *Mod) i64 {
  var need *Pkg = 0 as *Pkg
  var cnt i64 = 0
  var k *Pkg = m.pkgs
  while k != 0 as *Pkg {
    var im *Decl = k.ims
    if k.ok == 0 {
      im = 0 as *Decl
    }
    while im != 0 as *Decl {
      if !HavePkg(m, im.namep, im.namen) {
        var dup bool = false
        var q *Pkg = need
        while q != 0 as *Pkg {
          if ovid/mem.Eq(q.pathp, q.pathn, im.namep, im.namen) {
            dup = true
          }
          q = q.next
        }
        if !dup {
          var nk *Pkg = ovid/io.Alloc(m.io, sizeof(Pkg)) as *Pkg
          nk.pathp = im.namep
          nk.pathn = im.namen
          nk.next = need
          need = nk
          cnt = cnt + 1
        }
      }
      im = im.next
    }
    k = k.next
  }
  if cnt == 0 {
    return 0
  }
  if m.stdn == 0 {
    var b *ovid/mem.Buf = Msg(m.io, strptr("module imports "), 15)
    ovid/mem.WBytes(m.io, b, need.pathp, need.pathn)
    ovid/mem.WBytes(m.io, b, strptr(" and no standard library was given; pass --std <dir> (the directory holding ovid/io and ovid/mem)"), strlen(" and no standard library was given; pass --std <dir> (the directory holding ovid/io and ovid/mem)"))
    LoadErr(m, strptr("no_std"), 6, 0 as *File, 0, b)
    return 0
  }
  var sorted *Pkg = 0 as *Pkg
  while need != 0 as *Pkg {
    var nx *Pkg = need.next
    if sorted == 0 as *Pkg || Cmp(need.pathp, need.pathn, sorted.pathp, sorted.pathn) < 0 {
      need.next = sorted
      sorted = need
    } else {
      var c *Pkg = sorted
      while c.next != 0 as *Pkg && Cmp(c.next.pathp, c.next.pathn, need.pathp, need.pathn) < 0 {
        c = c.next
      }
      need.next = c.next
      c.next = need
    }
    need = nx
  }
  while sorted != 0 as *Pkg {
    var nxt *Pkg = sorted.next
    var dir i64 = Path(m.io, m.stdp, m.stdn, sorted.pathp, sorted.pathn)
    var e *File = ListDir(m.io, dir)
    var files *File = 0 as *File
    while e != 0 as *File {
      var en *File = e.next
      if !EntIsDir(m.io, dir, e) && HasOvSuffix(e.relp, e.reln) {
        var full i64 = Path(m.io, dir, ovid/io.CLen(dir), e.relp, e.reln)
        var pn i64 = ovid/io.Alloc(m.io, 8)
        var src i64, re i64 = ovid/io.ReadFile(m.io, full, ovid/io.CLen(full), pn)
        if re == 0 {
          var f *File = ovid/io.Alloc(m.io, sizeof(File)) as *File
          var t i64 = Cat(m.io, strptr("std:"), 4, sorted.pathp, sorted.pathn)
          f.relp = Path(m.io, t, 4 + sorted.pathn, e.relp, e.reln)
          f.reln = (5 + sorted.pathn) + e.reln
          // Shown as std:<pkg>/<file>, as the Go toolchain shows it.
          f.dispp = f.relp
          f.dispn = f.reln
          f.src = src
          f.n = load64(pn)
          f.std = 1
          files = InsertByName(files, f)
        }
      }
      e = en
    }
    if files == 0 as *File {
      if m.nmissing % 64 == 0 {
        var nm i64 = ovid/io.Alloc(m.io, (m.nmissing + 64) * 16)
        ovid/mem.Copy(nm, m.missing, m.nmissing * 16)
        m.missing = nm
      }
      store64(m.missing + (m.nmissing * 16), sorted.pathp)
      store64(m.missing + (m.nmissing * 16) + 8, sorted.pathn)
      m.nmissing = m.nmissing + 1
    } else {
      var k2 *Pkg = GroupFor(m, sorted.pathp, sorted.pathn)
      k2.std = 1
      k2.files = files
      AddPackage(m, k2)
    }
    sorted = nxt
  }
  return cnt
}

// RevAdd appends name, NUL, contents, NUL to the revision's input.
func RevAdd(m *Mod, b *ovid/mem.Buf, np i64, nn i64, sp i64, sn i64) i64 {
  ovid/mem.WBytes(m.io, b, np, nn)
  ovid/mem.WByte(m.io, b, 0)
  ovid/mem.WBytes(m.io, b, sp, sn)
  ovid/mem.WByte(m.io, b, 0)
  return 0
}

// Revision is the sha256, as 64 hex digits, of everything a build of the
// module reads: ovid.mod, every module file in package then file order,
// then every std file that was loaded, sorted by path (std:<pkg>/<file>).
// Callers print the first 16 digits. It matches RevisionDigest in
// internal/module. It is computed on first use: build never prints it.
func Revision(m *Mod) i64 {
  if m.rev != 0 {
    return m.rev
  }
  var b *ovid/mem.Buf = ovid/mem.New(m.io, 1 << 20)
  RevAdd(m, b, strptr("ovid.mod"), 8, m.modsrc, m.modlen)
  var f *File = m.files
  while f != 0 as *File {
    if f.std == 0 {
      RevAdd(m, b, f.relp, f.reln, f.src, f.n)
    }
    f = f.mnext
  }
  // The std files in path order: each round takes the smallest path after
  // the one taken last. There are only a handful.
  var last *File = 0 as *File
  var more bool = true
  while more {
    var best *File = 0 as *File
    f = m.files
    while f != 0 as *File {
      if f.std != 0 {
        var after bool = last == 0 as *File
        if !after {
          after = Cmp(f.relp, f.reln, last.relp, last.reln) > 0
        }
        if after {
          if best == 0 as *File {
            best = f
          } else if Cmp(f.relp, f.reln, best.relp, best.reln) < 0 {
            best = f
          }
        }
      }
      f = f.mnext
    }
    if best == 0 as *File {
      more = false
    } else {
      RevAdd(m, b, best.relp, best.reln, best.src, best.n)
      last = best
    }
  }
  var raw i64 = ovid/io.Alloc(m.io, 32)
  ovid/sha.Sum(m.io, b.data, b.len, raw)
  m.rev = ovid/io.Alloc(m.io, 64)
  ovid/sha.Hex(m.rev, raw)
  return m.rev
}

// Load reads and parses the module in dir (stdp/stdn: the --std directory,
// or 0 for none).
// notests leaves out _test.ov files, as build does. Check m.nerr; on 0,
// m.pkgs holds the program. Emit writes it as JSON.
func Load(io *ovid/io.Cap, dirp i64, dirn i64, stdp i64, stdn i64, notests bool) *Mod {
  var m *Mod = ovid/io.Alloc(io, sizeof(Mod)) as *Mod
  m.io = io
  m.notests = notests
  m.dirp = dirp
  m.dirn = dirn
  m.out = ovid/mem.New(io, 4096)
  var modp i64 = Path(io, dirp, dirn, strptr("ovid.mod"), 8)
  var mn i64 = ovid/io.Alloc(io, 8)
  var msrc i64, me i64 = ovid/io.ReadFile(io, modp, ovid/io.CLen(modp), mn)
  if me != 0 {
    var b *ovid/mem.Buf = Msg(io, strptr("no ovid.mod in "), 15)
    ovid/mem.WBytes(io, b, dirp, dirn)
    ovid/mem.WBytes(io, b, strptr("; pass the module directory (the one holding ovid.mod)"), strlen("; pass the module directory (the one holding ovid.mod)"))
    LoadErr(m, strptr("no_module"), 9, 0 as *File, 0, b)
    return m
  }
  m.modsrc = msrc
  m.modlen = load64(mn)
  ReadMod(m, m.modsrc, m.modlen, stdp, stdn)
  if m.nerr != 0 {
    return m
  }
  var root i64 = Cat(io, dirp, dirn, 0, 0)
  Walk(m, root, 0, 0)
  var k *Pkg = m.pkgs
  while k != 0 as *Pkg {
    AddPackage(m, k)
    k = k.next
  }
  while StdPass(m) != 0 {
    m.npkg = 0
  }
  if m.nerr != 0 {
    return m
  }
  var prev *Pkg = 0 as *Pkg
  k = m.pkgs
  while k != 0 as *Pkg {
    if k.ok == 0 {
      if prev == 0 as *Pkg {
        m.pkgs = k.next
      } else {
        prev.next = k.next
      }
    } else {
      prev = k
      m.npkg = m.npkg + 1
    }
    k = k.next
  }
  IndexFuncs(m)
  return m
}
