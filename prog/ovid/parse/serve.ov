package ovid/parse

import ovid/io
import ovid/mem

// ServeHost gives the entry package a main when it has handle and no main:
// the stdio host, which reads one request from stdin, calls handle, and
// writes the response. The main joins the entry package after its own
// funcs, so it cannot collide with a package of the module's, and the
// imports it needs, ovid/io and ovid/http, are ones handle's signature
// already made the package declare. The Go toolchain does the same
// (internal/tool/serve.go).
func ServeHost(m *Mod) i64 {
  var e *Pkg = m.pkgs
  while e != 0 as *Pkg && !ovid/mem.Eq(e.pathp, e.pathn, m.entryp, m.entryn) {
    e = e.next
  }
  if e == 0 as *Pkg {
    return 0
  }
  if FindDecl(e.fs, strptr("main"), 4) != 0 as *Decl || FindDecl(e.fs, strptr("handle"), 6) == 0 as *Decl {
    return 0
  }
  var io *ovid/io.Cap = m.io
  var b *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WBytes(io, b, strptr("package "), 8)
  ovid/mem.WBytes(io, b, m.entryp, m.entryn)
  ovid/mem.WBytes(io, b, strptr("\n\nfunc main(io *ovid/io.Cap) i64 {\n  var req *ovid/http.Request = ovid/http.ReadStdio(io)\n  var res *ovid/http.Response = ovid/http.NewResponse(io)\n  if ovid/http.Err(req) != 0 {\n    return ovid/http.WriteStdio(io, req, res, 0)\n  }\n  return ovid/http.WriteStdio(io, req, res, handle(io, req, res))\n}\n"), strlen("\n\nfunc main(io *ovid/io.Cap) i64 {\n  var req *ovid/http.Request = ovid/http.ReadStdio(io)\n  var res *ovid/http.Response = ovid/http.NewResponse(io)\n  if ovid/http.Err(req) != 0 {\n    return ovid/http.WriteStdio(io, req, res, 0)\n  }\n  return ovid/http.WriteStdio(io, req, res, handle(io, req, res))\n}\n"))
  var f *File = ovid/io.Alloc(io, sizeof(File)) as *File
  f.relp = strptr("serve host")
  f.reln = strlen("serve host")
  f.dispp = f.relp
  f.dispn = f.reln
  f.src = b.data
  f.n = b.len
  var p *P = NewP(io, f)
  var one *Pkg = ParseFile(p)
  if p.err != 0 {
    return 1
  }
  Merge(e, one)
  return IndexFuncs(m)
}
