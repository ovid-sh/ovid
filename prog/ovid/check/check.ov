package ovid/check

import ovid/io
import ovid/mem
import ovid/parse

// What an error is about (Ch.hk). The id text is only built when an error
// is printed or a decl id is claimed.
const H_NONE i64 = 0
const H_NODE i64 = 1
const H_PKG i64 = 2
const H_IMPORT i64 = 3
const H_CONST i64 = 4
const H_TYPE i64 = 5
const H_FIELD i64 = 6
const H_FUNC i64 = 7
const H_PARAM i64 = 8

// Ch is the checker's state. hk/hpk/hd/ho/hn name the node or decl the next
// error is about: hd is the decl (ho its type or func, for a field or
// param), hn the statement or expression (ho its func).
type Ch struct {
  io *ovid/io.Cap
  mod *ovid/parse.Mod
  errs i64
  env i64
  nenv i64
  mark i64
  nmark i64
  typ i64
  tyn i64
  pathp i64
  pathn i64
  fnp i64
  fnn i64
  tab i64
  tabmask i64
  b *ovid/mem.Buf
  ib *ovid/mem.Buf
  pkg *ovid/parse.Pkg
  fd *ovid/parse.Decl
  nfunc i64
  resp i64
  resn i64
  hk i64
  hpk *ovid/parse.Pkg
  hd *ovid/parse.Decl
  ho *ovid/parse.Decl
  hn *ovid/parse.Node
  croot *ovid/parse.Pkg
  cpath i64
  cn i64
  cep i64
  cscc i64
  csize i64
  ptab i64
  pmask i64
}

func WLit(c *Ch, p i64, n i64) i64 {
  return ovid/mem.WBytes(c.io, c.b, p, n)
}

func WRaw(c *Ch, p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    var ch i64 = load8(p + i)
    if ch == 34 || ch == 92 {
      ovid/mem.WByte(c.io, c.b, 92)
      ovid/mem.WByte(c.io, c.b, ch)
    } else {
      if ch == 10 {
        ovid/mem.WByte(c.io, c.b, 92)
        ovid/mem.WByte(c.io, c.b, 110)
      } else {
        ovid/mem.WByte(c.io, c.b, ch)
      }
    }
    i = i + 1
  }
  return 0
}

func WStr(c *Ch, p i64, n i64) i64 {
  ovid/mem.WByte(c.io, c.b, 34)
  WRaw(c, p, n)
  ovid/mem.WByte(c.io, c.b, 34)
  return 0
}

func WNum(c *Ch, v i64) i64 {
  var tmp i64 = ovid/io.Alloc(c.io, 64)
  var n i64 = ovid/mem.FormatI64(tmp, v)
  return ovid/mem.WBytes(c.io, c.b, tmp, n)
}

func Line(c *Ch) i64 {
  ovid/mem.WByte(c.io, c.b, 10)
  ovid/io.Stdout(c.b.data, c.b.len)
  c.b.len = 0
  return 0
}

// WId appends the id of the node or decl the checker is at to b, in the
// form `ovid dump` writes it.
func WId(c *Ch, b *ovid/mem.Buf) i64 {
  var io *ovid/io.Cap = c.io
  var k *ovid/parse.Pkg = c.hpk
  var d *ovid/parse.Decl = c.hd
  var o *ovid/parse.Decl = c.ho
  if c.hk == H_PKG {
    ovid/mem.WBytes(io, b, strptr("pkg:"), 4)
    return ovid/mem.WBytes(io, b, k.pathp, k.pathn)
  }
  if c.hk == H_IMPORT {
    ovid/mem.WBytes(io, b, strptr("im:"), 3)
    ovid/mem.WBytes(io, b, k.pathp, k.pathn)
    ovid/mem.WByte(io, b, 58)
    return ovid/mem.WBytes(io, b, d.namep, d.namen)
  }
  if c.hk == H_NODE {
    var n *ovid/parse.Node = c.hn
    if n.op <= ovid/parse.OP_EXPR {
      ovid/mem.WBytes(io, b, strptr("st:"), 3)
    } else {
      ovid/mem.WBytes(io, b, strptr("ex:"), 3)
    }
    ovid/mem.WBytes(io, b, k.pathp, k.pathn)
    ovid/mem.WByte(io, b, 46)
    ovid/mem.WBytes(io, b, o.namep, o.namen)
    ovid/mem.WByte(io, b, 58)
    return ovid/parse.WInt(io, b, n.num)
  }
  if c.hk == H_CONST {
    ovid/mem.WBytes(io, b, strptr("cn:"), 3)
  } else if c.hk == H_TYPE {
    ovid/mem.WBytes(io, b, strptr("ty:"), 3)
  } else if c.hk == H_FIELD {
    ovid/mem.WBytes(io, b, strptr("fld:"), 4)
  } else if c.hk == H_FUNC {
    ovid/mem.WBytes(io, b, strptr("fn:"), 3)
  } else {
    ovid/mem.WBytes(io, b, strptr("pa:"), 3)
  }
  ovid/mem.WBytes(io, b, k.pathp, k.pathn)
  ovid/mem.WByte(io, b, 46)
  if c.hk == H_FIELD || c.hk == H_PARAM {
    ovid/mem.WBytes(io, b, o.namep, o.namen)
    ovid/mem.WByte(io, b, 46)
  }
  return ovid/mem.WBytes(io, b, d.namep, d.namen)
}

// WHerePos appends the source position of what the checker is at.
func WHerePos(c *Ch) i64 {
  var k *ovid/parse.Pkg = c.hpk
  var d *ovid/parse.Decl = c.hd
  var o *ovid/parse.Decl = c.ho
  if c.hk == H_PKG {
    return ovid/parse.WPos(c.io, c.b, k.file, k.off)
  }
  if c.hk == H_NODE {
    var n *ovid/parse.Node = c.hn
    return ovid/parse.WPos(c.io, c.b, o.file, n.off)
  }
  if c.hk == H_FIELD || c.hk == H_PARAM {
    return ovid/parse.WPos(c.io, c.b, o.file, d.off)
  }
  return ovid/parse.WPos(c.io, c.b, d.file, d.off)
}

// Err prints one error line: code, message, the id it is about, and that
// id's source position.
func Err(c *Ch, code i64, coden i64, detail i64, dn i64) i64 {
  c.errs = c.errs + 1
  WLit(c, strptr("{\"fact\":\"error\",\"code\":"), strlen("{\"fact\":\"error\",\"code\":"))
  WStr(c, code, coden)
  WLit(c, strptr(",\"message\":"), strlen(",\"message\":"))
  WStr(c, detail, dn)
  if c.hk != H_NONE {
    WLit(c, strptr(",\"id\":\""), strlen(",\"id\":\""))
    WId(c, c.b)
    ovid/mem.WByte(c.io, c.b, 34)
  }
  if c.pathn != 0 {
    WLit(c, strptr(",\"pkg\":"), strlen(",\"pkg\":"))
    WStr(c, c.pathp, c.pathn)
  }
  if c.fnn != 0 {
    WLit(c, strptr(",\"func\":"), strlen(",\"func\":"))
    WStr(c, c.fnp, c.fnn)
  }
  if c.hk != H_NONE {
    WHerePos(c)
  }
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  return 0
}

// Here points errors at statement or expression n of the current func.
func Here(c *Ch, n *ovid/parse.Node) i64 {
  c.hk = H_NODE
  c.hpk = c.pkg
  c.ho = c.fd
  c.hn = n
  return 0
}

// HereDecl points errors at decl d of package k; kind is one of H_*, and o
// is the type of a field or the func of a param.
func HereDecl(c *Ch, kind i64, k *ovid/parse.Pkg, d *ovid/parse.Decl, o *ovid/parse.Decl) i64 {
  c.hk = kind
  c.hpk = k
  c.hd = d
  c.ho = o
  return 0
}

func HashStr(p i64, n i64) i64 {
  var h i64 = 5381
  var i i64 = 0
  while i < n {
    h = ((h << 5) + h) + load8(p + i)
    i = i + 1
  }
  return h
}

// Claim records the id of the decl the checker is at. It returns 1, and
// records nothing, when an earlier decl has the same id. Statement and
// expression ids are numbered by the parser, so only decls can collide.
func Claim(c *Ch) i64 {
  c.ib.len = 0
  WId(c, c.ib)
  var n i64 = c.ib.len
  var p i64 = c.ib.data
  var idx i64 = HashStr(p, n) & c.tabmask
  while true {
    var rec i64 = c.tab + (idx * 16)
    var sp i64 = load64(rec)
    var sn i64 = load64(rec + 8)
    if sp == 0 {
      var keep i64 = ovid/io.Alloc(c.io, n)
      ovid/mem.Copy(keep, p, n)
      store64(rec, keep)
      store64(rec + 8, n)
      return 0
    }
    if ovid/mem.Eq(sp, sn, p, n) {
      return 1
    }
    idx = (idx + 1) & c.tabmask
  }
  return 0
}

func Push(c *Ch) i64 {
  if c.nmark >= 256 {
    Err(c, strptr("scope"), strlen("scope"), strptr("too deep"), strlen("too deep"))
    return 0
  }
  store64(c.mark + (c.nmark * 8), c.nenv)
  c.nmark = c.nmark + 1
  return 0
}

func Pop(c *Ch) i64 {
  if c.nmark <= 0 {
    return 0
  }
  c.nmark = c.nmark - 1
  c.nenv = load64(c.mark + (c.nmark * 8))
  return 0
}

func Lookup(c *Ch, np i64, nn i64) i64 {
  var i i64 = c.nenv - 1
  while i >= 0 {
    var rec i64 = c.env + (i * 32)
    if ovid/mem.Eq(load64(rec), load64(rec + 8), np, nn) {
      return rec
    }
    i = i - 1
  }
  return 0
}

func Define(c *Ch, np i64, nn i64, tp i64, tn i64) i64 {
  if Lookup(c, np, nn) != 0 {
    Err(c, strptr("duplicate_name"), strlen("duplicate_name"), np, nn)
  }
  return Bind(c, np, nn, tp, tn)
}

// Bind puts np[0:nn] of type tp[0:tn] in scope, without Define's check
// for a name already there.
func Bind(c *Ch, np i64, nn i64, tp i64, tn i64) i64 {
  if c.nenv >= 4096 {
    return 0
  }
  var rec i64 = c.env + (c.nenv * 32)
  store64(rec, np)
  store64(rec + 8, nn)
  store64(rec + 16, tp)
  store64(rec + 24, tn)
  c.nenv = c.nenv + 1
  return 0
}

func SetTy(c *Ch, p i64, n i64) i64 {
  c.typ = p
  c.tyn = n
  return 0
}

func SetI64(c *Ch) i64 {
  return SetTy(c, strptr("i64"), strlen("i64"))
}

func SetBool(c *Ch) i64 {
  return SetTy(c, strptr("bool"), strlen("bool"))
}

func SetBad(c *Ch) i64 {
  return SetTy(c, strptr("invalid"), strlen("invalid"))
}

func IsTy(c *Ch, p i64, n i64) bool {
  return ovid/mem.Eq(c.typ, c.tyn, p, n)
}

func Bad(c *Ch) bool {
  return IsTy(c, strptr("invalid"), strlen("invalid"))
}

func TyEq(p i64, n i64, q i64, m i64) bool {
  return ovid/mem.Eq(p, n, q, m)
}

// FindPkg returns the package of path pp[0:pn], the first loaded if two
// share it, or 0. It looks in c.ptab, the open-addressed table IndexPkgs
// fills.
func FindPkg(c *Ch, pp i64, pn i64) *ovid/parse.Pkg {
  var idx i64 = HashStr(pp, pn) & c.pmask
  while true {
    var k *ovid/parse.Pkg = load64(c.ptab + (idx * 8)) as *ovid/parse.Pkg
    if k == 0 as *ovid/parse.Pkg {
      return k
    }
    if ovid/mem.Eq(k.pathp, k.pathn, pp, pn) {
      return k
    }
    idx = (idx + 1) & c.pmask
  }
  return 0 as *ovid/parse.Pkg
}

// IndexPkgs fills c.ptab with the module's packages and returns how many
// there are.
func IndexPkgs(c *Ch) i64 {
  var n i64 = 0
  var k *ovid/parse.Pkg = c.mod.pkgs
  while k != 0 as *ovid/parse.Pkg {
    n = n + 1
    k = k.next
  }
  var sz i64 = 16
  while sz < (n * 2) {
    sz = sz * 2
  }
  c.pmask = sz - 1
  c.ptab = ovid/io.Alloc(c.io, sz * 8)
  k = c.mod.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if FindPkg(c, k.pathp, k.pathn) == 0 as *ovid/parse.Pkg {
      var idx i64 = HashStr(k.pathp, k.pathn) & c.pmask
      while load64(c.ptab + (idx * 8)) != 0 {
        idx = (idx + 1) & c.pmask
      }
      store64(c.ptab + (idx * 8), k as i64)
    }
    k = k.next
  }
  return n
}

// CheckPkgConst types a reference pkg.NAME to another package's const.
func CheckPkgConst(c *Ch, pkp i64, pkn i64, np i64, nn i64) i64 {
  if !Imported(c, pkp, pkn) {
    Err(c, strptr("unknown_package"), strlen("unknown_package"), pkp, pkn)
    return SetBad(c)
  }
  var k *ovid/parse.Pkg = FindPkg(c, pkp, pkn)
  if k != 0 as *ovid/parse.Pkg {
    if ovid/parse.FindDecl(k.cs, np, nn) != 0 as *ovid/parse.Decl {
      return SetI64(c)
    }
  }
  Err(c, strptr("unknown_name"), strlen("unknown_name"), np, nn)
  return SetBad(c)
}

func Imported(c *Ch, pp i64, pn i64) bool {
  if ovid/mem.Eq(c.pathp, c.pathn, pp, pn) {
    return true
  }
  return ovid/parse.FindDecl(c.pkg.ims, pp, pn) != 0 as *ovid/parse.Decl
}

// FieldTy sets the current type to that of field fp[0:fn] of the pointer
// type tp[0:tn] (*pkg.Type), or returns -1.
func FieldTy(c *Ch, tp i64, tn i64, fp i64, fn i64) i64 {
  if tn < 2 {
    return -1
  }
  if load8(tp) != 42 {
    return -1
  }
  var p i64 = tp + 1
  var n i64 = tn - 1
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return -1
  }
  var k *ovid/parse.Pkg = FindPkg(c, p, dot)
  if k == 0 as *ovid/parse.Pkg {
    return -1
  }
  var t *ovid/parse.Decl = ovid/parse.FindDecl(k.ts, (p + dot) + 1, (n - dot) - 1)
  if t == 0 as *ovid/parse.Decl {
    return -1
  }
  var f *ovid/parse.Decl = ovid/parse.FindDecl(t.sub, fp, fn)
  if f == 0 as *ovid/parse.Decl {
    return -1
  }
  SetTy(c, f.typp, f.typn)
  return 0
}

// TyKind classifies the type tp[0:tn] as the parser wrote it (i64, bool,
// pkg.T, or *pkg.T): 0 for i64, bool, or a pointer to a struct that exists,
// 1 for such a struct by value, -1 when the package or struct is unknown.
func TyKind(c *Ch, tp i64, tn i64) i64 {
  if TyEq(tp, tn, strptr("i64"), strlen("i64")) || TyEq(tp, tn, strptr("bool"), strlen("bool")) {
    return 0
  }
  var star i64 = 0
  if tn > 0 && load8(tp) == 42 {
    star = 1
  }
  var p i64 = tp + star
  var n i64 = tn - star
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return -1
  }
  var k *ovid/parse.Pkg = FindPkg(c, p, dot)
  if k == 0 as *ovid/parse.Pkg {
    return -1
  }
  if ovid/parse.FindDecl(k.ts, (p + dot) + 1, (n - dot) - 1) == 0 as *ovid/parse.Decl {
    return -1
  }
  return 1 - star
}

// DeclTy checks the type of the field, param, or func result d, which the
// checker is at. An unknown type becomes invalid, so its uses stay quiet.
func DeclTy(c *Ch, d *ovid/parse.Decl) i64 {
  var kind i64 = TyKind(c, d.typp, d.typn)
  if kind < 0 {
    Err(c, strptr("bad_type"), strlen("bad_type"), d.typp, d.typn)
    d.typp = strptr("invalid")
    d.typn = strlen("invalid")
  } else if kind == 1 {
    Err(c, strptr("struct_value"), strlen("struct_value"), d.typp, d.typn)
  }
  return 0
}

// NeedTy reports a type_mismatch saying msg unless the current type is
// tp[0:tn], or either of them is invalid.
func NeedTy(c *Ch, tp i64, tn i64, msg i64, msgn i64) i64 {
  if TyEq(tp, tn, strptr("invalid"), strlen("invalid")) {
    return 0
  }
  if !Bad(c) {
    if !IsTy(c, tp, tn) {
      Err(c, strptr("type_mismatch"), strlen("type_mismatch"), msg, msgn)
    }
  }
  return 0
}

func NeedI64(c *Ch, msg i64, msgn i64) i64 {
  return NeedTy(c, strptr("i64"), strlen("i64"), msg, msgn)
}

func NeedBool(c *Ch, msg i64, msgn i64) i64 {
  return NeedTy(c, strptr("bool"), strlen("bool"), msg, msgn)
}

// CheckExpr types expression n, leaving the checker at n, so that an error
// a caller then reports about the value is placed at the expression and
// not at whatever node inside it was typed last.
func CheckExpr(c *Ch, n *ovid/parse.Node) i64 {
  if n == 0 as *ovid/parse.Node {
    Err(c, strptr("missing_expr"), strlen("missing_expr"), strptr("empty"), strlen("empty"))
    return SetBad(c)
  }
  CheckExprIn(c, n)
  Here(c, n)
  return 0
}

func CheckExprIn(c *Ch, n *ovid/parse.Node) i64 {
  Here(c, n)
  var op i64 = n.op
  if op == ovid/parse.OP_INT || op == ovid/parse.OP_STRPTR || op == ovid/parse.OP_STRLEN {
    return SetI64(c)
  }
  if op == ovid/parse.OP_SIZEOF {
    if TyKind(c, n.typp, n.typn) != 1 {
      Err(c, strptr("bad_type"), strlen("bad_type"), n.typp, n.typn)
    }
    return SetI64(c)
  }
  if op == ovid/parse.OP_BOOL {
    return SetBool(c)
  }
  if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      return CheckPkgConst(c, n.pkgp, n.pkgn, n.namep, n.namen)
    }
    var loc i64 = Lookup(c, n.namep, n.namen)
    if loc != 0 {
      return SetTy(c, load64(loc + 16), load64(loc + 24))
    }
    if ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen) != 0 as *ovid/parse.Decl {
      return SetI64(c)
    }
    Err(c, strptr("unknown_name"), strlen("unknown_name"), n.namep, n.namen)
    return SetBad(c)
  }
  if ovid/parse.UnsignedOp(op) {
    CheckExpr(c, n.left)
    NeedI64(c, strptr("unsigned argument 1"), strlen("unsigned argument 1"))
    CheckExpr(c, n.right)
    NeedI64(c, strptr("unsigned argument 2"), strlen("unsigned argument 2"))
    if op == ovid/parse.OP_ULT {
      return SetBool(c)
    }
    return SetI64(c)
  }
  // An operand of the wrong type is reported at that operand, as soon as
  // it is typed; a comparison of two different types is reported at its
  // right side.
  if op >= ovid/parse.OP_ADD && op <= ovid/parse.OP_SHR {
    CheckExpr(c, n.left)
    NeedI64(c, strptr("arith needs i64"), strlen("arith needs i64"))
    CheckExpr(c, n.right)
    NeedI64(c, strptr("arith needs i64"), strlen("arith needs i64"))
    return SetI64(c)
  }
  if op == ovid/parse.OP_EQ || op == ovid/parse.OP_NE {
    CheckExpr(c, n.left)
    var lp i64 = c.typ
    var ln i64 = c.tyn
    var lb bool = Bad(c)
    CheckExpr(c, n.right)
    if !lb {
      if !Bad(c) {
        if !TyEq(lp, ln, c.typ, c.tyn) {
          Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("comparison types differ"), strlen("comparison types differ"))
        }
      }
    }
    return SetBool(c)
  }
  if op >= ovid/parse.OP_LT && op <= ovid/parse.OP_GE {
    CheckExpr(c, n.left)
    NeedI64(c, strptr("order needs i64"), strlen("order needs i64"))
    CheckExpr(c, n.right)
    NeedI64(c, strptr("order needs i64"), strlen("order needs i64"))
    return SetBool(c)
  }
  if op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR {
    CheckExpr(c, n.left)
    NeedBool(c, strptr("logic needs bool"), strlen("logic needs bool"))
    CheckExpr(c, n.right)
    NeedBool(c, strptr("logic needs bool"), strlen("logic needs bool"))
    return SetBool(c)
  }
  if op == ovid/parse.OP_NOT {
    CheckExpr(c, n.arg)
    NeedBool(c, strptr("not needs bool"), strlen("not needs bool"))
    return SetBool(c)
  }
  if op == ovid/parse.OP_NEG || op == ovid/parse.OP_BNOT || ovid/parse.BswapOp(op) {
    CheckExpr(c, n.arg)
    NeedI64(c, strptr("unary needs i64"), strlen("unary needs i64"))
    return SetI64(c)
  }
  if ovid/parse.LoadOp(op) {
    CheckExpr(c, n.arg)
    NeedI64(c, strptr("load needs i64"), strlen("load needs i64"))
    return SetI64(c)
  }
  if op == ovid/parse.OP_CAST {
    var ck i64 = TyKind(c, n.typp, n.typn)
    if ck < 0 {
      Err(c, strptr("bad_type"), strlen("bad_type"), n.typp, n.typn)
      return SetBad(c)
    }
    if Opaque(c, n.typp, n.typn) {
      Here(c, n)
      Err(c, strptr("opaque_type"), strlen("opaque_type"), n.typp, n.typn)
    }
    CheckExpr(c, n.arg)
    if !Bad(c) && Opaque(c, c.typ, c.tyn) {
      Here(c, n)
      Err(c, strptr("opaque_type"), strlen("opaque_type"), c.typ, c.tyn)
    }
    if ck == 1 {
      if !Bad(c) {
        Here(c, n)
        Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("cast needs i64, bool, or a pointer type"), strlen("cast needs i64, bool, or a pointer type"))
      }
    }
    return SetTy(c, n.typp, n.typn)
  }
  if op == ovid/parse.OP_FIELD {
    CheckExpr(c, n.base)
    if Bad(c) {
      return SetBad(c)
    }
    if Opaque(c, c.typ, c.tyn) {
      Here(c, n)
      Err(c, strptr("opaque_type"), strlen("opaque_type"), n.namep, n.namen)
      return SetBad(c)
    }
    if FieldTy(c, c.typ, c.tyn, n.namep, n.namen) != 0 {
      Here(c, n)
      Err(c, strptr("unknown_field"), strlen("unknown_field"), n.namep, n.namen)
      return SetBad(c)
    }
    return 0
  }
  if op == ovid/parse.OP_CALL {
    var pp i64 = c.pathp
    var pn i64 = c.pathn
    var unloaded bool = false
    if n.pkgn != 0 {
      pp = n.pkgp
      pn = n.pkgn
      if !Imported(c, pp, pn) {
        Err(c, strptr("missing_import"), strlen("missing_import"), pp, pn)
        // A package nothing imports is not loaded, so whether it has the
        // func is unknown; the missing import is the whole report.
        unloaded = FindPkg(c, pp, pn) == 0 as *ovid/parse.Pkg
      }
    }
    var fn *ovid/parse.Decl = ovid/parse.FindFunc(c.mod, pp, pn, n.fnp, n.fnn)
    var a *ovid/parse.Node = n.args
    if fn != 0 as *ovid/parse.Decl {
      if fn.dup != 0 {
        // The index holds a repeat. Call the first func of the name; if
        // that one repeats a const or type, the call is not checked.
        var fk *ovid/parse.Pkg = FindPkg(c, pp, pn)
        fn = ovid/parse.FindDecl(fk.fs, n.fnp, n.fnn)
        if fn.dup != 0 {
          while a != 0 as *ovid/parse.Node {
            CheckExpr(c, a)
            a = a.next
          }
          return SetBad(c)
        }
      }
    }
    if fn == 0 as *ovid/parse.Decl {
      if !unloaded {
        Err(c, strptr("unknown_name"), strlen("unknown_name"), n.fnp, n.fnn)
      }
      while a != 0 as *ovid/parse.Node {
        CheckExpr(c, a)
        a = a.next
      }
      return SetBad(c)
    }
    if ovid/parse.CountNodes(a) != ovid/parse.CountDecls(fn.sub) {
      Err(c, strptr("arity"), strlen("arity"), n.fnp, n.fnn)
    }
    var p *ovid/parse.Decl = fn.sub
    while a != 0 as *ovid/parse.Node {
      CheckExpr(c, a)
      if p != 0 as *ovid/parse.Decl {
        NeedTy(c, p.typp, p.typn, n.fnp, n.fnn)
        p = p.next
      }
      a = a.next
    }
    return SetTy(c, fn.typp, fn.typn)
  }
  if op == ovid/parse.OP_SYSCALL {
    // The path alone is not enough: the package must have come from the
    // standard library, which a module cannot supply.
    if !ovid/mem.Eq(c.pathp, c.pathn, strptr("ovid/io"), strlen("ovid/io")) || c.pkg.std == 0 {
      Err(c, strptr("syscall_forbidden"), strlen("syscall_forbidden"), strptr("only ovid/io"), strlen("only ovid/io"))
    }
    var a *ovid/parse.Node = n.args
    if ovid/parse.CountNodes(a) != 7 {
      Err(c, strptr("arity"), strlen("arity"), strptr("syscall"), strlen("syscall"))
    }
    while a != 0 as *ovid/parse.Node {
      CheckExpr(c, a)
      NeedI64(c, strptr("syscall arg"), strlen("syscall arg"))
      a = a.next
    }
    return SetI64(c)
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("expr"), strlen("expr"))
  return SetBad(c)
}

// Paths reports whether every path through the statement list s returns.
func Paths(s *ovid/parse.Node) bool {
  if s == 0 as *ovid/parse.Node {
    return false
  }
  while s.next != 0 as *ovid/parse.Node {
    s = s.next
  }
  if s.op == ovid/parse.OP_RETURN {
    return true
  }
  if s.op == ovid/parse.OP_IF {
    if Paths(s.then) {
      return Paths(s.els)
    }
  }
  return false
}

func CheckStmts(c *Ch, s *ovid/parse.Node) i64 {
  while s != 0 as *ovid/parse.Node {
    CheckStmt(c, s)
    s = s.next
  }
  return 0
}

func CheckStmt(c *Ch, s *ovid/parse.Node) i64 {
  Here(c, s)
  var op i64 = s.op
  if op == ovid/parse.OP_VAR {
    var tp i64 = s.typp
    var tn i64 = s.typn
    var kind i64 = TyKind(c, tp, tn)
    if kind < 0 {
      Err(c, strptr("bad_type"), strlen("bad_type"), tp, tn)
      tp = strptr("invalid")
      tn = strlen("invalid")
    } else if kind == 1 {
      Err(c, strptr("struct_value"), strlen("struct_value"), s.namep, s.namen)
    }
    if Lookup(c, s.namep, s.namen) != 0 {
      Err(c, strptr("duplicate_name"), strlen("duplicate_name"), s.namep, s.namen)
    }
    // The value is checked before the name is in scope, as in codegen.
    if s.val != 0 as *ovid/parse.Node {
      CheckExpr(c, s.val)
      NeedTy(c, tp, tn, s.namep, s.namen)
    }
    Bind(c, s.namep, s.namen, tp, tn)
    return 0
  }
  if op == ovid/parse.OP_ASSIGN {
    var loc i64 = Lookup(c, s.namep, s.namen)
    if loc == 0 {
      Err(c, strptr("unknown_name"), strlen("unknown_name"), s.namep, s.namen)
      CheckExpr(c, s.val)
      return 0
    }
    CheckExpr(c, s.val)
    NeedTy(c, load64(loc + 16), load64(loc + 24), s.namep, s.namen)
    return 0
  }
  if op == ovid/parse.OP_SETFIELD {
    CheckExpr(c, s.base)
    var was bool = Bad(c)
    var fp i64 = 0
    var fn i64 = 0
    if !was && Opaque(c, c.typ, c.tyn) {
      Here(c, s)
      Err(c, strptr("opaque_type"), strlen("opaque_type"), s.namep, s.namen)
      was = true
    }
    if !was {
      if FieldTy(c, c.typ, c.tyn, s.namep, s.namen) != 0 {
        Here(c, s)
        Err(c, strptr("unknown_field"), strlen("unknown_field"), s.namep, s.namen)
        was = true
      } else {
        fp = c.typ
        fn = c.tyn
      }
    }
    CheckExpr(c, s.val)
    if !was {
      NeedTy(c, fp, fn, s.namep, s.namen)
    }
    return 0
  }
  if ovid/parse.StoreOp(op) {
    CheckExpr(c, s.addr)
    NeedI64(c, strptr("store address"), strlen("store address"))
    CheckExpr(c, s.val)
    NeedI64(c, strptr("store value"), strlen("store value"))
    return 0
  }
  if op == ovid/parse.OP_EXPR {
    CheckExpr(c, s.val)
    return 0
  }
  if op == ovid/parse.OP_RETURN {
    if s.val == 0 as *ovid/parse.Node {
      Err(c, strptr("type_mismatch"), strlen("type_mismatch"), strptr("missing return value"), strlen("missing return value"))
      return 0
    }
    CheckExpr(c, s.val)
    NeedTy(c, c.resp, c.resn, strptr("return type"), strlen("return type"))
    return 0
  }
  if op == ovid/parse.OP_IF {
    CheckExpr(c, s.cond)
    NeedBool(c, strptr("if needs bool"), strlen("if needs bool"))
    Push(c)
    CheckStmts(c, s.then)
    Pop(c)
    Push(c)
    CheckStmts(c, s.els)
    Pop(c)
    return 0
  }
  if op == ovid/parse.OP_WHILE {
    CheckExpr(c, s.cond)
    NeedBool(c, strptr("while needs bool"), strlen("while needs bool"))
    Push(c)
    CheckStmts(c, s.body)
    Pop(c)
    return 0
  }
  Err(c, strptr("bad_op"), strlen("bad_op"), strptr("stmt"), strlen("stmt"))
  return 0
}

func CheckFunc(c *Ch, fn *ovid/parse.Decl) i64 {
  c.nenv = 0
  c.nmark = 0
  c.fd = fn
  c.fnp = fn.namep
  c.fnn = fn.namen
  c.resp = fn.typp
  c.resn = fn.typn
  HereDecl(c, H_FUNC, c.pkg, fn, fn)
  Push(c)
  if ovid/parse.CountDecls(fn.sub) > 6 {
    Err(c, strptr("arity"), strlen("arity"), strptr("more than 6 params"), strlen("more than 6 params"))
  }
  var p *ovid/parse.Decl = fn.sub
  while p != 0 as *ovid/parse.Decl {
    HereDecl(c, H_PARAM, c.pkg, p, fn)
    Define(c, p.namep, p.namen, p.typp, p.typn)
    p = p.next
  }
  HereDecl(c, H_FUNC, c.pkg, fn, fn)
  CheckStmts(c, fn.body)
  if !Paths(fn.body) {
    HereDecl(c, H_FUNC, c.pkg, fn, fn)
    Err(c, strptr("missing_return"), strlen("missing_return"), c.fnp, c.fnn)
  }
  Pop(c)
  c.nfunc = c.nfunc + 1
  return 0
}

func CheckMain(c *Ch) i64 {
  var m *ovid/parse.Mod = c.mod
  var k *ovid/parse.Pkg = FindPkg(c, m.entryp, m.entryn)
  c.pathp = m.entryp
  c.pathn = m.entryn
  c.fnp = 0
  c.fnn = 0
  c.hk = H_NONE
  if k == 0 as *ovid/parse.Pkg {
    Err(c, strptr("no_entry"), strlen("no_entry"), strptr("entry package does not exist"), strlen("entry package does not exist"))
    return 0
  }
  var fn *ovid/parse.Decl = ovid/parse.FindDecl(k.fs, strptr("main"), strlen("main"))
  if fn != 0 as *ovid/parse.Decl {
    // A main that repeats an earlier name is reported and not checked.
    if fn.dup != 0 {
      fn = 0 as *ovid/parse.Decl
    }
  }
  if fn == 0 as *ovid/parse.Decl {
    // With no main, a handle is the entry: build writes the stdio host
    // around it (ovid/parse.ServeHost).
    var h *ovid/parse.Decl = ovid/parse.FindDecl(k.fs, strptr("handle"), strlen("handle"))
    if h != 0 as *ovid/parse.Decl {
      if h.dup != 0 {
        h = 0 as *ovid/parse.Decl
      }
    }
    if h == 0 as *ovid/parse.Decl {
      HereDecl(c, H_PKG, k, 0 as *ovid/parse.Decl, 0 as *ovid/parse.Decl)
      Err(c, strptr("bad_main"), strlen("bad_main"), strptr("entry package has no main"), strlen("entry package has no main"))
      return 0
    }
    if !HandleSig(h) {
      c.fnp = strptr("handle")
      c.fnn = strlen("handle")
      HereDecl(c, H_FUNC, k, h, h)
      Err(c, strptr("bad_handler"), strlen("bad_handler"), strptr("handle must be (io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64"), strlen("handle must be (io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64"))
    }
    return CheckAbi(c)
  }
  var ok bool = false
  var p *ovid/parse.Decl = fn.sub
  if ovid/parse.CountDecls(p) == 1 {
    if ovid/mem.Eq(p.typp, p.typn, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap")) {
      if ovid/mem.Eq(fn.typp, fn.typn, strptr("i64"), strlen("i64")) {
        ok = true
      }
    }
  }
  if !ok {
    c.fnp = strptr("main")
    c.fnn = strlen("main")
    HereDecl(c, H_FUNC, k, fn, fn)
    Err(c, strptr("bad_main"), strlen("bad_main"), strptr("main must be (io *ovid/io.Cap) i64"), strlen("main must be (io *ovid/io.Cap) i64"))
  }
  return CheckAbi(c)
}

// HandleSig reports whether fn is
// func handle(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64.
func HandleSig(fn *ovid/parse.Decl) bool {
  var p *ovid/parse.Decl = fn.sub
  if ovid/parse.CountDecls(p) != 3 || !ovid/mem.Eq(fn.typp, fn.typn, strptr("i64"), 3) {
    return false
  }
  if !ovid/mem.Eq(p.typp, p.typn, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap")) {
    return false
  }
  p = p.next
  if !ovid/mem.Eq(p.typp, p.typn, strptr("*ovid/http.Request"), strlen("*ovid/http.Request")) {
    return false
  }
  p = p.next
  return ovid/mem.Eq(p.typp, p.typn, strptr("*ovid/http.Response"), strlen("*ovid/http.Response"))
}

// Opaque reports whether the type is a pointer to one of ovid/io's types
// seen from outside ovid/io. Those types are handles on what the program
// may do, and a handle is only worth something if it cannot be forged or
// taken apart: so outside ovid/io one cannot be made by a cast or turned
// into an address by one, and its fields cannot be read or written.
func Opaque(c *Ch, tp i64, tn i64) bool {
  if tn < strlen("*ovid/io.") || !ovid/mem.Eq(tp, strlen("*ovid/io."), strptr("*ovid/io."), strlen("*ovid/io.")) {
    return false
  }
  return !ovid/mem.Eq(c.pathp, c.pathn, strptr("ovid/io"), strlen("ovid/io")) || c.pkg.std == 0
}

// CheckAbi checks that ovid/io.Cap starts with the five fields the runtime
// fills before main: argc, argv, heap, used, size, all i64.
func CheckAbi(c *Ch) i64 {
  c.fnp = 0
  c.fnn = 0
  c.hk = H_NONE
  var k *ovid/parse.Pkg = FindPkg(c, strptr("ovid/io"), strlen("ovid/io"))
  if k == 0 as *ovid/parse.Pkg {
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("missing package ovid/io"), strlen("missing package ovid/io"))
    return 0
  }
  var t *ovid/parse.Decl = ovid/parse.FindDecl(k.ts, strptr("Cap"), strlen("Cap"))
  if t == 0 as *ovid/parse.Decl {
    HereDecl(c, H_PKG, k, 0 as *ovid/parse.Decl, 0 as *ovid/parse.Decl)
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("ovid/io has no type Cap"), strlen("ovid/io has no type Cap"))
    return 0
  }
  // The names are four bytes each, five bytes apart.
  var names i64 = strptr("argc argv heap used size")
  var f *ovid/parse.Decl = t.sub
  var ok bool = true
  var i i64 = 0
  while i < 5 {
    if f == 0 as *ovid/parse.Decl {
      ok = false
    } else {
      if !ovid/mem.Eq(f.namep, f.namen, names + (i * 5), 4) {
        ok = false
      }
      if !ovid/mem.Eq(f.typp, f.typn, strptr("i64"), strlen("i64")) {
        ok = false
      }
      f = f.next
    }
    i = i + 1
  }
  if !ok {
    HereDecl(c, H_TYPE, k, t, 0 as *ovid/parse.Decl)
    Err(c, strptr("bad_abi"), strlen("bad_abi"), strptr("the runtime fills Cap's first five fields: argc, argv, heap, used, size (all i64, in order)"), strlen("the runtime fills Cap's first five fields: argc, argv, heap, used, size (all i64, in order)"))
  }
  return 0
}

// CountIds is the number of decl ids Run claims: packages, imports, types
// and their fields, consts, funcs and their params.
func CountIds(m *ovid/parse.Mod) i64 {
  var n i64 = 0
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    n = ((n + 1) + ovid/parse.CountDecls(k.ims)) + ovid/parse.CountDecls(k.cs)
    var d *ovid/parse.Decl = k.ts
    while d != 0 as *ovid/parse.Decl {
      n = (n + 1) + ovid/parse.CountDecls(d.sub)
      d = d.next
    }
    d = k.fs
    while d != 0 as *ovid/parse.Decl {
      n = (n + 1) + ovid/parse.CountDecls(d.sub)
      d = d.next
    }
    k = k.next
  }
  return n
}

// A second decl of a name in a package gets one duplicate_name error, at
// that decl, and nothing else about it is checked: not a repeated type's
// fields, nor a repeated func's params, result, or body.

// Before reports whether e is a decl that comes before d in the source: in
// a file of the package that sorts earlier, or earlier in the same file.
func Before(e *ovid/parse.Decl, d *ovid/parse.Decl) bool {
  if e == 0 as *ovid/parse.Decl {
    return false
  }
  var ef *ovid/parse.File = e.file
  var df *ovid/parse.File = d.file
  if ef == df {
    return e.off < d.off
  }
  return ovid/parse.Cmp(ef.relp, ef.reln, df.relp, df.reln) < 0
}

// Taken claims the id of the const, type, or func d, which the checker is
// at, and reports whether d repeats a name: an earlier decl of its kind has
// its id, or a decl of the same name in a or b, the package's lists of the
// other two kinds, comes before it.
func Taken(c *Ch, d *ovid/parse.Decl, a *ovid/parse.Decl, b *ovid/parse.Decl) bool {
  if Claim(c) != 0 {
    return true
  }
  if Before(ovid/parse.FindDecl(a, d.namep, d.namen), d) {
    return true
  }
  return Before(ovid/parse.FindDecl(b, d.namep, d.namen), d)
}

// Consts claims the ids of package k's consts.
func Consts(c *Ch, k *ovid/parse.Pkg) i64 {
  var d *ovid/parse.Decl = k.cs
  while d != 0 as *ovid/parse.Decl {
    HereDecl(c, H_CONST, k, d, 0 as *ovid/parse.Decl)
    if Taken(c, d, k.ts, k.fs) {
      Err(c, strptr("duplicate_name"), strlen("duplicate_name"), d.namep, d.namen)
    }
    d = d.next
  }
  return 0
}

// Types claims the ids of package k's types and their fields, and checks
// each type's name against the consts and each field's type.
func Types(c *Ch, k *ovid/parse.Pkg) i64 {
  var t *ovid/parse.Decl = k.ts
  while t != 0 as *ovid/parse.Decl {
    HereDecl(c, H_TYPE, k, t, 0 as *ovid/parse.Decl)
    if Taken(c, t, k.cs, k.fs) {
      Err(c, strptr("duplicate_name"), strlen("duplicate_name"), t.namep, t.namen)
    } else {
      var f *ovid/parse.Decl = t.sub
      while f != 0 as *ovid/parse.Decl {
        HereDecl(c, H_FIELD, k, f, t)
        if Claim(c) != 0 {
          Err(c, strptr("duplicate_name"), strlen("duplicate_name"), f.namep, f.namen)
        } else {
          DeclTy(c, f)
        }
        f = f.next
      }
    }
    t = t.next
  }
  return 0
}

// Funcs claims the ids of package k's funcs and their params, and checks
// each func's name against the consts and types and its param and result
// types. A repeated param is reported by CheckFunc.
func Funcs(c *Ch, k *ovid/parse.Pkg) i64 {
  var fn *ovid/parse.Decl = k.fs
  while fn != 0 as *ovid/parse.Decl {
    HereDecl(c, H_FUNC, k, fn, fn)
    if Taken(c, fn, k.cs, k.ts) {
      Err(c, strptr("duplicate_name"), strlen("duplicate_name"), fn.namep, fn.namen)
      fn.dup = 1
    } else {
      var pa *ovid/parse.Decl = fn.sub
      while pa != 0 as *ovid/parse.Decl {
        HereDecl(c, H_PARAM, k, pa, fn)
        Claim(c)
        DeclTy(c, pa)
        pa = pa.next
      }
      HereDecl(c, H_FUNC, k, fn, fn)
      DeclTy(c, fn)
    }
    fn = fn.next
  }
  return 0
}

// Less reports whether the bytes at a sort before those at b, as Go
// compares strings.
func Less(ap i64, an i64, bp i64, bn i64) bool {
  var i i64 = 0
  while i < an && i < bn {
    var x i64 = load8(ap + i)
    var y i64 = load8(bp + i)
    if x != y {
      return x < y
    }
    i = i + 1
  }
  return an < bn
}

// Walk carries CheckCycle's search into package k, pushing it on c.cpath:
// true when an import of k leads back to c.croot through packages whose
// paths sort after the root's, with c.cpath then holding the cycle.
func Walk(c *Ch, k *ovid/parse.Pkg) bool {
  if k.mark == c.cep {
    return false
  }
  k.mark = c.cep
  store64(c.cpath + (c.cn * 8), k as i64)
  c.cn = c.cn + 1
  var r *ovid/parse.Pkg = c.croot
  var im *ovid/parse.Decl = k.ims
  while im != 0 as *ovid/parse.Decl {
    if ovid/mem.Eq(im.namep, im.namen, r.pathp, r.pathn) {
      store64(c.cpath + (c.cn * 8), r as i64)
      c.cn = c.cn + 1
      return true
    }
    if Less(r.pathp, r.pathn, im.namep, im.namen) {
      var t *ovid/parse.Pkg = FindPkg(c, im.namep, im.namen)
      if Keep(c, t) {
        if Walk(c, t) {
          return true
        }
      }
    }
    im = im.next
  }
  c.cn = c.cn - 1
  return false
}

// Keep says whether CheckCycle's walk may enter package t: one that
// exists and, unless the root is a repeated package's later copy, is in
// the root's component.
func Keep(c *Ch, t *ovid/parse.Pkg) bool {
  if t == 0 as *ovid/parse.Pkg {
    return false
  }
  return c.cscc == 0 || t.scc == c.cscc
}

// Sccs numbers the strongly connected components of the import graph
// (imports of unknown packages dropped) in k.scc, from 1, with Tarjan's
// algorithm, iteratively so a long import chain cannot exhaust the stack.
// It stores each component's size in c.csize. A package is on Tarjan's
// stack while it is visited (ord != 0) and has no component yet.
func Sccs(c *Ch, npkg i64) i64 {
  var io *ovid/io.Cap = c.io
  c.csize = ovid/io.Alloc(io, (npkg + 1) * 8)
  var stack i64 = ovid/io.Alloc(io, (npkg + 1) * 8)
  var sn i64 = 0
  // A call frame is the package and the next of its imports to follow.
  var call i64 = ovid/io.Alloc(io, (npkg + 1) * 16)
  var cn i64 = 0
  var visited i64 = 0
  var ncomp i64 = 0
  var s *ovid/parse.Pkg = c.mod.pkgs
  while s != 0 as *ovid/parse.Pkg {
    var v *ovid/parse.Pkg = s
    if v.ord == 0 {
      visited = visited + 1
      v.ord = visited
      v.low = visited
      store64(stack + (sn * 8), v as i64)
      sn = sn + 1
      store64(call, v as i64)
      store64(call + 8, v.ims as i64)
      cn = 1
    }
    while cn > 0 {
      var f i64 = call + ((cn - 1) * 16)
      v = load64(f) as *ovid/parse.Pkg
      var im *ovid/parse.Decl = load64(f + 8) as *ovid/parse.Decl
      if im != 0 as *ovid/parse.Decl {
        store64(f + 8, im.next as i64)
        var w *ovid/parse.Pkg = FindPkg(c, im.namep, im.namen)
        if w != 0 as *ovid/parse.Pkg {
          if w.ord == 0 {
            visited = visited + 1
            w.ord = visited
            w.low = visited
            store64(stack + (sn * 8), w as i64)
            sn = sn + 1
            store64(call + (cn * 16), w as i64)
            store64(call + (cn * 16) + 8, w.ims as i64)
            cn = cn + 1
          } else if w.scc == 0 && w.ord < v.low {
            v.low = w.ord
          }
        }
      } else {
        cn = cn - 1
        if cn > 0 {
          var u *ovid/parse.Pkg = load64(call + ((cn - 1) * 16)) as *ovid/parse.Pkg
          if v.low < u.low {
            u.low = v.low
          }
        }
        if v.low == v.ord {
          ncomp = ncomp + 1
          var cnt i64 = 0
          var more bool = true
          while more {
            sn = sn - 1
            var x *ovid/parse.Pkg = load64(stack + (sn * 8)) as *ovid/parse.Pkg
            x.scc = ncomp
            cnt = cnt + 1
            more = x != v
          }
          store64(c.csize + (ncomp * 8), cnt)
        }
      }
    }
    s = s.next
  }
  return ncomp
}

// CheckCycle reports import_cycle once for each cycle whose lexically
// least package is r: at the first import of r, in source order, that
// leads back to r through packages whose paths sort after it. The search
// walks imports in source order, so it finds the same cycle path whatever
// order the packages were loaded in. Packages must form a DAG, so that
// each can be checked and compiled once its imports are.
//
// The walk costs up to the whole graph per root, so it runs only where it
// can report: a cycle lies entirely within one strongly connected
// component of the import graph (Sccs), so a root alone in its component
// (a self-import is import_self's, not a cycle) reports nothing, and the
// walk never needs a package outside the root's component. A package the
// walk could enter from the root that is outside the component cannot
// reach the root, nor, since everything that reaches the root's component
// reaches the root, any package in it: walking into it only marks
// packages the walk never needs, so skipping it changes neither whether
// the walk returns true nor the path it finds. A valid module so costs
// time linear in its packages and imports. The graph's nodes are the
// packages FindPkg returns; a repeated package's later copies are roots
// only, walked unpruned.
func CheckCycle(c *Ch, r *ovid/parse.Pkg) i64 {
  c.cscc = 0
  if FindPkg(c, r.pathp, r.pathn) == r {
    if load64(c.csize + (r.scc * 8)) == 1 {
      return 0
    }
    c.cscc = r.scc
  }
  c.croot = r
  c.cep = c.cep + 1
  var im *ovid/parse.Decl = r.ims
  while im != 0 as *ovid/parse.Decl {
    var t *ovid/parse.Pkg = 0 as *ovid/parse.Pkg
    if Less(r.pathp, r.pathn, im.namep, im.namen) {
      t = FindPkg(c, im.namep, im.namen)
    }
    if Keep(c, t) {
      store64(c.cpath, r as i64)
      c.cn = 1
      if Walk(c, t) {
        var mb *ovid/mem.Buf = ovid/mem.New(c.io, 64)
        ovid/mem.WBytes(c.io, mb, strptr("import cycle: "), strlen("import cycle: "))
        var i i64 = 0
        while i < c.cn {
          var k *ovid/parse.Pkg = load64(c.cpath + (i * 8)) as *ovid/parse.Pkg
          if i != 0 {
            ovid/mem.WBytes(c.io, mb, strptr(" -> "), 4)
          }
          ovid/mem.WBytes(c.io, mb, k.pathp, k.pathn)
          i = i + 1
        }
        HereDecl(c, H_IMPORT, r, im, im)
        c.pathp = r.pathp
        c.pathn = r.pathn
        Err(c, strptr("import_cycle"), strlen("import_cycle"), mb.data, mb.len)
        c.pathn = 0
        return 1
      }
    }
    im = im.next
  }
  return 0
}

// Run type-checks the loaded module m, prints its error lines, and returns
// the error count. For check (build false) it then prints the summary; for
// build it prints {"ok":false,"errors":N} only when there are errors, since
// the build receipt follows otherwise.
func Run(io *ovid/io.Cap, m *ovid/parse.Mod, build bool) i64 {
  var c *Ch = ovid/io.Alloc(io, sizeof(Ch)) as *Ch
  c.io = io
  c.mod = m
  c.b = ovid/mem.New(io, 4096)
  c.ib = ovid/mem.New(io, 256)
  c.env = ovid/io.Alloc(io, 4096 * 32)
  c.mark = ovid/io.Alloc(io, 256 * 8)
  var sz i64 = 1024
  while sz < (CountIds(m) * 2) {
    sz = sz * 2
  }
  c.tabmask = sz - 1
  c.tab = ovid/io.Alloc(io, sz * 16)
  IndexPkgs(c)
  if m.namen == 0 {
    Err(c, strptr("bad_module"), strlen("bad_module"), strptr("ovid.mod has no module line"), strlen("ovid.mod has no module line"))
  }
  var npkg i64 = 0
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    npkg = npkg + 1
    HereDecl(c, H_PKG, k, 0 as *ovid/parse.Decl, 0 as *ovid/parse.Decl)
    if Claim(c) != 0 {
      Err(c, strptr("duplicate_id"), strlen("duplicate_id"), c.ib.data, c.ib.len)
    }
    var im *ovid/parse.Decl = k.ims
    while im != 0 as *ovid/parse.Decl {
      HereDecl(c, H_IMPORT, k, im, im)
      c.pathp = k.pathp
      c.pathn = k.pathn
      if Claim(c) != 0 {
        Err(c, strptr("duplicate_name"), strlen("duplicate_name"), im.namep, im.namen)
      } else if ovid/mem.Eq(im.namep, im.namen, k.pathp, k.pathn) {
        Err(c, strptr("import_self"), strlen("import_self"), im.namep, im.namen)
      } else if FindPkg(c, im.namep, im.namen) == 0 as *ovid/parse.Pkg {
        Err(c, strptr("unknown_package"), strlen("unknown_package"), im.namep, im.namen)
      }
      im = im.next
    }
    c.pathp = k.pathp
    c.pathn = k.pathn
    Consts(c, k)
    Types(c, k)
    Funcs(c, k)
    c.pathn = 0
    k = k.next
  }
  c.cpath = ovid/io.Alloc(io, (npkg + 1) * 8)
  Sccs(c, npkg)
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    CheckCycle(c, k)
    k = k.next
  }
  CheckMain(c)
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    c.pkg = k
    c.pathp = k.pathp
    c.pathn = k.pathn
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      if f.dup == 0 {
        CheckFunc(c, f)
      }
      f = f.next
    }
    k = k.next
  }
  if build {
    if c.errs != 0 {
      WLit(c, strptr("{\"ok\":false,\"errors\":"), strlen("{\"ok\":false,\"errors\":"))
      WNum(c, c.errs)
      ovid/mem.WByte(c.io, c.b, 125)
      Line(c)
    }
    return c.errs
  }
  WLit(c, strptr("{\"fact\":\"summary\",\"ok\":"), strlen("{\"fact\":\"summary\",\"ok\":"))
  if c.errs == 0 {
    WLit(c, strptr("true"), strlen("true"))
  } else {
    WLit(c, strptr("false"), strlen("false"))
  }
  WLit(c, strptr(",\"errors\":"), strlen(",\"errors\":"))
  WNum(c, c.errs)
  WLit(c, strptr(",\"packages\":"), strlen(",\"packages\":"))
  WNum(c, npkg)
  WLit(c, strptr(",\"funcs\":"), strlen(",\"funcs\":"))
  WNum(c, c.nfunc)
  WLit(c, strptr(",\"revision\":\""), strlen(",\"revision\":\""))
  ovid/mem.WBytes(c.io, c.b, ovid/parse.Revision(m), 16)
  ovid/mem.WByte(c.io, c.b, 34)
  ovid/mem.WByte(c.io, c.b, 125)
  Line(c)
  return c.errs
}
