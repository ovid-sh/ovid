package ovid/json

import ovid/io
import ovid/mem

type Doc struct {
  data i64
  n i64
  pos i64
  err i64
}

func Skip(d *Doc) i64 {
  while d.pos < d.n {
    var c i64 = load8(d.data + d.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      d.pos = d.pos + 1
    } else {
      return 0
    }
  }
  return 0
}

func Peek(d *Doc) i64 {
  Skip(d)
  if d.pos >= d.n {
    return -1
  }
  return load8(d.data + d.pos)
}

func Bump(d *Doc) i64 {
  var c i64 = load8(d.data + d.pos)
  d.pos = d.pos + 1
  return c
}

func NewVal(io *ovid/io.Cap, kind i64, src i64) i64 {
  var v i64 = ovid/io.Alloc(io, 80)
  if v == 0 {
    return 0
  }
  store64(v + 0, kind)
  store64(v + 8, 0)
  store64(v + 16, 0)
  store64(v + 24, 0)
  store64(v + 32, 0)
  store64(v + 40, 0)
  store64(v + 48, 0)
  store64(v + 56, src)
  store64(v + 64, 0)
  return v
}

func EndVal(v i64, d *Doc) i64 {
  store64(v + 64, d.pos - load64(v + 56))
  return 0
}

func Kind(v i64) i64 {
  return load64(v + 0)
}

func Int(v i64) i64 {
  return load64(v + 8)
}

func StrP(v i64) i64 {
  return load64(v + 16)
}

func StrN(v i64) i64 {
  return load64(v + 24)
}

func Src(v i64) i64 {
  return load64(v + 56)
}

func SrcN(v i64) i64 {
  return load64(v + 64)
}

func Child(v i64) i64 {
  return load64(v + 16)
}

func Next(v i64) i64 {
  return load64(v + 32)
}

func Count(v i64) i64 {
  return load64(v + 24)
}

func Fail(d *Doc) i64 {
  d.err = 1
  return 0
}

func Lit(d *Doc, p i64, n i64) bool {
  var i i64 = 0
  while i < n {
    if d.pos >= d.n {
      return false
    }
    if load8(d.data + d.pos) != load8(p + i) {
      return false
    }
    d.pos = d.pos + 1
    i = i + 1
  }
  return true
}

func HexVal(c i64) i64 {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return (c - 97) + 10
  }
  if c >= 65 && c <= 70 {
    return (c - 65) + 10
  }
  return -1
}

func PushB(io *ovid/io.Cap, meta i64, c i64) i64 {
  var buf i64 = load64(meta + 0)
  var n i64 = load64(meta + 8)
  var cap i64 = load64(meta + 16)
  if (n + 1) >= cap {
    var nc i64 = cap * 2
    var nb i64 = ovid/io.Alloc(io, nc)
    if nb == 0 {
      return -1
    }
    ovid/mem.Copy(nb, buf, n)
    buf = nb
    cap = nc
    store64(meta + 0, buf)
    store64(meta + 16, cap)
  }
  store8(buf + n, c)
  store64(meta + 8, n + 1)
  return 0
}

func PushCP(io *ovid/io.Cap, meta i64, cp i64) i64 {
  if cp < 128 {
    return PushB(io, meta, cp)
  }
  if cp >= 0xD800 && cp <= 0xDFFF {
    return PushB(io, meta, 63)
  }
  if cp < 2048 {
    if PushB(io, meta, 192 + (cp >> 6)) != 0 {
      return -1
    }
    return PushB(io, meta, 128 + (cp & 63))
  }
  if PushB(io, meta, 224 + (cp >> 12)) != 0 {
    return -1
  }
  if PushB(io, meta, 128 + ((cp >> 6) & 63)) != 0 {
    return -1
  }
  return PushB(io, meta, 128 + (cp & 63))
}

func ParseString(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  if Bump(d) != 34 {
    return Fail(d)
  }
  var meta i64 = ovid/io.Alloc(io, 24)
  var buf i64 = ovid/io.Alloc(io, 16)
  if meta == 0 || buf == 0 {
    return Fail(d)
  }
  store64(meta + 0, buf)
  store64(meta + 8, 0)
  store64(meta + 16, 16)
  while d.pos < d.n {
    var c i64 = Bump(d)
    if c == 34 {
      var v i64 = NewVal(io, 3, src)
      if v == 0 {
        return Fail(d)
      }
      store64(v + 16, load64(meta + 0))
      store64(v + 24, load64(meta + 8))
      EndVal(v, d)
      return v
    }
    if c == 92 {
      if d.pos >= d.n {
        return Fail(d)
      }
      var e i64 = Bump(d)
      if e == 117 {
        var cp i64 = 0
        var k i64 = 0
        while k < 4 {
          if d.pos >= d.n {
            return Fail(d)
          }
          var hv i64 = HexVal(Bump(d))
          if hv < 0 {
            return Fail(d)
          }
          cp = (cp * 16) + hv
          k = k + 1
        }
        if PushCP(io, meta, cp) != 0 {
          return Fail(d)
        }
      } else {
        var bit i64 = -1
        if e == 110 {
          bit = 10
        }
        if e == 116 {
          bit = 9
        }
        if e == 114 {
          bit = 13
        }
        if e == 98 {
          bit = 8
        }
        if e == 102 {
          bit = 12
        }
        if e == 34 || e == 92 || e == 47 {
          bit = e
        }
        if bit < 0 {
          return Fail(d)
        }
        if PushB(io, meta, bit) != 0 {
          return Fail(d)
        }
      }
    } else {
      if PushB(io, meta, c) != 0 {
        return Fail(d)
      }
    }
  }
  return Fail(d)
}

func ParseNum(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  var neg bool = false
  if Peek(d) == 45 {
    neg = true
    Bump(d)
  }
  if Peek(d) < 48 || Peek(d) > 57 {
    return Fail(d)
  }
  var val i64 = 0
  while Peek(d) >= 48 && Peek(d) <= 57 {
    val = (val * 10) + (Bump(d) - 48)
  }
  if neg {
    val = 0 - val
  }
  var v i64 = NewVal(io, 2, src)
  store64(v + 8, val)
  EndVal(v, d)
  return v
}

func ParseValue(io *ovid/io.Cap, d *Doc) i64 {
  var c i64 = Peek(d)
  if c < 0 {
    return Fail(d)
  }
  var src i64 = d.pos
  if c == 110 {
    if !Lit(d, strptr("null"), strlen("null")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 0, src)
    EndVal(v, d)
    return v
  }
  if c == 116 {
    if !Lit(d, strptr("true"), strlen("true")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 1, src)
    store64(v + 8, 1)
    EndVal(v, d)
    return v
  }
  if c == 102 {
    if !Lit(d, strptr("false"), strlen("false")) {
      return Fail(d)
    }
    var v i64 = NewVal(io, 1, src)
    store64(v + 8, 0)
    EndVal(v, d)
    return v
  }
  if c == 34 {
    return ParseString(io, d)
  }
  if c == 45 || (c >= 48 && c <= 57) {
    return ParseNum(io, d)
  }
  if c == 91 {
    return ParseArr(io, d)
  }
  if c == 123 {
    return ParseObj(io, d)
  }
  return Fail(d)
}

func AddChild(parent i64, prev i64, child i64, count i64) i64 {
  store64(child + 32, 0)
  if prev == 0 {
    store64(parent + 16, child)
  } else {
    store64(prev + 32, child)
  }
  store64(parent + 24, count)
  return child
}

func ParseArr(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  Bump(d)
  var v i64 = NewVal(io, 4, src)
  var prev i64 = 0
  var count i64 = 0
  if Peek(d) == 93 {
    Bump(d)
    EndVal(v, d)
    return v
  }
  while true {
    var child i64 = ParseValue(io, d)
    if child == 0 {
      return Fail(d)
    }
    count = count + 1
    prev = AddChild(v, prev, child, count)
    var p i64 = Peek(d)
    if p == 93 {
      Bump(d)
      EndVal(v, d)
      return v
    }
    if p != 44 {
      return Fail(d)
    }
    Bump(d)
  }
  return Fail(d)
}

func ParseObj(io *ovid/io.Cap, d *Doc) i64 {
  var src i64 = d.pos
  Bump(d)
  var v i64 = NewVal(io, 5, src)
  var prev i64 = 0
  var count i64 = 0
  if Peek(d) == 125 {
    Bump(d)
    EndVal(v, d)
    return v
  }
  while true {
    if Peek(d) != 34 {
      return Fail(d)
    }
    var key i64 = ParseString(io, d)
    if key == 0 {
      return Fail(d)
    }
    if Peek(d) != 58 {
      return Fail(d)
    }
    Bump(d)
    var child i64 = ParseValue(io, d)
    if child == 0 {
      return Fail(d)
    }
    store64(child + 40, StrP(key))
    store64(child + 48, StrN(key))
    count = count + 1
    prev = AddChild(v, prev, child, count)
    var p i64 = Peek(d)
    if p == 125 {
      Bump(d)
      EndVal(v, d)
      return v
    }
    if p != 44 {
      return Fail(d)
    }
    Bump(d)
  }
  return Fail(d)
}

func Parse(io *ovid/io.Cap, data i64, n i64) i64 {
  var raw i64 = ovid/io.Alloc(io, 32)
  var d *Doc = raw as *Doc
  d.data = data
  d.n = n
  d.pos = 0
  d.err = 0
  var v i64 = ParseValue(io, d)
  if v == 0 || d.err != 0 {
    return 0
  }
  return v
}

func Get(obj i64, key i64, kn i64) i64 {
  if obj == 0 {
    return 0
  }
  if Kind(obj) != 5 {
    return 0
  }
  var c i64 = Child(obj)
  while c != 0 {
    if ovid/mem.Eq(load64(c + 40), load64(c + 48), key, kn) {
      return c
    }
    c = Next(c)
  }
  return 0
}

func GetLit(obj i64, lit i64, n i64) i64 {
  return Get(obj, lit, n)
}

func At(arr i64, i i64) i64 {
  if arr == 0 {
    return 0
  }
  var c i64 = Child(arr)
  var k i64 = 0
  while c != 0 {
    if k == i {
      return c
    }
    k = k + 1
    c = Next(c)
  }
  return 0
}

func IsLit(v i64, lit i64, n i64) bool {
  if v == 0 {
    return false
  }
  if Kind(v) != 3 {
    return false
  }
  return ovid/mem.Eq(StrP(v), StrN(v), lit, n)
}
