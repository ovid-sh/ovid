package ovid/json

import ovid/io
import ovid/mem
import ovid/test

func TestParse(io *ovid/io.Cap) i64 {
  var src i64 = strptr("{\"a\": [1, -23, \"x\\n\\u00e9\"], \"b\": true, \"c\": null}")
  var v i64 = Parse(io, src, strlen("{\"a\": [1, -23, \"x\\n\\u00e9\"], \"b\": true, \"c\": null}"))
  if !ovid/test.True(v != 0, strptr("the object did not parse")) {
    return 1
  }
  if !ovid/test.Eq(io, Kind(v), 5) || !ovid/test.Eq(io, Count(v), 3) {
    return 2
  }
  var a i64 = GetLit(v, strptr("a"), 1)
  if !ovid/test.Eq(io, Kind(a), 4) || !ovid/test.Eq(io, Count(a), 3) {
    return 3
  }
  if !ovid/test.Eq(io, Int(At(a, 0)), 1) || !ovid/test.Eq(io, Int(At(a, 1)), -23) {
    return 4
  }
  // Escapes are decoded: \n is one byte, é two bytes of UTF-8.
  var s i64 = At(a, 2)
  if !ovid/test.Eq(io, Kind(s), 3) || !ovid/mem.Eq(StrP(s), StrN(s), strptr("x\n\xc3\xa9"), 4) {
    return 5
  }
  if !ovid/test.Eq(io, Int(GetLit(v, strptr("b"), 1)), 1) || !ovid/test.Eq(io, Kind(GetLit(v, strptr("c"), 1)), 0) {
    return 6
  }
  if !ovid/test.Eq(io, GetLit(v, strptr("d"), 1), 0) {
    return 7
  }
  return 0
}

func TestMalformed(io *ovid/io.Cap) i64 {
  if !ovid/test.Eq(io, Parse(io, strptr("[1,"), 3), 0) {
    return 1
  }
  if !ovid/test.Eq(io, Parse(io, strptr("{\"a\" 1}"), 7), 0) {
    return 2
  }
  if !ovid/test.Eq(io, Parse(io, strptr("tru"), 3), 0) {
    return 3
  }
  return 0
}
