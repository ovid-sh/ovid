package ovid/cg

import ovid/io
import ovid/json
import ovid/mem
import ovid/asm
import ovid/elf

const HEAP i64 = 128 << 20
const MAXLOC i64 = 1024

// FNREC is the size of a func record: pkg, fn, name p/n, path p/n, label,
// nparam, live.
const FNREC i64 = 72

type C struct {
  io *ovid/io.Cap
  code *ovid/asm.Code
  root i64
  pkgs i64
  npkg i64
  fns i64
  nfn i64
  pathp i64
  pathn i64
  fn i64
  locs i64
  nloc i64
  localBytes i64
  cons i64
  ncon i64
  epi i64
  err i64
  peak i64
  typ i64
  tyn i64
}

func Zero(p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    store8(p + i, 0)
    i = i + 1
  }
  return 0
}

func Fail(c *C, code i64) i64 {
  if c.err == 0 {
    c.err = code
  }
  return c.err
}

func Max(a i64, b i64) i64 {
  if a > b {
    return a
  }
  return b
}

func SGet(obj i64, lit i64, n i64) i64 {
  if obj == 0 {
    return 0
  }
  return ovid/json.GetLit(obj, lit, n)
}

func JStrP(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrP(v)
}

func JStrN(v i64) i64 {
  if v == 0 {
    return 0
  }
  return ovid/json.StrN(v)
}

func Lit(op i64, s i64, n i64) bool {
  return ovid/json.IsLit(op, s, n)
}

func LeafOp(op i64) bool {
  if Lit(op, strptr("int"), strlen("int")) {
    return true
  }
  if Lit(op, strptr("sizeof"), strlen("sizeof")) {
    return true
  }
  if Lit(op, strptr("strptr"), strlen("strptr")) {
    return true
  }
  if Lit(op, strptr("strlen"), strlen("strlen")) {
    return true
  }
  return false
}

func ArithOp(op i64) bool {
  if Lit(op, strptr("add"), strlen("add")) {
    return true
  }
  if Lit(op, strptr("sub"), strlen("sub")) {
    return true
  }
  if Lit(op, strptr("mul"), strlen("mul")) {
    return true
  }
  if Lit(op, strptr("div"), strlen("div")) {
    return true
  }
  if Lit(op, strptr("mod"), strlen("mod")) {
    return true
  }
  if Lit(op, strptr("and"), strlen("and")) {
    return true
  }
  if Lit(op, strptr("or"), strlen("or")) {
    return true
  }
  if Lit(op, strptr("xor"), strlen("xor")) {
    return true
  }
  if Lit(op, strptr("shl"), strlen("shl")) {
    return true
  }
  if Lit(op, strptr("shr"), strlen("shr")) {
    return true
  }
  return false
}

func CmpOp(op i64) bool {
  if Lit(op, strptr("eq"), strlen("eq")) {
    return true
  }
  if Lit(op, strptr("ne"), strlen("ne")) {
    return true
  }
  if Lit(op, strptr("lt"), strlen("lt")) {
    return true
  }
  if Lit(op, strptr("le"), strlen("le")) {
    return true
  }
  if Lit(op, strptr("gt"), strlen("gt")) {
    return true
  }
  if Lit(op, strptr("ge"), strlen("ge")) {
    return true
  }
  return false
}

func UnaryOp(op i64) bool {
  if Lit(op, strptr("not"), strlen("not")) {
    return true
  }
  if Lit(op, strptr("neg"), strlen("neg")) {
    return true
  }
  if Lit(op, strptr("bnot"), strlen("bnot")) {
    return true
  }
  if Lit(op, strptr("cast"), strlen("cast")) {
    return true
  }
  if Lit(op, strptr("load8"), strlen("load8")) {
    return true
  }
  if Lit(op, strptr("load32"), strlen("load32")) {
    return true
  }
  if Lit(op, strptr("load64"), strlen("load64")) {
    return true
  }
  return false
}

func FindPkg(c *C, pp i64, pn i64) i64 {
  var i i64 = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    if Lit(path, pp, pn) {
      return pkg
    }
    i = i + 1
  }
  return 0
}

// PkgConst returns the const that name node n refers to in another
// package (n has "pkg" set), or 0.
func PkgConst(c *C, n i64) i64 {
  var pk i64 = SGet(n, strptr("pkg"), strlen("pkg"))
  if pk == 0 {
    return 0
  }
  var pkg i64 = FindPkg(c, JStrP(pk), JStrN(pk))
  if pkg == 0 {
    return 0
  }
  var arr i64 = SGet(pkg, strptr("consts"), strlen("consts"))
  if arr == 0 {
    return 0
  }
  var nm i64 = SGet(n, strptr("name"), strlen("name"))
  var k i64 = ovid/json.Child(arr)
  while k != 0 {
    if Lit(SGet(k, strptr("name"), strlen("name")), JStrP(nm), JStrN(nm)) {
      return k
    }
    k = ovid/json.Next(k)
  }
  return 0
}

func FindFnRec(c *C, pp i64, pn i64, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.nfn {
    var rec i64 = c.fns + (i * FNREC)
    if ovid/mem.Eq(load64(rec + 32), load64(rec + 40), pp, pn) {
      if ovid/mem.Eq(load64(rec + 16), load64(rec + 24), np, nn) {
        return rec
      }
    }
    i = i + 1
  }
  return 0
}

func AddFn(c *C, pkg i64, f i64, pp i64, pn i64) i64 {
  var nm i64 = SGet(f, strptr("name"), strlen("name"))
  var np i64 = JStrP(nm)
  var nn i64 = JStrN(nm)
  if FindFnRec(c, pp, pn, np, nn) != 0 {
    return Fail(c, 3)
  }
  var rec i64 = c.fns + (c.nfn * FNREC)
  store64(rec + 0, pkg)
  store64(rec + 8, f)
  store64(rec + 16, np)
  store64(rec + 24, nn)
  store64(rec + 32, pp)
  store64(rec + 40, pn)
  store64(rec + 48, ovid/asm.NewLabel(c.code))
  var params i64 = SGet(f, strptr("params"), strlen("params"))
  var nparam i64 = 0
  if params != 0 {
    nparam = ovid/json.Count(params)
  }
  store64(rec + 56, nparam)
  store64(rec + 64, 0)
  c.nfn = c.nfn + 1
  return 0
}

func IndexProg(c *C) i64 {
  var pkgs i64 = SGet(c.root, strptr("packages"), strlen("packages"))
  if pkgs == 0 {
    return Fail(c, 1)
  }
  c.npkg = ovid/json.Count(pkgs)
  if c.npkg <= 0 {
    return Fail(c, 1)
  }
  c.pkgs = ovid/io.Alloc(c.io, c.npkg * 8)
  c.locs = ovid/io.Alloc(c.io, MAXLOC * 40)
  c.cons = ovid/io.Alloc(c.io, MAXLOC * 24)
  var total i64 = 0
  var i i64 = 0
  var p i64 = ovid/json.Child(pkgs)
  while p != 0 {
    store64(c.pkgs + (i * 8), p)
    var fns i64 = SGet(p, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      total = total + ovid/json.Count(fns)
    }
    i = i + 1
    p = ovid/json.Next(p)
  }
  c.nfn = 0
  c.fns = ovid/io.Alloc(c.io, (total + 1) * FNREC)
  i = 0
  while i < c.npkg {
    var pkg i64 = load64(c.pkgs + (i * 8))
    var path i64 = SGet(pkg, strptr("path"), strlen("path"))
    var fns i64 = SGet(pkg, strptr("funcs"), strlen("funcs"))
    if fns != 0 {
      var f i64 = ovid/json.Child(fns)
      while f != 0 {
        if AddFn(c, pkg, f, JStrP(path), JStrN(path)) != 0 {
          return c.err
        }
        f = ovid/json.Next(f)
      }
    }
    i = i + 1
  }
  return 0
}

func FindLoc(c *C, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.nloc {
    var rec i64 = c.locs + (i * 40)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      return rec
    }
    i = i + 1
  }
  return 0
}

func AddLoc(c *C, np i64, nn i64, tp i64, tn i64) i64 {
  var rec i64 = FindLoc(c, np, nn)
  if rec != 0 {
    store64(rec + 24, tp)
    store64(rec + 32, tn)
    return 0
  }
  if c.nloc >= MAXLOC {
    return Fail(c, 6)
  }
  rec = c.locs + (c.nloc * 40)
  store64(rec + 0, np)
  store64(rec + 8, nn)
  store64(rec + 16, 0 - ((c.nloc + 1) * 8))
  store64(rec + 24, tp)
  store64(rec + 32, tn)
  c.nloc = c.nloc + 1
  return 0
}

func FindCon(c *C, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.ncon {
    var rec i64 = c.cons + (i * 24)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      return rec
    }
    i = i + 1
  }
  return 0
}

func LoadConsts(c *C, pkg i64) i64 {
  c.ncon = 0
  var arr i64 = SGet(pkg, strptr("consts"), strlen("consts"))
  if arr == 0 {
    return 0
  }
  var k i64 = ovid/json.Child(arr)
  while k != 0 {
    if c.ncon >= MAXLOC {
      return Fail(c, 6)
    }
    var rec i64 = c.cons + (c.ncon * 24)
    var nm i64 = SGet(k, strptr("name"), strlen("name"))
    var vl i64 = SGet(k, strptr("value"), strlen("value"))
    var iv i64 = 0
    if vl != 0 {
      iv = ovid/json.Int(vl)
    }
    store64(rec + 0, JStrP(nm))
    store64(rec + 8, JStrN(nm))
    store64(rec + 16, iv)
    c.ncon = c.ncon + 1
    k = ovid/json.Next(k)
  }
  return 0
}

func CollectParams(c *C, fn i64) i64 {
  var params i64 = SGet(fn, strptr("params"), strlen("params"))
  if params == 0 {
    return 0
  }
  var p i64 = ovid/json.Child(params)
  while p != 0 {
    var nm i64 = SGet(p, strptr("name"), strlen("name"))
    var ty i64 = SGet(p, strptr("type"), strlen("type"))
    AddLoc(c, JStrP(nm), JStrN(nm), JStrP(ty), JStrN(ty))
    p = ovid/json.Next(p)
  }
  return 0
}

func CollectStmts(c *C, arr i64) i64 {
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    CollectOne(c, s)
    s = ovid/json.Next(s)
  }
  return 0
}

func CollectOne(c *C, s i64) i64 {
  var op i64 = SGet(s, strptr("op"), strlen("op"))
  if Lit(op, strptr("var"), strlen("var")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var ty i64 = SGet(s, strptr("type"), strlen("type"))
    if nm != 0 {
      AddLoc(c, JStrP(nm), JStrN(nm), JStrP(ty), JStrN(ty))
    }
    return 0
  }
  if Lit(op, strptr("if"), strlen("if")) {
    CollectStmts(c, SGet(s, strptr("then"), strlen("then")))
    CollectStmts(c, SGet(s, strptr("else"), strlen("else")))
    return 0
  }
  if Lit(op, strptr("while"), strlen("while")) {
    CollectStmts(c, SGet(s, strptr("body"), strlen("body")))
    return 0
  }
  return 0
}

func CallPeak(n i64, lv i64) i64 {
  var m i64 = -1
  var args i64 = SGet(n, strptr("args"), strlen("args"))
  if args == 0 {
    return m
  }
  var i i64 = 0
  var a i64 = ovid/json.Child(args)
  while a != 0 {
    var p i64 = ExprPeak(a, lv + i)
    m = Max(m, Max(p, lv + i))
    i = i + 1
    a = ovid/json.Next(a)
  }
  return m
}

func ExprPeak(n i64, lv i64) i64 {
  if n == 0 {
    return -1
  }
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if LeafOp(op) {
    return -1
  }
  if Lit(op, strptr("bool"), strlen("bool")) {
    return -1
  }
  if Lit(op, strptr("name"), strlen("name")) {
    return -1
  }
  if ArithOp(op) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv + 1)
    return Max(l, Max(r, lv))
  }
  if CmpOp(op) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv + 1)
    return Max(l, Max(r, lv))
  }
  if Lit(op, strptr("land"), strlen("land")) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv)
    return Max(l, r)
  }
  if Lit(op, strptr("lor"), strlen("lor")) {
    var l i64 = ExprPeak(SGet(n, strptr("left"), strlen("left")), lv)
    var r i64 = ExprPeak(SGet(n, strptr("right"), strlen("right")), lv)
    return Max(l, r)
  }
  if UnaryOp(op) {
    return ExprPeak(SGet(n, strptr("arg"), strlen("arg")), lv)
  }
  if Lit(op, strptr("field"), strlen("field")) {
    return ExprPeak(SGet(n, strptr("base"), strlen("base")), lv)
  }
  if Lit(op, strptr("call"), strlen("call")) {
    return CallPeak(n, lv)
  }
  if Lit(op, strptr("syscall"), strlen("syscall")) {
    return CallPeak(n, lv)
  }
  return lv
}

func StmtsPeak(arr i64) i64 {
  if arr == 0 {
    return -1
  }
  var m i64 = -1
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    m = Max(m, StmtPeak(s))
    s = ovid/json.Next(s)
  }
  return m
}

func StmtPeak(s i64) i64 {
  if s == 0 {
    return -1
  }
  var op i64 = SGet(s, strptr("op"), strlen("op"))
  if Lit(op, strptr("var"), strlen("var")) {
    return ExprPeak(SGet(s, strptr("val"), strlen("val")), 0)
  }
  if Lit(op, strptr("assign"), strlen("assign")) {
    return ExprPeak(SGet(s, strptr("val"), strlen("val")), 0)
  }
  if Lit(op, strptr("expr"), strlen("expr")) {
    return ExprPeak(SGet(s, strptr("val"), strlen("val")), 0)
  }
  if Lit(op, strptr("return"), strlen("return")) {
    return ExprPeak(SGet(s, strptr("val"), strlen("val")), 0)
  }
  if Lit(op, strptr("setfield"), strlen("setfield")) {
    var b i64 = ExprPeak(SGet(s, strptr("base"), strlen("base")), 0)
    var v i64 = ExprPeak(SGet(s, strptr("val"), strlen("val")), 1)
    return Max(b, Max(v, 1))
  }
  if Lit(op, strptr("store8"), strlen("store8")) {
    var b i64 = ExprPeak(SGet(s, strptr("addr"), strlen("addr")), 0)
    var v i64 = ExprPeak(SGet(s, strptr("val"), strlen("val")), 1)
    return Max(b, Max(v, 1))
  }
  if Lit(op, strptr("store64"), strlen("store64")) {
    var b i64 = ExprPeak(SGet(s, strptr("addr"), strlen("addr")), 0)
    var v i64 = ExprPeak(SGet(s, strptr("val"), strlen("val")), 1)
    return Max(b, Max(v, 1))
  }
  if Lit(op, strptr("if"), strlen("if")) {
    var m i64 = ExprPeak(SGet(s, strptr("cond"), strlen("cond")), 0)
    m = Max(m, StmtsPeak(SGet(s, strptr("then"), strlen("then"))))
    m = Max(m, StmtsPeak(SGet(s, strptr("else"), strlen("else"))))
    return m
  }
  if Lit(op, strptr("while"), strlen("while")) {
    var cnd i64 = ExprPeak(SGet(s, strptr("cond"), strlen("cond")), 0)
    return Max(cnd, StmtsPeak(SGet(s, strptr("body"), strlen("body"))))
  }
  return -1
}

func SetI64(c *C) i64 {
  c.typ = strptr("i64")
  c.tyn = strlen("i64")
  return 0
}

func SetBool(c *C) i64 {
  c.typ = strptr("bool")
  c.tyn = strlen("bool")
  return 0
}

// SizeOf is the byte size of struct type pkg.T (tp/tn): 8 per field.
func SizeOf(c *C, tp i64, tn i64) i64 {
  var dot i64 = -1
  var i i64 = 0
  while i < tn {
    if load8(tp + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    Fail(c, 4)
    return -1
  }
  var pkg i64 = FindPkg(c, tp, dot)
  if pkg == 0 {
    Fail(c, 4)
    return -1
  }
  var types i64 = SGet(pkg, strptr("types"), strlen("types"))
  var t i64 = 0
  if types != 0 {
    t = ovid/json.Child(types)
  }
  while t != 0 {
    var nm i64 = SGet(t, strptr("name"), strlen("name"))
    if Lit(nm, (tp + dot) + 1, (tn - dot) - 1) {
      var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
      if fields == 0 {
        return 0
      }
      return ovid/json.Count(fields) * 8
    }
    t = ovid/json.Next(t)
  }
  Fail(c, 4)
  return -1
}

func OffsetOf(c *C, tp i64, tn i64, fp i64, fnn i64) i64 {
  if tn < 2 {
    Fail(c, 4)
    return -1
  }
  if load8(tp) != 42 {
    Fail(c, 4)
    return -1
  }
  var p i64 = tp + 1
  var n i64 = tn - 1
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    Fail(c, 4)
    return -1
  }
  var pkg i64 = FindPkg(c, p, dot)
  if pkg == 0 {
    Fail(c, 4)
    return -1
  }
  var tnamep i64 = (p + dot) + 1
  var tnamen i64 = (n - dot) - 1
  var types i64 = SGet(pkg, strptr("types"), strlen("types"))
  if types == 0 {
    Fail(c, 4)
    return -1
  }
  var t i64 = ovid/json.Child(types)
  while t != 0 {
    var nm i64 = SGet(t, strptr("name"), strlen("name"))
    if Lit(nm, tnamep, tnamen) {
      var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
      if fields == 0 {
        Fail(c, 4)
        return -1
      }
      var k i64 = 0
      var f i64 = ovid/json.Child(fields)
      while f != 0 {
        var fnm i64 = SGet(f, strptr("name"), strlen("name"))
        if Lit(fnm, fp, fnn) {
          var fty i64 = SGet(f, strptr("type"), strlen("type"))
          c.typ = JStrP(fty)
          c.tyn = JStrN(fty)
          return k * 8
        }
        k = k + 1
        f = ovid/json.Next(f)
      }
      Fail(c, 4)
      return -1
    }
    t = ovid/json.Next(t)
  }
  Fail(c, 4)
  return -1
}

func TypeOf(c *C, n i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 {
    return Fail(c, 5)
  }
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if LeafOp(op) {
    return SetI64(c)
  }
  if ArithOp(op) {
    return SetI64(c)
  }
  if Lit(op, strptr("neg"), strlen("neg")) {
    return SetI64(c)
  }
  if Lit(op, strptr("bnot"), strlen("bnot")) {
    return SetI64(c)
  }
  if Lit(op, strptr("load8"), strlen("load8")) {
    return SetI64(c)
  }
  if Lit(op, strptr("load32"), strlen("load32")) {
    return SetI64(c)
  }
  if Lit(op, strptr("load64"), strlen("load64")) {
    return SetI64(c)
  }
  if Lit(op, strptr("syscall"), strlen("syscall")) {
    return SetI64(c)
  }
  if Lit(op, strptr("bool"), strlen("bool")) {
    return SetBool(c)
  }
  if CmpOp(op) {
    return SetBool(c)
  }
  if Lit(op, strptr("land"), strlen("land")) {
    return SetBool(c)
  }
  if Lit(op, strptr("lor"), strlen("lor")) {
    return SetBool(c)
  }
  if Lit(op, strptr("not"), strlen("not")) {
    return SetBool(c)
  }
  if Lit(op, strptr("name"), strlen("name")) {
    if SGet(n, strptr("pkg"), strlen("pkg")) != 0 {
      if PkgConst(c, n) != 0 {
        return SetI64(c)
      }
      return Fail(c, 2)
    }
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    var loc i64 = FindLoc(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      if FindCon(c, JStrP(nm), JStrN(nm)) != 0 {
        return SetI64(c)
      }
      return Fail(c, 2)
    }
    c.typ = load64(loc + 24)
    c.tyn = load64(loc + 32)
    return 0
  }
  if Lit(op, strptr("cast"), strlen("cast")) {
    var ty i64 = SGet(n, strptr("type"), strlen("type"))
    c.typ = JStrP(ty)
    c.tyn = JStrN(ty)
    return 0
  }
  if Lit(op, strptr("field"), strlen("field")) {
    if TypeOf(c, SGet(n, strptr("base"), strlen("base"))) != 0 {
      return c.err
    }
    var tp i64 = c.typ
    var tn i64 = c.tyn
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    if OffsetOf(c, tp, tn, JStrP(nm), JStrN(nm)) < 0 {
      return c.err
    }
    return 0
  }
  if Lit(op, strptr("call"), strlen("call")) {
    var pp i64 = c.pathp
    var pn i64 = c.pathn
    var pk i64 = SGet(n, strptr("pkg"), strlen("pkg"))
    if pk != 0 {
      pp = JStrP(pk)
      pn = JStrN(pk)
    }
    var nm i64 = SGet(n, strptr("func"), strlen("func"))
    var rec i64 = FindFnRec(c, pp, pn, JStrP(nm), JStrN(nm))
    if rec == 0 {
      return Fail(c, 3)
    }
    var fn i64 = load64(rec + 8)
    var rs i64 = SGet(fn, strptr("result"), strlen("result"))
    c.typ = JStrP(rs)
    c.tyn = JStrN(rs)
    return 0
  }
  return Fail(c, 5)
}

func FieldOff(c *C, base i64, fp i64, fnn i64) i64 {
  if TypeOf(c, base) != 0 {
    return -1
  }
  var tp i64 = c.typ
  var tn i64 = c.tyn
  return OffsetOf(c, tp, tn, fp, fnn)
}

func CapOff(c *C, fp i64, fnn i64) i64 {
  var pkg i64 = FindPkg(c, strptr("ovid/io"), strlen("ovid/io"))
  if pkg == 0 {
    Fail(c, 4)
    return -1
  }
  var types i64 = SGet(pkg, strptr("types"), strlen("types"))
  if types == 0 {
    Fail(c, 4)
    return -1
  }
  var t i64 = ovid/json.Child(types)
  while t != 0 {
    var nm i64 = SGet(t, strptr("name"), strlen("name"))
    if Lit(nm, strptr("Cap"), strlen("Cap")) {
      var fields i64 = SGet(t, strptr("fields"), strlen("fields"))
      var k i64 = 0
      var f i64 = 0
      if fields != 0 {
        f = ovid/json.Child(fields)
      }
      while f != 0 {
        var fnm i64 = SGet(f, strptr("name"), strlen("name"))
        if Lit(fnm, fp, fnn) {
          return k * 8
        }
        k = k + 1
        f = ovid/json.Next(f)
      }
    }
    t = ovid/json.Next(t)
  }
  Fail(c, 4)
  return -1
}

func TempDisp(c *C, lv i64) i64 {
  return 0 - (c.localBytes + ((lv + 1) * 8))
}

func StoreTemp(c *C, lv i64) i64 {
  ovid/asm.MovMemRbpRax(c.code, TempDisp(c, lv))
  return 0
}

func ArgReg(i i64) i64 {
  if i == 0 {
    return 7
  }
  if i == 1 {
    return 6
  }
  if i == 2 {
    return 2
  }
  if i == 3 {
    return 1
  }
  if i == 4 {
    return 8
  }
  return 9
}

func SysReg(i i64) i64 {
  if i == 0 {
    return 0
  }
  if i == 1 {
    return 7
  }
  if i == 2 {
    return 6
  }
  if i == 3 {
    return 2
  }
  if i == 4 {
    return 10
  }
  if i == 5 {
    return 8
  }
  return 9
}

func EmitBin(c *C, n i64, lv i64) i64 {
  if EmitExpr(c, SGet(n, strptr("left"), strlen("left")), lv) != 0 {
    return c.err
  }
  StoreTemp(c, lv)
  if EmitExpr(c, SGet(n, strptr("right"), strlen("right")), lv + 1) != 0 {
    return c.err
  }
  ovid/asm.MovRegReg(c.code, 1, 0)
  ovid/asm.MovRaxMemRbp(c.code, TempDisp(c, lv))
  return 0
}

func EmitArith(c *C, op i64) i64 {
  if Lit(op, strptr("add"), strlen("add")) {
    ovid/asm.AddRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("sub"), strlen("sub")) {
    ovid/asm.SubRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("mul"), strlen("mul")) {
    ovid/asm.ImulRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("and"), strlen("and")) {
    ovid/asm.AndRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("or"), strlen("or")) {
    ovid/asm.OrRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("xor"), strlen("xor")) {
    ovid/asm.XorRaxRcx(c.code)
    return 0
  }
  if Lit(op, strptr("shl"), strlen("shl")) {
    ovid/asm.ShlRaxCl(c.code)
    return 0
  }
  if Lit(op, strptr("shr"), strlen("shr")) {
    ovid/asm.SarRaxCl(c.code)
    return 0
  }
  if Lit(op, strptr("div"), strlen("div")) {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    return 0
  }
  if Lit(op, strptr("mod"), strlen("mod")) {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    ovid/asm.MovRegReg(c.code, 0, 2)
    return 0
  }
  return Fail(c, 5)
}

func CmpCC(op i64) i64 {
  if Lit(op, strptr("eq"), strlen("eq")) {
    return 0x94
  }
  if Lit(op, strptr("ne"), strlen("ne")) {
    return 0x95
  }
  if Lit(op, strptr("lt"), strlen("lt")) {
    return 0x9C
  }
  if Lit(op, strptr("ge"), strlen("ge")) {
    return 0x9D
  }
  if Lit(op, strptr("le"), strlen("le")) {
    return 0x9E
  }
  return 0x9F
}

func EmitCall(c *C, n i64, lv i64) i64 {
  var pp i64 = c.pathp
  var pn i64 = c.pathn
  var pk i64 = SGet(n, strptr("pkg"), strlen("pkg"))
  if pk != 0 {
    pp = JStrP(pk)
    pn = JStrN(pk)
  }
  var nm i64 = SGet(n, strptr("func"), strlen("func"))
  var rec i64 = FindFnRec(c, pp, pn, JStrP(nm), JStrN(nm))
  if rec == 0 {
    return Fail(c, 3)
  }
  var args i64 = SGet(n, strptr("args"), strlen("args"))
  var nargs i64 = 0
  if args != 0 {
    nargs = ovid/json.Count(args)
  }
  if nargs > 6 {
    return Fail(c, 6)
  }
  var i i64 = 0
  var a i64 = 0
  if args != 0 {
    a = ovid/json.Child(args)
  }
  while a != 0 {
    if EmitExpr(c, a, lv + i) != 0 {
      return c.err
    }
    StoreTemp(c, lv + i)
    i = i + 1
    a = ovid/json.Next(a)
  }
  i = 0
  a = 0
  if args != 0 {
    a = ovid/json.Child(args)
  }
  while a != 0 {
    ovid/asm.MovRegMemRbp(c.code, ArgReg(i), TempDisp(c, lv + i))
    i = i + 1
    a = ovid/json.Next(a)
  }
  ovid/asm.Call(c.code, load64(rec + 48))
  return 0
}

func EmitSys(c *C, n i64, lv i64) i64 {
  var args i64 = SGet(n, strptr("args"), strlen("args"))
  var nargs i64 = 0
  if args != 0 {
    nargs = ovid/json.Count(args)
  }
  if nargs != 7 {
    return Fail(c, 6)
  }
  var i i64 = 0
  var a i64 = ovid/json.Child(args)
  while a != 0 {
    if EmitExpr(c, a, lv + i) != 0 {
      return c.err
    }
    StoreTemp(c, lv + i)
    i = i + 1
    a = ovid/json.Next(a)
  }
  i = 0
  a = ovid/json.Child(args)
  while a != 0 {
    ovid/asm.MovRegMemRbp(c.code, SysReg(i), TempDisp(c, lv + i))
    i = i + 1
    a = ovid/json.Next(a)
  }
  ovid/asm.Syscall(c.code)
  return 0
}

func EmitExpr(c *C, n i64, lv i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 {
    return Fail(c, 5)
  }
  var op i64 = SGet(n, strptr("op"), strlen("op"))
  if Lit(op, strptr("int"), strlen("int")) {
    var v i64 = SGet(n, strptr("value"), strlen("value"))
    ovid/asm.MovRegImm(c.code, 0, ovid/json.Int(v))
    return 0
  }
  if Lit(op, strptr("sizeof"), strlen("sizeof")) {
    var ty i64 = SGet(n, strptr("type"), strlen("type"))
    var sz i64 = SizeOf(c, JStrP(ty), JStrN(ty))
    if sz < 0 {
      return c.err
    }
    ovid/asm.MovRegImm(c.code, 0, sz)
    return 0
  }
  if Lit(op, strptr("bool"), strlen("bool")) {
    var v i64 = SGet(n, strptr("value"), strlen("value"))
    var b i64 = 0
    if ovid/json.Int(v) != 0 {
      b = 1
    }
    ovid/asm.MovRegImm(c.code, 0, b)
    return 0
  }
  if Lit(op, strptr("strptr"), strlen("strptr")) {
    var v i64 = SGet(n, strptr("value"), strlen("value"))
    var off i64 = ovid/asm.Intern(c.code, JStrP(v), JStrN(v))
    ovid/asm.MovRegImm(c.code, 0, 0)
    ovid/asm.AbsHere(c.code, off)
    return 0
  }
  if Lit(op, strptr("strlen"), strlen("strlen")) {
    var v i64 = SGet(n, strptr("value"), strlen("value"))
    ovid/asm.MovRegImm(c.code, 0, JStrN(v))
    return 0
  }
  if Lit(op, strptr("name"), strlen("name")) {
    if SGet(n, strptr("pkg"), strlen("pkg")) != 0 {
      var pc i64 = PkgConst(c, n)
      if pc == 0 {
        return Fail(c, 2)
      }
      ovid/asm.MovRegImm(c.code, 0, ovid/json.Int(SGet(pc, strptr("value"), strlen("value"))))
      return 0
    }
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    var np i64 = JStrP(nm)
    var nn i64 = JStrN(nm)
    var loc i64 = FindLoc(c, np, nn)
    if loc != 0 {
      ovid/asm.MovRaxMemRbp(c.code, load64(loc + 16))
      return 0
    }
    var con i64 = FindCon(c, np, nn)
    if con != 0 {
      ovid/asm.MovRegImm(c.code, 0, load64(con + 16))
      return 0
    }
    return Fail(c, 2)
  }
  if ArithOp(op) {
    if EmitBin(c, n, lv) != 0 {
      return c.err
    }
    return EmitArith(c, op)
  }
  if CmpOp(op) {
    if EmitBin(c, n, lv) != 0 {
      return c.err
    }
    ovid/asm.CmpRaxRcx(c.code)
    ovid/asm.SetccAl(c.code, CmpCC(op))
    ovid/asm.MovzxRaxAl(c.code)
    return 0
  }
  if Lit(op, strptr("land"), strlen("land")) {
    var no i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    if EmitExpr(c, SGet(n, strptr("left"), strlen("left")), lv) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jz(c.code, no)
    if EmitExpr(c, SGet(n, strptr("right"), strlen("right")), lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, end)
    ovid/asm.Mark(c.code, no)
    ovid/asm.XorRaxRax(c.code)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if Lit(op, strptr("lor"), strlen("lor")) {
    var yes i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    if EmitExpr(c, SGet(n, strptr("left"), strlen("left")), lv) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jnz(c.code, yes)
    if EmitExpr(c, SGet(n, strptr("right"), strlen("right")), lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, end)
    ovid/asm.Mark(c.code, yes)
    ovid/asm.MovRegImm(c.code, 0, 1)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if Lit(op, strptr("not"), strlen("not")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.SetccAl(c.code, 0x94)
    ovid/asm.MovzxRaxAl(c.code)
    return 0
  }
  if Lit(op, strptr("neg"), strlen("neg")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.NegRax(c.code)
    return 0
  }
  if Lit(op, strptr("bnot"), strlen("bnot")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.NotRax(c.code)
    return 0
  }
  if Lit(op, strptr("cast"), strlen("cast")) {
    return EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv)
  }
  if Lit(op, strptr("field"), strlen("field")) {
    var nm i64 = SGet(n, strptr("name"), strlen("name"))
    var base i64 = SGet(n, strptr("base"), strlen("base"))
    var off i64 = FieldOff(c, base, JStrP(nm), JStrN(nm))
    if off < 0 {
      return c.err
    }
    if EmitExpr(c, base, lv) != 0 {
      return c.err
    }
    ovid/asm.MovRaxMemRegDisp(c.code, 0, off)
    return 0
  }
  if Lit(op, strptr("load8"), strlen("load8")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.MovRegReg(c.code, 1, 0)
    ovid/asm.MovzxRaxByteRcx(c.code)
    return 0
  }
  if Lit(op, strptr("load32"), strlen("load32")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.MovRegReg(c.code, 1, 0)
    ovid/asm.MovEaxDwordRcx(c.code)
    return 0
  }
  if Lit(op, strptr("load64"), strlen("load64")) {
    if EmitExpr(c, SGet(n, strptr("arg"), strlen("arg")), lv) != 0 {
      return c.err
    }
    ovid/asm.MovRegReg(c.code, 1, 0)
    ovid/asm.MovRaxQwordRcx(c.code)
    return 0
  }
  if Lit(op, strptr("call"), strlen("call")) {
    return EmitCall(c, n, lv)
  }
  if Lit(op, strptr("syscall"), strlen("syscall")) {
    return EmitSys(c, n, lv)
  }
  return Fail(c, 5)
}

func EmitStmts(c *C, arr i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if arr == 0 {
    return 0
  }
  var s i64 = ovid/json.Child(arr)
  while s != 0 {
    if EmitStmt(c, s) != 0 {
      return c.err
    }
    s = ovid/json.Next(s)
  }
  return 0
}

func EmitStmt(c *C, s i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if s == 0 {
    return Fail(c, 5)
  }
  var op i64 = SGet(s, strptr("op"), strlen("op"))
  if Lit(op, strptr("var"), strlen("var")) {
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val == 0 {
      return 0
    }
    if EmitExpr(c, val, 0) != 0 {
      return c.err
    }
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var loc i64 = FindLoc(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      return Fail(c, 2)
    }
    ovid/asm.MovMemRbpRax(c.code, load64(loc + 16))
    return 0
  }
  if Lit(op, strptr("assign"), strlen("assign")) {
    if EmitExpr(c, SGet(s, strptr("val"), strlen("val")), 0) != 0 {
      return c.err
    }
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var loc i64 = FindLoc(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      return Fail(c, 2)
    }
    ovid/asm.MovMemRbpRax(c.code, load64(loc + 16))
    return 0
  }
  if Lit(op, strptr("setfield"), strlen("setfield")) {
    var nm i64 = SGet(s, strptr("name"), strlen("name"))
    var base i64 = SGet(s, strptr("base"), strlen("base"))
    var off i64 = FieldOff(c, base, JStrP(nm), JStrN(nm))
    if off < 0 {
      return c.err
    }
    if EmitExpr(c, base, 0) != 0 {
      return c.err
    }
    StoreTemp(c, 0)
    if EmitExpr(c, SGet(s, strptr("val"), strlen("val")), 1) != 0 {
      return c.err
    }
    ovid/asm.MovRcxMemRbp(c.code, TempDisp(c, 0))
    ovid/asm.MovMemRegDispRax(c.code, 1, off)
    return 0
  }
  if Lit(op, strptr("store8"), strlen("store8")) {
    if EmitExpr(c, SGet(s, strptr("addr"), strlen("addr")), 0) != 0 {
      return c.err
    }
    StoreTemp(c, 0)
    if EmitExpr(c, SGet(s, strptr("val"), strlen("val")), 1) != 0 {
      return c.err
    }
    ovid/asm.MovRcxMemRbp(c.code, TempDisp(c, 0))
    ovid/asm.MovByteRcxAl(c.code)
    return 0
  }
  if Lit(op, strptr("store64"), strlen("store64")) {
    if EmitExpr(c, SGet(s, strptr("addr"), strlen("addr")), 0) != 0 {
      return c.err
    }
    StoreTemp(c, 0)
    if EmitExpr(c, SGet(s, strptr("val"), strlen("val")), 1) != 0 {
      return c.err
    }
    ovid/asm.MovRcxMemRbp(c.code, TempDisp(c, 0))
    ovid/asm.MovQwordRcxRax(c.code)
    return 0
  }
  if Lit(op, strptr("expr"), strlen("expr")) {
    return EmitExpr(c, SGet(s, strptr("val"), strlen("val")), 0)
  }
  if Lit(op, strptr("return"), strlen("return")) {
    var val i64 = SGet(s, strptr("val"), strlen("val"))
    if val != 0 {
      if EmitExpr(c, val, 0) != 0 {
        return c.err
      }
    } else {
      ovid/asm.XorRaxRax(c.code)
    }
    ovid/asm.Jmp(c.code, c.epi)
    return 0
  }
  if Lit(op, strptr("if"), strlen("if")) {
    if EmitExpr(c, SGet(s, strptr("cond"), strlen("cond")), 0) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    var elseL i64 = end
    var el i64 = SGet(s, strptr("else"), strlen("else"))
    var hasElse bool = false
    if el != 0 {
      if ovid/json.Count(el) > 0 {
        hasElse = true
        elseL = ovid/asm.NewLabel(c.code)
      }
    }
    ovid/asm.Jz(c.code, elseL)
    if EmitStmts(c, SGet(s, strptr("then"), strlen("then"))) != 0 {
      return c.err
    }
    if hasElse {
      ovid/asm.Jmp(c.code, end)
      ovid/asm.Mark(c.code, elseL)
      if EmitStmts(c, el) != 0 {
        return c.err
      }
    }
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if Lit(op, strptr("while"), strlen("while")) {
    var begin i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    ovid/asm.Mark(c.code, begin)
    if EmitExpr(c, SGet(s, strptr("cond"), strlen("cond")), 0) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jz(c.code, end)
    if EmitStmts(c, SGet(s, strptr("body"), strlen("body"))) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, begin)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  return Fail(c, 5)
}

func EmitFunc(c *C, rec i64) i64 {
  c.nloc = 0
  c.ncon = 0
  c.err = 0
  c.pathp = load64(rec + 32)
  c.pathn = load64(rec + 40)
  c.fn = load64(rec + 8)
  var pkg i64 = load64(rec + 0)
  LoadConsts(c, pkg)
  CollectParams(c, c.fn)
  var body i64 = SGet(c.fn, strptr("body"), strlen("body"))
  CollectStmts(c, body)
  if c.err != 0 {
    return c.err
  }
  c.localBytes = c.nloc * 8
  c.peak = StmtsPeak(body)
  var tempBytes i64 = 0
  if c.peak >= 0 {
    tempBytes = (c.peak + 1) * 8
  }
  var frame i64 = c.localBytes + tempBytes
  if (frame % 16) != 0 {
    frame = frame + 8
  }
  c.epi = ovid/asm.NewLabel(c.code)
  ovid/asm.Mark(c.code, load64(rec + 48))
  ovid/asm.PushReg(c.code, 5)
  ovid/asm.MovRegReg(c.code, 5, 4)
  ovid/asm.SubRsp(c.code, frame)
  if frame > 0 {
    ovid/asm.XorRaxRax(c.code)
    var d i64 = 8
    while d <= (c.localBytes + tempBytes) {
      ovid/asm.MovMemRbpRax(c.code, 0 - d)
      d = d + 8
    }
  }
  var params i64 = SGet(c.fn, strptr("params"), strlen("params"))
  var i i64 = 0
  var pa i64 = 0
  if params != 0 {
    pa = ovid/json.Child(params)
  }
  while pa != 0 {
    var nm i64 = SGet(pa, strptr("name"), strlen("name"))
    var loc i64 = FindLoc(c, JStrP(nm), JStrN(nm))
    if loc == 0 {
      return Fail(c, 2)
    }
    ovid/asm.MovMemRbpReg(c.code, ArgReg(i), load64(loc + 16))
    i = i + 1
    pa = ovid/json.Next(pa)
  }
  if EmitStmts(c, body) != 0 {
    return c.err
  }
  ovid/asm.XorRaxRax(c.code)
  ovid/asm.Mark(c.code, c.epi)
  ovid/asm.MovRegReg(c.code, 4, 5)
  ovid/asm.PopReg(c.code, 5)
  ovid/asm.Ret(c.code)
  return 0
}

// MarkLive flags rec and every func it can call (rec + 64). Only live
// funcs are emitted, matching the Go compiler.
func MarkLive(c *C, rec i64) i64 {
  if load64(rec + 64) != 0 {
    return 0
  }
  store64(rec + 64, 1)
  var body i64 = SGet(load64(rec + 8), strptr("body"), strlen("body"))
  if body != 0 {
    WalkLive(c, body, load64(rec + 32), load64(rec + 40))
  }
  return 0
}

// WalkLive marks the callee of every call node under v; pp/pn is the
// package that unqualified calls resolve in.
func WalkLive(c *C, v i64, pp i64, pn i64) i64 {
  var k i64 = ovid/json.Kind(v)
  if k == 5 {
    var op i64 = SGet(v, strptr("op"), strlen("op"))
    if op != 0 && Lit(op, strptr("call"), strlen("call")) {
      var cp i64 = pp
      var cn i64 = pn
      var pk i64 = SGet(v, strptr("pkg"), strlen("pkg"))
      if pk != 0 {
        cp = JStrP(pk)
        cn = JStrN(pk)
      }
      var nm i64 = SGet(v, strptr("func"), strlen("func"))
      if nm != 0 {
        var rec i64 = FindFnRec(c, cp, cn, JStrP(nm), JStrN(nm))
        if rec != 0 {
          MarkLive(c, rec)
        }
      }
    }
  }
  if k == 4 || k == 5 {
    var ch i64 = ovid/json.Child(v)
    while ch != 0 {
      WalkLive(c, ch, pp, pn)
      ch = ovid/json.Next(ch)
    }
  }
  return 0
}

func EmitStartup(c *C, mainLab i64) i64 {
  var argcOff i64 = CapOff(c, strptr("argc"), strlen("argc"))
  var argvOff i64 = CapOff(c, strptr("argv"), strlen("argv"))
  var heapOff i64 = CapOff(c, strptr("heap"), strlen("heap"))
  var usedOff i64 = CapOff(c, strptr("used"), strlen("used"))
  var sizeOff i64 = CapOff(c, strptr("size"), strlen("size"))
  if argcOff < 0 {
    return c.err
  }
  if argvOff < 0 {
    return c.err
  }
  if heapOff < 0 {
    return c.err
  }
  if usedOff < 0 {
    return c.err
  }
  if sizeOff < 0 {
    return c.err
  }
  var fail i64 = ovid/asm.NewLabel(c.code)
  ovid/asm.MovR12MemRsp(c.code)
  ovid/asm.LeaR13Rsp8(c.code)
  ovid/asm.AndRspAlign(c.code)
  ovid/asm.MovRegImm(c.code, 7, 0)
  ovid/asm.MovRegImm(c.code, 6, HEAP)
  ovid/asm.MovRegImm(c.code, 2, 3)
  ovid/asm.MovRegImm(c.code, 10, 0x22)
  ovid/asm.MovRegImm(c.code, 8, -1)
  ovid/asm.MovRegImm(c.code, 9, 0)
  ovid/asm.MovRegImm(c.code, 0, 9)
  ovid/asm.Syscall(c.code)
  ovid/asm.MovRegReg(c.code, 14, 0)
  ovid/asm.TestRaxRax(c.code)
  ovid/asm.Jl(c.code, fail)
  ovid/asm.SubRsp(c.code, 48)
  ovid/asm.MovRegReg(c.code, 1, 4)
  ovid/asm.MovRegReg(c.code, 0, 12)
  ovid/asm.MovMemRegDispRax(c.code, 1, argcOff)
  ovid/asm.MovRegReg(c.code, 0, 13)
  ovid/asm.MovMemRegDispRax(c.code, 1, argvOff)
  ovid/asm.MovRegReg(c.code, 0, 14)
  ovid/asm.MovMemRegDispRax(c.code, 1, heapOff)
  ovid/asm.MovRegImm(c.code, 0, 0)
  ovid/asm.MovMemRegDispRax(c.code, 1, usedOff)
  ovid/asm.MovRegImm(c.code, 0, HEAP)
  ovid/asm.MovMemRegDispRax(c.code, 1, sizeOff)
  ovid/asm.MovRegReg(c.code, 7, 4)
  ovid/asm.Call(c.code, mainLab)
  ovid/asm.MovRegReg(c.code, 7, 0)
  ovid/asm.MovRegImm(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  ovid/asm.Mark(c.code, fail)
  ovid/asm.MovRegImm(c.code, 7, 125)
  ovid/asm.MovRegImm(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  return 0
}

func Compile(io *ovid/io.Cap, root i64, errp i64) *ovid/mem.Buf {
  var z i64 = 0
  if root == 0 {
    store64(errp, 1)
    return z as *ovid/mem.Buf
  }
  var raw i64 = ovid/io.Alloc(io, sizeof(C))
  if raw == 0 {
    store64(errp, 1)
    return z as *ovid/mem.Buf
  }
  Zero(raw, sizeof(C))
  var c *C = raw as *C
  c.io = io
  c.root = root
  c.code = ovid/asm.New(io)
  if IndexProg(c) != 0 {
    store64(errp, c.err)
    return z as *ovid/mem.Buf
  }
  var ent i64 = SGet(root, strptr("entry"), strlen("entry"))
  var mainRec i64 = FindFnRec(c, JStrP(ent), JStrN(ent), strptr("main"), strlen("main"))
  if mainRec == 0 {
    store64(errp, 1)
    return z as *ovid/mem.Buf
  }
  if EmitStartup(c, load64(mainRec + 48)) != 0 {
    store64(errp, c.err)
    return z as *ovid/mem.Buf
  }
  MarkLive(c, mainRec)
  var i i64 = 0
  while i < c.nfn {
    var rec i64 = c.fns + (i * FNREC)
    if load64(rec + 64) != 0 {
      if EmitFunc(c, rec) != 0 {
        store64(errp, c.err)
        return z as *ovid/mem.Buf
      }
    }
    i = i + 1
  }
  ovid/asm.Patch(c.code)
  store64(errp, 0)
  return ovid/elf.Link(io, c.code)
}
