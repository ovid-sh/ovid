package ovid/cg

import ovid/io
import ovid/mem
import ovid/asm
import ovid/elf
import ovid/parse

const HEAP i64 = 128 << 20
const MAXLOC i64 = 1024

// A local's record in C.locs, one per param or var declaration: name
// (address, length), rbp displacement, type (address, length), weight, and
// register (-1 for none).
const LOCSIZE i64 = 56
const LOC_WEIGHT i64 = 40
const LOC_REG i64 = 48

// C is the code generator's state. pkg/pathp/fn are the func being
// emitted; locs holds its params and vars, nloc of them. While they are
// bound, scope holds the numbers of the nscope in scope, innermost last;
// live is the most that were in scope at once. err is set by the first
// failure, and msg says what it was.
type C struct {
  io *ovid/io.Cap
  code *ovid/asm.Code
  mod *ovid/parse.Mod
  work i64
  nwork i64
  workcap i64
  pkg *ovid/parse.Pkg
  pathp i64
  pathn i64
  fn *ovid/parse.Decl
  locs i64
  nloc i64
  scope i64
  nscope i64
  live i64
  localBytes i64
  epi i64
  err i64
  peak i64
  typ i64
  tyn i64
  opv i64
  addrd i64
  last *ovid/parse.Node
  amBase i64
  amIndex i64
  saved i64
  nsaved i64
  saveBase i64
  free i64
  msg *ovid/mem.Buf
  adding bool
}

// Fail records the first failure. Its message is p[0:n] and whatever Add
// appends before the next Fail.
func Fail(c *C, p i64, n i64) i64 {
  c.adding = c.err == 0
  if c.adding {
    c.err = 1
    c.msg = ovid/mem.New(c.io, 64)
    ovid/mem.WBytes(c.io, c.msg, p, n)
  }
  return c.err
}

// Add appends p[0:n] to the message of the failure the last Fail recorded.
func Add(c *C, p i64, n i64) i64 {
  if c.adding {
    ovid/mem.WBytes(c.io, c.msg, p, n)
  }
  return c.err
}

// AddQual appends name np[0:nn], qualified with package pp[0:pn] if any.
func AddQual(c *C, pp i64, pn i64, np i64, nn i64) i64 {
  if pn != 0 {
    Add(c, pp, pn)
    Add(c, strptr("."), 1)
  }
  return Add(c, np, nn)
}

// FailName fails with what followed by the name n refers to.
func FailName(c *C, what i64, whatn i64, n *ovid/parse.Node) i64 {
  Fail(c, what, whatn)
  return AddQual(c, n.pkgp, n.pkgn, n.namep, n.namen)
}

// FailCall fails for call node n, whose func was not found.
func FailCall(c *C, n *ovid/parse.Node) i64 {
  Fail(c, strptr("call "), strlen("call "))
  return AddQual(c, n.pkgp, n.pkgn, n.fnp, n.fnn)
}

// FailIn fails with what followed by the func being emitted, pkg.Name.
func FailIn(c *C, what i64, whatn i64) i64 {
  Fail(c, what, whatn)
  return AddQual(c, c.pathp, c.pathn, c.fn.namep, c.fn.namen)
}

// FailField fails with "field f on T", for a field fp[0:fnn] that type
// tp[0:tn] does not have.
func FailField(c *C, tp i64, tn i64, fp i64, fnn i64) i64 {
  Fail(c, strptr("field "), strlen("field "))
  Add(c, fp, fnn)
  Add(c, strptr(" on "), strlen(" on "))
  return Add(c, tp, tn)
}

func Max(a i64, b i64) i64 {
  if a > b {
    return a
  }
  return b
}

func LeafOp(op i64) bool {
  return op == ovid/parse.OP_INT || op == ovid/parse.OP_SIZEOF || op == ovid/parse.OP_STRPTR || op == ovid/parse.OP_STRLEN
}

func ArithOp(op i64) bool {
  return op >= ovid/parse.OP_ADD && op <= ovid/parse.OP_SHR
}

func CmpOp(op i64) bool {
  return op >= ovid/parse.OP_EQ && op <= ovid/parse.OP_GE
}

func UnaryOp(op i64) bool {
  if op == ovid/parse.OP_NOT || op == ovid/parse.OP_NEG || op == ovid/parse.OP_BNOT || op == ovid/parse.OP_CAST {
    return true
  }
  return op == ovid/parse.OP_LOAD8 || op == ovid/parse.OP_LOAD32 || op == ovid/parse.OP_LOAD64
}

func FindPkg(c *C, pp i64, pn i64) *ovid/parse.Pkg {
  var k *ovid/parse.Pkg = c.mod.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if ovid/mem.Eq(k.pathp, k.pathn, pp, pn) {
      return k
    }
    k = k.next
  }
  return k
}

// PkgConst returns the const that name node n refers to in another
// package (n.pkg is set), or nil.
func PkgConst(c *C, n *ovid/parse.Node) *ovid/parse.Decl {
  var k *ovid/parse.Pkg = FindPkg(c, n.pkgp, n.pkgn)
  if k == 0 as *ovid/parse.Pkg {
    return 0 as *ovid/parse.Decl
  }
  return ovid/parse.FindDecl(k.cs, n.namep, n.namen)
}

// IndexProg gives every func its label, in program order.
func IndexProg(c *C) i64 {
  var k *ovid/parse.Pkg = c.mod.pkgs
  if k == 0 as *ovid/parse.Pkg {
    return Fail(c, strptr("no packages"), strlen("no packages"))
  }
  c.locs = ovid/io.Alloc(c.io, MAXLOC * LOCSIZE)
  c.scope = ovid/io.Alloc(c.io, MAXLOC * 8)
  c.saved = ovid/io.Alloc(c.io, 64)
  c.free = ovid/io.Alloc(c.io, 64)
  while k != 0 as *ovid/parse.Pkg {
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      f.lab = ovid/asm.NewLabel(c.code)
      f = f.next
    }
    k = k.next
  }
  return 0
}

// LocOf is the record of the local that n, a var, an assign, or a name,
// is, or 0.
func LocOf(c *C, n *ovid/parse.Node) i64 {
  if n == 0 as *ovid/parse.Node || n.loc == 0 {
    return 0
  }
  return c.locs + ((n.loc - 1) * LOCSIZE)
}

// AddLoc gives the declaration s (nil for a param) a new local and puts it
// in scope. Its slot is the number of locals in scope, so vars of sibling
// blocks share slots.
func AddLoc(c *C, s *ovid/parse.Node, np i64, nn i64, tp i64, tn i64) i64 {
  if c.nloc >= MAXLOC {
    return FailIn(c, strptr("too many locals in "), strlen("too many locals in "))
  }
  var rec i64 = c.locs + (c.nloc * LOCSIZE)
  store64(rec + 0, np)
  store64(rec + 8, nn)
  store64(rec + 16, 0 - ((c.nscope + 1) * 8))
  store64(rec + 24, tp)
  store64(rec + 32, tn)
  store64(rec + LOC_WEIGHT, 0)
  store64(rec + LOC_REG, -1)
  store64(c.scope + (c.nscope * 8), c.nloc)
  c.nloc = c.nloc + 1
  c.nscope = c.nscope + 1
  c.live = Max(c.live, c.nscope)
  if s != 0 as *ovid/parse.Node {
    s.loc = c.nloc
  }
  return 0
}

// BindName resolves n, an assign or a name, to the innermost local called
// np[0:nn] in scope, if there is one.
func BindName(c *C, n *ovid/parse.Node, np i64, nn i64) i64 {
  n.loc = 0
  var j i64 = c.nscope - 1
  while j >= 0 {
    var i i64 = load64(c.scope + (j * 8))
    var rec i64 = c.locs + (i * LOCSIZE)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      n.loc = i + 1
      return 0
    }
    j = j - 1
  }
  return 0
}

// BindStmts gives every var declared in the statement list s its own local
// and resolves each use of a name to the declaration in scope, as the
// checker scopes: a var's value is evaluated before its name is in scope,
// and a block's vars leave scope where it ends.
func BindStmts(c *C, s *ovid/parse.Node) i64 {
  var n i64 = c.nscope
  while s != 0 as *ovid/parse.Node {
    BindExpr(c, s.val)
    BindExpr(c, s.base)
    BindExpr(c, s.addr)
    BindExpr(c, s.cond)
    if s.op == ovid/parse.OP_VAR {
      if s.namen != 0 {
        AddLoc(c, s, s.namep, s.namen, s.typp, s.typn)
      }
    } else if s.op == ovid/parse.OP_ASSIGN {
      BindName(c, s, s.namep, s.namen)
    }
    BindStmts(c, s.then)
    BindStmts(c, s.els)
    BindStmts(c, s.body)
    s = s.next
  }
  c.nscope = n
  return 0
}

func BindExpr(c *C, n *ovid/parse.Node) i64 {
  if n == 0 as *ovid/parse.Node {
    return 0
  }
  if n.op == ovid/parse.OP_NAME && n.pkgn == 0 {
    BindName(c, n, n.namep, n.namen)
  }
  BindExpr(c, n.left)
  BindExpr(c, n.right)
  BindExpr(c, n.arg)
  BindExpr(c, n.base)
  var a *ovid/parse.Node = n.args
  while a != 0 as *ovid/parse.Node {
    BindExpr(c, a)
    a = a.next
  }
  return 0
}

func CallPeak(n *ovid/parse.Node, lv i64) i64 {
  var m i64 = -1
  var i i64 = 0
  var a *ovid/parse.Node = n.args
  while a != 0 as *ovid/parse.Node {
    var p i64 = ExprPeak(a, lv + i)
    m = Max(m, Max(p, lv + i))
    i = i + 1
    a = a.next
  }
  return m
}

// ExprPeak is the highest temp slot evaluating n at level lv uses, or -1.
func ExprPeak(n *ovid/parse.Node, lv i64) i64 {
  if n == 0 as *ovid/parse.Node {
    return -1
  }
  var op i64 = n.op
  if LeafOp(op) || op == ovid/parse.OP_BOOL || op == ovid/parse.OP_NAME {
    return -1
  }
  if ArithOp(op) || CmpOp(op) {
    var l i64 = ExprPeak(n.left, lv)
    var r i64 = ExprPeak(n.right, lv + 1)
    return Max(l, Max(r, lv))
  }
  if op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR {
    var l i64 = ExprPeak(n.left, lv)
    var r i64 = ExprPeak(n.right, lv)
    return Max(l, r)
  }
  if UnaryOp(op) {
    return ExprPeak(n.arg, lv)
  }
  if op == ovid/parse.OP_FIELD {
    return ExprPeak(n.base, lv)
  }
  if op == ovid/parse.OP_CALL || op == ovid/parse.OP_SYSCALL {
    return CallPeak(n, lv)
  }
  return lv
}

func StmtsPeak(s *ovid/parse.Node) i64 {
  var m i64 = -1
  while s != 0 as *ovid/parse.Node {
    m = Max(m, StmtPeak(s))
    s = s.next
  }
  return m
}

func StmtPeak(s *ovid/parse.Node) i64 {
  var op i64 = s.op
  if op == ovid/parse.OP_VAR || op == ovid/parse.OP_ASSIGN || op == ovid/parse.OP_EXPR || op == ovid/parse.OP_RETURN {
    return ExprPeak(s.val, 0)
  }
  if op == ovid/parse.OP_SETFIELD {
    var b i64 = ExprPeak(s.base, 0)
    var v i64 = ExprPeak(s.val, 1)
    return Max(b, Max(v, 1))
  }
  if op == ovid/parse.OP_STORE8 || op == ovid/parse.OP_STORE64 {
    var b i64 = ExprPeak(s.addr, 0)
    var v i64 = ExprPeak(s.val, 1)
    return Max(b, Max(v, 1))
  }
  if op == ovid/parse.OP_IF {
    var m i64 = ExprPeak(s.cond, 0)
    m = Max(m, StmtsPeak(s.then))
    m = Max(m, StmtsPeak(s.els))
    return m
  }
  if op == ovid/parse.OP_WHILE {
    var cnd i64 = ExprPeak(s.cond, 0)
    return Max(cnd, StmtsPeak(s.body))
  }
  return -1
}

func SetI64(c *C) i64 {
  c.typ = strptr("i64")
  c.tyn = strlen("i64")
  return 0
}

func SetBool(c *C) i64 {
  c.typ = strptr("bool")
  c.tyn = strlen("bool")
  return 0
}

// FindType returns the struct type pkg.T named by tp[0:tn], or nil.
func FindType(c *C, tp i64, tn i64) *ovid/parse.Decl {
  var dot i64 = -1
  var i i64 = 0
  while i < tn {
    if load8(tp + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return 0 as *ovid/parse.Decl
  }
  var k *ovid/parse.Pkg = FindPkg(c, tp, dot)
  if k == 0 as *ovid/parse.Pkg {
    return 0 as *ovid/parse.Decl
  }
  return ovid/parse.FindDecl(k.ts, (tp + dot) + 1, (tn - dot) - 1)
}

// SizeOf is the byte size of struct type pkg.T (tp/tn): 8 per field.
func SizeOf(c *C, tp i64, tn i64) i64 {
  var t *ovid/parse.Decl = FindType(c, tp, tn)
  if t == 0 as *ovid/parse.Decl {
    Fail(c, strptr("sizeof "), strlen("sizeof "))
    Add(c, tp, tn)
    return -1
  }
  return ovid/parse.CountDecls(t.sub) * 8
}

// OffsetOf is the byte offset of field fp[0:fnn] in the pointer type
// tp[0:tn] (*pkg.T); it sets the current type to the field's.
func OffsetOf(c *C, tp i64, tn i64, fp i64, fnn i64) i64 {
  var t *ovid/parse.Decl = 0 as *ovid/parse.Decl
  if tn >= 2 {
    if load8(tp) == 42 {
      t = FindType(c, tp + 1, tn - 1)
    }
  }
  if t == 0 as *ovid/parse.Decl {
    FailField(c, tp, tn, fp, fnn)
    return -1
  }
  var k i64 = 0
  var f *ovid/parse.Decl = t.sub
  while f != 0 as *ovid/parse.Decl {
    if ovid/mem.Eq(f.namep, f.namen, fp, fnn) {
      c.typ = f.typp
      c.tyn = f.typn
      return k * 8
    }
    k = k + 1
    f = f.next
  }
  FailField(c, tp, tn, fp, fnn)
  return -1
}

// Callee returns the func that call node n resolves to, or nil; pp/pn is
// the package an unqualified call resolves in.
func Callee(c *C, n *ovid/parse.Node, pp i64, pn i64) *ovid/parse.Decl {
  if n.pkgn != 0 {
    pp = n.pkgp
    pn = n.pkgn
  }
  return ovid/parse.FindFunc(c.mod, pp, pn, n.fnp, n.fnn)
}

func TypeOf(c *C, n *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 as *ovid/parse.Node {
    return FailIn(c, strptr("nil expr in "), strlen("nil expr in "))
  }
  var op i64 = n.op
  if LeafOp(op) || ArithOp(op) || op == ovid/parse.OP_NEG || op == ovid/parse.OP_BNOT {
    return SetI64(c)
  }
  if op == ovid/parse.OP_LOAD8 || op == ovid/parse.OP_LOAD32 || op == ovid/parse.OP_LOAD64 || op == ovid/parse.OP_SYSCALL {
    return SetI64(c)
  }
  if op == ovid/parse.OP_BOOL || CmpOp(op) || op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR || op == ovid/parse.OP_NOT {
    return SetBool(c)
  }
  if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      if PkgConst(c, n) != 0 as *ovid/parse.Decl {
        return SetI64(c)
      }
      return FailName(c, strptr("const "), strlen("const "), n)
    }
    var loc i64 = LocOf(c, n)
    if loc == 0 {
      if ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen) != 0 as *ovid/parse.Decl {
        return SetI64(c)
      }
      return FailName(c, strptr("name "), strlen("name "), n)
    }
    c.typ = load64(loc + 24)
    c.tyn = load64(loc + 32)
    return 0
  }
  if op == ovid/parse.OP_CAST {
    c.typ = n.typp
    c.tyn = n.typn
    return 0
  }
  if op == ovid/parse.OP_FIELD {
    if TypeOf(c, n.base) != 0 {
      return c.err
    }
    if OffsetOf(c, c.typ, c.tyn, n.namep, n.namen) < 0 {
      return c.err
    }
    return 0
  }
  if op == ovid/parse.OP_CALL {
    var fn *ovid/parse.Decl = Callee(c, n, c.pathp, c.pathn)
    if fn == 0 as *ovid/parse.Decl {
      return FailCall(c, n)
    }
    c.typ = fn.typp
    c.tyn = fn.typn
    return 0
  }
  return FailIn(c, strptr("no type for an expr in "), strlen("no type for an expr in "))
}

func FieldOff(c *C, base *ovid/parse.Node, fp i64, fnn i64) i64 {
  if TypeOf(c, base) != 0 {
    return -1
  }
  return OffsetOf(c, c.typ, c.tyn, fp, fnn)
}

// CapOff is the offset of field fp[0:fnn] in ovid/io.Cap.
func CapOff(c *C, fp i64, fnn i64) i64 {
  return OffsetOf(c, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap"), fp, fnn)
}

func TempDisp(c *C, lv i64) i64 {
  return 0 - (c.localBytes + ((lv + 1) * 8))
}

func StoreTemp(c *C, lv i64) i64 {
  ovid/asm.MovMemRbpRax(c.code, TempDisp(c, lv))
  return 0
}

func ArgReg(i i64) i64 {
  if i == 0 {
    return 7
  }
  if i == 1 {
    return 6
  }
  if i == 2 {
    return 2
  }
  if i == 3 {
    return 1
  }
  if i == 4 {
    return 8
  }
  return 9
}

func SysReg(i i64) i64 {
  if i == 0 {
    return 0
  }
  if i == 1 {
    return 7
  }
  if i == 2 {
    return 6
  }
  if i == 3 {
    return 2
  }
  if i == 4 {
    return 10
  }
  if i == 5 {
    return 8
  }
  return 9
}

// An operand is a value that needs no code of its own: an instruction can
// name it. KIMM is a constant that fits a signed 32-bit immediate; KMEM is
// a local in the frame, by its rbp displacement; KREG is a local in a
// register, by the register's number.
// SYSMAX bounds the system call numbers Mod.sys can mark.
const SYSMAX i64 = 1024

const KNONE i64 = 0
const KIMM i64 = 1
const KMEM i64 = 2
const KREG i64 = 3

// WeighStmts adds, for each local used or assigned in the statement list
// s, 4^depth to its weight, depth being the number of loops around the use
// (at most 5).
func WeighStmts(c *C, s *ovid/parse.Node, depth i64) i64 {
  while s != 0 as *ovid/parse.Node {
    Weigh(c, LocOf(c, s), depth)
    WeighExpr(c, s.val, depth)
    WeighExpr(c, s.base, depth)
    WeighExpr(c, s.addr, depth)
    WeighStmts(c, s.then, depth)
    WeighStmts(c, s.els, depth)
    if s.op == ovid/parse.OP_WHILE {
      var inner i64 = depth
      if inner < 5 {
        inner = inner + 1
      }
      WeighExpr(c, s.cond, inner)
      WeighStmts(c, s.body, inner)
    } else {
      WeighExpr(c, s.cond, depth)
    }
    s = s.next
  }
  return 0
}

// Weigh adds 4^depth to the weight of the local whose record is rec, if
// there is one.
func Weigh(c *C, rec i64, depth i64) i64 {
  if rec != 0 {
    store64(rec + LOC_WEIGHT, load64(rec + LOC_WEIGHT) + (1 << (2 * depth)))
  }
  return 0
}

func WeighExpr(c *C, n *ovid/parse.Node, depth i64) i64 {
  if n == 0 as *ovid/parse.Node {
    return 0
  }
  Weigh(c, LocOf(c, n), depth)
  WeighExpr(c, n.left, depth)
  WeighExpr(c, n.right, depth)
  WeighExpr(c, n.arg, depth)
  WeighExpr(c, n.base, depth)
  var a *ovid/parse.Node = n.args
  while a != 0 as *ovid/parse.Node {
    WeighExpr(c, a, depth)
    a = a.next
  }
  return 0
}

// StmtsCall reports whether the statement list s contains a call or a
// syscall.
func StmtsCall(s *ovid/parse.Node) bool {
  while s != 0 as *ovid/parse.Node {
    if ExprCalls(s.val) || ExprCalls(s.base) || ExprCalls(s.addr) || ExprCalls(s.cond) {
      return true
    }
    if StmtsCall(s.then) || StmtsCall(s.els) || StmtsCall(s.body) {
      return true
    }
    s = s.next
  }
  return false
}

func ExprCalls(n *ovid/parse.Node) bool {
  if n == 0 as *ovid/parse.Node {
    return false
  }
  if n.op == ovid/parse.OP_CALL || n.op == ovid/parse.OP_SYSCALL {
    return true
  }
  return ExprCalls(n.left) || ExprCalls(n.right) || ExprCalls(n.arg) || ExprCalls(n.base)
}

// CalleeReg is the j-th callee-saved register: rbx, r12, r13, r14, r15.
func CalleeReg(j i64) i64 {
  if j == 0 {
    return 3
  }
  return 11 + j
}

// AllocRegs decides which locals live in registers. A func that calls
// nothing keeps its params where they arrive (rdi, rsi, r8, r9; rdx and rcx
// are needed as scratch) and may use the other registers a call would
// clobber, which cost nothing to take. After those come the callee-saved
// registers, which must be saved and restored, so only a local used at
// least three times gets one. The most used locals choose first; a use
// inside a loop counts four times one outside it.
func AllocRegs(c *C, body *ovid/parse.Node, nparams i64) i64 {
  c.nsaved = 0
  WeighStmts(c, body, 0)
  var nfree i64 = 0
  var head i64 = 0
  var i i64 = 0
  if !StmtsCall(body) {
    while i < 6 {
      var r i64 = ArgReg(i)
      if r != 2 && r != 1 {
        if i < nparams {
          store64((c.locs + (i * LOCSIZE)) + LOC_REG, r)
        } else {
          store64(c.free + (nfree * 8), r)
          nfree = nfree + 1
        }
      }
      i = i + 1
    }
    store64(c.free + (nfree * 8), 10)
    store64((c.free + (nfree * 8)) + 8, 11)
    nfree = nfree + 2
  }
  var more bool = true
  while more {
    // The heaviest local without a register; the first of equals.
    var best i64 = 0
    var bestw i64 = 0
    i = 0
    while i < c.nloc {
      var rec i64 = c.locs + (i * LOCSIZE)
      if load64(rec + LOC_REG) < 0 && load64(rec + LOC_WEIGHT) > bestw {
        best = rec
        bestw = load64(rec + LOC_WEIGHT)
      }
      i = i + 1
    }
    if bestw == 0 {
      more = false
    } else if head < nfree {
      store64(best + LOC_REG, load64(c.free + (head * 8)))
      head = head + 1
    } else if c.nsaved < 5 && bestw >= 3 {
      store64(best + LOC_REG, CalleeReg(c.nsaved))
      store64(c.saved + (c.nsaved * 8), CalleeReg(c.nsaved))
      c.nsaved = c.nsaved + 1
    } else {
      more = false
    }
  }
  return 0
}

// The x86 group-1 operations, by their /digit.
const ALU_ADD i64 = 0
const ALU_OR i64 = 1
const ALU_AND i64 = 4
const ALU_SUB i64 = 5
const ALU_XOR i64 = 6
const ALU_CMP i64 = 7

func Uncast(n *ovid/parse.Node) *ovid/parse.Node {
  while n != 0 as *ovid/parse.Node && n.op == ovid/parse.OP_CAST {
    n = n.arg
  }
  return n
}

// Operand classifies n and returns its kind; c.opv gets the immediate or
// the displacement. Read c.opv before emitting anything else.
func Operand(c *C, n *ovid/parse.Node) i64 {
  n = Uncast(n)
  if n == 0 as *ovid/parse.Node {
    return KNONE
  }
  var op i64 = n.op
  var v i64 = 0
  if op == ovid/parse.OP_INT {
    v = n.ival
  } else if op == ovid/parse.OP_BOOL {
    if n.ival != 0 {
      v = 1
    }
  } else if op == ovid/parse.OP_STRLEN {
    v = n.strn
  } else if op == ovid/parse.OP_SIZEOF {
    v = SizeOf(c, n.typp, n.typn)
    if v < 0 {
      return KNONE
    }
  } else if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      var pc *ovid/parse.Decl = PkgConst(c, n)
      if pc == 0 as *ovid/parse.Decl {
        return KNONE
      }
      v = pc.val
    } else {
      var loc i64 = LocOf(c, n)
      if loc != 0 {
        c.opv = load64(loc + LOC_REG)
        if c.opv >= 0 {
          return KREG
        }
        c.opv = load64(loc + 16)
        return KMEM
      }
      var con *ovid/parse.Decl = ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen)
      if con == 0 as *ovid/parse.Decl {
        return KNONE
      }
      v = con.val
    }
  } else {
    return KNONE
  }
  if v < (0 - 0x80000000) || v > 0x7fffffff {
    return KNONE
  }
  c.opv = v
  return KIMM
}

// LoadOpnd moves an operand into reg.
func LoadOpnd(c *C, reg i64, k i64, v i64) i64 {
  if k == KIMM {
    return ovid/asm.MovRegImm(c.code, reg, v)
  }
  if k == KMEM {
    return ovid/asm.MovRegMemRbp(c.code, reg, v)
  }
  if reg != v {
    ovid/asm.MovRegReg(c.code, reg, v)
  }
  return 0
}

// AluOpnd emits op reg, operand for the group-1 operation n.
func AluOpnd(c *C, n i64, reg i64, k i64, v i64) i64 {
  if k == KIMM {
    return ovid/asm.AluRegImm(c.code, n, reg, v)
  }
  if k == KMEM {
    return ovid/asm.AluRegMem(c.code, n, reg, v)
  }
  return ovid/asm.AluRegReg(c.code, n, reg, v)
}

func AluOf(op i64) i64 {
  if op == ovid/parse.OP_ADD {
    return ALU_ADD
  }
  if op == ovid/parse.OP_SUB {
    return ALU_SUB
  }
  if op == ovid/parse.OP_AND {
    return ALU_AND
  }
  if op == ovid/parse.OP_OR {
    return ALU_OR
  }
  if op == ovid/parse.OP_XOR {
    return ALU_XOR
  }
  return -1
}

func Commutes(op i64) bool {
  return op == ovid/parse.OP_ADD || op == ovid/parse.OP_MUL || op == ovid/parse.OP_AND || op == ovid/parse.OP_OR || op == ovid/parse.OP_XOR
}

// ArithOpnd emits rax = rax op operand.
func ArithOpnd(c *C, op i64, k i64, v i64) i64 {
  if AluOf(op) >= 0 {
    return AluOpnd(c, AluOf(op), 0, k, v)
  }
  if op == ovid/parse.OP_MUL {
    if k == KIMM {
      return ovid/asm.ImulRaxImm(c.code, v)
    }
    if k == KMEM {
      return ovid/asm.ImulRaxMem(c.code, v)
    }
    return ovid/asm.ImulRaxReg(c.code, v)
  }
  if k == KIMM && (op == ovid/parse.OP_SHL || op == ovid/parse.OP_SHR) {
    // The same count the cl form would use: the low six bits.
    return ovid/asm.ShiftRaxImm(c.code, op == ovid/parse.OP_SHR, v & 63)
  }
  LoadOpnd(c, 1, k, v)
  return ArithRcx(c, op)
}

// ArithRcx emits rax = rax op rcx.
func ArithRcx(c *C, op i64) i64 {
  if op == ovid/parse.OP_ADD {
    ovid/asm.AddRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_SUB {
    ovid/asm.SubRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_MUL {
    ovid/asm.ImulRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_AND {
    ovid/asm.AndRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_OR {
    ovid/asm.OrRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_XOR {
    ovid/asm.XorRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_SHL {
    ovid/asm.ShlRaxCl(c.code)
    return 0
  }
  if op == ovid/parse.OP_SHR {
    ovid/asm.SarRaxCl(c.code)
    return 0
  }
  if op == ovid/parse.OP_DIV {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_MOD {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    ovid/asm.MovRegReg(c.code, 0, 2)
    return 0
  }
  return FailIn(c, strptr("bad arith op in "), strlen("bad arith op in "))
}

// EmitArith evaluates a binary arithmetic node into rax. A side that is an
// operand costs no temp; evaluating the other side first is safe because
// nothing an expression does can change a local or a constant.
func EmitArith(c *C, n *ovid/parse.Node, lv i64) i64 {
  var op i64 = n.op
  var k i64 = Operand(c, n.right)
  var v i64 = c.opv
  if k != KNONE {
    if EmitExpr(c, n.left, lv) != 0 {
      return c.err
    }
    return ArithOpnd(c, op, k, v)
  }
  k = Operand(c, n.left)
  v = c.opv
  if k != KNONE {
    if EmitExpr(c, n.right, lv) != 0 {
      return c.err
    }
    if Commutes(op) {
      return ArithOpnd(c, op, k, v)
    }
    ovid/asm.MovRegReg(c.code, 1, 0)
    LoadOpnd(c, 0, k, v)
    return ArithRcx(c, op)
  }
  if EmitExpr(c, n.left, lv) != 0 {
    return c.err
  }
  StoreTemp(c, lv)
  if EmitExpr(c, n.right, lv + 1) != 0 {
    return c.err
  }
  if Commutes(op) {
    return ArithOpnd(c, op, KMEM, TempDisp(c, lv))
  }
  ovid/asm.MovRegReg(c.code, 1, 0)
  ovid/asm.MovRaxMemRbp(c.code, TempDisp(c, lv))
  return ArithRcx(c, op)
}

// CcOf is a comparison's condition code: the low nibble shared by setcc
// (0F 9x) and jcc (0F 8x). Flipping bit 0 negates one.
func CcOf(op i64) i64 {
  if op == ovid/parse.OP_EQ {
    return 0x4
  }
  if op == ovid/parse.OP_NE {
    return 0x5
  }
  if op == ovid/parse.OP_LT {
    return 0xC
  }
  if op == ovid/parse.OP_GE {
    return 0xD
  }
  if op == ovid/parse.OP_LE {
    return 0xE
  }
  return 0xF
}

// CcSwap is the condition for the operands the other way round.
func CcSwap(cc i64) i64 {
  if cc == 0xC {
    return 0xF
  }
  if cc == 0xF {
    return 0xC
  }
  if cc == 0xD {
    return 0xE
  }
  if cc == 0xE {
    return 0xD
  }
  return cc
}

// EmitCmp sets the flags for a comparison node and returns the condition
// code under which it is true, or -1 on an error.
func EmitCmp(c *C, n *ovid/parse.Node, lv i64) i64 {
  var cc i64 = CcOf(n.op)
  var k i64 = Operand(c, n.right)
  var v i64 = c.opv
  if k != KNONE {
    // A local in a register is compared where it is.
    if Operand(c, n.left) == KREG {
      AluOpnd(c, ALU_CMP, c.opv, k, v)
      return cc
    }
    if EmitExpr(c, n.left, lv) != 0 {
      return -1
    }
    AluOpnd(c, ALU_CMP, 0, k, v)
    return cc
  }
  k = Operand(c, n.left)
  v = c.opv
  if k != KNONE {
    if EmitExpr(c, n.right, lv) != 0 {
      return -1
    }
    AluOpnd(c, ALU_CMP, 0, k, v)
    return CcSwap(cc)
  }
  if EmitExpr(c, n.left, lv) != 0 {
    return -1
  }
  StoreTemp(c, lv)
  if EmitExpr(c, n.right, lv + 1) != 0 {
    return -1
  }
  ovid/asm.AluMemReg(c.code, ALU_CMP, TempDisp(c, lv), 0)
  return cc
}

// EmitJump jumps to lab when the condition n is when, and falls through
// otherwise, without making the bool a value.
func EmitJump(c *C, n *ovid/parse.Node, lv i64, lab i64, when bool) i64 {
  if c.err != 0 {
    return c.err
  }
  n = Uncast(n)
  if n == 0 as *ovid/parse.Node {
    return FailIn(c, strptr("nil condition in "), strlen("nil condition in "))
  }
  var op i64 = n.op
  if CmpOp(op) {
    var cc i64 = EmitCmp(c, n, lv)
    if cc < 0 {
      return c.err
    }
    if !when {
      cc = cc ^ 1
    }
    ovid/asm.Jcc(c.code, 0x80 | cc, lab)
    return 0
  }
  if op == ovid/parse.OP_NOT {
    return EmitJump(c, n.arg, lv, lab, !when)
  }
  if (op == ovid/parse.OP_LAND && !when) || (op == ovid/parse.OP_LOR && when) {
    // Either side decides: both jump to lab.
    if EmitJump(c, n.left, lv, lab, when) != 0 {
      return c.err
    }
    return EmitJump(c, n.right, lv, lab, when)
  }
  if op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR {
    // The left side can only rule the jump out.
    var skip i64 = ovid/asm.NewLabel(c.code)
    if EmitJump(c, n.left, lv, skip, !when) != 0 {
      return c.err
    }
    if EmitJump(c, n.right, lv, lab, when) != 0 {
      return c.err
    }
    ovid/asm.Mark(c.code, skip)
    return 0
  }
  if op == ovid/parse.OP_BOOL {
    var yes bool = n.ival != 0
    if (yes && when) || (!yes && !when) {
      ovid/asm.Jmp(c.code, lab)
    }
    return 0
  }
  if EmitExpr(c, n, lv) != 0 {
    return c.err
  }
  ovid/asm.TestRaxRax(c.code)
  if when {
    ovid/asm.Jnz(c.code, lab)
  } else {
    ovid/asm.Jz(c.code, lab)
  }
  return 0
}

// SplitAddr peels the constant terms off an address expression: it returns
// what is left, and c.addrd gets their sum, for the instruction to carry
// as a displacement. Read c.addrd before emitting anything else.
func SplitAddr(c *C, n *ovid/parse.Node) *ovid/parse.Node {
  var d i64 = 0
  var more bool = true
  n = Uncast(n)
  while more && n != 0 as *ovid/parse.Node && (n.op == ovid/parse.OP_ADD || n.op == ovid/parse.OP_SUB) {
    more = Operand(c, n.right) == KIMM
    if more {
      var v i64 = c.opv
      if n.op == ovid/parse.OP_SUB {
        v = 0 - v
      }
      if (d + v) < (0 - 0x80000000) || (d + v) > 0x7fffffff {
        more = false
      } else {
        d = d + v
        n = Uncast(n.left)
      }
    }
  }
  c.addrd = d
  return n
}

// AddrMode reports whether n, an address with its constant terms taken
// off, is a local in a register or the sum of two; c.amBase and c.amIndex
// (-1 for none) then name them.
func AddrMode(c *C, n *ovid/parse.Node) bool {
  c.amIndex = -1
  if Operand(c, n) == KREG {
    c.amBase = c.opv
    return true
  }
  if n != 0 as *ovid/parse.Node && n.op == ovid/parse.OP_ADD {
    if Operand(c, n.left) == KREG {
      var l i64 = c.opv
      if Operand(c, n.right) == KREG {
        c.amBase = l
        c.amIndex = c.opv
        return true
      }
    }
  }
  return false
}

// EmitAddr makes an address usable as a memory operand: c.amBase is its
// base register, c.amIndex its index register (-1 for none), and the
// result its displacement, or ADDRERR. Locals in registers serve as they
// are; anything else is evaluated into rax. Read the three before emitting
// anything else.
func EmitAddr(c *C, n *ovid/parse.Node, lv i64) i64 {
  n = SplitAddr(c, n)
  var d i64 = c.addrd
  if AddrMode(c, n) {
    return d
  }
  if EmitExpr(c, n, lv) != 0 {
    return ADDRERR
  }
  c.amBase = 0
  c.amIndex = -1
  return d
}

const ADDRERR i64 = -1 << 62

// EmitStore stores val, width bits of it, at addr + off.
func EmitStore(c *C, addr *ovid/parse.Node, val *ovid/parse.Node, width i64, off i64) i64 {
  var k i64 = Operand(c, val)
  var v i64 = c.opv
  if k != KNONE {
    var d i64 = EmitAddr(c, addr, 0)
    if d == ADDRERR {
      return c.err
    }
    if k == KIMM {
      return ovid/asm.StoreMemImm(c.code, width, c.amBase, c.amIndex, off + d, v)
    }
    if k == KREG {
      return ovid/asm.StoreMemReg(c.code, width, v, c.amBase, c.amIndex, off + d)
    }
    ovid/asm.MovRcxMemRbp(c.code, v)
    return ovid/asm.StoreMemReg(c.code, width, 1, c.amBase, c.amIndex, off + d)
  }
  var n *ovid/parse.Node = SplitAddr(c, addr)
  var bd i64 = c.addrd
  if AddrMode(c, n) {
    var base i64 = c.amBase
    var index i64 = c.amIndex
    if EmitExpr(c, val, 0) != 0 {
      return c.err
    }
    return ovid/asm.StoreMemReg(c.code, width, 0, base, index, off + bd)
  }
  if Operand(c, n) == KMEM {
    var slot i64 = c.opv
    if EmitExpr(c, val, 0) != 0 {
      return c.err
    }
    ovid/asm.MovRcxMemRbp(c.code, slot)
    return ovid/asm.StoreMemReg(c.code, width, 0, 1, -1, off + bd)
  }
  if EmitExpr(c, n, 0) != 0 {
    return c.err
  }
  StoreTemp(c, 0)
  if EmitExpr(c, val, 1) != 0 {
    return c.err
  }
  ovid/asm.MovRcxMemRbp(c.code, TempDisp(c, 0))
  return ovid/asm.StoreMemReg(c.code, width, 0, 1, -1, off + bd)
}

// EmitAssign sets the local s names, whose record is loc, to s.val.
func EmitAssign(c *C, s *ovid/parse.Node, loc i64) i64 {
  var reg i64 = load64(loc + LOC_REG)
  var disp i64 = load64(loc + 16)
  var k i64 = Operand(c, s.val)
  var v i64 = c.opv
  if reg >= 0 && k != KNONE {
    return LoadOpnd(c, reg, k, v)
  }
  if k == KIMM {
    return ovid/asm.MovMemRbpImm(c.code, disp, v)
  }
  if k == KREG {
    return ovid/asm.MovMemRbpReg(c.code, v, disp)
  }
  // x = x op operand works on x in place.
  var n *ovid/parse.Node = Uncast(s.val)
  if n != 0 as *ovid/parse.Node && AluOf(n.op) >= 0 {
    if LocOf(c, Uncast(n.left)) == loc {
      k = Operand(c, n.right)
      v = c.opv
      if k != KNONE {
        if reg >= 0 {
          return AluOpnd(c, AluOf(n.op), reg, k, v)
        }
        if k == KIMM {
          return ovid/asm.AluMemImm(c.code, AluOf(n.op), disp, v)
        }
        if k == KREG {
          return ovid/asm.AluMemReg(c.code, AluOf(n.op), disp, v)
        }
        ovid/asm.MovRaxMemRbp(c.code, v)
        return ovid/asm.AluMemReg(c.code, AluOf(n.op), disp, 0)
      }
    }
  }
  if EmitExpr(c, s.val, 0) != 0 {
    return c.err
  }
  if reg >= 0 {
    return ovid/asm.MovRegReg(c.code, reg, 0)
  }
  return ovid/asm.MovMemRbpRax(c.code, disp)
}

func RegOf(sys bool, i i64) i64 {
  if sys {
    return SysReg(i)
  }
  return ArgReg(i)
}

// EmitArgs evaluates a call's arguments into its registers. An argument
// that is an operand is loaded last, straight into its register; the
// others go through temps, except the last of them, which is still in rax.
func EmitArgs(c *C, args *ovid/parse.Node, sys bool, lv i64) i64 {
  var last i64 = -1
  var i i64 = 0
  var a *ovid/parse.Node = args
  while a != 0 as *ovid/parse.Node {
    if Operand(c, a) == KNONE {
      last = i
    }
    i = i + 1
    a = a.next
  }
  i = 0
  a = args
  while a != 0 as *ovid/parse.Node {
    if Operand(c, a) == KNONE {
      if EmitExpr(c, a, lv + i) != 0 {
        return c.err
      }
      if i != last {
        StoreTemp(c, lv + i)
      }
    }
    i = i + 1
    a = a.next
  }
  if last >= 0 && RegOf(sys, last) != 0 {
    ovid/asm.MovRegReg(c.code, RegOf(sys, last), 0)
  }
  i = 0
  a = args
  while a != 0 as *ovid/parse.Node {
    if i != last && Operand(c, a) == KNONE {
      ovid/asm.MovRegMemRbp(c.code, RegOf(sys, i), TempDisp(c, lv + i))
    }
    i = i + 1
    a = a.next
  }
  i = 0
  a = args
  while a != 0 as *ovid/parse.Node {
    var k i64 = Operand(c, a)
    if k != KNONE {
      LoadOpnd(c, RegOf(sys, i), k, c.opv)
    }
    i = i + 1
    a = a.next
  }
  return 0
}

func EmitCall(c *C, n *ovid/parse.Node, lv i64) i64 {
  var fn *ovid/parse.Decl = Callee(c, n, c.pathp, c.pathn)
  if fn == 0 as *ovid/parse.Decl {
    return FailCall(c, n)
  }
  if ovid/parse.CountNodes(n.args) > 6 {
    Fail(c, strptr("arity "), strlen("arity "))
    return Add(c, n.fnp, n.fnn)
  }
  if EmitArgs(c, n.args, false, lv) != 0 {
    return c.err
  }
  ovid/asm.Call(c.code, fn.lab)
  return 0
}

func EmitSys(c *C, n *ovid/parse.Node, lv i64) i64 {
  if ovid/parse.CountNodes(n.args) != 7 {
    return Fail(c, strptr("syscall arity"), strlen("syscall arity"))
  }
  // The number is the first argument; record it for the build receipt.
  if Operand(c, n.args) == KIMM && c.opv >= 0 && c.opv < SYSMAX {
    store8(c.mod.sys + c.opv, 1)
  } else {
    c.mod.sysunk = c.mod.sysunk + 1
  }
  if EmitArgs(c, n.args, true, lv) != 0 {
    return c.err
  }
  ovid/asm.Syscall(c.code)
  return 0
}

func EmitExpr(c *C, n *ovid/parse.Node, lv i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 as *ovid/parse.Node {
    return FailIn(c, strptr("nil expr in "), strlen("nil expr in "))
  }
  var op i64 = n.op
  if op == ovid/parse.OP_INT {
    ovid/asm.MovRegImm(c.code, 0, n.ival)
    return 0
  }
  if op == ovid/parse.OP_SIZEOF {
    var sz i64 = SizeOf(c, n.typp, n.typn)
    if sz < 0 {
      return c.err
    }
    ovid/asm.MovRegImm(c.code, 0, sz)
    return 0
  }
  if op == ovid/parse.OP_BOOL {
    var b i64 = 0
    if n.ival != 0 {
      b = 1
    }
    ovid/asm.MovRegImm(c.code, 0, b)
    return 0
  }
  if op == ovid/parse.OP_STRPTR {
    var off i64 = ovid/asm.Intern(c.code, n.strp, n.strn)
    ovid/asm.MovRegImm64(c.code, 0, 0)
    ovid/asm.AbsHere(c.code, off)
    return 0
  }
  if op == ovid/parse.OP_STRLEN {
    ovid/asm.MovRegImm(c.code, 0, n.strn)
    return 0
  }
  if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      var pc *ovid/parse.Decl = PkgConst(c, n)
      if pc == 0 as *ovid/parse.Decl {
        return FailName(c, strptr("const "), strlen("const "), n)
      }
      ovid/asm.MovRegImm(c.code, 0, pc.val)
      return 0
    }
    var loc i64 = LocOf(c, n)
    if loc != 0 {
      if load64(loc + LOC_REG) >= 0 {
        ovid/asm.MovRegReg(c.code, 0, load64(loc + LOC_REG))
      } else {
        ovid/asm.MovRaxMemRbp(c.code, load64(loc + 16))
      }
      return 0
    }
    var con *ovid/parse.Decl = ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen)
    if con != 0 as *ovid/parse.Decl {
      ovid/asm.MovRegImm(c.code, 0, con.val)
      return 0
    }
    return FailName(c, strptr("name "), strlen("name "), n)
  }
  if ArithOp(op) {
    return EmitArith(c, n, lv)
  }
  if CmpOp(op) {
    var cc i64 = EmitCmp(c, n, lv)
    if cc < 0 {
      return c.err
    }
    ovid/asm.SetccAl(c.code, 0x90 | cc)
    ovid/asm.MovzxRaxAl(c.code)
    return 0
  }
  if op == ovid/parse.OP_LAND {
    var no i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    if EmitJump(c, n.left, lv, no, false) != 0 {
      return c.err
    }
    if EmitExpr(c, n.right, lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, end)
    ovid/asm.Mark(c.code, no)
    ovid/asm.XorRaxRax(c.code)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if op == ovid/parse.OP_LOR {
    var yes i64 = ovid/asm.NewLabel(c.code)
    var done i64 = ovid/asm.NewLabel(c.code)
    if EmitJump(c, n.left, lv, yes, true) != 0 {
      return c.err
    }
    if EmitExpr(c, n.right, lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, done)
    ovid/asm.Mark(c.code, yes)
    ovid/asm.MovRegImm(c.code, 0, 1)
    ovid/asm.Mark(c.code, done)
    return 0
  }
  if op == ovid/parse.OP_CAST {
    return EmitExpr(c, n.arg, lv)
  }
  if op == ovid/parse.OP_FIELD {
    var foff i64 = FieldOff(c, n.base, n.namep, n.namen)
    if foff < 0 {
      return c.err
    }
    var fd i64 = EmitAddr(c, n.base, lv)
    if fd == ADDRERR {
      return c.err
    }
    ovid/asm.LoadMem(c.code, 64, c.amBase, c.amIndex, foff + fd)
    return 0
  }
  if op == ovid/parse.OP_CALL {
    return EmitCall(c, n, lv)
  }
  if op == ovid/parse.OP_SYSCALL {
    return EmitSys(c, n, lv)
  }
  if op == ovid/parse.OP_LOAD8 || op == ovid/parse.OP_LOAD32 || op == ovid/parse.OP_LOAD64 {
    var ld i64 = EmitAddr(c, n.arg, lv)
    if ld == ADDRERR {
      return c.err
    }
    var width i64 = 64
    if op == ovid/parse.OP_LOAD8 {
      width = 8
    } else if op == ovid/parse.OP_LOAD32 {
      width = 32
    }
    ovid/asm.LoadMem(c.code, width, c.amBase, c.amIndex, ld)
    return 0
  }
  if !UnaryOp(op) {
    return FailIn(c, strptr("bad expr op in "), strlen("bad expr op in "))
  }
  if EmitExpr(c, n.arg, lv) != 0 {
    return c.err
  }
  if op == ovid/parse.OP_NOT {
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.SetccAl(c.code, 0x94)
    ovid/asm.MovzxRaxAl(c.code)
  } else if op == ovid/parse.OP_NEG {
    ovid/asm.NegRax(c.code)
  } else {
    ovid/asm.NotRax(c.code)
  }
  return 0
}

func EmitStmts(c *C, s *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  while s != 0 as *ovid/parse.Node {
    if EmitStmt(c, s) != 0 {
      return c.err
    }
    s = s.next
  }
  return 0
}

func EmitStmt(c *C, s *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  var op i64 = s.op
  if op == ovid/parse.OP_VAR || op == ovid/parse.OP_ASSIGN {
    var loc i64 = LocOf(c, s)
    if loc == 0 {
      if op == ovid/parse.OP_VAR {
        Fail(c, strptr("var "), strlen("var "))
      } else {
        Fail(c, strptr("assign "), strlen("assign "))
      }
      return Add(c, s.namep, s.namen)
    }
    if s.val == 0 as *ovid/parse.Node && op == ovid/parse.OP_VAR {
      // A declaration without a value makes the local zero, each time it
      // runs: the frame is not cleared on entry, and the slot may have been
      // a sibling block's.
      if load64(loc + LOC_REG) >= 0 {
        return ovid/asm.MovRegImm(c.code, load64(loc + LOC_REG), 0)
      }
      return ovid/asm.MovMemRbpImm(c.code, load64(loc + 16), 0)
    }
    return EmitAssign(c, s, loc)
  }
  if op == ovid/parse.OP_SETFIELD {
    var off i64 = FieldOff(c, s.base, s.namep, s.namen)
    if off < 0 {
      return c.err
    }
    return EmitStore(c, s.base, s.val, 64, off)
  }
  if op == ovid/parse.OP_STORE8 {
    return EmitStore(c, s.addr, s.val, 8, 0)
  }
  if op == ovid/parse.OP_STORE64 {
    return EmitStore(c, s.addr, s.val, 64, 0)
  }
  if op == ovid/parse.OP_EXPR {
    return EmitExpr(c, s.val, 0)
  }
  if op == ovid/parse.OP_RETURN {
    if s.val != 0 as *ovid/parse.Node {
      if EmitExpr(c, s.val, 0) != 0 {
        return c.err
      }
    } else {
      ovid/asm.XorRaxRax(c.code)
    }
    // The func's last statement falls into the epilogue.
    if s != c.last {
      ovid/asm.Jmp(c.code, c.epi)
    }
    return 0
  }
  if op == ovid/parse.OP_IF {
    var end i64 = ovid/asm.NewLabel(c.code)
    var elseL i64 = end
    if s.els != 0 as *ovid/parse.Node {
      elseL = ovid/asm.NewLabel(c.code)
    }
    if EmitJump(c, s.cond, 0, elseL, false) != 0 {
      return c.err
    }
    if EmitStmts(c, s.then) != 0 {
      return c.err
    }
    if s.els != 0 as *ovid/parse.Node {
      ovid/asm.Jmp(c.code, end)
      ovid/asm.Mark(c.code, elseL)
      if EmitStmts(c, s.els) != 0 {
        return c.err
      }
    }
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if op == ovid/parse.OP_WHILE {
    // The condition sits below the body, so each turn of the loop takes
    // one jump: jmp test; body: ...; test: if cond goto body.
    var top i64 = ovid/asm.NewLabel(c.code)
    var test i64 = ovid/asm.NewLabel(c.code)
    ovid/asm.Jmp(c.code, test)
    ovid/asm.Mark(c.code, top)
    if EmitStmts(c, s.body) != 0 {
      return c.err
    }
    ovid/asm.Mark(c.code, test)
    return EmitJump(c, s.cond, 0, top, true)
  }
  return FailIn(c, strptr("bad stmt op in "), strlen("bad stmt op in "))
}

func EmitFunc(c *C, fn *ovid/parse.Decl) i64 {
  c.nloc = 0
  c.nscope = 0
  c.live = 0
  c.err = 0
  c.pkg = fn.pkg
  c.pathp = fn.pkg.pathp
  c.pathn = fn.pkg.pathn
  c.fn = fn
  var pa *ovid/parse.Decl = c.fn.sub
  while pa != 0 as *ovid/parse.Decl {
    AddLoc(c, 0 as *ovid/parse.Node, pa.namep, pa.namen, pa.typp, pa.typn)
    pa = pa.next
  }
  var body *ovid/parse.Node = c.fn.body
  BindStmts(c, body)
  if c.err != 0 {
    return c.err
  }
  c.localBytes = c.live * 8
  c.peak = StmtsPeak(body)
  var tempBytes i64 = 0
  if c.peak >= 0 {
    tempBytes = (c.peak + 1) * 8
  }
  AllocRegs(c, body, ovid/parse.CountDecls(c.fn.sub))
  c.saveBase = 0 - (c.localBytes + tempBytes)
  var frame i64 = (c.localBytes + tempBytes) + (c.nsaved * 8)
  if (frame % 16) != 0 {
    frame = frame + 8
  }
  c.epi = ovid/asm.NewLabel(c.code)
  ovid/asm.Mark(c.code, fn.lab)
  ovid/asm.PushReg(c.code, 5)
  ovid/asm.MovRegReg(c.code, 5, 4)
  // The frame is not cleared: the checker lets no local be read before
  // its declaration has run, a declaration always writes its local (zero
  // when it gives no value), and a temp is written before it is read.
  ovid/asm.SubRsp(c.code, frame)
  var i i64 = 0
  while i < c.nsaved {
    ovid/asm.MovMemRbpReg(c.code, load64(c.saved + (i * 8)), c.saveBase - ((i + 1) * 8))
    i = i + 1
  }
  i = 0
  pa = c.fn.sub
  while pa != 0 as *ovid/parse.Decl {
    var loc i64 = c.locs + (i * LOCSIZE)
    var r i64 = load64(loc + LOC_REG)
    if r < 0 {
      ovid/asm.MovMemRbpReg(c.code, ArgReg(i), load64(loc + 16))
    } else if r != ArgReg(i) {
      ovid/asm.MovRegReg(c.code, r, ArgReg(i))
    }
    i = i + 1
    pa = pa.next
  }
  // last is the func's final statement when it is a return.
  c.last = body
  while c.last != 0 as *ovid/parse.Node && c.last.next != 0 as *ovid/parse.Node {
    c.last = c.last.next
  }
  if c.last != 0 as *ovid/parse.Node && c.last.op != ovid/parse.OP_RETURN {
    c.last = 0 as *ovid/parse.Node
  }
  if EmitStmts(c, body) != 0 {
    return c.err
  }
  if c.last == 0 as *ovid/parse.Node {
    ovid/asm.XorRaxRax(c.code)
  }
  ovid/asm.Mark(c.code, c.epi)
  i = 0
  while i < c.nsaved {
    ovid/asm.MovRegMemRbp(c.code, load64(c.saved + (i * 8)), c.saveBase - ((i + 1) * 8))
    i = i + 1
  }
  ovid/asm.Leave(c.code)
  ovid/asm.Ret(c.code)
  return 0
}

// MarkLive flags fn as reachable and queues it for LiveFrom. Only live
// funcs are emitted, matching the Go compiler.
func MarkLive(c *C, fn *ovid/parse.Decl) i64 {
  if fn.live != 0 {
    return 0
  }
  fn.live = 1
  if c.nwork >= c.workcap {
    var w i64 = ovid/io.Alloc(c.io, c.workcap * 16)
    ovid/mem.Copy(w, c.work, c.workcap * 8)
    c.work = w
    c.workcap = c.workcap * 2
  }
  store64(c.work + (c.nwork * 8), fn as i64)
  c.nwork = c.nwork + 1
  return 0
}

// LiveFrom marks every func reachable from fn. The queue keeps a long call
// chain from becoming deep recursion.
func LiveFrom(c *C, fn *ovid/parse.Decl) i64 {
  c.workcap = 256
  c.work = ovid/io.Alloc(c.io, c.workcap * 8)
  MarkLive(c, fn)
  while c.nwork > 0 {
    c.nwork = c.nwork - 1
    var f *ovid/parse.Decl = load64(c.work + (c.nwork * 8)) as *ovid/parse.Decl
    WalkLive(c, f.body, f.pkg.pathp, f.pkg.pathn)
  }
  return 0
}

// WalkLive marks the callee of every call in the node list n; pp/pn is the
// package that unqualified calls resolve in.
func WalkLive(c *C, n *ovid/parse.Node, pp i64, pn i64) i64 {
  while n != 0 as *ovid/parse.Node {
    if n.op == ovid/parse.OP_CALL {
      var fn *ovid/parse.Decl = Callee(c, n, pp, pn)
      if fn != 0 as *ovid/parse.Decl {
        MarkLive(c, fn)
      }
    }
    WalkLive(c, n.left, pp, pn)
    WalkLive(c, n.right, pp, pn)
    WalkLive(c, n.arg, pp, pn)
    WalkLive(c, n.base, pp, pn)
    WalkLive(c, n.addr, pp, pn)
    WalkLive(c, n.val, pp, pn)
    WalkLive(c, n.cond, pp, pn)
    WalkLive(c, n.args, pp, pn)
    WalkLive(c, n.then, pp, pn)
    WalkLive(c, n.els, pp, pn)
    WalkLive(c, n.body, pp, pn)
    n = n.next
  }
  return 0
}

func EmitStartup(c *C, mainLab i64) i64 {
  var argcOff i64 = CapOff(c, strptr("argc"), strlen("argc"))
  var argvOff i64 = CapOff(c, strptr("argv"), strlen("argv"))
  var heapOff i64 = CapOff(c, strptr("heap"), strlen("heap"))
  var usedOff i64 = CapOff(c, strptr("used"), strlen("used"))
  var sizeOff i64 = CapOff(c, strptr("size"), strlen("size"))
  if argcOff < 0 {
    return c.err
  }
  if argvOff < 0 {
    return c.err
  }
  if heapOff < 0 {
    return c.err
  }
  if usedOff < 0 {
    return c.err
  }
  if sizeOff < 0 {
    return c.err
  }
  var fail i64 = ovid/asm.NewLabel(c.code)
  ovid/asm.MovR12MemRsp(c.code)
  ovid/asm.LeaR13Rsp8(c.code)
  ovid/asm.AndRspAlign(c.code)
  ovid/asm.MovRegImm64(c.code, 7, 0)
  ovid/asm.MovRegImm64(c.code, 6, HEAP)
  ovid/asm.MovRegImm64(c.code, 2, 3)
  // MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE, as in internal/compile.
  ovid/asm.MovRegImm64(c.code, 10, 0x4022)
  ovid/asm.MovRegImm64(c.code, 8, -1)
  ovid/asm.MovRegImm64(c.code, 9, 0)
  ovid/asm.MovRegImm64(c.code, 0, 9)
  ovid/asm.Syscall(c.code)
  ovid/asm.MovRegReg(c.code, 14, 0)
  ovid/asm.TestRaxRax(c.code)
  ovid/asm.Jl(c.code, fail)
  ovid/asm.SubRsp(c.code, 48)
  ovid/asm.MovRegReg(c.code, 1, 4)
  ovid/asm.MovRegReg(c.code, 0, 12)
  ovid/asm.MovMemRegDispRax(c.code, 1, argcOff)
  ovid/asm.MovRegReg(c.code, 0, 13)
  ovid/asm.MovMemRegDispRax(c.code, 1, argvOff)
  ovid/asm.MovRegReg(c.code, 0, 14)
  ovid/asm.MovMemRegDispRax(c.code, 1, heapOff)
  ovid/asm.MovRegImm64(c.code, 0, 0)
  ovid/asm.MovMemRegDispRax(c.code, 1, usedOff)
  // Cap's sixth field, net, starts as 0: ovid/io fills it on first use.
  // It is the last of the 48 bytes reserved above.
  ovid/asm.MovMemRegDispRax(c.code, 1, 40)
  ovid/asm.MovRegImm64(c.code, 0, HEAP)
  ovid/asm.MovMemRegDispRax(c.code, 1, sizeOff)
  ovid/asm.MovRegReg(c.code, 7, 4)
  // The network handle, for a main that takes one: the same block as
  // the Cap under another type, so it costs nothing to make.
  ovid/asm.MovRegReg(c.code, 6, 4)
  ovid/asm.Call(c.code, mainLab)
  ovid/asm.MovRegReg(c.code, 7, 0)
  ovid/asm.MovRegImm64(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  // "out of memory\n" on standard error and exit 71, as in internal/compile.
  ovid/asm.Mark(c.code, fail)
  ovid/asm.MovRegImm64(c.code, 0, 0xa79726f6d65)
  ovid/asm.PushReg(c.code, 0)
  ovid/asm.MovRegImm64(c.code, 0, 0x6d20666f2074756f)
  ovid/asm.PushReg(c.code, 0)
  ovid/asm.MovRegImm64(c.code, 7, 2)
  ovid/asm.MovRegReg(c.code, 6, 4)
  ovid/asm.MovRegImm64(c.code, 2, 14)
  ovid/asm.MovRegImm64(c.code, 0, 1)
  ovid/asm.Syscall(c.code)
  ovid/asm.MovRegImm64(c.code, 7, 71)
  ovid/asm.MovRegImm64(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  return 0
}

// Compile emits the checked module m as a static executable, or returns
// nil with a *ovid/mem.Buf at errp that says what failed.
func Compile(io *ovid/io.Cap, m *ovid/parse.Mod, errp i64) *ovid/mem.Buf {
  var z i64 = 0
  store64(errp, 0)
  var c *C = ovid/io.Alloc(io, sizeof(C)) as *C
  c.io = io
  c.mod = m
  c.code = ovid/asm.New(io)
  if IndexProg(c) != 0 {
    store64(errp, c.msg as i64)
    return z as *ovid/mem.Buf
  }
  var mainFn *ovid/parse.Decl = ovid/parse.FindFunc(m, m.entryp, m.entryn, strptr("main"), strlen("main"))
  if mainFn == 0 as *ovid/parse.Decl {
    Fail(c, strptr("missing "), strlen("missing "))
    Add(c, m.entryp, m.entryn)
    Add(c, strptr(".main"), strlen(".main"))
    store64(errp, c.msg as i64)
    return z as *ovid/mem.Buf
  }
  // m.sys marks the numbers of the system calls the program can make.
  // The startup code maps the heap, exits with main's result, and writes
  // "out of memory" when the heap is refused.
  m.sys = ovid/io.Alloc(io, SYSMAX)
  m.sysunk = 0
  store8(m.sys + 1, 1)
  store8(m.sys + 9, 1)
  store8(m.sys + 60, 1)
  if EmitStartup(c, mainFn.lab) != 0 {
    store64(errp, c.msg as i64)
    return z as *ovid/mem.Buf
  }
  LiveFrom(c, mainFn)
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      if f.live != 0 {
        if EmitFunc(c, f) != 0 {
          store64(errp, c.msg as i64)
          return z as *ovid/mem.Buf
        }
      }
      f = f.next
    }
    k = k.next
  }
  ovid/asm.Patch(c.code)
  return ovid/elf.Link(io, c.code)
}
