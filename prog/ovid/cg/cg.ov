package ovid/cg

import ovid/io
import ovid/mem
import ovid/asm
import ovid/elf
import ovid/parse

const HEAP i64 = 128 << 20
const MAXLOC i64 = 1024

// C is the code generator's state. pkg/pathp/fn are the func being
// emitted; locs holds its params and vars.
type C struct {
  io *ovid/io.Cap
  code *ovid/asm.Code
  mod *ovid/parse.Mod
  work i64
  nwork i64
  workcap i64
  pkg *ovid/parse.Pkg
  pathp i64
  pathn i64
  fn *ovid/parse.Decl
  locs i64
  nloc i64
  localBytes i64
  epi i64
  err i64
  peak i64
  typ i64
  tyn i64
}

func Fail(c *C, code i64) i64 {
  if c.err == 0 {
    c.err = code
  }
  return c.err
}

func Max(a i64, b i64) i64 {
  if a > b {
    return a
  }
  return b
}

func LeafOp(op i64) bool {
  return op == ovid/parse.OP_INT || op == ovid/parse.OP_SIZEOF || op == ovid/parse.OP_STRPTR || op == ovid/parse.OP_STRLEN
}

func ArithOp(op i64) bool {
  return op >= ovid/parse.OP_ADD && op <= ovid/parse.OP_SHR
}

func CmpOp(op i64) bool {
  return op >= ovid/parse.OP_EQ && op <= ovid/parse.OP_GE
}

func UnaryOp(op i64) bool {
  if op == ovid/parse.OP_NOT || op == ovid/parse.OP_NEG || op == ovid/parse.OP_BNOT || op == ovid/parse.OP_CAST {
    return true
  }
  return op == ovid/parse.OP_LOAD8 || op == ovid/parse.OP_LOAD32 || op == ovid/parse.OP_LOAD64
}

func FindPkg(c *C, pp i64, pn i64) *ovid/parse.Pkg {
  var k *ovid/parse.Pkg = c.mod.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if ovid/mem.Eq(k.pathp, k.pathn, pp, pn) {
      return k
    }
    k = k.next
  }
  return k
}

// PkgConst returns the const that name node n refers to in another
// package (n.pkg is set), or nil.
func PkgConst(c *C, n *ovid/parse.Node) *ovid/parse.Decl {
  var k *ovid/parse.Pkg = FindPkg(c, n.pkgp, n.pkgn)
  if k == 0 as *ovid/parse.Pkg {
    return 0 as *ovid/parse.Decl
  }
  return ovid/parse.FindDecl(k.cs, n.namep, n.namen)
}

// IndexProg gives every func its label, in program order.
func IndexProg(c *C) i64 {
  var k *ovid/parse.Pkg = c.mod.pkgs
  if k == 0 as *ovid/parse.Pkg {
    return Fail(c, 1)
  }
  c.locs = ovid/io.Alloc(c.io, MAXLOC * 40)
  while k != 0 as *ovid/parse.Pkg {
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      f.lab = ovid/asm.NewLabel(c.code)
      f = f.next
    }
    k = k.next
  }
  return 0
}

func FindLoc(c *C, np i64, nn i64) i64 {
  var i i64 = 0
  while i < c.nloc {
    var rec i64 = c.locs + (i * 40)
    if ovid/mem.Eq(load64(rec + 0), load64(rec + 8), np, nn) {
      return rec
    }
    i = i + 1
  }
  return 0
}

func AddLoc(c *C, np i64, nn i64, tp i64, tn i64) i64 {
  var rec i64 = FindLoc(c, np, nn)
  if rec != 0 {
    store64(rec + 24, tp)
    store64(rec + 32, tn)
    return 0
  }
  if c.nloc >= MAXLOC {
    return Fail(c, 6)
  }
  rec = c.locs + (c.nloc * 40)
  store64(rec + 0, np)
  store64(rec + 8, nn)
  store64(rec + 16, 0 - ((c.nloc + 1) * 8))
  store64(rec + 24, tp)
  store64(rec + 32, tn)
  c.nloc = c.nloc + 1
  return 0
}

// CollectStmts gives every var declared in the statement list s a slot.
func CollectStmts(c *C, s *ovid/parse.Node) i64 {
  while s != 0 as *ovid/parse.Node {
    if s.op == ovid/parse.OP_VAR {
      if s.namen != 0 {
        AddLoc(c, s.namep, s.namen, s.typp, s.typn)
      }
    } else if s.op == ovid/parse.OP_IF {
      CollectStmts(c, s.then)
      CollectStmts(c, s.els)
    } else if s.op == ovid/parse.OP_WHILE {
      CollectStmts(c, s.body)
    }
    s = s.next
  }
  return 0
}

func CallPeak(n *ovid/parse.Node, lv i64) i64 {
  var m i64 = -1
  var i i64 = 0
  var a *ovid/parse.Node = n.args
  while a != 0 as *ovid/parse.Node {
    var p i64 = ExprPeak(a, lv + i)
    m = Max(m, Max(p, lv + i))
    i = i + 1
    a = a.next
  }
  return m
}

// ExprPeak is the highest temp slot evaluating n at level lv uses, or -1.
func ExprPeak(n *ovid/parse.Node, lv i64) i64 {
  if n == 0 as *ovid/parse.Node {
    return -1
  }
  var op i64 = n.op
  if LeafOp(op) || op == ovid/parse.OP_BOOL || op == ovid/parse.OP_NAME {
    return -1
  }
  if ArithOp(op) || CmpOp(op) {
    var l i64 = ExprPeak(n.left, lv)
    var r i64 = ExprPeak(n.right, lv + 1)
    return Max(l, Max(r, lv))
  }
  if op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR {
    var l i64 = ExprPeak(n.left, lv)
    var r i64 = ExprPeak(n.right, lv)
    return Max(l, r)
  }
  if UnaryOp(op) {
    return ExprPeak(n.arg, lv)
  }
  if op == ovid/parse.OP_FIELD {
    return ExprPeak(n.base, lv)
  }
  if op == ovid/parse.OP_CALL || op == ovid/parse.OP_SYSCALL {
    return CallPeak(n, lv)
  }
  return lv
}

func StmtsPeak(s *ovid/parse.Node) i64 {
  var m i64 = -1
  while s != 0 as *ovid/parse.Node {
    m = Max(m, StmtPeak(s))
    s = s.next
  }
  return m
}

func StmtPeak(s *ovid/parse.Node) i64 {
  var op i64 = s.op
  if op == ovid/parse.OP_VAR || op == ovid/parse.OP_ASSIGN || op == ovid/parse.OP_EXPR || op == ovid/parse.OP_RETURN {
    return ExprPeak(s.val, 0)
  }
  if op == ovid/parse.OP_SETFIELD {
    var b i64 = ExprPeak(s.base, 0)
    var v i64 = ExprPeak(s.val, 1)
    return Max(b, Max(v, 1))
  }
  if op == ovid/parse.OP_STORE8 || op == ovid/parse.OP_STORE64 {
    var b i64 = ExprPeak(s.addr, 0)
    var v i64 = ExprPeak(s.val, 1)
    return Max(b, Max(v, 1))
  }
  if op == ovid/parse.OP_IF {
    var m i64 = ExprPeak(s.cond, 0)
    m = Max(m, StmtsPeak(s.then))
    m = Max(m, StmtsPeak(s.els))
    return m
  }
  if op == ovid/parse.OP_WHILE {
    var cnd i64 = ExprPeak(s.cond, 0)
    return Max(cnd, StmtsPeak(s.body))
  }
  return -1
}

func SetI64(c *C) i64 {
  c.typ = strptr("i64")
  c.tyn = strlen("i64")
  return 0
}

func SetBool(c *C) i64 {
  c.typ = strptr("bool")
  c.tyn = strlen("bool")
  return 0
}

// FindType returns the struct type pkg.T named by tp[0:tn], or nil.
func FindType(c *C, tp i64, tn i64) *ovid/parse.Decl {
  var dot i64 = -1
  var i i64 = 0
  while i < tn {
    if load8(tp + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return 0 as *ovid/parse.Decl
  }
  var k *ovid/parse.Pkg = FindPkg(c, tp, dot)
  if k == 0 as *ovid/parse.Pkg {
    return 0 as *ovid/parse.Decl
  }
  return ovid/parse.FindDecl(k.ts, (tp + dot) + 1, (tn - dot) - 1)
}

// SizeOf is the byte size of struct type pkg.T (tp/tn): 8 per field.
func SizeOf(c *C, tp i64, tn i64) i64 {
  var t *ovid/parse.Decl = FindType(c, tp, tn)
  if t == 0 as *ovid/parse.Decl {
    Fail(c, 4)
    return -1
  }
  return ovid/parse.CountDecls(t.sub) * 8
}

// OffsetOf is the byte offset of field fp[0:fnn] in the pointer type
// tp[0:tn] (*pkg.T); it sets the current type to the field's.
func OffsetOf(c *C, tp i64, tn i64, fp i64, fnn i64) i64 {
  var t *ovid/parse.Decl = 0 as *ovid/parse.Decl
  if tn >= 2 {
    if load8(tp) == 42 {
      t = FindType(c, tp + 1, tn - 1)
    }
  }
  if t == 0 as *ovid/parse.Decl {
    Fail(c, 4)
    return -1
  }
  var k i64 = 0
  var f *ovid/parse.Decl = t.sub
  while f != 0 as *ovid/parse.Decl {
    if ovid/mem.Eq(f.namep, f.namen, fp, fnn) {
      c.typ = f.typp
      c.tyn = f.typn
      return k * 8
    }
    k = k + 1
    f = f.next
  }
  Fail(c, 4)
  return -1
}

// Callee returns the func that call node n resolves to, or nil; pp/pn is
// the package an unqualified call resolves in.
func Callee(c *C, n *ovid/parse.Node, pp i64, pn i64) *ovid/parse.Decl {
  if n.pkgn != 0 {
    pp = n.pkgp
    pn = n.pkgn
  }
  return ovid/parse.FindFunc(c.mod, pp, pn, n.fnp, n.fnn)
}

func TypeOf(c *C, n *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 as *ovid/parse.Node {
    return Fail(c, 5)
  }
  var op i64 = n.op
  if LeafOp(op) || ArithOp(op) || op == ovid/parse.OP_NEG || op == ovid/parse.OP_BNOT {
    return SetI64(c)
  }
  if op == ovid/parse.OP_LOAD8 || op == ovid/parse.OP_LOAD32 || op == ovid/parse.OP_LOAD64 || op == ovid/parse.OP_SYSCALL {
    return SetI64(c)
  }
  if op == ovid/parse.OP_BOOL || CmpOp(op) || op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR || op == ovid/parse.OP_NOT {
    return SetBool(c)
  }
  if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      if PkgConst(c, n) != 0 as *ovid/parse.Decl {
        return SetI64(c)
      }
      return Fail(c, 2)
    }
    var loc i64 = FindLoc(c, n.namep, n.namen)
    if loc == 0 {
      if ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen) != 0 as *ovid/parse.Decl {
        return SetI64(c)
      }
      return Fail(c, 2)
    }
    c.typ = load64(loc + 24)
    c.tyn = load64(loc + 32)
    return 0
  }
  if op == ovid/parse.OP_CAST {
    c.typ = n.typp
    c.tyn = n.typn
    return 0
  }
  if op == ovid/parse.OP_FIELD {
    if TypeOf(c, n.base) != 0 {
      return c.err
    }
    if OffsetOf(c, c.typ, c.tyn, n.namep, n.namen) < 0 {
      return c.err
    }
    return 0
  }
  if op == ovid/parse.OP_CALL {
    var fn *ovid/parse.Decl = Callee(c, n, c.pathp, c.pathn)
    if fn == 0 as *ovid/parse.Decl {
      return Fail(c, 3)
    }
    c.typ = fn.typp
    c.tyn = fn.typn
    return 0
  }
  return Fail(c, 5)
}

func FieldOff(c *C, base *ovid/parse.Node, fp i64, fnn i64) i64 {
  if TypeOf(c, base) != 0 {
    return -1
  }
  return OffsetOf(c, c.typ, c.tyn, fp, fnn)
}

// CapOff is the offset of field fp[0:fnn] in ovid/io.Cap.
func CapOff(c *C, fp i64, fnn i64) i64 {
  return OffsetOf(c, strptr("*ovid/io.Cap"), strlen("*ovid/io.Cap"), fp, fnn)
}

func TempDisp(c *C, lv i64) i64 {
  return 0 - (c.localBytes + ((lv + 1) * 8))
}

func StoreTemp(c *C, lv i64) i64 {
  ovid/asm.MovMemRbpRax(c.code, TempDisp(c, lv))
  return 0
}

func ArgReg(i i64) i64 {
  if i == 0 {
    return 7
  }
  if i == 1 {
    return 6
  }
  if i == 2 {
    return 2
  }
  if i == 3 {
    return 1
  }
  if i == 4 {
    return 8
  }
  return 9
}

func SysReg(i i64) i64 {
  if i == 0 {
    return 0
  }
  if i == 1 {
    return 7
  }
  if i == 2 {
    return 6
  }
  if i == 3 {
    return 2
  }
  if i == 4 {
    return 10
  }
  if i == 5 {
    return 8
  }
  return 9
}

func EmitBin(c *C, n *ovid/parse.Node, lv i64) i64 {
  if EmitExpr(c, n.left, lv) != 0 {
    return c.err
  }
  StoreTemp(c, lv)
  if EmitExpr(c, n.right, lv + 1) != 0 {
    return c.err
  }
  ovid/asm.MovRegReg(c.code, 1, 0)
  ovid/asm.MovRaxMemRbp(c.code, TempDisp(c, lv))
  return 0
}

func EmitArith(c *C, op i64) i64 {
  if op == ovid/parse.OP_ADD {
    ovid/asm.AddRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_SUB {
    ovid/asm.SubRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_MUL {
    ovid/asm.ImulRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_AND {
    ovid/asm.AndRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_OR {
    ovid/asm.OrRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_XOR {
    ovid/asm.XorRaxRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_SHL {
    ovid/asm.ShlRaxCl(c.code)
    return 0
  }
  if op == ovid/parse.OP_SHR {
    ovid/asm.SarRaxCl(c.code)
    return 0
  }
  if op == ovid/parse.OP_DIV {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    return 0
  }
  if op == ovid/parse.OP_MOD {
    ovid/asm.Cqo(c.code)
    ovid/asm.IdivRcx(c.code)
    ovid/asm.MovRegReg(c.code, 0, 2)
    return 0
  }
  return Fail(c, 5)
}

func CmpCC(op i64) i64 {
  if op == ovid/parse.OP_EQ {
    return 0x94
  }
  if op == ovid/parse.OP_NE {
    return 0x95
  }
  if op == ovid/parse.OP_LT {
    return 0x9C
  }
  if op == ovid/parse.OP_GE {
    return 0x9D
  }
  if op == ovid/parse.OP_LE {
    return 0x9E
  }
  return 0x9F
}

// EmitArgs evaluates the argument list a into temps lv, lv+1, ...
func EmitArgs(c *C, a *ovid/parse.Node, lv i64) i64 {
  var i i64 = 0
  while a != 0 as *ovid/parse.Node {
    if EmitExpr(c, a, lv + i) != 0 {
      return c.err
    }
    StoreTemp(c, lv + i)
    i = i + 1
    a = a.next
  }
  return 0
}

func EmitCall(c *C, n *ovid/parse.Node, lv i64) i64 {
  var fn *ovid/parse.Decl = Callee(c, n, c.pathp, c.pathn)
  if fn == 0 as *ovid/parse.Decl {
    return Fail(c, 3)
  }
  var nargs i64 = ovid/parse.CountNodes(n.args)
  if nargs > 6 {
    return Fail(c, 6)
  }
  if EmitArgs(c, n.args, lv) != 0 {
    return c.err
  }
  var i i64 = 0
  while i < nargs {
    ovid/asm.MovRegMemRbp(c.code, ArgReg(i), TempDisp(c, lv + i))
    i = i + 1
  }
  ovid/asm.Call(c.code, fn.lab)
  return 0
}

func EmitSys(c *C, n *ovid/parse.Node, lv i64) i64 {
  if ovid/parse.CountNodes(n.args) != 7 {
    return Fail(c, 6)
  }
  if EmitArgs(c, n.args, lv) != 0 {
    return c.err
  }
  var i i64 = 0
  while i < 7 {
    ovid/asm.MovRegMemRbp(c.code, SysReg(i), TempDisp(c, lv + i))
    i = i + 1
  }
  ovid/asm.Syscall(c.code)
  return 0
}

func EmitExpr(c *C, n *ovid/parse.Node, lv i64) i64 {
  if c.err != 0 {
    return c.err
  }
  if n == 0 as *ovid/parse.Node {
    return Fail(c, 5)
  }
  var op i64 = n.op
  if op == ovid/parse.OP_INT {
    ovid/asm.MovRegImm(c.code, 0, n.ival)
    return 0
  }
  if op == ovid/parse.OP_SIZEOF {
    var sz i64 = SizeOf(c, n.typp, n.typn)
    if sz < 0 {
      return c.err
    }
    ovid/asm.MovRegImm(c.code, 0, sz)
    return 0
  }
  if op == ovid/parse.OP_BOOL {
    var b i64 = 0
    if n.ival != 0 {
      b = 1
    }
    ovid/asm.MovRegImm(c.code, 0, b)
    return 0
  }
  if op == ovid/parse.OP_STRPTR {
    var off i64 = ovid/asm.Intern(c.code, n.strp, n.strn)
    ovid/asm.MovRegImm(c.code, 0, 0)
    ovid/asm.AbsHere(c.code, off)
    return 0
  }
  if op == ovid/parse.OP_STRLEN {
    ovid/asm.MovRegImm(c.code, 0, n.strn)
    return 0
  }
  if op == ovid/parse.OP_NAME {
    if n.pkgn != 0 {
      var pc *ovid/parse.Decl = PkgConst(c, n)
      if pc == 0 as *ovid/parse.Decl {
        return Fail(c, 2)
      }
      ovid/asm.MovRegImm(c.code, 0, pc.val)
      return 0
    }
    var loc i64 = FindLoc(c, n.namep, n.namen)
    if loc != 0 {
      ovid/asm.MovRaxMemRbp(c.code, load64(loc + 16))
      return 0
    }
    var con *ovid/parse.Decl = ovid/parse.FindDecl(c.pkg.cs, n.namep, n.namen)
    if con != 0 as *ovid/parse.Decl {
      ovid/asm.MovRegImm(c.code, 0, con.val)
      return 0
    }
    return Fail(c, 2)
  }
  if ArithOp(op) {
    if EmitBin(c, n, lv) != 0 {
      return c.err
    }
    return EmitArith(c, op)
  }
  if CmpOp(op) {
    if EmitBin(c, n, lv) != 0 {
      return c.err
    }
    ovid/asm.CmpRaxRcx(c.code)
    ovid/asm.SetccAl(c.code, CmpCC(op))
    ovid/asm.MovzxRaxAl(c.code)
    return 0
  }
  if op == ovid/parse.OP_LAND {
    var no i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    if EmitExpr(c, n.left, lv) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jz(c.code, no)
    if EmitExpr(c, n.right, lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, end)
    ovid/asm.Mark(c.code, no)
    ovid/asm.XorRaxRax(c.code)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if op == ovid/parse.OP_LOR {
    var yes i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    if EmitExpr(c, n.left, lv) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jnz(c.code, yes)
    if EmitExpr(c, n.right, lv) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, end)
    ovid/asm.Mark(c.code, yes)
    ovid/asm.MovRegImm(c.code, 0, 1)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if op == ovid/parse.OP_CAST {
    return EmitExpr(c, n.arg, lv)
  }
  if op == ovid/parse.OP_FIELD {
    var off i64 = FieldOff(c, n.base, n.namep, n.namen)
    if off < 0 {
      return c.err
    }
    if EmitExpr(c, n.base, lv) != 0 {
      return c.err
    }
    ovid/asm.MovRaxMemRegDisp(c.code, 0, off)
    return 0
  }
  if op == ovid/parse.OP_CALL {
    return EmitCall(c, n, lv)
  }
  if op == ovid/parse.OP_SYSCALL {
    return EmitSys(c, n, lv)
  }
  if !UnaryOp(op) {
    return Fail(c, 5)
  }
  if EmitExpr(c, n.arg, lv) != 0 {
    return c.err
  }
  if op == ovid/parse.OP_NOT {
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.SetccAl(c.code, 0x94)
    ovid/asm.MovzxRaxAl(c.code)
  } else if op == ovid/parse.OP_NEG {
    ovid/asm.NegRax(c.code)
  } else if op == ovid/parse.OP_BNOT {
    ovid/asm.NotRax(c.code)
  } else {
    ovid/asm.MovRegReg(c.code, 1, 0)
    if op == ovid/parse.OP_LOAD8 {
      ovid/asm.MovzxRaxByteRcx(c.code)
    } else if op == ovid/parse.OP_LOAD32 {
      ovid/asm.MovEaxDwordRcx(c.code)
    } else {
      ovid/asm.MovRaxQwordRcx(c.code)
    }
  }
  return 0
}

func EmitStmts(c *C, s *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  while s != 0 as *ovid/parse.Node {
    if EmitStmt(c, s) != 0 {
      return c.err
    }
    s = s.next
  }
  return 0
}

// EmitStore evaluates addr (or a base) and val, leaving the address in rcx
// and the value in rax.
func EmitStore(c *C, addr *ovid/parse.Node, val *ovid/parse.Node) i64 {
  if EmitExpr(c, addr, 0) != 0 {
    return c.err
  }
  StoreTemp(c, 0)
  if EmitExpr(c, val, 1) != 0 {
    return c.err
  }
  ovid/asm.MovRcxMemRbp(c.code, TempDisp(c, 0))
  return 0
}

func EmitStmt(c *C, s *ovid/parse.Node) i64 {
  if c.err != 0 {
    return c.err
  }
  var op i64 = s.op
  if op == ovid/parse.OP_VAR || op == ovid/parse.OP_ASSIGN {
    if s.val == 0 as *ovid/parse.Node {
      if op == ovid/parse.OP_VAR {
        return 0
      }
    }
    if EmitExpr(c, s.val, 0) != 0 {
      return c.err
    }
    var loc i64 = FindLoc(c, s.namep, s.namen)
    if loc == 0 {
      return Fail(c, 2)
    }
    ovid/asm.MovMemRbpRax(c.code, load64(loc + 16))
    return 0
  }
  if op == ovid/parse.OP_SETFIELD {
    var off i64 = FieldOff(c, s.base, s.namep, s.namen)
    if off < 0 {
      return c.err
    }
    if EmitStore(c, s.base, s.val) != 0 {
      return c.err
    }
    ovid/asm.MovMemRegDispRax(c.code, 1, off)
    return 0
  }
  if op == ovid/parse.OP_STORE8 {
    if EmitStore(c, s.addr, s.val) != 0 {
      return c.err
    }
    ovid/asm.MovByteRcxAl(c.code)
    return 0
  }
  if op == ovid/parse.OP_STORE64 {
    if EmitStore(c, s.addr, s.val) != 0 {
      return c.err
    }
    ovid/asm.MovQwordRcxRax(c.code)
    return 0
  }
  if op == ovid/parse.OP_EXPR {
    return EmitExpr(c, s.val, 0)
  }
  if op == ovid/parse.OP_RETURN {
    if s.val != 0 as *ovid/parse.Node {
      if EmitExpr(c, s.val, 0) != 0 {
        return c.err
      }
    } else {
      ovid/asm.XorRaxRax(c.code)
    }
    ovid/asm.Jmp(c.code, c.epi)
    return 0
  }
  if op == ovid/parse.OP_IF {
    if EmitExpr(c, s.cond, 0) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    var elseL i64 = end
    if s.els != 0 as *ovid/parse.Node {
      elseL = ovid/asm.NewLabel(c.code)
    }
    ovid/asm.Jz(c.code, elseL)
    if EmitStmts(c, s.then) != 0 {
      return c.err
    }
    if s.els != 0 as *ovid/parse.Node {
      ovid/asm.Jmp(c.code, end)
      ovid/asm.Mark(c.code, elseL)
      if EmitStmts(c, s.els) != 0 {
        return c.err
      }
    }
    ovid/asm.Mark(c.code, end)
    return 0
  }
  if op == ovid/parse.OP_WHILE {
    var begin i64 = ovid/asm.NewLabel(c.code)
    var end i64 = ovid/asm.NewLabel(c.code)
    ovid/asm.Mark(c.code, begin)
    if EmitExpr(c, s.cond, 0) != 0 {
      return c.err
    }
    ovid/asm.TestRaxRax(c.code)
    ovid/asm.Jz(c.code, end)
    if EmitStmts(c, s.body) != 0 {
      return c.err
    }
    ovid/asm.Jmp(c.code, begin)
    ovid/asm.Mark(c.code, end)
    return 0
  }
  return Fail(c, 5)
}

func EmitFunc(c *C, fn *ovid/parse.Decl) i64 {
  c.nloc = 0
  c.err = 0
  c.pkg = fn.pkg
  c.pathp = fn.pkg.pathp
  c.pathn = fn.pkg.pathn
  c.fn = fn
  var pa *ovid/parse.Decl = c.fn.sub
  while pa != 0 as *ovid/parse.Decl {
    AddLoc(c, pa.namep, pa.namen, pa.typp, pa.typn)
    pa = pa.next
  }
  var body *ovid/parse.Node = c.fn.body
  CollectStmts(c, body)
  if c.err != 0 {
    return c.err
  }
  c.localBytes = c.nloc * 8
  c.peak = StmtsPeak(body)
  var tempBytes i64 = 0
  if c.peak >= 0 {
    tempBytes = (c.peak + 1) * 8
  }
  var frame i64 = c.localBytes + tempBytes
  if (frame % 16) != 0 {
    frame = frame + 8
  }
  c.epi = ovid/asm.NewLabel(c.code)
  ovid/asm.Mark(c.code, fn.lab)
  ovid/asm.PushReg(c.code, 5)
  ovid/asm.MovRegReg(c.code, 5, 4)
  ovid/asm.SubRsp(c.code, frame)
  if frame > 0 {
    ovid/asm.XorRaxRax(c.code)
    var d i64 = 8
    while d <= (c.localBytes + tempBytes) {
      ovid/asm.MovMemRbpRax(c.code, 0 - d)
      d = d + 8
    }
  }
  var i i64 = 0
  pa = c.fn.sub
  while pa != 0 as *ovid/parse.Decl {
    var loc i64 = FindLoc(c, pa.namep, pa.namen)
    if loc == 0 {
      return Fail(c, 2)
    }
    ovid/asm.MovMemRbpReg(c.code, ArgReg(i), load64(loc + 16))
    i = i + 1
    pa = pa.next
  }
  if EmitStmts(c, body) != 0 {
    return c.err
  }
  ovid/asm.XorRaxRax(c.code)
  ovid/asm.Mark(c.code, c.epi)
  ovid/asm.MovRegReg(c.code, 4, 5)
  ovid/asm.PopReg(c.code, 5)
  ovid/asm.Ret(c.code)
  return 0
}

// MarkLive flags fn as reachable and queues it for LiveFrom. Only live
// funcs are emitted, matching the Go compiler.
func MarkLive(c *C, fn *ovid/parse.Decl) i64 {
  if fn.live != 0 {
    return 0
  }
  fn.live = 1
  if c.nwork >= c.workcap {
    var w i64 = ovid/io.Alloc(c.io, c.workcap * 16)
    ovid/mem.Copy(w, c.work, c.workcap * 8)
    c.work = w
    c.workcap = c.workcap * 2
  }
  store64(c.work + (c.nwork * 8), fn as i64)
  c.nwork = c.nwork + 1
  return 0
}

// LiveFrom marks every func reachable from fn. The queue keeps a long call
// chain from becoming deep recursion.
func LiveFrom(c *C, fn *ovid/parse.Decl) i64 {
  c.workcap = 256
  c.work = ovid/io.Alloc(c.io, c.workcap * 8)
  MarkLive(c, fn)
  while c.nwork > 0 {
    c.nwork = c.nwork - 1
    var f *ovid/parse.Decl = load64(c.work + (c.nwork * 8)) as *ovid/parse.Decl
    WalkLive(c, f.body, f.pkg.pathp, f.pkg.pathn)
  }
  return 0
}

// WalkLive marks the callee of every call in the node list n; pp/pn is the
// package that unqualified calls resolve in.
func WalkLive(c *C, n *ovid/parse.Node, pp i64, pn i64) i64 {
  while n != 0 as *ovid/parse.Node {
    if n.op == ovid/parse.OP_CALL {
      var fn *ovid/parse.Decl = Callee(c, n, pp, pn)
      if fn != 0 as *ovid/parse.Decl {
        MarkLive(c, fn)
      }
    }
    WalkLive(c, n.left, pp, pn)
    WalkLive(c, n.right, pp, pn)
    WalkLive(c, n.arg, pp, pn)
    WalkLive(c, n.base, pp, pn)
    WalkLive(c, n.addr, pp, pn)
    WalkLive(c, n.val, pp, pn)
    WalkLive(c, n.cond, pp, pn)
    WalkLive(c, n.args, pp, pn)
    WalkLive(c, n.then, pp, pn)
    WalkLive(c, n.els, pp, pn)
    WalkLive(c, n.body, pp, pn)
    n = n.next
  }
  return 0
}

func EmitStartup(c *C, mainLab i64) i64 {
  var argcOff i64 = CapOff(c, strptr("argc"), strlen("argc"))
  var argvOff i64 = CapOff(c, strptr("argv"), strlen("argv"))
  var heapOff i64 = CapOff(c, strptr("heap"), strlen("heap"))
  var usedOff i64 = CapOff(c, strptr("used"), strlen("used"))
  var sizeOff i64 = CapOff(c, strptr("size"), strlen("size"))
  if argcOff < 0 {
    return c.err
  }
  if argvOff < 0 {
    return c.err
  }
  if heapOff < 0 {
    return c.err
  }
  if usedOff < 0 {
    return c.err
  }
  if sizeOff < 0 {
    return c.err
  }
  var fail i64 = ovid/asm.NewLabel(c.code)
  ovid/asm.MovR12MemRsp(c.code)
  ovid/asm.LeaR13Rsp8(c.code)
  ovid/asm.AndRspAlign(c.code)
  ovid/asm.MovRegImm(c.code, 7, 0)
  ovid/asm.MovRegImm(c.code, 6, HEAP)
  ovid/asm.MovRegImm(c.code, 2, 3)
  ovid/asm.MovRegImm(c.code, 10, 0x22)
  ovid/asm.MovRegImm(c.code, 8, -1)
  ovid/asm.MovRegImm(c.code, 9, 0)
  ovid/asm.MovRegImm(c.code, 0, 9)
  ovid/asm.Syscall(c.code)
  ovid/asm.MovRegReg(c.code, 14, 0)
  ovid/asm.TestRaxRax(c.code)
  ovid/asm.Jl(c.code, fail)
  ovid/asm.SubRsp(c.code, 48)
  ovid/asm.MovRegReg(c.code, 1, 4)
  ovid/asm.MovRegReg(c.code, 0, 12)
  ovid/asm.MovMemRegDispRax(c.code, 1, argcOff)
  ovid/asm.MovRegReg(c.code, 0, 13)
  ovid/asm.MovMemRegDispRax(c.code, 1, argvOff)
  ovid/asm.MovRegReg(c.code, 0, 14)
  ovid/asm.MovMemRegDispRax(c.code, 1, heapOff)
  ovid/asm.MovRegImm(c.code, 0, 0)
  ovid/asm.MovMemRegDispRax(c.code, 1, usedOff)
  ovid/asm.MovRegImm(c.code, 0, HEAP)
  ovid/asm.MovMemRegDispRax(c.code, 1, sizeOff)
  ovid/asm.MovRegReg(c.code, 7, 4)
  ovid/asm.Call(c.code, mainLab)
  ovid/asm.MovRegReg(c.code, 7, 0)
  ovid/asm.MovRegImm(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  ovid/asm.Mark(c.code, fail)
  ovid/asm.MovRegImm(c.code, 7, 125)
  ovid/asm.MovRegImm(c.code, 0, 60)
  ovid/asm.Syscall(c.code)
  return 0
}

// Compile emits the checked module m as a static executable, or returns
// nil with a code at errp.
func Compile(io *ovid/io.Cap, m *ovid/parse.Mod, errp i64) *ovid/mem.Buf {
  var z i64 = 0
  var raw i64 = ovid/io.Alloc(io, sizeof(C))
  if raw == 0 {
    store64(errp, 1)
    return z as *ovid/mem.Buf
  }
  var c *C = raw as *C
  c.io = io
  c.mod = m
  c.code = ovid/asm.New(io)
  if IndexProg(c) != 0 {
    store64(errp, c.err)
    return z as *ovid/mem.Buf
  }
  var mainFn *ovid/parse.Decl = ovid/parse.FindFunc(m, m.entryp, m.entryn, strptr("main"), strlen("main"))
  if mainFn == 0 as *ovid/parse.Decl {
    store64(errp, 1)
    return z as *ovid/mem.Buf
  }
  if EmitStartup(c, mainFn.lab) != 0 {
    store64(errp, c.err)
    return z as *ovid/mem.Buf
  }
  LiveFrom(c, mainFn)
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      if f.live != 0 {
        if EmitFunc(c, f) != 0 {
          store64(errp, c.err)
          return z as *ovid/mem.Buf
        }
      }
      f = f.next
    }
    k = k.next
  }
  ovid/asm.Patch(c.code)
  store64(errp, 0)
  return ovid/elf.Link(io, c.code)
}
