package ovid/lower

import ovid/io
import ovid/mem
import ovid/parse

// The lowering rewrites a checked program so that no bytes value is left
// in it, which lets the code generator keep one word per value. It is
// internal/lower in Ovid, statement for statement, so that both
// compilers hand the code generator the same tree.
//
// A bytes is an address and a length. After lowering, every bytes local,
// param, or field b is the pair of i64 b and b#n; a func returning bytes
// returns two results, one returning (bytes, i64) three (the third word
// rides in rcx: a return with a third value in args, a var2 or assign2
// with a third name in args); b[i] is a bload (a checked load); b[i] = v
// a chk and a store8; b[i:j] the pair (p + i, j - i) after two chks;
// len(b) is b#n; "lit" is strptr and strlen; bytes(p, n) the pair.
//
// The checks and the pairs' parts are simple operands (a name or a
// constant) or, for a field, its two loads left in place; anything else
// is first moved into a temp local (t#k) by a statement placed before
// the one being lowered. Moving an expression keeps evaluation order:
// every earlier expression in the same statement that is not a simple
// operand is moved too (a memory read left of a call that writes it
// must come first), the halves of a field among them, and an operand of
// && or || or a while condition that needs a move is restructured into
// an if, so the move runs exactly when the operand would have.
//
// Unlike the Go pass, this one works in place: a build is one process.

type L struct {
  io *ovid/io.Cap
  mod *ovid/parse.Mod
  pkg *ovid/parse.Pkg
  env i64
  nenv i64
  tmp i64
  typ bytes
  pa *ovid/parse.Node
  pl *ovid/parse.Node
  err i64
  locs *Loc
  free *Free
  fb bytes
  fi bytes
}

// Loc is what the check elision knows about one of a function's names:
// how often it is declared (a param or a var; var2 too), the value of
// its one var, whether anything assigns it, and whether every
// assignment is name = name + k with k a positive literal.
type Loc struct {
  name bytes
  decls i64
  val *ovid/parse.Node
  assigned bool
  grows bool
  next *Loc
}

// Free is a loop's bytes and index whose b[i] the condition proves in
// bounds; an empty b proves nothing.
type Free struct {
  b bytes
  i bytes
  next *Free
}

// Pre is a statement list being built: what runs before the statement
// being lowered, then the statement itself.
type Pre struct {
  head *ovid/parse.Node
  tail *ovid/parse.Node
}

const ENVREC i64 = 32
const MAXENV i64 = 4096

func NewPre(l *L) *Pre {
  return ovid/io.Alloc(l.io, sizeof(Pre)) as *Pre
}

// Append puts n at the end of p.
func Append(p *Pre, n *ovid/parse.Node) i64 {
  n.next = 0 as *ovid/parse.Node
  if p.tail == 0 as *ovid/parse.Node {
    p.head = n
  } else {
    p.tail.next = n
  }
  p.tail = n
  return 0
}

// InsertAfter puts n after mark in p, or first when mark is nil, and
// returns n, the mark for the next insertion in order.
func InsertAfter(p *Pre, mark *ovid/parse.Node, n *ovid/parse.Node) *ovid/parse.Node {
  if mark == 0 as *ovid/parse.Node {
    n.next = p.head
    p.head = n
  } else {
    n.next = mark.next
    mark.next = n
  }
  if mark == p.tail {
    p.tail = n
  }
  return n
}

// Program lowers m in place.
func Program(io *ovid/io.Cap, m *ovid/parse.Mod) i64 {
  var l *L = ovid/io.Alloc(io, sizeof(L)) as *L
  l.io = io
  l.mod = m
  l.env = ovid/io.Alloc(io, MAXENV * ENVREC)
  // Signatures first, so a call site knows what its callee returns.
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var fn *ovid/parse.Decl = k.fs
    while fn != 0 as *ovid/parse.Decl {
      if IsBytes(fn.typ) {
        fn.bres = 2
        if len(fn.typ2) != 0 {
          fn.bres = 3
        }
      }
      fn = fn.next
    }
    k = k.next
  }
  // Every struct before any body, since a body may read another
  // package's bytes field.
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var t *ovid/parse.Decl = k.ts
    while t != 0 as *ovid/parse.Decl {
      Expand(l, t)
      t = t.next
    }
    k = k.next
  }
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    l.pkg = k
    var f *ovid/parse.Decl = k.fs
    while f != 0 as *ovid/parse.Decl {
      Func(l, f)
      f = f.next
    }
    k = k.next
  }
  return l.err
}

func IsBytes(t bytes) bool {
  return ovid/mem.Eq(t, "bytes")
}

// NName is name#n, the length half of the pair of the bytes called name.
func NName(l *L, name bytes) bytes {
  var d bytes = ovid/io.AllocBytes(l.io, len(name) + 2)
  ovid/mem.Copy(d, name)
  d[len(name)] = 35
  d[len(name) + 1] = 110
  return d
}

// Expand splits every bytes field or param in the list under d into two
// i64 decls, f and f#n.
func Expand(l *L, d *ovid/parse.Decl) i64 {
  var f *ovid/parse.Decl = d.sub
  while f != 0 as *ovid/parse.Decl {
    if IsBytes(f.typ) {
      f.typ = "i64"
      var g *ovid/parse.Decl = ovid/io.Alloc(l.io, sizeof(ovid/parse.Decl)) as *ovid/parse.Decl
      g.name = NName(l, f.name)
      g.typ = "i64"
      g.file = f.file
      g.off = f.off
      g.pkg = f.pkg
      g.next = f.next
      f.next = g
      if d.subt == f {
        d.subt = g
      }
      f = g
    }
    f = f.next
  }
  return 0
}

func Func(l *L, fn *ovid/parse.Decl) i64 {
  l.nenv = 0
  var pa *ovid/parse.Decl = fn.sub
  while pa != 0 as *ovid/parse.Decl {
    Bind(l, pa.name, pa.typ)
    pa = pa.next
  }
  Expand(l, fn)
  if fn.bres != 0 {
    fn.typ = "i64"
    if len(fn.typ2) == 0 {
      fn.typ2 = "i64"
    }
  }
  l.locs = 0 as *Loc
  pa = fn.sub
  while pa != 0 as *ovid/parse.Decl {
    var c *Loc = Local(l, pa.name)
    c.decls = c.decls + 1
    pa = pa.next
  }
  Scan(l, fn.body)
  l.free = 0 as *Free
  fn.body = Stmts(l, fn.body)
  return 0
}

func Local(l *L, name bytes) *Loc {
  var c *Loc = l.locs
  while c != 0 as *Loc {
    if ovid/mem.Eq(c.name, name) {
      return c
    }
    c = c.next
  }
  c = ovid/io.Alloc(l.io, sizeof(Loc)) as *Loc
  c.name = name
  c.grows = true
  c.next = l.locs
  l.locs = c
  return c
}

// Scan records the declarations and assignments of the function's
// names, through every block.
func Scan(l *L, s *ovid/parse.Node) i64 {
  while s != 0 as *ovid/parse.Node {
    var op i64 = s.op
    if op == ovid/parse.OP_VAR {
      var c *Loc = Local(l, s.name)
      c.decls = c.decls + 1
      // A copy: the lowering rewrites the value in place before a later
      // loop asks what it was.
      if s.val != 0 as *ovid/parse.Node {
        c.val = Copy(l, s.val)
      }
    } else if op == ovid/parse.OP_VAR2 {
      var c1 *Loc = Local(l, s.name)
      c1.decls = c1.decls + 1
      var c2 *Loc = Local(l, s.name2)
      c2.decls = c2.decls + 1
    } else if op == ovid/parse.OP_ASSIGN {
      var c3 *Loc = Local(l, s.name)
      c3.assigned = true
      if Growth(s) < 1 {
        c3.grows = false
      }
    } else if op == ovid/parse.OP_ASSIGN2 {
      var c4 *Loc = Local(l, s.name)
      c4.assigned = true
      c4.grows = false
      var c5 *Loc = Local(l, s.name2)
      c5.assigned = true
      c5.grows = false
    }
    Scan(l, s.then)
    Scan(l, s.els)
    Scan(l, s.body)
    s = s.next
  }
  return 0
}

// Growth is the k of the statement name = name + k, k a positive
// literal, or 0 when s is not one.
func Growth(s *ovid/parse.Node) i64 {
  if s.op != ovid/parse.OP_ASSIGN {
    return 0
  }
  var v *ovid/parse.Node = s.val
  if v.op != ovid/parse.OP_ADD || v.left.op != ovid/parse.OP_NAME || len(v.left.pkg) != 0 || !ovid/mem.Eq(v.left.name, s.name) {
    return 0
  }
  if v.right.op != ovid/parse.OP_INT || v.right.ival < 1 {
    return 0
  }
  return v.right.ival
}

// LenOf is the bytes local b when n is len(b), or empty.
func LenOf(l *L, n *ovid/parse.Node) bytes {
  if n == 0 as *ovid/parse.Node {
    return ""
  }
  var op i64 = n.op
  if op != ovid/parse.OP_LEN && op != ovid/parse.OP_BLEN {
    return ""
  }
  var b *ovid/parse.Node = n.base
  if op == ovid/parse.OP_LEN {
    if len(n.pkg) != 0 || b == 0 as *ovid/parse.Node {
      return ""
    }
    b = Name(l, n.name)
  }
  if b.op != ovid/parse.OP_NAME || len(b.pkg) != 0 || !Lookup(l, b.name) || !IsBytes(l.typ) {
    return ""
  }
  return b.name
}

// FreeLoop says what the while statement s proves: its condition is
// i < len(b), or i < n with n the one var len(b), where b and n are
// never assigned, i is declared once as a var with a literal that is
// not negative and only ever grows by a positive literal, and the body
// assigns i only in its own top-level statements. Then b[i] is in
// bounds in the condition and in the body's statements before the
// first of those, which is the count returned (the body's length when
// there is none), with b and i in l.fb and l.fi; -1 when s proves
// nothing.
func FreeLoop(l *L, s *ovid/parse.Node) i64 {
  var c *ovid/parse.Node = s.cond
  if c.op == ovid/parse.OP_LAND {
    c = c.left
  }
  if c.op != ovid/parse.OP_LT || c.left.op != ovid/parse.OP_NAME || len(c.left.pkg) != 0 {
    return -1
  }
  var i bytes = c.left.name
  var b bytes = LenOf(l, c.right)
  if len(b) == 0 && c.right.op == ovid/parse.OP_NAME && len(c.right.pkg) == 0 {
    var n *Loc = Local(l, c.right.name)
    if n.decls == 1 && !n.assigned && n.val != 0 as *ovid/parse.Node {
      b = LenOf(l, n.val)
    }
  }
  if len(b) == 0 {
    return -1
  }
  var bl *Loc = Local(l, b)
  if bl.decls != 1 || bl.assigned {
    return -1
  }
  var il *Loc = Local(l, i)
  if il.decls != 1 || il.val == 0 as *ovid/parse.Node || il.val.op != ovid/parse.OP_INT || il.val.ival < 0 || !il.grows {
    return -1
  }
  var k i64 = -1
  var j i64 = 0
  var t *ovid/parse.Node = s.body
  while t != 0 as *ovid/parse.Node {
    if t.op == ovid/parse.OP_ASSIGN && ovid/mem.Eq(t.name, i) {
      if k < 0 {
        k = j
      }
    } else if Assigns(t, i) {
      return -1
    }
    j = j + 1
    t = t.next
  }
  if k < 0 {
    k = j
  }
  l.fb = b
  l.fi = i
  return k
}

// Assigns says whether a statement under s (not s itself) assigns name.
func Assigns(s *ovid/parse.Node, name bytes) bool {
  return AssignsIn(s.then, name) || AssignsIn(s.els, name) || AssignsIn(s.body, name)
}

func AssignsIn(s *ovid/parse.Node, name bytes) bool {
  while s != 0 as *ovid/parse.Node {
    if (s.op == ovid/parse.OP_ASSIGN && ovid/mem.Eq(s.name, name)) || Assigns(s, name) {
      return true
    }
    s = s.next
  }
  return false
}

// IsFree says whether b[i] needs no check where the lowering stands.
func IsFree(l *L, b *ovid/parse.Node, i *ovid/parse.Node) bool {
  if b.op != ovid/parse.OP_NAME || i.op != ovid/parse.OP_NAME || len(b.pkg) != 0 || len(i.pkg) != 0 {
    return false
  }
  var f *Free = l.free
  while f != 0 as *Free {
    if ovid/mem.Eq(f.b, b.name) && ovid/mem.Eq(f.i, i.name) {
      return true
    }
    f = f.next
  }
  return false
}

// PushFree makes b[i] free, or nothing when b is empty.
func PushFree(l *L, b bytes, i bytes) i64 {
  var f *Free = ovid/io.Alloc(l.io, sizeof(Free)) as *Free
  f.b = b
  f.i = i
  f.next = l.free
  l.free = f
  return 0
}

func Bind(l *L, name bytes, t bytes) i64 {
  if l.nenv >= MAXENV {
    return 0
  }
  var rec i64 = l.env + (l.nenv * ENVREC)
  store64(rec, ptr(name))
  store64(rec + 8, len(name))
  store64(rec + 16, ptr(t))
  store64(rec + 24, len(t))
  l.nenv = l.nenv + 1
  return 0
}

// Lookup sets l.typ to the type of the local name and reports
// whether there is one.
func Lookup(l *L, name bytes) bool {
  var i i64 = l.nenv - 1
  while i >= 0 {
    var rec i64 = l.env + (i * ENVREC)
    if ovid/mem.Eq(bytes(load64(rec), load64(rec + 8)), name) {
      l.typ = bytes(load64(rec + 16), load64(rec + 24))
      return true
    }
    i = i - 1
  }
  return false
}

func FindPkg(l *L, path bytes) *ovid/parse.Pkg {
  var k *ovid/parse.Pkg = l.mod.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if ovid/mem.Eq(k.path, path) {
      return k
    }
    k = k.next
  }
  return k
}

// FindType is the struct decl of the type *pkg.T written at t.
func FindType(l *L, t bytes) *ovid/parse.Decl {
  if len(t) < 2 || load8(ptr(t)) != 42 {
    return 0 as *ovid/parse.Decl
  }
  var p i64 = ptr(t) + 1
  var n i64 = len(t) - 1
  var dot i64 = -1
  var i i64 = 0
  while i < n {
    if load8(p + i) == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot < 1 {
    return 0 as *ovid/parse.Decl
  }
  var k *ovid/parse.Pkg = FindPkg(l, bytes(p, dot))
  if k == 0 as *ovid/parse.Pkg {
    return 0 as *ovid/parse.Decl
  }
  return ovid/parse.FindDecl(k.ts, bytes((p + dot) + 1, (n - dot) - 1))
}

// FieldIsBytes says whether field f of the struct pointer type bt was
// declared bytes: its decl has been expanded, so f#n follows it.
func FieldIsBytes(l *L, bt *ovid/parse.Decl, fs bytes) bool {
  if bt == 0 as *ovid/parse.Decl {
    return false
  }
  var f *ovid/parse.Decl = ovid/parse.FindDecl(bt.sub, fs)
  if f == 0 as *ovid/parse.Decl || f.next == 0 as *ovid/parse.Decl {
    return false
  }
  var g *ovid/parse.Decl = f.next
  if len(g.name) != len(fs) + 2 {
    return false
  }
  return ovid/mem.Eq(g.name[0:len(fs)], fs) && g.name[len(fs)] == 35 && g.name[len(fs) + 1] == 110
}

func Callee(l *L, n *ovid/parse.Node) *ovid/parse.Decl {
  var pp i64 = ptr(l.pkg.path)
  var pn i64 = len(l.pkg.path)
  if len(n.pkg) != 0 {
    pp = ptr(n.pkg)
    pn = len(n.pkg)
  }
  return ovid/parse.FindFunc(l.mod, bytes(pp, pn), n.fn)
}

// ResultWords is how many words a call to n returns: 1, or 2 or 3 for a
// bytes result.
func ResultWords(l *L, n *ovid/parse.Node) i64 {
  var fn *ovid/parse.Decl = Callee(l, n)
  if fn != 0 as *ovid/parse.Decl && fn.bres != 0 {
    return fn.bres
  }
  return 1
}

func SetTy(l *L, t bytes) i64 {
  l.typ = t
  return 0
}

// TypeOf leaves in l.typ the checker's type of n, for the shapes the
// lowering asks about: whether something is a bytes, and a field's base.
func TypeOf(l *L, n *ovid/parse.Node) i64 {
  var op i64 = n.op
  if op == ovid/parse.OP_NAME {
    if len(n.pkg) == 0 && Lookup(l, n.name) {
      return 0
    }
    return SetTy(l, "i64")
  }
  if op == ovid/parse.OP_STR || op == ovid/parse.OP_SLICE || op == ovid/parse.OP_BYTES {
    return SetTy(l, "bytes")
  }
  if op == ovid/parse.OP_CAST {
    return SetTy(l, n.typ)
  }
  if op == ovid/parse.OP_FIELD {
    TypeOf(l, n.base)
    var bt *ovid/parse.Decl = FindType(l, l.typ)
    if FieldIsBytes(l, bt, n.name) {
      return SetTy(l, "bytes")
    }
    if bt != 0 as *ovid/parse.Decl {
      var f *ovid/parse.Decl = ovid/parse.FindDecl(bt.sub, n.name)
      if f != 0 as *ovid/parse.Decl {
        return SetTy(l, f.typ)
      }
    }
    return SetTy(l, "i64")
  }
  if op == ovid/parse.OP_CALL {
    if ResultWords(l, n) > 1 {
      return SetTy(l, "bytes")
    }
    var fn *ovid/parse.Decl = Callee(l, n)
    if fn != 0 as *ovid/parse.Decl {
      return SetTy(l, fn.typ)
    }
    return SetTy(l, "i64")
  }
  if op == ovid/parse.OP_BOOL || (op >= ovid/parse.OP_LOR && op <= ovid/parse.OP_GE) || op == ovid/parse.OP_ULT || op == ovid/parse.OP_NOT {
    return SetTy(l, "bool")
  }
  return SetTy(l, "i64")
}

func IsBytesExpr(l *L, n *ovid/parse.Node) bool {
  TypeOf(l, n)
  return IsBytes(l.typ)
}

func NewNode(l *L, op i64) *ovid/parse.Node {
  var n *ovid/parse.Node = ovid/io.Alloc(l.io, sizeof(ovid/parse.Node)) as *ovid/parse.Node
  n.op = op
  return n
}

func Name(l *L, name bytes) *ovid/parse.Node {
  var n *ovid/parse.Node = NewNode(l, ovid/parse.OP_NAME)
  n.name = name
  return n
}

func Bin(l *L, op i64, a *ovid/parse.Node, b *ovid/parse.Node) *ovid/parse.Node {
  var n *ovid/parse.Node = NewNode(l, op)
  n.left = a
  n.right = b
  return n
}

func One(l *L) *ovid/parse.Node {
  var n *ovid/parse.Node = NewNode(l, ovid/parse.OP_INT)
  n.ival = 1
  n.valk = 1
  return n
}

func BoolNode(l *L, v bool) *ovid/parse.Node {
  var n *ovid/parse.Node = NewNode(l, ovid/parse.OP_BOOL)
  n.valk = 2
  if v {
    n.ival = 1
  }
  return n
}

// Simple says n can be an operand of a check or a pair without being
// moved: a local or a constant.
func Simple(n *ovid/parse.Node) bool {
  var op i64 = n.op
  return op == ovid/parse.OP_NAME || op == ovid/parse.OP_INT || op == ovid/parse.OP_STRLEN || op == ovid/parse.OP_STRPTR || op == ovid/parse.OP_SIZEOF || op == ovid/parse.OP_LEN
}

// Pure says n is a load with nothing to run: a local, or a field of one.
func Pure(n *ovid/parse.Node) bool {
  return n.op == ovid/parse.OP_NAME || (n.op == ovid/parse.OP_FIELD && Pure(n.base))
}

// TempType sets l.typ to the type a temp holding the lowered n takes:
// TypeOf, except that a field it still calls bytes is the address half
// of a pair, which Pair leaves as a load of the field named after it.
func TempType(l *L, n *ovid/parse.Node) i64 {
  TypeOf(l, n)
  if n.op == ovid/parse.OP_FIELD && IsBytes(l.typ) {
    return SetTy(l, "i64")
  }
  return 0
}

// TmpName makes the name t#k of a fresh temp.
func TmpName(l *L) bytes {
  l.tmp = l.tmp + 1
  var d i64 = ovid/io.Alloc(l.io, 24)
  store8(d, 116)
  store8(d + 1, 35)
  return bytes(d, 2 + ovid/mem.FormatI64(d + 2, l.tmp))
}

// Temp declares a fresh local of type t holding v, in p, and
// returns a name node for it.
func Temp(l *L, t bytes, v *ovid/parse.Node, p *Pre) *ovid/parse.Node {
  var name bytes = TmpName(l)
  Bind(l, name, t)
  var d *ovid/parse.Node = NewNode(l, ovid/parse.OP_VAR)
  d.name = name
  d.typ = t
  d.val = v
  Append(p, d)
  return Name(l, name)
}

// Copy is a fresh node with n's contents, off the list n is on.
func Copy(l *L, n *ovid/parse.Node) *ovid/parse.Node {
  var m *ovid/parse.Node = NewNode(l, n.op)
  ovid/mem.CopyN(m as i64, n as i64, sizeof(ovid/parse.Node))
  m.next = 0 as *ovid/parse.Node
  return m
}

// Become makes n, in place, the name node of name: its place on a
// list and its id stay, everything else goes.
func Become(l *L, n *ovid/parse.Node, name bytes) i64 {
  var next *ovid/parse.Node = n.next
  var num i64 = n.num
  var off i64 = n.off
  var end i64 = n.end
  var z i64 = 0
  ovid/mem.CopyN(n as i64, NewNode(l, ovid/parse.OP_NAME) as i64, sizeof(ovid/parse.Node))
  n.name = name
  n.next = next
  n.num = num
  n.off = off
  n.end = end
  return z
}

// Hoist lowers n and makes it a simple operand: itself, or a fresh temp
// it is moved into, in place.
func Hoist(l *L, n *ovid/parse.Node, p *Pre) *ovid/parse.Node {
  Expr(l, n, p)
  return Fix(l, n, p)
}

// Fix makes the lowered n a simple operand, moving it into a temp, in
// place, if it is not one.
func Fix(l *L, n *ovid/parse.Node, p *Pre) *ovid/parse.Node {
  if Simple(n) {
    return n
  }
  TempType(l, n)
  var tb bytes = l.typ
  var t *ovid/parse.Node = Temp(l, tb, Copy(l, n), p)
  Become(l, n, t.name)
  return n
}

// FixAt moves the lowered a and b, where not simple, into temps placed
// after mark in p, ahead of what was added since, so their reads keep
// their place in source order.
func FixAt(l *L, p *Pre, mark *ovid/parse.Node, a *ovid/parse.Node, b *ovid/parse.Node) i64 {
  if !Grew(p, mark) {
    return 0
  }
  return FixAll(l, p, mark, a, b)
}

// FixAll is FixAt whether or not p grew.
func FixAll(l *L, p *Pre, mark *ovid/parse.Node, a *ovid/parse.Node, b *ovid/parse.Node) i64 {
  var kept *ovid/parse.Node = 0 as *ovid/parse.Node
  if !Simple(a) {
    kept = Keep(l, kept, a)
  }
  if !Simple(b) {
    kept = Keep(l, kept, b)
  }
  MoveCalls(l, p, mark, kept)
  return 0
}

// Pair lowers a bytes-typed expression to its address and length: simple
// operands, or a field's two loads in place, in l.pa and l.pl, placing in
// p the statements that must run first.
func Pair(l *L, n *ovid/parse.Node, p *Pre) i64 {
  var op i64 = n.op
  if op == ovid/parse.OP_NAME {
    l.pa = Name(l, n.name)
    l.pl = Name(l, NName(l, n.name))
    return 0
  }
  if op == ovid/parse.OP_STR {
    var sp *ovid/parse.Node = NewNode(l, ovid/parse.OP_STRPTR)
    sp.valk = 3
    sp.str = n.str
    var sl *ovid/parse.Node = NewNode(l, ovid/parse.OP_STRLEN)
    sl.valk = 3
    sl.str = n.str
    l.pa = sp
    l.pl = sl
    return 0
  }
  if op == ovid/parse.OP_BYTES {
    var a *ovid/parse.Node = Hoist(l, n.left, p)
    var ln *ovid/parse.Node = Hoist(l, n.right, p)
    // n < 2^63 unsigned: a negative length would let every later
    // check pass. A literal length settles it here.
    if ln.op != ovid/parse.OP_INT || ln.ival < 0 {
      var lim *ovid/parse.Node = NewNode(l, ovid/parse.OP_INT)
      lim.ival = (0 - 9223372036854775807) - 1
      lim.valk = 1
      var ck *ovid/parse.Node = NewNode(l, ovid/parse.OP_CHK)
      ck.addr = ln
      ck.val = lim
      Append(p, ck)
    }
    l.pa = a
    l.pl = ln
    return 0
  }
  if op == ovid/parse.OP_FIELD {
    // Two loads of the expanded fields, left where they are: a base
    // with nothing to run is read in place, any other is moved first.
    Expr(l, n.base, p)
    var base *ovid/parse.Node = n.base
    if !Pure(base) {
      TypeOf(l, base)
      var tb bytes = l.typ
      base = Temp(l, tb, Copy(l, base), p)
    }
    var fp *ovid/parse.Node = NewNode(l, ovid/parse.OP_FIELD)
    fp.base = base
    fp.name = n.name
    var fnn *ovid/parse.Node = NewNode(l, ovid/parse.OP_FIELD)
    fnn.base = base
    fnn.name = NName(l, n.name)
    l.pa = fp
    l.pl = fnn
    return 0
  }
  if op == ovid/parse.OP_SLICE {
    Pair(l, n.base, p)
    var bp *ovid/parse.Node = l.pa
    var bn *ovid/parse.Node = l.pl
    var mark *ovid/parse.Node = p.tail
    var i *ovid/parse.Node = Hoist(l, n.left, p)
    var j *ovid/parse.Node = Hoist(l, n.right, p)
    FixAt(l, p, mark, bp, bn)
    // j <= n and i <= j, unsigned, so a negative bound trips too.
    var c1 *ovid/parse.Node = NewNode(l, ovid/parse.OP_CHK)
    c1.addr = j
    c1.val = Bin(l, ovid/parse.OP_ADD, bn, One(l))
    Append(p, c1)
    var c2 *ovid/parse.Node = NewNode(l, ovid/parse.OP_CHK)
    c2.addr = i
    c2.val = Bin(l, ovid/parse.OP_ADD, j, One(l))
    Append(p, c2)
    var sa *ovid/parse.Node = Temp(l, "i64", Bin(l, ovid/parse.OP_ADD, bp, i), p)
    var sn *ovid/parse.Node = Temp(l, "i64", Bin(l, ovid/parse.OP_SUB, j, i), p)
    l.pa = sa
    l.pl = sn
    return 0
  }
  if op == ovid/parse.OP_CALL {
    Expr(l, n, p)
    var t bytes = TmpName(l)
    var t2 bytes = NName(l, t)
    Bind(l, t, "i64")
    Bind(l, t2, "i64")
    var v2 *ovid/parse.Node = NewNode(l, ovid/parse.OP_VAR2)
    v2.name = t
    v2.typ = "i64"
    v2.name2 = t2
    v2.typ2 = "i64"
    v2.val = Copy(l, n)
    Append(p, v2)
    l.pa = Name(l, t)
    l.pl = Name(l, t2)
    return 0
  }
  l.err = 1
  return 0
}

// Grew says whether p gained statements since mark was its tail.
func Grew(p *Pre, mark *ovid/parse.Node) bool {
  return p.tail != mark
}

// MoveCalls moves every node in the list kept (a list of name-less
// holder nodes whose base is the node to move, none simple) into a temp
// placed after mark in p, in order, and returns the mark after the last
// one.
func MoveCalls(l *L, p *Pre, mark *ovid/parse.Node, kept *ovid/parse.Node) *ovid/parse.Node {
  while kept != 0 as *ovid/parse.Node {
    var n *ovid/parse.Node = kept.base
    TempType(l, n)
    var t bytes = l.typ
    var name bytes = TmpName(l)
    Bind(l, name, t)
    var d *ovid/parse.Node = NewNode(l, ovid/parse.OP_VAR)
    d.name = name
    d.typ = t
    d.val = Copy(l, n)
    mark = InsertAfter(p, mark, d)
    Become(l, n, name)
    kept = kept.next
  }
  return mark
}

// Keep adds n to the kept list (a holder node pointing at it) and
// returns the new head.
func Keep(l *L, kept *ovid/parse.Node, n *ovid/parse.Node) *ovid/parse.Node {
  var h *ovid/parse.Node = NewNode(l, ovid/parse.OP_EXPR)
  h.base = n
  if kept == 0 as *ovid/parse.Node {
    return h
  }
  var t *ovid/parse.Node = kept
  while t.next != 0 as *ovid/parse.Node {
    t = t.next
  }
  t.next = h
  return kept
}

// Expr lowers the bytes operations inside an i64 or bool expression, in
// place, placing in p what must run first. Children go in evaluation
// order, and when one adds to p, every earlier child that is not a
// simple operand is moved into a temp ahead of that addition, so what
// it computes or reads still happens in source order.
func Expr(l *L, n *ovid/parse.Node, p *Pre) i64 {
  if n == 0 as *ovid/parse.Node {
    return 0
  }
  var op i64 = n.op
  // The checker rewrites b[i] and len(b) on a bytes local to byte and
  // blen; a tree compiled without it still has index and len, which say
  // the same when the name is a bytes.
  if (op == ovid/parse.OP_INDEX || op == ovid/parse.OP_LEN) && len(n.pkg) == 0 && n.base != 0 as *ovid/parse.Node {
    if Lookup(l, n.name) && IsBytes(l.typ) {
      if op == ovid/parse.OP_INDEX {
        op = ovid/parse.OP_BYTE
      } else {
        op = ovid/parse.OP_BLEN
      }
      n.op = op
    }
  }
  if op == ovid/parse.OP_BYTE {
    var free bool = IsFree(l, n.base, n.arg)
    Pair(l, n.base, p)
    var bp *ovid/parse.Node = l.pa
    var bn *ovid/parse.Node = l.pl
    var mark *ovid/parse.Node = p.tail
    var i *ovid/parse.Node = Hoist(l, n.arg, p)
    FixAt(l, p, mark, bp, bn)
    if free {
      n.op = ovid/parse.OP_LOAD8
      n.base = 0 as *ovid/parse.Node
      n.arg = Bin(l, ovid/parse.OP_ADD, bp, i)
      return 0
    }
    n.op = ovid/parse.OP_BLOAD
    n.base = bp
    n.left = i
    n.right = bn
    n.arg = 0 as *ovid/parse.Node
    return 0
  }
  if op == ovid/parse.OP_BLEN || op == ovid/parse.OP_PTR {
    var half *ovid/parse.Node = n.base
    if op == ovid/parse.OP_PTR {
      half = n.arg
    }
    Pair(l, half, p)
    var ln *ovid/parse.Node = l.pl
    if op == ovid/parse.OP_PTR {
      ln = l.pa
    }
    if ln.op == ovid/parse.OP_NAME {
      Become(l, n, ln.name)
    } else {
      // Of a literal (strlen or strptr) or a field (its load).
      var next *ovid/parse.Node = n.next
      var num i64 = n.num
      ovid/mem.CopyN(n as i64, ln as i64, sizeof(ovid/parse.Node))
      n.next = next
      n.num = num
    }
    return 0
  }
  if op == ovid/parse.OP_LAND || op == ovid/parse.OP_LOR {
    Expr(l, n.left, p)
    var rp *Pre = NewPre(l)
    Expr(l, n.right, rp)
    if rp.head == 0 as *ovid/parse.Node {
      return 0
    }
    // The right side has statements: run them only when it is
    // evaluated. var t bool = left; if t { rp; t = right } (or if !t
    // for ||), and the expression is t.
    var t *ovid/parse.Node = Temp(l, "bool", n.left, p)
    var set *ovid/parse.Node = NewNode(l, ovid/parse.OP_ASSIGN)
    set.name = t.name
    set.val = n.right
    Append(rp, set)
    var ifn *ovid/parse.Node = NewNode(l, ovid/parse.OP_IF)
    ifn.then = rp.head
    if op == ovid/parse.OP_LAND {
      ifn.cond = Name(l, t.name)
    } else {
      var nt *ovid/parse.Node = NewNode(l, ovid/parse.OP_NOT)
      nt.arg = Name(l, t.name)
      ifn.cond = nt
    }
    Append(p, ifn)
    Become(l, n, t.name)
    return 0
  }
  if op == ovid/parse.OP_CALL || op == ovid/parse.OP_SYSCALL {
    var out *Pre = NewPre(l)
    var kept *ovid/parse.Node = 0 as *ovid/parse.Node
    var a *ovid/parse.Node = n.args
    while a != 0 as *ovid/parse.Node {
      var nxt *ovid/parse.Node = a.next
      a.next = 0 as *ovid/parse.Node
      var at *ovid/parse.Node = p.tail
      if IsBytesExpr(l, a) {
        Pair(l, a, p)
        if Grew(p, at) {
          MoveCalls(l, p, at, kept)
          kept = 0 as *ovid/parse.Node
        }
        if !Simple(l.pa) {
          kept = Keep(l, kept, l.pa)
          kept = Keep(l, kept, l.pl)
        }
        Append(out, l.pa)
        Append(out, l.pl)
      } else {
        Expr(l, a, p)
        if Grew(p, at) {
          MoveCalls(l, p, at, kept)
          kept = 0 as *ovid/parse.Node
        }
        if !Simple(a) {
          kept = Keep(l, kept, a)
        }
        Append(out, a)
      }
      a = nxt
    }
    n.args = out.head
    return 0
  }
  return Ordered(l, p, n)
}

// Ordered lowers h's operands (left, right, arg, base, cond: an
// expression's children, or a statement's operands put in a holder in
// that order) in evaluation order, in place; when one adds to p, every
// earlier operand that is not simple is moved into a temp ahead of
// that addition, so what it computes or reads still happens in source
// order.
func Ordered(l *L, p *Pre, h *ovid/parse.Node) i64 {
  var done *ovid/parse.Node = 0 as *ovid/parse.Node
  var k i64 = 0
  while k < 5 {
    var ch *ovid/parse.Node = h.left
    if k == 1 {
      ch = h.right
    } else if k == 2 {
      ch = h.arg
    } else if k == 3 {
      ch = h.base
    } else if k == 4 {
      ch = h.cond
    }
    if ch != 0 as *ovid/parse.Node {
      var at *ovid/parse.Node = p.tail
      Expr(l, ch, p)
      if Grew(p, at) {
        var mk *ovid/parse.Node = at
        var dn *ovid/parse.Node = done
        while dn != 0 as *ovid/parse.Node {
          if !Simple(dn.base) {
            mk = MoveCalls(l, p, mk, Keep(l, 0 as *ovid/parse.Node, dn.base))
          }
          dn = dn.next
        }
        done = 0 as *ovid/parse.Node
      }
      done = Keep(l, done, ch)
    }
    k = k + 1
  }
  return 0
}

// CountList is the length of the statement list s.
func CountList(s *ovid/parse.Node) i64 {
  var n i64 = 0
  while s != 0 as *ovid/parse.Node {
    n = n + 1
    s = s.next
  }
  return n
}

// Holder is a node whose left, right, and arg are a statement's
// operands, for Ordered.
func Holder(l *L, a *ovid/parse.Node, b *ovid/parse.Node, c *ovid/parse.Node) *ovid/parse.Node {
  var h *ovid/parse.Node = NewNode(l, ovid/parse.OP_EXPR)
  h.left = a
  h.right = b
  h.arg = c
  return h
}

// Claim gives statement n and the generated statements under it the
// id id, leaving statements that have one (the source's own) alone.
func Claim(n *ovid/parse.Node, id i64) i64 {
  if n.num != 0 {
    return 0
  }
  n.num = id
  ClaimList(n.then, id)
  ClaimList(n.els, id)
  ClaimList(n.body, id)
  return 0
}

func ClaimList(n *ovid/parse.Node, id i64) i64 {
  while n != 0 as *ovid/parse.Node {
    Claim(n, id)
    n = n.next
  }
  return 0
}

func Stmts(l *L, s *ovid/parse.Node) *ovid/parse.Node {
  return Region(l, s, -1)
}

// Region lowers the statements of a block; with k not negative, the last
// entry of l.free holds for the first k of them only and is dropped
// after them.
func Region(l *L, s *ovid/parse.Node, k i64) *ovid/parse.Node {
  var save i64 = l.nenv
  var out *Pre = NewPre(l)
  var j i64 = 0
  while s != 0 as *ovid/parse.Node {
    if j == k {
      l.free.b = ""
      l.free.i = ""
    }
    j = j + 1
    var nxt *ovid/parse.Node = s.next
    var p *Pre = NewPre(l)
    Stmt(l, s, p)
    // What was placed before the statement is the statement's, for the
    // crash report when a check in it fails: the statements themselves
    // and what the restructuring of && or a while put under them.
    var m *ovid/parse.Node = p.head
    while m != 0 as *ovid/parse.Node {
      Claim(m, s.num)
      var mn *ovid/parse.Node = m.next
      Append(out, m)
      m = mn
    }
    s = nxt
  }
  if k >= 0 {
    l.free = l.free.next
  }
  l.nenv = save
  return out.head
}

func ThirdName(l *L, s *ovid/parse.Node) i64 {
  // var b bytes, e i64 = f(): b, b#n, and e, the third in rcx.
  var third *ovid/parse.Node = Name(l, s.name2)
  if ovid/parse.IsBlank(s.name) {
    s.name2 = s.name
  } else {
    s.name2 = NName(l, s.name)
  }
  if s.op == ovid/parse.OP_VAR2 {
    s.typ = "i64"
    s.typ2 = "i64"
  } else {
    s.typ2 = bytes(0, 0)
  }
  s.args = third
  return 0
}

// Stmt lowers s into p: what must run first, then s (or what replaces
// it).
func Stmt(l *L, s *ovid/parse.Node, p *Pre) i64 {
  var op i64 = s.op
  if op == ovid/parse.OP_VAR {
    if IsBytes(s.typ) {
      if s.val.op == ovid/parse.OP_CALL {
        Expr(l, s.val, p)
        Bind(l, s.name, "bytes")
        s.op = ovid/parse.OP_VAR2
        s.typ = "i64"
        s.name2 = NName(l, s.name)
        s.typ2 = "i64"
        Append(p, s)
        return 0
      }
      Pair(l, s.val, p)
      Bind(l, s.name, "bytes")
      s.typ = "i64"
      s.val = l.pa
      Append(p, s)
      var v2 *ovid/parse.Node = NewNode(l, ovid/parse.OP_VAR)
      v2.name = NName(l, s.name)
      v2.typ = "i64"
      v2.val = l.pl
      Append(p, v2)
      return 0
    }
    Expr(l, s.val, p)
    Bind(l, s.name, s.typ)
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_VAR2 || op == ovid/parse.OP_ASSIGN2 {
    Expr(l, s.val, p)
    if op == ovid/parse.OP_VAR2 {
      Bind(l, s.name, s.typ)
      Bind(l, s.name2, s.typ2)
    }
    if s.val.op == ovid/parse.OP_CALL && ResultWords(l, s.val) == 3 {
      ThirdName(l, s)
    }
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_ASSIGN {
    if Lookup(l, s.name) && IsBytes(l.typ) {
      if s.val.op == ovid/parse.OP_CALL {
        Expr(l, s.val, p)
        s.op = ovid/parse.OP_ASSIGN2
        s.name2 = NName(l, s.name)
        Append(p, s)
        return 0
      }
      Pair(l, s.val, p)
      s.val = l.pa
      Append(p, s)
      var a2 *ovid/parse.Node = NewNode(l, ovid/parse.OP_ASSIGN)
      a2.name = NName(l, s.name)
      a2.val = l.pl
      Append(p, a2)
      return 0
    }
    Expr(l, s.val, p)
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_SETFIELD {
    TypeOf(l, s.base)
    if FieldIsBytes(l, FindType(l, l.typ), s.name) {
      var base *ovid/parse.Node = Hoist(l, s.base, p)
      Pair(l, s.val, p)
      // Both words are read before the first store: through a cast the
      // destination may overlap the source, and the whole value is what
      // the assignment means.
      var a *ovid/parse.Node = Fix(l, l.pa, p)
      var ln *ovid/parse.Node = Fix(l, l.pl, p)
      s.base = base
      s.val = a
      Append(p, s)
      var f2 *ovid/parse.Node = NewNode(l, ovid/parse.OP_SETFIELD)
      f2.base = base
      f2.name = NName(l, s.name)
      f2.val = ln
      Append(p, f2)
      return 0
    }
    Ordered(l, p, Holder(l, s.base, s.val, 0 as *ovid/parse.Node))
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_SETBYTE {
    var ix *ovid/parse.Node = s.base
    var free bool = IsFree(l, ix.base, ix.arg)
    Pair(l, ix.base, p)
    var bp *ovid/parse.Node = l.pa
    var bn *ovid/parse.Node = l.pl
    var mark *ovid/parse.Node = p.tail
    var i *ovid/parse.Node = Hoist(l, ix.arg, p)
    Expr(l, s.val, p)
    // The store computes the value before its address, so when it could
    // change b, b is read first and the check and the store see the
    // same pair.
    if !Simple(s.val) {
      FixAll(l, p, mark, bp, bn)
    } else {
      FixAt(l, p, mark, bp, bn)
    }
    if !free {
      var ck *ovid/parse.Node = NewNode(l, ovid/parse.OP_CHK)
      ck.addr = i
      ck.val = bn
      Append(p, ck)
    }
    s.op = ovid/parse.OP_STORE8
    s.base = 0 as *ovid/parse.Node
    s.addr = Bin(l, ovid/parse.OP_ADD, bp, i)
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_RETURN {
    if s.val != 0 as *ovid/parse.Node && IsBytesExpr(l, s.val) {
      if s.val.op == ovid/parse.OP_CALL && s.val2 == 0 as *ovid/parse.Node {
        // Forwarded: the callee's results are this func's.
        Expr(l, s.val, p)
        Append(p, s)
        return 0
      }
      var e *ovid/parse.Node = s.val2
      Pair(l, s.val, p)
      s.val = l.pa
      s.val2 = l.pl
      if e != 0 as *ovid/parse.Node {
        // return b, e: the error code is the third word, and the code
        // generator computes it first, so b is read into temps ahead
        // of it.
        s.val = Fix(l, s.val, p)
        s.val2 = Fix(l, s.val2, p)
        Expr(l, e, p)
        s.args = e
      }
      Append(p, s)
      return 0
    }
    Ordered(l, p, Holder(l, s.val, s.val2, 0 as *ovid/parse.Node))
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_IF {
    Expr(l, s.cond, p)
    s.then = Stmts(l, s.then)
    s.els = Stmts(l, s.els)
    Append(p, s)
    return 0
  }
  if op == ovid/parse.OP_WHILE {
    // A loop over b by i needs no check of b[i] in its condition and
    // before i grows: the condition proved it.
    var k i64 = FreeLoop(l, s)
    if k >= 0 {
      PushFree(l, l.fb, l.fi)
    } else {
      PushFree(l, "", "")
      k = CountList(s.body)
    }
    var cp *Pre = NewPre(l)
    Expr(l, s.cond, cp)
    s.body = Region(l, s.body, k)
    if cp.head == 0 as *ovid/parse.Node {
      Append(p, s)
      return 0
    }
    // The condition has statements, which must run before each test:
    // var go bool = true; while go { cp; if cond { body } else { go =
    // false } }.
    var g *ovid/parse.Node = Temp(l, "bool", BoolNode(l, true), p)
    var stop *ovid/parse.Node = NewNode(l, ovid/parse.OP_ASSIGN)
    stop.name = g.name
    stop.val = BoolNode(l, false)
    var ifn *ovid/parse.Node = NewNode(l, ovid/parse.OP_IF)
    ifn.cond = s.cond
    ifn.then = s.body
    ifn.els = stop
    Append(cp, ifn)
    // The checks in cp are the while's, for the crash report.
    ClaimList(cp.head, s.num)
    s.cond = Name(l, g.name)
    s.body = cp.head
    Append(p, s)
    return 0
  }
  // expr, store*, chk: lower the expressions in place, in order.
  Ordered(l, p, Holder(l, s.addr, s.val, s.val2))
  Append(p, s)
  return 0
}
