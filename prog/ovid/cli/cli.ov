package ovid/cli

import ovid/io
import ovid/mem
import ovid/check
import ovid/cg
import ovid/lower
import ovid/parse

// Args holds the parsed command line: the module dir, --std, and -o.
type Args struct {
  dir i64
  std i64
  out i64
  bad i64
  q i64
  name i64
}

func ArgEq(io *ovid/io.Cap, i i64, lit bytes) bool {
  var a i64 = ovid/io.ArgC(io, i)
  return ovid/mem.Eq(bytes(a, ovid/io.CLen(a)), lit)
}

func Join(io *ovid/io.Cap, dir bytes, suf bytes) i64 {
  var n i64 = (len(dir) + 1) + len(suf)
  var p i64 = ovid/io.Alloc(io, n + 1)
  ovid/mem.CopyN(p, ptr(dir), len(dir))
  store8(p + len(dir), 47)
  ovid/mem.CopyN(p + len(dir) + 1, ptr(suf), len(suf))
  store8(p + n, 0)
  return p
}

// Usage prints the usage error (exit 64). Keep it in sync with main.
func Usage(io *ovid/io.Cap, msg bytes) i64 {
  var b *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WBytes(io, b, "{\"ok\":false,\"error\":\"usage\",\"message\":")
  ovid/parse.WStr(io, b, msg)
  ovid/mem.WBytes(io, b, ",\"usage\":\"ovid check [dir] [--std dir] | ovid build [dir] [-o out] [--std dir] | ovid dump [dir] [--std dir] | ovid refs <id|name> [dir] [--name N] [--std dir]; dir defaults to . and may also be given as -C dir; out defaults to <dir>/bin/<module name>; --std names the directory holding the shipped packages (ovid/io, ovid/mem)\"}\n")
  ovid/io.Stdout(bytes(b.data, b.len))
  return 64
}

func Fail(io *ovid/io.Cap, code bytes, detail bytes) i64 {
  var b *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WBytes(io, b, "{\"ok\":false,\"error\":")
  ovid/parse.WStr(io, b, code)
  ovid/mem.WBytes(io, b, ",\"message\":")
  ovid/parse.WStr(io, b, detail)
  ovid/mem.WBytes(io, b, bytes(strptr("}\n"), 2))
  ovid/io.Stdout(bytes(b.data, b.len))
  return 1
}

// LoadFailed ends the output for a module that did not load: the summary
// line for check and dump, {"ok":false,"errors":N} for build.
func LoadFailed(io *ovid/io.Cap, m *ovid/parse.Mod, build bool) i64 {
  var b *ovid/mem.Buf = ovid/mem.New(io, 256)
  if build {
    ovid/mem.WBytes(io, b, "{\"ok\":false,\"errors\":")
  } else {
    ovid/mem.WBytes(io, b, "{\"fact\":\"summary\",\"ok\":false,\"errors\":")
  }
  ovid/parse.WInt(io, b, m.nerr)
  ovid/mem.WBytes(io, b, bytes(strptr("}\n"), 2))
  ovid/io.Stdout(bytes(b.data, b.len))
  return 1
}

func MkParent(io *ovid/io.Cap, path i64) i64 {
  var n i64 = ovid/io.CLen(path)
  var i i64 = n - 1
  while i >= 0 {
    if load8(path + i) == 47 {
      var p i64 = ovid/io.Alloc(io, i + 1)
      ovid/mem.CopyN(p, path, i)
      store8(p + i, 0)
      ovid/io.Mkdir(p)
      return 0
    }
    i = i - 1
  }
  return 0
}

// ParseArgs reads the command line after the command: the module dir, -C
// DIR, --std DIR, -o OUT when allowOut, and when wantQ the first bare word
// as the query (a.q) before the dir, and --name N (a.name). a.bad is set
// (and a message printed) on a usage error.
func ParseArgs(io *ovid/io.Cap, allowOut bool, wantQ bool) *Args {
  var a *Args = ovid/io.Alloc(io, sizeof(Args)) as *Args
  var i i64 = 2
  var n i64 = ovid/io.Argc(io)
  while i < n && a.bad == 0 {
    var flag bool = ArgEq(io, i, "-C") || ArgEq(io, i, "--std") || (allowOut && ArgEq(io, i, "-o")) || (wantQ && ArgEq(io, i, "--name"))
    if flag {
      if i + 1 >= n {
        a.bad = Usage(io, "flag needs a value")
      } else if ArgEq(io, i, "--std") {
        a.std = ovid/io.ArgC(io, i + 1)
      } else if ArgEq(io, i, "-o") {
        a.out = ovid/io.ArgC(io, i + 1)
      } else if ArgEq(io, i, "--name") {
        a.name = ovid/io.ArgC(io, i + 1)
      } else if a.dir != 0 {
        a.bad = Usage(io, "more than one module dir")
      } else {
        a.dir = ovid/io.ArgC(io, i + 1)
      }
      i = i + 2
    } else if load8(ovid/io.ArgC(io, i)) == 45 {
      a.bad = Usage(io, bytes(ovid/io.ArgC(io, i), ovid/io.CLen(ovid/io.ArgC(io, i))))
    } else if wantQ && a.q == 0 {
      a.q = ovid/io.ArgC(io, i)
      i = i + 1
    } else if a.dir != 0 {
      a.bad = Usage(io, "more than one module dir")
    } else {
      a.dir = ovid/io.ArgC(io, i)
      i = i + 1
    }
  }
  if a.dir == 0 {
    a.dir = strptr(".")
  }
  return a
}

// LoadArgs loads the module named by a; on load errors it prints the
// closing line (see LoadFailed) and returns 0.
func LoadArgs(io *ovid/io.Cap, a *Args, build bool) *ovid/parse.Mod {
  var stdn i64 = 0
  if a.std != 0 {
    stdn = ovid/io.CLen(a.std)
  }
  var dn i64 = ovid/io.CLen(a.dir)
  while dn > 1 && load8((a.dir + dn) - 1) == 47 {
    dn = dn - 1
  }
  var m *ovid/parse.Mod = ovid/parse.Load(io, bytes(a.dir, dn), bytes(a.std, stdn), build)
  if m.nerr != 0 {
    LoadFailed(io, m, build)
    return 0 as *ovid/parse.Mod
  }
  return m
}

func CmdCheck(io *ovid/io.Cap) i64 {
  var a *Args = ParseArgs(io, false, false)
  if a.bad != 0 {
    return a.bad
  }
  var m *ovid/parse.Mod = LoadArgs(io, a, false)
  if m == 0 as *ovid/parse.Mod {
    return 1
  }
  if ovid/check.Run(io, m, false) != 0 {
    return 1
  }
  return 0
}

func CmdDump(io *ovid/io.Cap) i64 {
  var a *Args = ParseArgs(io, false, false)
  if a.bad != 0 {
    return a.bad
  }
  var m *ovid/parse.Mod = LoadArgs(io, a, false)
  if m == 0 as *ovid/parse.Mod {
    return 1
  }
  ovid/parse.Emit(m)
  ovid/io.Stdout(bytes(m.json.data, m.json.len))
  return 0
}

func CmdBuild(io *ovid/io.Cap) i64 {
  var a *Args = ParseArgs(io, true, false)
  if a.bad != 0 {
    return a.bad
  }
  var m *ovid/parse.Mod = LoadArgs(io, a, true)
  if m == 0 as *ovid/parse.Mod {
    return 1
  }
  if ovid/check.Run(io, m, true) != 0 {
    return 1
  }
  if ovid/parse.ServeHost(m) != 0 {
    return Fail(io, "compile", "serve host: syntax")
  }
  var out i64 = a.out
  if out == 0 {
    var bin i64 = Join(io, m.dir, "bin")
    out = Join(io, bytes(bin, len(m.dir) + 4), m.name)
  }
  var errp i64 = ovid/io.Alloc(io, 8)
  store64(errp, 0)
  // A bytes is two words; the code generator sees only one per value.
  ovid/lower.Program(io, m)
  var b *ovid/mem.Buf = ovid/cg.Compile(io, m, errp)
  if load64(errp) != 0 {
    var msg *ovid/mem.Buf = load64(errp) as *ovid/mem.Buf
    return Fail(io, "compile", bytes(msg.data, msg.len))
  }
  MkParent(io, out)
  if ovid/io.WriteFileAtomic(io, bytes(out, ovid/io.CLen(out)), bytes(b.data, b.len), 493) != 0 {
    return Fail(io, "write", bytes(out, ovid/io.CLen(out)))
  }
  var qb *ovid/mem.Buf = ovid/mem.New(io, 1024)
  ovid/mem.WBytes(io, qb, "{\"ok\":true,\"output\":")
  ovid/parse.WStr(io, qb, bytes(out, ovid/io.CLen(out)))
  ovid/mem.WBytes(io, qb, ",\"bytes\":")
  ovid/parse.WInt(io, qb, b.len)
  // Every system call the program can make, in increasing order.
  ovid/mem.WBytes(io, qb, ",\"syscalls\":[")
  var sn i64 = 0
  var first bool = true
  while sn < ovid/cg.SYSMAX {
    if load8(m.sys + sn) != 0 {
      if !first {
        ovid/mem.WByte(io, qb, 44)
      }
      first = false
      ovid/parse.WInt(io, qb, sn)
    }
    sn = sn + 1
  }
  ovid/mem.WByte(io, qb, 93)
  if m.sysunk != 0 {
    ovid/mem.WBytes(io, qb, ",\"syscalls_unknown\":")
    ovid/parse.WInt(io, qb, m.sysunk)
  }
  ovid/mem.WBytes(io, qb, bytes(strptr("}\n"), 2))
  ovid/io.Stdout(bytes(qb.data, qb.len))
  return 0
}

func main(io *ovid/io.Cap) i64 {
  if ovid/io.Argc(io) < 2 {
    return Usage(io, "no command")
  }
  if ArgEq(io, 1, "check") {
    return CmdCheck(io)
  }
  if ArgEq(io, 1, "build") {
    return CmdBuild(io)
  }
  if ArgEq(io, 1, "dump") {
    return CmdDump(io)
  }
  if ArgEq(io, 1, "refs") {
    return CmdRefs(io)
  }
  var cmd i64 = ovid/io.ArgC(io, 1)
  var b *ovid/mem.Buf = ovid/mem.New(io, 256)
  ovid/mem.WBytes(io, b, "unknown command ")
  ovid/mem.WBytes(io, b, bytes(cmd, ovid/io.CLen(cmd)))
  ovid/mem.WBytes(io, b, "; commands: check build dump refs")
  return Usage(io, bytes(b.data, b.len))
}
