package ovid/cli

import ovid/io
import ovid/mem
import ovid/check
import ovid/parse

// A refs target: one of the decl kinds, or a var statement.
const T_FUNC i64 = 1
const T_TYPE i64 = 2
const T_CONST i64 = 3
const T_FIELD i64 = 4
const T_PARAM i64 = 5
const T_VAR i64 = 6

// Target is what refs was asked about: a decl (kind T_FUNC..T_PARAM) or
// the var statement vn (T_VAR); pkg is its package and own its enclosing
// type or func, for the id.
type Target struct {
  kind i64
  d *ovid/parse.Decl
  vn *ovid/parse.Node
  pkg *ovid/parse.Pkg
  own *ovid/parse.Decl
  nmatch i64
  bad *ovid/mem.Buf
  copies i64
}

// Eq2 reports whether the two strings are the same.
func Eq2(a bytes, b bytes) bool {
  return ovid/mem.Eq(a, b)
}

// Split finds the last byte c in s, or -1.
func Split(s bytes, c i64) i64 {
  var i i64 = len(s) - 1
  while i >= 0 {
    if load8(ptr(s) + i) == c {
      return i
    }
    i = i - 1
  }
  return -1
}

// ParseInt reads the decimal in s as an id spells it: digits only,
// no leading zero, at most 18 digits (so it cannot wrap); else -1.
func ParseInt(s bytes) i64 {
  if len(s) == 0 || len(s) > 18 {
    return -1
  }
  if len(s) > 1 && load8(ptr(s)) == 48 {
    return -1
  }
  var v i64 = 0
  var i i64 = 0
  while i < len(s) {
    var c i64 = load8(ptr(s) + i)
    if c < 48 || c > 57 {
      return -1
    }
    v = (v * 10) + (c - 48)
    i = i + 1
  }
  return v
}

// FindVar finds statement number num in the statement list s.
func FindVar(s *ovid/parse.Node, num i64) *ovid/parse.Node {
  while s != 0 as *ovid/parse.Node {
    if s.num == num {
      return s
    }
    var r *ovid/parse.Node = FindVar(s.then, num)
    if r == 0 as *ovid/parse.Node {
      r = FindVar(s.els, num)
    }
    if r == 0 as *ovid/parse.Node {
      r = FindVar(s.body, num)
    }
    if r != 0 as *ovid/parse.Node {
      return r
    }
    s = s.next
  }
  return 0 as *ovid/parse.Node
}

// HasExpr reports whether an expression numbered num is in the statement
// list s.
func HasExpr(s *ovid/parse.Node, num i64) bool {
  while s != 0 as *ovid/parse.Node {
    if !ovid/parse.IsStmt(s.op) && s.num == num {
      return true
    }
    if HasExpr(s.left, num) || HasExpr(s.right, num) || HasExpr(s.arg, num) || HasExpr(s.base, num) {
      return true
    }
    if HasExpr(s.addr, num) || HasExpr(s.val, num) || HasExpr(s.val2, num) || HasExpr(s.cond, num) {
      return true
    }
    if HasExpr(s.args, num) || HasExpr(s.then, num) || HasExpr(s.els, num) || HasExpr(s.body, num) {
      return true
    }
    s = s.next
  }
  return false
}

// IdCopies counts the nodes the pkg:, im:, or ex: id q (colon at c)
// names in the module: 0 for an id that names nothing, more than 1 for
// a duplicated one.
func IdCopies(m *ovid/parse.Mod, q bytes, c i64) i64 {
  var rp i64 = (ptr(q) + c) + 1
  var rn i64 = (len(q) - c) - 1
  if load8(ptr(q)) == 112 {
    var k *ovid/parse.Pkg = m.pkgs
    while k != 0 as *ovid/parse.Pkg {
      if Eq2(k.path, bytes(rp, rn)) {
        return 1
      }
      k = k.next
    }
    return 0
  }
  if load8(ptr(q)) == 105 {
    // im:<pkg>:<import path>
    var c2 i64 = Split(bytes(rp, rn), 58)
    if c2 < 0 {
      return 0
    }
    var k *ovid/parse.Pkg = m.pkgs
    while k != 0 as *ovid/parse.Pkg {
      if Eq2(k.path, bytes(rp, c2)) {
        return CountNamed(k.ims, bytes((rp + c2) + 1, (rn - c2) - 1))
      }
      k = k.next
    }
    return 0
  }
  // ex:<pkg>.<func>:<num>, in every copy of the func
  var c3 i64 = Split(bytes(rp, rn), 58)
  if c3 < 0 {
    return 0
  }
  var num i64 = ParseInt(bytes((rp + c3) + 1, (rn - c3) - 1))
  var dot i64 = Split(bytes(rp, c3), 46)
  if dot < 1 || num < 0 {
    return 0
  }
  var pk *ovid/parse.Pkg = m.pkgs
  while pk != 0 as *ovid/parse.Pkg && !Eq2(pk.path, bytes(rp, dot)) {
    pk = pk.next
  }
  if pk == 0 as *ovid/parse.Pkg {
    return 0
  }
  var n i64 = 0
  var fn *ovid/parse.Decl = pk.fs
  while fn != 0 as *ovid/parse.Decl {
    if Eq2(fn.name, bytes((rp + dot) + 1, (c3 - dot) - 1)) && HasExpr(fn.body, num) {
      n = n + 1
    }
    fn = fn.next
  }
  return n
}

// ByID resolves a full id (fn:pkg.N, ty:pkg.N, cn:pkg.N, fld:pkg.T.f,
// pa:pkg.F.p, st:pkg.F:N) into t; nmatch is 1 when found.
func ByID(m *ovid/parse.Mod, t *Target, q bytes) i64 {
  var colon i64 = 0
  while colon < len(q) && load8(ptr(q) + colon) != 58 {
    colon = colon + 1
  }
  if colon >= len(q) {
    return 0
  }
  var kind i64 = 0
  if Eq2(q[0:colon], "fn") {
    kind = T_FUNC
  } else if Eq2(q[0:colon], "ty") {
    kind = T_TYPE
  } else if Eq2(q[0:colon], "cn") {
    kind = T_CONST
  } else if Eq2(q[0:colon], "fld") {
    kind = T_FIELD
  } else if Eq2(q[0:colon], "pa") {
    kind = T_PARAM
  } else if Eq2(q[0:colon], "st") {
    kind = T_VAR
  } else if Eq2(q[0:colon], "ex") || Eq2(q[0:colon], "pkg") || Eq2(q[0:colon], "im") {
    // An id refs cannot follow, as the Go refs says; one that names
    // nothing is not found, as there, and one that names several copies
    // is ambiguous_id first, as there.
    t.copies = IdCopies(m, q, colon)
    if t.copies == 0 {
      return 0
    }
    t.bad = ovid/mem.New(m.io, 256)
    ovid/mem.WBytes(m.io, t.bad, "refs works on funcs, types, fields, consts, params, and var statements, not ")
    if load8(ptr(q)) == 101 {
      ovid/mem.WBytes(m.io, t.bad, "expr")
    } else if load8(ptr(q)) == 112 {
      ovid/mem.WBytes(m.io, t.bad, "package")
    } else {
      ovid/mem.WBytes(m.io, t.bad, "import")
    }
    t.nmatch = 1
    return 0
  } else {
    return 0
  }
  var rp i64 = (ptr(q) + colon) + 1
  var rn i64 = (len(q) - colon) - 1
  var num i64 = -1
  if kind == T_VAR {
    var c2 i64 = Split(bytes(rp, rn), 58)
    if c2 < 0 {
      return 0
    }
    num = ParseInt(bytes((rp + c2) + 1, (rn - c2) - 1))
    rn = c2
  }
  // pkg.Name, or pkg.Owner.name for a field or param.
  var dot i64 = Split(bytes(rp, rn), 46)
  if dot < 1 {
    return 0
  }
  var np i64 = (rp + dot) + 1
  var nn i64 = (rn - dot) - 1
  var op i64 = 0
  var on i64 = 0
  var pn i64 = dot
  if kind == T_FIELD || kind == T_PARAM {
    var dot2 i64 = Split(bytes(rp, dot), 46)
    if dot2 < 1 {
      return 0
    }
    op = (rp + dot2) + 1
    on = (dot - dot2) - 1
    pn = dot2
  }
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg && !Eq2(k.path, bytes(rp, pn)) {
    k = k.next
  }
  if k == 0 as *ovid/parse.Pkg {
    return 0
  }
  t.kind = kind
  t.pkg = k
  if kind == T_FUNC {
    t.d = ovid/parse.FindDecl(k.fs, bytes(np, nn))
  } else if kind == T_TYPE {
    t.d = ovid/parse.FindDecl(k.ts, bytes(np, nn))
  } else if kind == T_CONST {
    t.d = ovid/parse.FindDecl(k.cs, bytes(np, nn))
  } else if kind == T_FIELD || kind == T_PARAM {
    var owners *ovid/parse.Decl = k.fs
    if kind == T_FIELD {
      owners = k.ts
    }
    t.own = OwnerWith(owners, bytes(op, on), bytes(np, nn))
    if t.own != 0 as *ovid/parse.Decl {
      t.d = ovid/parse.FindDecl(t.own.sub, bytes(np, nn))
    }
  } else {
    // The first copy of the func that has the statement, likewise.
    var fns *ovid/parse.Decl = k.fs
    while fns != 0 as *ovid/parse.Decl && t.vn == 0 as *ovid/parse.Node {
      if Eq2(fns.name, bytes(np, nn)) {
        t.own = fns
        if num >= 0 {
          t.vn = FindVar(fns.body, num)
        }
      }
      fns = fns.next
    }
    if t.vn == 0 as *ovid/parse.Node {
      return 0
    }
    t.nmatch = 1
    if t.vn.op == ovid/parse.OP_VAR2 {
      t.bad = ovid/mem.New(m.io, 256)
      ovid/mem.WBytes(m.io, t.bad, q)
      ovid/mem.WBytes(m.io, t.bad, " declares two locals, ")
      ovid/mem.WBytes(m.io, t.bad, t.vn.name)
      ovid/mem.WBytes(m.io, t.bad, " and ")
      ovid/mem.WBytes(m.io, t.bad, t.vn.name2)
      ovid/mem.WBytes(m.io, t.bad, ", and an id names only one; refs cannot reach either yet (ovid grep finds their uses)")
    } else if t.vn.op != ovid/parse.OP_VAR {
      t.bad = ovid/mem.New(m.io, 256)
      ovid/mem.WBytes(m.io, t.bad, "refs works on funcs, types, fields, consts, params, and var statements; ")
      ovid/mem.WBytes(m.io, t.bad, q)
      ovid/mem.WBytes(m.io, t.bad, " is another kind of statement")
    }
    return 0
  }
  if t.d != 0 as *ovid/parse.Decl {
    t.nmatch = 1
  }
  return 0
}

// PkgIs reports whether package k is named by q: its whole path, or
// the tail of it after a "/" (mem for ovid/mem), as the Go toolchain's
// name lookup allows.
func PkgIs(k *ovid/parse.Pkg, q bytes) bool {
  if Eq2(k.path, q) {
    return true
  }
  if len(k.path) > len(q) && load8((ptr(k.path) + len(k.path)) - (len(q) + 1)) == 47 {
    return Eq2(bytes((ptr(k.path) + len(k.path)) - len(q), len(q)), q)
  }
  return false
}

// Found counts one decl that answers to the name.
func Found(t *Target, kind i64, k *ovid/parse.Pkg, d *ovid/parse.Decl, own *ovid/parse.Decl) i64 {
  if d == 0 as *ovid/parse.Decl {
    return 0
  }
  t.nmatch = t.nmatch + 1
  t.kind = kind
  t.d = d
  t.pkg = k
  t.own = own
  return 0
}

// ByName resolves Name, pkg.Name, Owner.name, or pkg.Owner.name among
// funcs, types, consts, fields, and params (pkg being a package path or
// the tail of one); nmatch counts how many decls answer to it.
func ByName(m *ovid/parse.Mod, t *Target, q bytes) i64 {
  var dot i64 = Split(q, 46)
  var np i64 = ptr(q)
  var nn i64 = len(q)
  if dot > 0 {
    np = (ptr(q) + dot) + 1
    nn = (len(q) - dot) - 1
  }
  // The qualifier as an owner (Type or Func), itself maybe qualified.
  var op i64 = 0
  var on i64 = 0
  var pp i64 = 0
  var pn i64 = -1
  if dot > 0 {
    var dot2 i64 = Split(q[0:dot], 46)
    op = (ptr(q) + dot2) + 1
    on = (dot - dot2) - 1
    if dot2 > 0 {
      pp = ptr(q)
      pn = dot2
    }
  }
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if dot < 0 || PkgIs(k, q[0:dot]) {
      Found(t, T_FUNC, k, ovid/parse.FindDecl(k.fs, bytes(np, nn)), 0 as *ovid/parse.Decl)
      Found(t, T_TYPE, k, ovid/parse.FindDecl(k.ts, bytes(np, nn)), 0 as *ovid/parse.Decl)
      Found(t, T_CONST, k, ovid/parse.FindDecl(k.cs, bytes(np, nn)), 0 as *ovid/parse.Decl)
    }
    k = k.next
  }
  // Fields and params only when no decl answers, as the Go lookup does.
  if t.nmatch != 0 || dot < 0 {
    return 0
  }
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if pn < 0 || PkgIs(k, bytes(pp, pn)) {
      var ty *ovid/parse.Decl = OwnerWith(k.ts, bytes(op, on), bytes(np, nn))
      if ty != 0 as *ovid/parse.Decl {
        Found(t, T_FIELD, k, ovid/parse.FindDecl(ty.sub, bytes(np, nn)), ty)
      }
      var fn *ovid/parse.Decl = OwnerWith(k.fs, bytes(op, on), bytes(np, nn))
      if fn != 0 as *ovid/parse.Decl {
        Found(t, T_PARAM, k, ovid/parse.FindDecl(fn.sub, bytes(np, nn)), fn)
      }
    }
    k = k.next
  }
  return 0
}

// OwnerWith is the first decl in the list named owner that has a member
// named name, or nil: the Go index holds a field's or param's id from
// whichever copy of a duplicated owner has it.
func OwnerWith(d *ovid/parse.Decl, owner bytes, name bytes) *ovid/parse.Decl {
  while d != 0 as *ovid/parse.Decl {
    if Eq2(d.name, owner) && ovid/parse.FindDecl(d.sub, name) != 0 as *ovid/parse.Decl {
      return d
    }
    d = d.next
  }
  return 0 as *ovid/parse.Decl
}

// CountNamed counts the decls in the list d named name.
func CountNamed(d *ovid/parse.Decl, name bytes) i64 {
  var n i64 = 0
  while d != 0 as *ovid/parse.Decl {
    if Eq2(d.name, name) {
      n = n + 1
    }
    d = d.next
  }
  return n
}

// Copies counts the decls that share t's id: more than one when check
// reports a duplicate, and refs then refuses to pick, as the Go refs does.
// A field, param, or var is counted in every copy of its owner too.
func Copies(t *Target) i64 {
  if t.kind == T_TYPE {
    return CountNamed(t.pkg.ts, t.d.name)
  }
  if t.kind == T_CONST {
    return CountNamed(t.pkg.cs, t.d.name)
  }
  if t.kind == T_FUNC {
    return CountNamed(t.pkg.fs, t.d.name)
  }
  var owners *ovid/parse.Decl = t.pkg.fs
  if t.kind == T_FIELD {
    owners = t.pkg.ts
  }
  var n i64 = 0
  while owners != 0 as *ovid/parse.Decl {
    if Eq2(owners.name, t.own.name) {
      if t.kind == T_VAR {
        if FindVar(owners.body, t.vn.num) != 0 as *ovid/parse.Node {
          n = n + 1
        }
      } else {
        n = n + CountNamed(owners.sub, t.d.name)
      }
    }
    owners = owners.next
  }
  return n
}

// Hits reports whether use u is of target t.
func Hits(t *Target, u *ovid/parse.Use) bool {
  if t.kind == T_VAR {
    return u.vnode == t.vn
  }
  return u.decl == t.d && u.decl != 0 as *ovid/parse.Decl
}

// WTarget writes t's id.
func WTarget(io *ovid/io.Cap, b *ovid/mem.Buf, t *Target) i64 {
  if t.kind == T_FUNC {
    ovid/mem.WBytes(io, b, "fn:")
  } else if t.kind == T_TYPE {
    ovid/mem.WBytes(io, b, "ty:")
  } else if t.kind == T_CONST {
    ovid/mem.WBytes(io, b, "cn:")
  } else if t.kind == T_FIELD {
    ovid/mem.WBytes(io, b, "fld:")
  } else if t.kind == T_PARAM {
    ovid/mem.WBytes(io, b, "pa:")
  } else {
    ovid/mem.WBytes(io, b, "st:")
  }
  ovid/mem.WBytes(io, b, t.pkg.path)
  ovid/mem.WByte(io, b, 46)
  if t.own != 0 as *ovid/parse.Decl {
    ovid/mem.WBytes(io, b, t.own.name)
    if t.kind == T_VAR {
      ovid/mem.WByte(io, b, 58)
      ovid/parse.WInt(io, b, t.vn.num)
      return 0
    }
    ovid/mem.WByte(io, b, 46)
  }
  ovid/mem.WBytes(io, b, t.d.name)
  return 0
}

// WDeclID writes the id of the func, type, or const d (the "in" of a
// use). Every func has a result type and no type decl does; a func's body
// may be empty; a const is on its package's list.
func WDeclID(io *ovid/io.Cap, b *ovid/mem.Buf, d *ovid/parse.Decl) i64 {
  if IsConst(d) {
    ovid/mem.WBytes(io, b, "cn:")
  } else if len(d.typ) != 0 {
    ovid/mem.WBytes(io, b, "fn:")
  } else {
    ovid/mem.WBytes(io, b, "ty:")
  }
  ovid/mem.WBytes(io, b, d.pkg.path)
  ovid/mem.WByte(io, b, 46)
  ovid/mem.WBytes(io, b, d.name)
  return 0
}

// IsConst says whether d is one of its package's consts, which a use in
// another const's value sits in. A field or param has no package of its
// own set, and is not one.
func IsConst(d *ovid/parse.Decl) bool {
  if d.pkg == 0 as *ovid/parse.Pkg {
    return false
  }
  var c *ovid/parse.Decl = d.pkg.cs
  while c != 0 as *ovid/parse.Decl {
    if c == d {
      return true
    }
    c = c.next
  }
  return false
}

// Cursor remembers where the last LineFrom scan ended (file, byte, line,
// line start), so the sorted uses of one file are counted in one pass
// rather than from byte 0 each time.
type Cursor struct {
  file *ovid/parse.File
  pos i64
  line i64
  ls i64
}

// LineFrom is the 1-based line of offset off in f, and the trimmed text of
// that line (its start and length go to out, two words). It continues
// from cur when that lies in the same file before off, and leaves cur at
// off.
func LineFrom(f *ovid/parse.File, off i64, out i64, cur *Cursor) i64 {
  var line i64 = 1
  var ls i64 = 0
  var i i64 = 0
  if cur != 0 as *Cursor {
    if cur.file == f && cur.pos <= off {
      i = cur.pos
      line = cur.line
      ls = cur.ls
    }
  }
  while i < off && i < len(f.src) {
    if load8(ptr(f.src) + i) == 10 {
      line = line + 1
      ls = i + 1
    }
    i = i + 1
  }
  if cur != 0 as *Cursor {
    cur.file = f
    cur.pos = i
    cur.line = line
    cur.ls = ls
  }
  var le i64 = ls
  while le < len(f.src) && load8(ptr(f.src) + le) != 10 {
    le = le + 1
  }
  while ls < le && (load8(ptr(f.src) + ls) == 32 || load8(ptr(f.src) + ls) == 9) {
    ls = ls + 1
  }
  while le > ls && (load8(ptr(f.src) + (le - 1)) == 32 || load8(ptr(f.src) + (le - 1)) == 9 || load8(ptr(f.src) + (le - 1)) == 13) {
    le = le - 1
  }
  store64(out, ptr(f.src) + ls)
  store64(out + 8, le - ls)
  return line
}

// UseFile is the file a use sits in: that of the func, type, or const it
// is in.
func UseFile(u *ovid/parse.Use) *ovid/parse.File {
  return u.in.file
}

// SortKey orders uses as refs prints them: by file, then by position.
// Files are numbered once (f.ord, set by NumberFiles) so a key is one
// integer: file number above, offset below.
func SortKey(u *ovid/parse.Use) i64 {
  var f *ovid/parse.File = UseFile(u)
  return (f.ord << 32) | (ptr(u.tok) - ptr(f.src))
}

// NumberFiles gives each module file its place in the list.
func NumberFiles(m *ovid/parse.Mod) i64 {
  var i i64 = 0
  var f *ovid/parse.File = m.files
  while f != 0 as *ovid/parse.File {
    f.ord = i
    i = i + 1
    f = f.mnext
  }
  return 0
}

// MergeSort sorts the n (key, use) pairs at a (16 bytes each) by key,
// bottom-up, with tmp as scratch of the same size. Stable.
func MergeSort(a i64, tmp i64, n i64) i64 {
  var w i64 = 1
  while w < n {
    var lo i64 = 0
    while lo < n {
      var mid i64 = lo + w
      var hi i64 = lo + (2 * w)
      if mid > n {
        mid = n
      }
      if hi > n {
        hi = n
      }
      var i i64 = lo
      var j i64 = mid
      var k i64 = lo
      while k < hi {
        var takeLeft bool = j >= hi
        if !takeLeft && i < mid {
          takeLeft = load64(a + (i * 16)) <= load64(a + (j * 16))
        }
        var src i64 = j
        if takeLeft {
          src = i
          i = i + 1
        } else {
          j = j + 1
        }
        store64(tmp + (k * 16), load64(a + (src * 16)))
        store64(tmp + (k * 16) + 8, load64(a + (src * 16) + 8))
        k = k + 1
      }
      lo = hi
    }
    ovid/mem.CopyN(a, tmp, n * 16)
    w = w * 2
  }
  return 0
}

// CmdRefs prints every use of the named decl, grouped under the file and
// decl each use is in, then the JSON last line the Go toolchain's refs
// prints.
func CmdRefs(io *ovid/io.Cap) i64 {
  var a *Args = ParseArgs(io, false, true)
  if a.bad != 0 {
    return a.bad
  }
  if a.q == 0 {
    return Usage(io, "refs needs an id or name")
  }
  var m *ovid/parse.Mod = LoadArgs(io, a, false)
  if m == 0 as *ovid/parse.Mod {
    return 1
  }
  ovid/check.RunMode(io, m, false, true)
  var t *Target = ovid/io.Alloc(io, sizeof(Target)) as *Target
  var qn i64 = ovid/io.CLen(a.q)
  ByID(m, t, bytes(a.q, qn))
  if t.nmatch == 0 {
    ByName(m, t, bytes(a.q, qn))
  }
  if t.nmatch == 0 {
    return Fail(io, "not_found", "no declaration named that")
  }
  if t.nmatch > 1 {
    return Fail(io, "ambiguous", "several declarations have that name; use a full id")
  }
  // A duplicated id is refused before a kind refs cannot follow, as the
  // Go refs resolves the id before it looks at the kind.
  var copies i64 = t.copies
  if t.d != 0 as *ovid/parse.Decl || t.vn != 0 as *ovid/parse.Node {
    copies = Copies(t)
  }
  if copies > 1 {
    var ab *ovid/mem.Buf = ovid/mem.New(io, 256)
    if t.bad != 0 as *ovid/mem.Buf && t.d == 0 as *ovid/parse.Decl && t.vn == 0 as *ovid/parse.Node {
      ovid/mem.WBytes(io, ab, bytes(a.q, qn))
    } else {
      WTarget(io, ab, t)
    }
    ovid/mem.WBytes(io, ab, " names ")
    ovid/parse.WInt(io, ab, copies)
    ovid/mem.WBytes(io, ab, " nodes (check reports the duplicate)")
    return Fail(io, "ambiguous_id", bytes(ab.data, ab.len))
  }
  if t.bad != 0 as *ovid/mem.Buf {
    return Fail(io, "unsupported", bytes(t.bad.data, t.bad.len))
  }
  // The uses of t as (key, use) pairs, sorted by file and position.
  NumberFiles(m)
  var pairs i64 = ovid/io.Alloc(io, (m.nuses + 1) * 16)
  var n i64 = 0
  var u *ovid/parse.Use = m.uses
  while u != 0 as *ovid/parse.Use {
    if Hits(t, u) {
      store64(pairs + (n * 16), SortKey(u))
      store64(pairs + (n * 16) + 8, u as i64)
      n = n + 1
    }
    u = u.next
  }
  MergeSort(pairs, ovid/io.Alloc(io, (n + 1) * 16), n)
  var hits i64 = ovid/io.Alloc(io, (n + 1) * 8)
  var i i64 = 0
  while i < n {
    store64(hits + (i * 8), load64(pairs + (i * 16) + 8))
    i = i + 1
  }
  var b *ovid/mem.Buf = ovid/mem.New(io, 4096)
  var out i64 = ovid/io.Alloc(io, 16)
  var cur *Cursor = ovid/io.Alloc(io, sizeof(Cursor)) as *Cursor
  var last *ovid/parse.Decl = 0 as *ovid/parse.Decl
  var files i64 = 0
  var external i64 = 0
  i = 0
  while i < n {
    u = load64(hits + (i * 8)) as *ovid/parse.Use
    var f *ovid/parse.File = UseFile(u)
    if u.in != last {
      if last == 0 as *ovid/parse.Decl || last.file != f {
        files = files + 1
      }
      ovid/mem.WBytes(io, b, f.disp)
      ovid/mem.WBytes(io, b, "  ")
      WDeclID(io, b, u.in)
      ovid/mem.WByte(io, b, 10)
      last = u.in
    }
    if u.in.pkg != t.pkg {
      external = external + 1
    }
    // The line is the one the node that spells the use starts on, as
    // the Go refs prints it: a func's own result use starts at the func.
    // A const named in a const's value has no node of its own, and a
    // table's elements may run over lines, so its line is the name's.
    var off i64 = ptr(u.tok) - ptr(f.src)
    if u.node != 0 as *ovid/parse.Node {
      off = u.node.off
    } else if u.kind == ovid/parse.USE_RESULT {
      off = u.in.off
    } else if u.udecl != 0 as *ovid/parse.Decl && !IsConst(u.udecl) {
      off = u.udecl.off
    }
    var line i64 = LineFrom(f, off, out, cur)
    var tmp i64 = ovid/io.Alloc(io, 32)
    var dn i64 = ovid/mem.FormatI64(tmp, line)
    var pad i64 = 4 - dn
    while pad > 0 {
      ovid/mem.WByte(io, b, 32)
      pad = pad - 1
    }
    ovid/mem.WBytes(io, b, bytes(tmp, dn))
    ovid/mem.WBytes(io, b, ": ")
    ovid/mem.WBytes(io, b, bytes(load64(out), load64(out + 8)))
    ovid/mem.WByte(io, b, 10)
    i = i + 1
  }
  // by_pkg: the uses by the package they sit in, in path order.
  ovid/mem.WBytes(io, b, bytes(strptr("{\"by_pkg\":{"), 11))
  var first bool = true
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var cnt i64 = 0
    i = 0
    while i < n {
      u = load64(hits + (i * 8)) as *ovid/parse.Use
      if u.in.pkg == k {
        cnt = cnt + 1
      }
      i = i + 1
    }
    if cnt > 0 {
      if !first {
        ovid/mem.WByte(io, b, 44)
      }
      first = false
      ovid/parse.WStr(io, b, k.path)
      ovid/mem.WByte(io, b, 58)
      ovid/parse.WInt(io, b, cnt)
    }
    k = k.next
  }
  ovid/mem.WBytes(io, b, bytes(strptr("},\"count\":"), 10))
  ovid/parse.WInt(io, b, n)
  ovid/mem.WBytes(io, b, bytes(strptr(",\"external\":"), 12))
  ovid/parse.WInt(io, b, external)
  ovid/mem.WBytes(io, b, bytes(strptr(",\"files\":"), 9))
  ovid/parse.WInt(io, b, files)
  ovid/mem.WBytes(io, b, ",\"has_more\":false,\"offset\":0,\"ok\":true,\"revision\":\"")
  ovid/mem.WBytes(io, b, bytes(ovid/parse.Revision(m), 16))
  ovid/mem.WBytes(io, b, bytes(strptr("\",\"target\":\""), 12))
  WTarget(io, b, t)
  ovid/mem.WBytes(io, b, bytes(strptr("\",\"total\":"), 10))
  ovid/parse.WInt(io, b, n)
  ovid/mem.WBytes(io, b, bytes(strptr("}\n"), 2))
  ovid/io.Stdout(bytes(b.data, b.len))
  return 0
}
