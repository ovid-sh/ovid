package ovid/cli

import ovid/io
import ovid/mem
import ovid/check
import ovid/parse

// A refs target: one of the decl kinds, or a var statement.
const T_FUNC i64 = 1
const T_TYPE i64 = 2
const T_CONST i64 = 3
const T_FIELD i64 = 4
const T_PARAM i64 = 5
const T_VAR i64 = 6

// Target is what refs was asked about: a decl (kind T_FUNC..T_PARAM) or
// the var statement vn (T_VAR); pkg is its package and own its enclosing
// type or func, for the id.
type Target struct {
  kind i64
  d *ovid/parse.Decl
  vn *ovid/parse.Node
  pkg *ovid/parse.Pkg
  own *ovid/parse.Decl
  nmatch i64
  bad *ovid/mem.Buf
}

// Eq2 reports whether the two strings are the same.
func Eq2(ap i64, an i64, bp i64, bn i64) bool {
  return ovid/mem.Eq(ap, an, bp, bn)
}

// Split finds the last byte c in p[0:n], or -1.
func Split(p i64, n i64, c i64) i64 {
  var i i64 = n - 1
  while i >= 0 {
    if load8(p + i) == c {
      return i
    }
    i = i - 1
  }
  return -1
}

// ParseInt reads the decimal in p[0:n] as an id spells it: digits only,
// no leading zero, at most 18 digits (so it cannot wrap); else -1.
func ParseInt(p i64, n i64) i64 {
  if n == 0 || n > 18 {
    return -1
  }
  if n > 1 && load8(p) == 48 {
    return -1
  }
  var v i64 = 0
  var i i64 = 0
  while i < n {
    var c i64 = load8(p + i)
    if c < 48 || c > 57 {
      return -1
    }
    v = (v * 10) + (c - 48)
    i = i + 1
  }
  return v
}

// FindVar finds statement number num in the statement list s.
func FindVar(s *ovid/parse.Node, num i64) *ovid/parse.Node {
  while s != 0 as *ovid/parse.Node {
    if s.num == num {
      return s
    }
    var r *ovid/parse.Node = FindVar(s.then, num)
    if r == 0 as *ovid/parse.Node {
      r = FindVar(s.els, num)
    }
    if r == 0 as *ovid/parse.Node {
      r = FindVar(s.body, num)
    }
    if r != 0 as *ovid/parse.Node {
      return r
    }
    s = s.next
  }
  return 0 as *ovid/parse.Node
}

// HasExpr reports whether an expression numbered num is in the statement
// list s.
func HasExpr(s *ovid/parse.Node, num i64) bool {
  while s != 0 as *ovid/parse.Node {
    if s.op > ovid/parse.OP_EXPR && s.num == num {
      return true
    }
    if HasExpr(s.left, num) || HasExpr(s.right, num) || HasExpr(s.arg, num) || HasExpr(s.base, num) {
      return true
    }
    if HasExpr(s.addr, num) || HasExpr(s.val, num) || HasExpr(s.val2, num) || HasExpr(s.cond, num) {
      return true
    }
    if HasExpr(s.args, num) || HasExpr(s.then, num) || HasExpr(s.els, num) || HasExpr(s.body, num) {
      return true
    }
    s = s.next
  }
  return false
}

// IdExists reports whether the pkg:, im:, or ex: id q[0:n] (colon at c)
// names something in the module.
func IdExists(m *ovid/parse.Mod, q i64, n i64, c i64) bool {
  var rp i64 = (q + c) + 1
  var rn i64 = (n - c) - 1
  if load8(q) == 112 {
    var k *ovid/parse.Pkg = m.pkgs
    while k != 0 as *ovid/parse.Pkg {
      if Eq2(k.pathp, k.pathn, rp, rn) {
        return true
      }
      k = k.next
    }
    return false
  }
  if load8(q) == 105 {
    // im:<pkg>:<import path>
    var c2 i64 = Split(rp, rn, 58)
    if c2 < 0 {
      return false
    }
    var k *ovid/parse.Pkg = m.pkgs
    while k != 0 as *ovid/parse.Pkg {
      if Eq2(k.pathp, k.pathn, rp, c2) {
        return ovid/parse.FindDecl(k.ims, (rp + c2) + 1, (rn - c2) - 1) != 0 as *ovid/parse.Decl
      }
      k = k.next
    }
    return false
  }
  // ex:<pkg>.<func>:<num>
  var c3 i64 = Split(rp, rn, 58)
  if c3 < 0 {
    return false
  }
  var num i64 = ParseInt((rp + c3) + 1, (rn - c3) - 1)
  var dot i64 = Split(rp, c3, 46)
  if dot < 1 || num < 0 {
    return false
  }
  var fn *ovid/parse.Decl = ovid/parse.FindFunc(m, rp, dot, (rp + dot) + 1, (c3 - dot) - 1)
  if fn == 0 as *ovid/parse.Decl {
    return false
  }
  return HasExpr(fn.body, num)
}

// ByID resolves a full id (fn:pkg.N, ty:pkg.N, cn:pkg.N, fld:pkg.T.f,
// pa:pkg.F.p, st:pkg.F:N) into t; nmatch is 1 when found.
func ByID(m *ovid/parse.Mod, t *Target, qp i64, qn i64) i64 {
  var colon i64 = 0
  while colon < qn && load8(qp + colon) != 58 {
    colon = colon + 1
  }
  if colon >= qn {
    return 0
  }
  var kind i64 = 0
  if Eq2(qp, colon, strptr("fn"), 2) {
    kind = T_FUNC
  } else if Eq2(qp, colon, strptr("ty"), 2) {
    kind = T_TYPE
  } else if Eq2(qp, colon, strptr("cn"), 2) {
    kind = T_CONST
  } else if Eq2(qp, colon, strptr("fld"), 3) {
    kind = T_FIELD
  } else if Eq2(qp, colon, strptr("pa"), 2) {
    kind = T_PARAM
  } else if Eq2(qp, colon, strptr("st"), 2) {
    kind = T_VAR
  } else if Eq2(qp, colon, strptr("ex"), 2) || Eq2(qp, colon, strptr("pkg"), 3) || Eq2(qp, colon, strptr("im"), 2) {
    // An id refs cannot follow, as the Go refs says; one that names
    // nothing is not found, as there.
    if !IdExists(m, qp, qn, colon) {
      return 0
    }
    t.bad = ovid/mem.New(m.io, 256)
    ovid/mem.WBytes(m.io, t.bad, strptr("refs works on funcs, types, fields, consts, params, and var statements, not "), strlen("refs works on funcs, types, fields, consts, params, and var statements, not "))
    if load8(qp) == 101 {
      ovid/mem.WBytes(m.io, t.bad, strptr("expr"), 4)
    } else if load8(qp) == 112 {
      ovid/mem.WBytes(m.io, t.bad, strptr("package"), 7)
    } else {
      ovid/mem.WBytes(m.io, t.bad, strptr("import"), 6)
    }
    t.nmatch = 1
    return 0
  } else {
    return 0
  }
  var rp i64 = (qp + colon) + 1
  var rn i64 = (qn - colon) - 1
  var num i64 = -1
  if kind == T_VAR {
    var c2 i64 = Split(rp, rn, 58)
    if c2 < 0 {
      return 0
    }
    num = ParseInt((rp + c2) + 1, (rn - c2) - 1)
    rn = c2
  }
  // pkg.Name, or pkg.Owner.name for a field or param.
  var dot i64 = Split(rp, rn, 46)
  if dot < 1 {
    return 0
  }
  var np i64 = (rp + dot) + 1
  var nn i64 = (rn - dot) - 1
  var op i64 = 0
  var on i64 = 0
  var pn i64 = dot
  if kind == T_FIELD || kind == T_PARAM {
    var dot2 i64 = Split(rp, dot, 46)
    if dot2 < 1 {
      return 0
    }
    op = (rp + dot2) + 1
    on = (dot - dot2) - 1
    pn = dot2
  }
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg && !Eq2(k.pathp, k.pathn, rp, pn) {
    k = k.next
  }
  if k == 0 as *ovid/parse.Pkg {
    return 0
  }
  t.kind = kind
  t.pkg = k
  if kind == T_FUNC {
    t.d = ovid/parse.FindDecl(k.fs, np, nn)
  } else if kind == T_TYPE {
    t.d = ovid/parse.FindDecl(k.ts, np, nn)
  } else if kind == T_CONST {
    t.d = ovid/parse.FindDecl(k.cs, np, nn)
  } else if kind == T_FIELD {
    t.own = ovid/parse.FindDecl(k.ts, op, on)
    if t.own != 0 as *ovid/parse.Decl {
      t.d = ovid/parse.FindDecl(t.own.sub, np, nn)
    }
  } else if kind == T_PARAM {
    t.own = ovid/parse.FindDecl(k.fs, op, on)
    if t.own != 0 as *ovid/parse.Decl {
      t.d = ovid/parse.FindDecl(t.own.sub, np, nn)
    }
  } else {
    t.own = ovid/parse.FindDecl(k.fs, np, nn)
    if t.own != 0 as *ovid/parse.Decl && num >= 0 {
      t.vn = FindVar(t.own.body, num)
    }
    if t.vn == 0 as *ovid/parse.Node {
      return 0
    }
    t.nmatch = 1
    if t.vn.op == ovid/parse.OP_VAR2 {
      t.bad = ovid/mem.New(m.io, 256)
      ovid/mem.WBytes(m.io, t.bad, qp, qn)
      ovid/mem.WBytes(m.io, t.bad, strptr(" declares two locals, "), strlen(" declares two locals, "))
      ovid/mem.WBytes(m.io, t.bad, t.vn.namep, t.vn.namen)
      ovid/mem.WBytes(m.io, t.bad, strptr(" and "), 5)
      ovid/mem.WBytes(m.io, t.bad, t.vn.name2p, t.vn.name2n)
      ovid/mem.WBytes(m.io, t.bad, strptr(", and an id names only one; refs cannot reach either yet (ovid grep finds their uses)"), strlen(", and an id names only one; refs cannot reach either yet (ovid grep finds their uses)"))
    } else if t.vn.op != ovid/parse.OP_VAR {
      t.bad = ovid/mem.New(m.io, 256)
      ovid/mem.WBytes(m.io, t.bad, strptr("refs works on funcs, types, fields, consts, params, and var statements; "), strlen("refs works on funcs, types, fields, consts, params, and var statements; "))
      ovid/mem.WBytes(m.io, t.bad, qp, qn)
      ovid/mem.WBytes(m.io, t.bad, strptr(" is another kind of statement"), strlen(" is another kind of statement"))
    }
    return 0
  }
  if t.d != 0 as *ovid/parse.Decl {
    t.nmatch = 1
  }
  return 0
}

// PkgIs reports whether package k is named by q[0:n]: its whole path, or
// the tail of it after a "/" (mem for ovid/mem), as the Go toolchain's
// name lookup allows.
func PkgIs(k *ovid/parse.Pkg, q i64, n i64) bool {
  if Eq2(k.pathp, k.pathn, q, n) {
    return true
  }
  if k.pathn > n && load8((k.pathp + k.pathn) - (n + 1)) == 47 {
    return Eq2((k.pathp + k.pathn) - n, n, q, n)
  }
  return false
}

// Found counts one decl that answers to the name.
func Found(t *Target, kind i64, k *ovid/parse.Pkg, d *ovid/parse.Decl, own *ovid/parse.Decl) i64 {
  if d == 0 as *ovid/parse.Decl {
    return 0
  }
  t.nmatch = t.nmatch + 1
  t.kind = kind
  t.d = d
  t.pkg = k
  t.own = own
  return 0
}

// ByName resolves Name, pkg.Name, Owner.name, or pkg.Owner.name among
// funcs, types, consts, fields, and params (pkg being a package path or
// the tail of one); nmatch counts how many decls answer to it.
func ByName(m *ovid/parse.Mod, t *Target, qp i64, qn i64) i64 {
  var dot i64 = Split(qp, qn, 46)
  var np i64 = qp
  var nn i64 = qn
  if dot > 0 {
    np = (qp + dot) + 1
    nn = (qn - dot) - 1
  }
  // The qualifier as an owner (Type or Func), itself maybe qualified.
  var op i64 = 0
  var on i64 = 0
  var pp i64 = 0
  var pn i64 = -1
  if dot > 0 {
    var dot2 i64 = Split(qp, dot, 46)
    op = (qp + dot2) + 1
    on = (dot - dot2) - 1
    if dot2 > 0 {
      pp = qp
      pn = dot2
    }
  }
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if dot < 0 || PkgIs(k, qp, dot) {
      Found(t, T_FUNC, k, ovid/parse.FindDecl(k.fs, np, nn), 0 as *ovid/parse.Decl)
      Found(t, T_TYPE, k, ovid/parse.FindDecl(k.ts, np, nn), 0 as *ovid/parse.Decl)
      Found(t, T_CONST, k, ovid/parse.FindDecl(k.cs, np, nn), 0 as *ovid/parse.Decl)
    }
    k = k.next
  }
  // Fields and params only when no decl answers, as the Go lookup does.
  if t.nmatch != 0 || dot < 0 {
    return 0
  }
  k = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    if pn < 0 || PkgIs(k, pp, pn) {
      var ty *ovid/parse.Decl = ovid/parse.FindDecl(k.ts, op, on)
      if ty != 0 as *ovid/parse.Decl {
        Found(t, T_FIELD, k, ovid/parse.FindDecl(ty.sub, np, nn), ty)
      }
      var fn *ovid/parse.Decl = ovid/parse.FindDecl(k.fs, op, on)
      if fn != 0 as *ovid/parse.Decl {
        Found(t, T_PARAM, k, ovid/parse.FindDecl(fn.sub, np, nn), fn)
      }
    }
    k = k.next
  }
  return 0
}

// Hits reports whether use u is of target t.
func Hits(t *Target, u *ovid/parse.Use) bool {
  if t.kind == T_VAR {
    return u.vnode == t.vn
  }
  return u.decl == t.d && u.decl != 0 as *ovid/parse.Decl
}

// WTarget writes t's id.
func WTarget(io *ovid/io.Cap, b *ovid/mem.Buf, t *Target) i64 {
  if t.kind == T_FUNC {
    ovid/mem.WBytes(io, b, strptr("fn:"), 3)
  } else if t.kind == T_TYPE {
    ovid/mem.WBytes(io, b, strptr("ty:"), 3)
  } else if t.kind == T_CONST {
    ovid/mem.WBytes(io, b, strptr("cn:"), 3)
  } else if t.kind == T_FIELD {
    ovid/mem.WBytes(io, b, strptr("fld:"), 4)
  } else if t.kind == T_PARAM {
    ovid/mem.WBytes(io, b, strptr("pa:"), 3)
  } else {
    ovid/mem.WBytes(io, b, strptr("st:"), 3)
  }
  ovid/mem.WBytes(io, b, t.pkg.pathp, t.pkg.pathn)
  ovid/mem.WByte(io, b, 46)
  if t.own != 0 as *ovid/parse.Decl {
    ovid/mem.WBytes(io, b, t.own.namep, t.own.namen)
    if t.kind == T_VAR {
      ovid/mem.WByte(io, b, 58)
      ovid/parse.WInt(io, b, t.vn.num)
      return 0
    }
    ovid/mem.WByte(io, b, 46)
  }
  ovid/mem.WBytes(io, b, t.d.namep, t.d.namen)
  return 0
}

// WDeclID writes the id of the func or type d (the "in" of a use). Every
// func has a result type and no type decl does; a func's body may be empty.
func WDeclID(io *ovid/io.Cap, b *ovid/mem.Buf, d *ovid/parse.Decl) i64 {
  if d.typn != 0 {
    ovid/mem.WBytes(io, b, strptr("fn:"), 3)
  } else {
    ovid/mem.WBytes(io, b, strptr("ty:"), 3)
  }
  ovid/mem.WBytes(io, b, d.pkg.pathp, d.pkg.pathn)
  ovid/mem.WByte(io, b, 46)
  ovid/mem.WBytes(io, b, d.namep, d.namen)
  return 0
}

// LineOf is the 1-based line of offset off in f, and the trimmed text of
// that line: its start and length go to lp/ln.
func LineOf(f *ovid/parse.File, off i64, lp i64, ln i64) i64 {
  var line i64 = 1
  var ls i64 = 0
  var i i64 = 0
  while i < off && i < f.n {
    if load8(f.src + i) == 10 {
      line = line + 1
      ls = i + 1
    }
    i = i + 1
  }
  var le i64 = ls
  while le < f.n && load8(f.src + le) != 10 {
    le = le + 1
  }
  while ls < le && (load8(f.src + ls) == 32 || load8(f.src + ls) == 9) {
    ls = ls + 1
  }
  while le > ls && (load8(f.src + (le - 1)) == 32 || load8(f.src + (le - 1)) == 9 || load8(f.src + (le - 1)) == 13) {
    le = le - 1
  }
  store64(lp, f.src + ls)
  store64(ln, le - ls)
  return line
}

// FileIndex is where f stands in the module's file list.
func FileIndex(m *ovid/parse.Mod, f *ovid/parse.File) i64 {
  var i i64 = 0
  var g *ovid/parse.File = m.files
  while g != 0 as *ovid/parse.File {
    if g == f {
      return i
    }
    i = i + 1
    g = g.mnext
  }
  return i
}

// UseFile is the file a use sits in: that of the func or type it is in.
func UseFile(u *ovid/parse.Use) *ovid/parse.File {
  return u.in.file
}

// Before orders uses as refs prints them: by file, then by position.
func Before(m *ovid/parse.Mod, a *ovid/parse.Use, b *ovid/parse.Use) bool {
  var fa i64 = FileIndex(m, UseFile(a))
  var fb i64 = FileIndex(m, UseFile(b))
  if fa != fb {
    return fa < fb
  }
  return a.tokp < b.tokp
}

// CmdRefs prints every use of the named decl, grouped under the file and
// decl each use is in, then the JSON last line the Go toolchain's refs
// prints.
func CmdRefs(io *ovid/io.Cap) i64 {
  var a *Args = ParseArgs(io, false, true)
  if a.bad != 0 {
    return a.bad
  }
  if a.q == 0 {
    return Usage(io, strptr("refs needs an id or name"), strlen("refs needs an id or name"))
  }
  var m *ovid/parse.Mod = LoadArgs(io, a, false)
  if m == 0 as *ovid/parse.Mod {
    return 1
  }
  ovid/check.RunMode(io, m, false, true)
  var t *Target = ovid/io.Alloc(io, sizeof(Target)) as *Target
  var qn i64 = ovid/io.CLen(a.q)
  ByID(m, t, a.q, qn)
  if t.nmatch == 0 {
    ByName(m, t, a.q, qn)
  }
  if t.nmatch == 0 {
    return Fail(io, strptr("not_found"), 9, strptr("no declaration named that"), strlen("no declaration named that"))
  }
  if t.nmatch > 1 {
    return Fail(io, strptr("ambiguous"), 9, strptr("several declarations have that name; use a full id"), strlen("several declarations have that name; use a full id"))
  }
  if t.bad != 0 as *ovid/mem.Buf {
    return Fail(io, strptr("unsupported"), 11, t.bad.data, t.bad.len)
  }
  // The uses of t, sorted by file and position (insertion sort; a decl
  // has tens of uses, a few hundred at most).
  var hits i64 = ovid/io.Alloc(io, (m.nuses + 1) * 8)
  var n i64 = 0
  var u *ovid/parse.Use = m.uses
  while u != 0 as *ovid/parse.Use {
    if Hits(t, u) {
      var j i64 = n
      while j > 0 && Before(m, u, load64(hits + ((j - 1) * 8)) as *ovid/parse.Use) {
        store64(hits + (j * 8), load64(hits + ((j - 1) * 8)))
        j = j - 1
      }
      store64(hits + (j * 8), u as i64)
      n = n + 1
    }
    u = u.next
  }
  var b *ovid/mem.Buf = ovid/mem.New(io, 4096)
  var lp i64 = ovid/io.Alloc(io, 8)
  var ln i64 = ovid/io.Alloc(io, 8)
  var last *ovid/parse.Decl = 0 as *ovid/parse.Decl
  var files i64 = 0
  var external i64 = 0
  var i i64 = 0
  while i < n {
    u = load64(hits + (i * 8)) as *ovid/parse.Use
    var f *ovid/parse.File = UseFile(u)
    if u.in != last {
      if last == 0 as *ovid/parse.Decl || last.file != f {
        files = files + 1
      }
      ovid/mem.WBytes(io, b, f.dispp, f.dispn)
      ovid/mem.WBytes(io, b, strptr("  "), 2)
      WDeclID(io, b, u.in)
      ovid/mem.WByte(io, b, 10)
      last = u.in
    }
    if u.in.pkg != t.pkg {
      external = external + 1
    }
    // The line is the one the node that spells the use starts on, as
    // the Go refs prints it: a func's own result use starts at the func.
    var off i64 = u.tokp - f.src
    if u.node != 0 as *ovid/parse.Node {
      off = u.node.off
    } else if u.kind == ovid/parse.USE_RESULT {
      off = u.in.off
    } else if u.udecl != 0 as *ovid/parse.Decl {
      off = u.udecl.off
    }
    var line i64 = LineOf(f, off, lp, ln)
    var tmp i64 = ovid/io.Alloc(io, 32)
    var dn i64 = ovid/mem.FormatI64(tmp, line)
    var pad i64 = 4 - dn
    while pad > 0 {
      ovid/mem.WByte(io, b, 32)
      pad = pad - 1
    }
    ovid/mem.WBytes(io, b, tmp, dn)
    ovid/mem.WBytes(io, b, strptr(": "), 2)
    ovid/mem.WBytes(io, b, load64(lp), load64(ln))
    ovid/mem.WByte(io, b, 10)
    i = i + 1
  }
  // by_pkg: the uses by the package they sit in, in path order.
  ovid/mem.WBytes(io, b, strptr("{\"by_pkg\":{"), 11)
  var first bool = true
  var k *ovid/parse.Pkg = m.pkgs
  while k != 0 as *ovid/parse.Pkg {
    var cnt i64 = 0
    i = 0
    while i < n {
      u = load64(hits + (i * 8)) as *ovid/parse.Use
      if u.in.pkg == k {
        cnt = cnt + 1
      }
      i = i + 1
    }
    if cnt > 0 {
      if !first {
        ovid/mem.WByte(io, b, 44)
      }
      first = false
      ovid/parse.WStr(io, b, k.pathp, k.pathn)
      ovid/mem.WByte(io, b, 58)
      ovid/parse.WInt(io, b, cnt)
    }
    k = k.next
  }
  ovid/mem.WBytes(io, b, strptr("},\"count\":"), 10)
  ovid/parse.WInt(io, b, n)
  ovid/mem.WBytes(io, b, strptr(",\"external\":"), 12)
  ovid/parse.WInt(io, b, external)
  ovid/mem.WBytes(io, b, strptr(",\"files\":"), 9)
  ovid/parse.WInt(io, b, files)
  ovid/mem.WBytes(io, b, strptr(",\"has_more\":false,\"offset\":0,\"ok\":true,\"revision\":\""), strlen(",\"has_more\":false,\"offset\":0,\"ok\":true,\"revision\":\""))
  ovid/mem.WBytes(io, b, ovid/parse.Revision(m), 16)
  ovid/mem.WBytes(io, b, strptr("\",\"target\":\""), 12)
  WTarget(io, b, t)
  ovid/mem.WBytes(io, b, strptr("\",\"total\":"), 10)
  ovid/parse.WInt(io, b, n)
  ovid/mem.WBytes(io, b, strptr("}\n"), 2)
  ovid/io.Stdout(b.data, b.len)
  return 0
}
