package server

import ovid/io
import ovid/http
import ovid/task
import ovid/mem

// POC C, native: stackful tasks. The code reads like baseline/'s blocking
// server; each connection is a task, and /w2's ten upstream calls are ten
// tasks in a group. ovid/task's Accept, Read, Write, and Connect suspend
// only the task that calls them.
//
//   server <port> <upstream port>

const UPSTREAM_MS i64 = 10
const FANOUT i64 = 10

func atoi(p i64) i64 {
  var v i64 = 0
  var i i64 = 0
  while load8(p + i) >= 48 && load8(p + i) <= 57 {
    v = (v * 10) + (load8(p + i) - 48)
    i = i + 1
  }
  return v
}

// upstream makes one upstream call, suspending this task while it waits.
// It returns 0, or an error code.
func upstream(io *ovid/io.Cap, port i64) i64 {
  var fd i64, e i64 = ovid/task.Connect(io, port)
  if e != 0 {
    return e
  }
  e = ovid/task.Write(io, fd, strptr("10\n"), 3)
  if e != 0 {
    ovid/io.Close(fd)
    return e
  }
  var buf i64 = ovid/io.Alloc(io, 8)
  var got i64 = 0
  while got < 3 {
    var n i64, re i64 = ovid/task.Read(io, fd, buf + got, 8 - got)
    if re != 0 || n == 0 {
      ovid/io.Close(fd)
      return ovid/io.E_IO
    }
    got = got + n
  }
  ovid/io.Close(fd)
  return 0
}

// call is the task of one /w2 upstream call; arg is the upstream port.
func call(io *ovid/io.Cap, arg i64) i64 {
  return upstream(io, arg)
}

func handle(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response, up i64) i64 {
  if ovid/http.PathIs(req, strptr("/w1"), 3) {
    if upstream(io, up) != 0 {
      return 1
    }
    ovid/http.Write(io, res, strptr("ok"), 2)
    return 0
  }
  if ovid/http.PathIs(req, strptr("/w2"), 3) {
    var g *ovid/task.Group = ovid/task.NewGroup(io)
    var i i64 = 0
    while i < FANOUT {
      ovid/task.Go(io, g, taskfn(call), up)
      i = i + 1
    }
    if ovid/task.Wait(io, g) != 0 {
      return 1
    }
    ovid/http.Write(io, res, strptr("ok "), 3)
    ovid/http.WriteInt(io, res, FANOUT)
    return 0
  }
  ovid/http.SetStatus(res, 404)
  return 0
}

func headEnd(p i64, n i64) i64 {
  var i i64 = 3
  while i < n {
    if load8(p + (i - 3)) == 13 && load8(p + (i - 2)) == 10 && load8(p + (i - 1)) == 13 && load8(p + i) == 10 {
      return i + 1
    }
    i = i + 1
  }
  return -1
}

// conn is the task of one connection: arg is the fd, and the upstream
// port above bit 32. What it allocates goes when it ends.
func conn(io *ovid/io.Cap, arg i64) i64 {
  var fd i64 = arg & 0xffffffff
  var up i64 = arg >> 32
  var cap i64 = 8192
  var buf i64 = ovid/io.Alloc(io, cap)
  var n i64 = 0
  var h i64 = -1
  while h < 0 && n < cap {
    var k i64, e i64 = ovid/task.Read(io, fd, buf + n, cap - n)
    if e != 0 || k == 0 {
      ovid/io.Close(fd)
      return 1
    }
    n = n + k
    h = headEnd(buf, n)
  }
  var req *ovid/http.Request = ovid/http.NewRequest(io, 0, 0, 0, 0)
  var res *ovid/http.Response = ovid/http.NewResponse(io)
  var result i64 = 0
  if ovid/http.Parse(req, buf, h) == 0 {
    result = handle(io, req, res, up)
  }
  var out *ovid/mem.Buf = ovid/http.Format(io, req, res, result)
  ovid/task.Write(io, fd, out.data, out.len)
  ovid/io.Close(fd)
  return 0
}

// accept is the root task: arg is the port, and the upstream port above
// bit 32. Each connection becomes a task of its own, released to be freed
// when it ends.
func accept(io *ovid/io.Cap, arg i64) i64 {
  var ln i64, e i64 = ovid/io.Listen(io, arg & 0xffffffff, ovid/io.SOCK_NONBLOCK, false)
  if e != 0 {
    ovid/io.Eprint(ovid/io.ErrText(e))
    return 1
  }
  while true {
    var fd i64, ae i64 = ovid/task.Accept(io, ln)
    if ae == 0 {
      ovid/task.Release(io, ovid/task.Spawn(io, taskfn(conn), fd | ((arg >> 32) << 32)))
    }
  }
  return 0
}

func main(io *ovid/io.Cap) i64 {
  if ovid/io.Argc(io) < 3 {
    ovid/io.Eprint(strptr("usage: server <port> <upstream port>\n"))
    return 64
  }
  var port i64 = atoi(ovid/io.Arg(io, 1))
  var up i64 = atoi(ovid/io.Arg(io, 2))
  return ovid/task.Run(io, taskfn(accept), port | (up << 32))
}
