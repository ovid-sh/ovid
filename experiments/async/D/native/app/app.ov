package app

import ovid/io
import ovid/http
import ovid/mem

// The program under D: baseline/server's blocking handler, unchanged but
// for exporting Serve and Atoi. It knows nothing of concurrency; the host
// package runs many copies of it in forked processes.
//
//   GET /w1  one upstream call of 10 ms, then "ok"
//   GET /w2  ten upstream calls of 10 ms each, one after another, then "ok 10"

// UPSTREAM_MS is how long each upstream call waits.
const UPSTREAM_MS i64 = 10

// FANOUT is how many upstream calls /w2 makes.
const FANOUT i64 = 10

// Atoi reads the decimal number in the NUL-terminated string at p.
func Atoi(p i64) i64 {
  var v i64 = 0
  var i i64 = 0
  while load8(p + i) >= 48 && load8(p + i) <= 57 {
    v = (v * 10) + (load8(p + i) - 48)
    i = i + 1
  }
  return v
}

// upstream makes one blocking upstream call. It returns 0, or an error code.
func upstream(io *ovid/io.Cap, port i64) i64 {
  var fd i64, e i64 = ovid/io.Connect(io, port, 0)
  if e != 0 {
    return e
  }
  e = ovid/io.Write(fd, strptr("10\n"), 3)
  if e != 0 {
    ovid/io.Close(fd)
    return e
  }
  var buf i64 = ovid/io.Alloc(io, 8)
  var got i64 = 0
  while got < 3 {
    var n i64, re i64 = ovid/io.Read(fd, buf + got, 8 - got)
    if re != 0 || n == 0 {
      ovid/io.Close(fd)
      return ovid/io.E_IO
    }
    got = got + n
  }
  ovid/io.Close(fd)
  return 0
}

func handle(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response, up i64) i64 {
  if ovid/http.PathIs(req, strptr("/w1"), 3) {
    if upstream(io, up) != 0 {
      return 1
    }
    ovid/http.Write(io, res, strptr("ok"), 2)
    return 0
  }
  if ovid/http.PathIs(req, strptr("/w2"), 3) {
    var i i64 = 0
    while i < FANOUT {
      if upstream(io, up) != 0 {
        return 1
      }
      i = i + 1
    }
    ovid/http.Write(io, res, strptr("ok "), 3)
    ovid/http.WriteInt(io, res, FANOUT)
    return 0
  }
  ovid/http.SetStatus(res, 404)
  return 0
}

// headEnd is the length of the request head in the n bytes at p, up to
// and including the blank line, or -1 when it has not all arrived.
func headEnd(p i64, n i64) i64 {
  var i i64 = 3
  while i < n {
    if load8(p + (i - 3)) == 13 && load8(p + (i - 2)) == 10 && load8(p + (i - 1)) == 13 && load8(p + i) == 10 {
      return i + 1
    }
    i = i + 1
  }
  return -1
}

// Serve reads one request from fd, answers it, and closes fd.
func Serve(io *ovid/io.Cap, fd i64, up i64) i64 {
  var cap i64 = 8192
  var buf i64 = ovid/io.Alloc(io, cap)
  var n i64 = 0
  var h i64 = -1
  while h < 0 && n < cap {
    var k i64, e i64 = ovid/io.Read(fd, buf + n, cap - n)
    if e != 0 || k == 0 {
      ovid/io.Close(fd)
      return 1
    }
    n = n + k
    h = headEnd(buf, n)
  }
  var req *ovid/http.Request = ovid/http.NewRequest(io, 0, 0, 0, 0)
  var res *ovid/http.Response = ovid/http.NewResponse(io)
  var result i64 = 0
  if ovid/http.Parse(req, buf, h) == 0 {
    result = handle(io, req, res, up)
  }
  var out *ovid/mem.Buf = ovid/http.Format(io, req, res, result)
  ovid/io.Write(fd, out.data, out.len)
  ovid/io.Close(fd)
  return 0
}

// Loop is the blocking server: accept a connection on ln, serve it, give
// back the heap it used, forever. It is baseline/server's main.
func Loop(io *ovid/io.Cap, ln i64, up i64) i64 {
  var m *ovid/io.HeapMark = ovid/io.MarkHeap(io)
  while true {
    var fd i64, ae i64 = ovid/io.Accept(ln, 0)
    if ae == 0 {
      Serve(io, fd, up)
    }
    ovid/io.ResetHeap(io, m)
  }
  return 0
}
