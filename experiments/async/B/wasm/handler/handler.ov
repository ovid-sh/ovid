package handler

import ovid/io
import ovid/http

// POC B under wasm. The host gives each request its own instance, so the
// loop here is only for the calls within one request: submit every
// upstream call (a host timer) at once, then poll for completions, keeping
// a state per call, until none is pending.

const UPSTREAM_MS i64 = 10
const FANOUT i64 = 10

// Call states, one byte each in the table.
const PENDING i64 = 1
const DONE i64 = 2

// fanout makes n upstream calls concurrently. It returns 0, or an error code.
func fanout(io *ovid/io.Cap, n i64) i64 {
  var state i64 = ovid/io.Alloc(io, n)
  var i i64 = 0
  while i < n {
    var e i64 = ovid/io.HostSubmit(UPSTREAM_MS, i)
    if e != 0 {
      return e
    }
    store8(state + i, PENDING)
    i = i + 1
  }
  var pending i64 = n
  var tags i64 = ovid/io.Alloc(io, 8 * n)
  while pending > 0 {
    var got i64, pe i64 = ovid/io.HostPoll(tags, n)
    if pe != 0 {
      return pe
    }
    var j i64 = 0
    while j < got {
      var tag i64 = load64(tags + (8 * j))
      if tag < 0 || tag >= n || load8(state + tag) != PENDING {
        return ovid/io.E_IO
      }
      store8(state + tag, DONE)
      pending = pending - 1
      j = j + 1
    }
  }
  return 0
}

func handle(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64 {
  if ovid/http.PathIs(req, strptr("/w1"), 3) {
    if fanout(io, 1) != 0 {
      return 1
    }
    ovid/http.Write(io, res, strptr("ok"), 2)
    return 0
  }
  if ovid/http.PathIs(req, strptr("/w2"), 3) {
    if fanout(io, FANOUT) != 0 {
      return 1
    }
    ovid/http.Write(io, res, strptr("ok "), 3)
    ovid/http.WriteInt(io, res, FANOUT)
    return 0
  }
  ovid/http.SetStatus(res, 404)
  return 0
}
