// stdout: "leaf 0\nsaved 0\nfield 0\nstore 0\n"
package demo
import ovid/io

// An address that adds a local in a register to another, times 2, 4, or
// 8 or shifted left by 1 to 3, is a scaled index. Each func here reads or
// writes memory through such addresses and through the same address
// computed into a local first, and counts the differences.

type Arr struct {
  data i64
  n i64
}

// Leaf calls nothing: a, i, j, and k live in rdi, rsi, r8, and r9.
func Leaf(a i64, i i64, j i64, k i64) i64 {
  var bad i64 = 0
  var p i64 = a + (i * 8)
  var v i64 = load64(p)
  if load64(a + (i * 8)) != v {
    bad = bad + 1
  }
  if load64((i * 8) + a) != v {
    bad = bad + 1
  }
  if load64(a + (8 * i)) != v {
    bad = bad + 1
  }
  if load64(a + (i << 3)) != v {
    bad = bad + 1
  }
  p = (a + (i * 8)) + 16
  if load64((a + (i * 8)) + 16) != load64(p) {
    bad = bad + 1
  }
  p = (a + 16) + (i * 8)
  if load64((a + 16) + (i * 8)) != load64(p) {
    bad = bad + 1
  }
  p = (a + (i * 8)) - 8
  if load64((a + (i * 8)) - 8) != load64(p) {
    bad = bad + 1
  }
  p = a + (j * 4)
  if load32(a + (j * 4)) != load32(p) {
    bad = bad + 1
  }
  p = a + (k << 1)
  if load8(a + (k << 1)) != load8(p) {
    bad = bad + 1
  }
  p = a + (k * 2)
  if load8((k * 2) + a) != load8(p) {
    bad = bad + 1
  }
  p = a + k
  if load8(a + k) != load8(p) {
    bad = bad + 1
  }
  // Not scaled indexes: times 1 and 3, and a shift by 4.
  p = a + (k * 1)
  if load8(a + (k * 1)) != load8(p) {
    bad = bad + 1
  }
  p = a + (k * 3)
  if load8(a + (k * 3)) != load8(p) {
    bad = bad + 1
  }
  p = a + (k << 4)
  if load8(a + (k << 4)) != load8(p) {
    bad = bad + 1
  }
  return bad
}

func Id(x i64) i64 {
  return x
}

// Saved calls Id, so its locals live in rbx and r12 to r15, each used
// both as a base and as an index; r12 and r13 encode differently as a
// base.
func Saved(a i64, n i64) i64 {
  var bad i64 = 0
  var b i64 = a + 8
  var i i64 = 0
  while i < n {
    var j i64 = (n - 2) - i
    var p i64 = a + (i * 8)
    var q i64 = b + (j * 8)
    if load64(a + (i * 8)) != load64(p) {
      bad = bad + 1
    }
    if load64(b + (j * 8)) != load64(q) {
      bad = bad + 1
    }
    if load64((j << 3) + b) != load64(q) {
      bad = bad + 1
    }
    q = b + (i * 8)
    if load64(b + (i * 8)) != load64(q) {
      bad = bad + 1
    }
    p = a + (j * 8)
    if load64((j * 8) + a) != load64(p) {
      bad = bad + 1
    }
    p = a + (Id(i) * 8)
    if load64(a + (Id(i) * 8)) != load64(p) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

// Field reads and writes through a base that is not a local in a
// register, which goes to rax.
func Field(r *Arr) i64 {
  var bad i64 = 0
  var i i64 = 0
  while i < r.n {
    var p i64 = r.data + (i * 8)
    if load64(r.data + (i * 8)) != load64(p) {
      bad = bad + 1
    }
    if load8(r.data + i) != load8(p - (i * 7)) {
      bad = bad + 1
    }
    var v i64 = load64(p) + 1
    store64(r.data + (i * 8), v)
    if load64(p) != v {
      bad = bad + 1
    }
    store64(r.data + (i * 8), (v * 3) - 1)
    if load64(p) != ((v * 3) - 1) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

// Store writes immediates, registers, and computed values through scaled
// addresses, and reads them back through computed ones.
func Store(a i64, n i64) i64 {
  var bad i64 = 0
  var i i64 = 0
  while i < n {
    store64(a + (i * 8), 0 - 7)
    if load64(a + (i * 8)) != (0 - 7) {
      bad = bad + 1
    }
    var p i64 = a + (i * 8)
    store64(a + (i << 3), i)
    if load64(p) != i {
      bad = bad + 1
    }
    store64((a + (i * 8)) + 8, (i * 5) + 2)
    if load64(p + 8) != ((i * 5) + 2) {
      bad = bad + 1
    }
    store8(a + (i * 2), 200)
    p = a + (i * 2)
    if load8(p) != 200 {
      bad = bad + 1
    }
    store8(a + (i * 4), i + 1)
    p = a + (i * 4)
    if load8(p) != ((i + 1) & 255) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

func Put(io *ovid/io.Cap, name i64, v i64) i64 {
  ovid/io.Print(name)
  ovid/io.PrintInt(io, v)
  ovid/io.Print(strptr("\n"))
  return 0
}

func main(io *ovid/io.Cap) i64 {
  var n i64 = 64
  var a i64 = ovid/io.Alloc(io, (n * 16) + 64)
  var i i64 = 0
  while i < ((n * 2) + 8) {
    store64(a + (i * 8), (i * 0x0101010101) + 3)
    i = i + 1
  }
  var leaf i64 = 0
  i = 1
  while i < n {
    leaf = leaf + Leaf(a + 8, i, i + 3, i ^ 5)
    i = i + 1
  }
  Put(io, strptr("leaf "), leaf)
  // Saved reads from 8 bytes below its a.
  Put(io, strptr("saved "), Saved(a + 16, n))
  var r *Arr = ovid/io.Alloc(io, sizeof(Arr)) as *Arr
  r.data = a
  r.n = n
  Put(io, strptr("field "), Field(r))
  Put(io, strptr("store "), Store(a, n))
  return 0
}
