// The heap grows past the first 128 MiB region: 200 one-MiB blocks, then
// one block bigger than a region. Every block starts zeroed and keeps what
// was stored in it.
// exit: 0
// stdout: "5"
package demo

import ovid/io

func main(io *ovid/io.Cap) i64 {
  var mib i64 = 1 << 20
  var first i64 = ovid/io.Alloc(io, mib)
  store64(first, 41)
  var prev i64 = first
  var i i64 = 1
  while i < 200 {
    var p i64 = ovid/io.Alloc(io, mib)
    if p == 0 || p == prev {
      return 1
    }
    if load64(p) != 0 || load64((p + mib) - 8) != 0 {
      return 2
    }
    store64(p, i)
    store64((p + mib) - 8, i)
    prev = p
    i = i + 1
  }
  var big i64 = ovid/io.Alloc(io, 300 * mib)
  if load64(big) != 0 || load64((big + (300 * mib)) - 8) != 0 {
    return 3
  }
  store64((big + (300 * mib)) - 8, 7)
  var after i64 = ovid/io.Alloc(io, 64)
  if load64(after) != 0 {
    return 4
  }
  ovid/io.PrintInt(io, 5)
  if load64(first) != 41 || load64(prev) != 199 {
    return 5
  }
  return 0
}
