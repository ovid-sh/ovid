// ovid/io reports failure as an error: ReadFile of a missing file
// is E_NOENT, reading a directory is E_ISDIR, and ErrText names them.
// stdout: "no such file or directory\nis a directory\n"
// exit: 2
package demo
import ovid/io
func main(io *ovid/io.Cap) i64 {
  var _, e error = ovid/io.ReadFile(io, "no-such-file")
  ovid/io.Print(io, ovid/io.ErrText(e))
  ovid/io.Print(io, "\n")
  var fd *ovid/io.File, oe error = ovid/io.Open(io, ".", ovid/io.O_RDONLY, 0)
  if oe != 0 {
    return 1
  }
  var buf bytes = ovid/io.AllocBytes(io, 8)
  var n i64, re error = ovid/io.Read(fd, buf)
  ovid/io.Print(io, ovid/io.ErrText(re))
  ovid/io.Print(io, "\n")
  if n != 0 || re != ovid/io.E_ISDIR || ovid/io.Close(fd) != 0 {
    return 3
  }
  return e as i64
}
