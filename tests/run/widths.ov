// The 16- and 32-bit memory builtins and bswap, at the edges: zero, the top
// bit set, all ones, and values wider than the access.
package demo
import ovid/io
func main(io *ovid/io.Cap) i64 {
  var p i64 = ovid/io.Alloc(io, 32)
  // A store keeps the low bits; a load zero-extends.
  store16(p, 0x12345)
  if load16(p) != 0x2345 {
    return 1
  }
  store16(p, -1)
  if load16(p) != 65535 {
    return 2
  }
  var v i64 = 0x8000
  store16(p + 2, v)
  if load16(p + 2) != 32768 {
    return 3
  }
  if load32(p) != 0x8000FFFF {
    return 4
  }
  store32(p + 8, -1)
  if load32(p + 8) != 4294967295 {
    return 5
  }
  var w i64 = 4294967297
  store32(p + 8, w)
  if load32(p + 8) != 1 {
    return 6
  }
  if load64(p + 8) != 1 {
    return 7
  }
  store32(p + 16, 0x7FFFFFFF)
  if load16(p + 16) != 0xFFFF || load8(p + 19) != 0x7F || load32(p + 16) != 0x7FFFFFFF {
    return 8
  }
  // bswap reverses the low width bits and zero-extends.
  if bswap16(0x1234) != 0x3412 || bswap16(0xFFFF1234) != 0x3412 {
    return 9
  }
  if bswap32(0x12345678) != 0x78563412 || bswap32(0x80000001) != 0x01000080 {
    return 10
  }
  if bswap64(0x0102030405060708) != 0x0807060504030201 {
    return 11
  }
  if bswap64(-1) != -1 || bswap32(-1) != 4294967295 || bswap16(0) != 0 {
    return 12
  }
  var x i64 = 0x12345678
  if bswap32(x) != 0x78563412 || bswap16(x) != 0x7856 || bswap64(x) != 0x7856341200000000 {
    return 13
  }
  // A big-endian field is a store of a swapped value.
  store32(p + 24, bswap32(0xCAFEBABE))
  if load8(p + 24) != 0xCA || load8(p + 27) != 0xBE || bswap32(load32(p + 24)) != 0xCAFEBABE {
    return 14
  }
  store16(p + 28, bswap16(0xBEEF))
  if load8(p + 28) != 0xBE || load8(p + 29) != 0xEF || bswap16(load16(p + 28)) != 0xBEEF {
    return 15
  }
  return 0
}
