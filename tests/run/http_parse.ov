// stdout: "ok 0\n"
// stdout: "http/1.0 0\n"
// stdout: "no version 1\n"
// stdout: "bad version 1\n"
// stdout: "empty method 1\n"
// stdout: "bare lf 1\n"
// stdout: "bare cr 1\n"
// stdout: "folded 1\n"
// stdout: "no colon 1\n"
// stdout: "space before colon 1\n"
// stdout: "no blank line 1\n"
// stdout: "two lengths 1\n"
// stdout: "length not digits 1\n"
// stdout: "body short 1\n"
// stdout: "chunked 3\n"
// stdout: "control in value 1\n"
// stdout: "del in value 1\n"
// stdout: "tab and high bytes in value 0\n"
// stdout: "status 0 -1 -1\n"
// stdout: "headers -1 -1 -1 -1 -1 0\n"
// stdout: "values -1 -1 0\n"
// stdout: "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 418 \r\nX-A: 1\r\nContent-Length: 2\r\n\r\nhi"
// stdout: "HTTP/1.1 204 No Content\r\nX-A: 1\r\n\r\n"
// stdout: "HTTP/1.1 205 Reset Content\r\nX-A: 1\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 200 OK\r\nX-A: 1\r\nContent-Length: 2\r\n\r\n"
// stdout: "test: 201 /x 3 b=2 7\n"
package demo

import ovid/io
import ovid/http
import ovid/mem

func try(io *ovid/io.Cap, label bytes, p i64, n i64) i64 {
  var r *ovid/http.Request = ovid/http.NewRequest(io, 0, 0, 0, 0)
  ovid/io.Print(label)
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.Parse(r, p, n))
  ovid/io.Print("\n")
  return 0
}

func show(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response, result i64) i64 {
  var b *ovid/mem.Buf = ovid/http.Format(io, req, res, result)
  return ovid/io.Stdout(bytes(b.data, b.len))
}

// handler is what a test calls with a request made by hand.
func handler(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64 {
  ovid/http.SetStatus(res, 201)
  ovid/http.Write(io, res, ovid/http.Path(req), ovid/http.PathLen(req))
  ovid/http.Write(io, res, strptr(" "), strlen(" "))
  ovid/http.WriteInt(io, res, ovid/http.BodyLen(req))
  ovid/http.Write(io, res, strptr(" "), strlen(" "))
  ovid/http.Write(io, res, ovid/http.Query(req), ovid/http.QueryLen(req))
  return 0
}

func main(io *ovid/io.Cap) i64 {
  try(io, "ok", strptr("GET / HTTP/1.1\r\nA: b\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\r\n\r\n"))
  try(io, "http/1.0", strptr("GET / HTTP/1.0\r\n\r\n"), strlen("GET / HTTP/1.0\r\n\r\n"))
  try(io, "no version", strptr("GET /\r\n\r\n"), strlen("GET /\r\n\r\n"))
  try(io, "bad version", strptr("GET / HTTP/2\r\n\r\n"), strlen("GET / HTTP/2\r\n\r\n"))
  try(io, "empty method", strptr(" / HTTP/1.1\r\n\r\n"), strlen(" / HTTP/1.1\r\n\r\n"))
  try(io, "bare lf", strptr("GET / HTTP/1.1\nA: b\n\n"), strlen("GET / HTTP/1.1\nA: b\n\n"))
  try(io, "bare cr", strptr("GET / HTTP/1.1\r\nA: b\rc\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\rc\r\n\r\n"))
  try(io, "folded", strptr("GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"))
  try(io, "no colon", strptr("GET / HTTP/1.1\r\nA b\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA b\r\n\r\n"))
  try(io, "space before colon", strptr("GET / HTTP/1.1\r\nA : b\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA : b\r\n\r\n"))
  try(io, "no blank line", strptr("GET / HTTP/1.1\r\nA: b\r\n"), strlen("GET / HTTP/1.1\r\nA: b\r\n"))
  try(io, "two lengths", strptr("GET / HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\nx"), strlen("GET / HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\nx"))
  try(io, "length not digits", strptr("GET / HTTP/1.1\r\nContent-Length: +1\r\n\r\nx"), strlen("GET / HTTP/1.1\r\nContent-Length: +1\r\n\r\nx"))
  try(io, "body short", strptr("GET / HTTP/1.1\r\nContent-Length: 9\r\n\r\nabc"), strlen("GET / HTTP/1.1\r\nContent-Length: 9\r\n\r\nabc"))
  try(io, "chunked", strptr("GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"), strlen("GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"))
  try(io, "control in value", strptr("GET / HTTP/1.1\r\nA: b\x01c\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\x01c\r\n\r\n"))
  try(io, "del in value", strptr("GET / HTTP/1.1\r\nA: b\x7fc\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\x7fc\r\n\r\n"))
  try(io, "tab and high bytes in value", strptr("GET / HTTP/1.1\r\nA: b\tc\xc3\xa9\r\n\r\n"), strlen("GET / HTTP/1.1\r\nA: b\tc\xc3\xa9\r\n\r\n"))

  var res *ovid/http.Response = ovid/http.NewResponse(io)
  ovid/io.Print("status ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 418))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 99))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 600))
  ovid/io.Print("\n")
  // Refused: an empty name, a name with a space, a value with CRLF,
  // Content-Length, and Transfer-Encoding; accepted: X-A.
  ovid/io.Print("headers ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr(""), 0, strptr("1"), 1))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr("X A"), strlen("X A"), strptr("1"), 1))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr("X-A"), strlen("X-A"), strptr("1\r\nSet-Cookie: x"), strlen("1\r\nSet-Cookie: x")))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr("Content-length"), strlen("Content-length"), strptr("1"), 1))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr("transfer-Encoding"), strlen("transfer-Encoding"), strptr("chunked"), strlen("chunked")))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, strptr("X-A"), strlen("X-A"), strptr("1"), 1))
  ovid/io.Print("\n")
  ovid/http.Write(io, res, strptr("hi"), strlen("hi"))
  // An escape byte and DEL are refused in a value; tab and bytes from
  // 0x80 up are not.
  var other *ovid/http.Response = ovid/http.NewResponse(io)
  ovid/io.Print("values ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, strptr("X-B"), 3, strptr("\x1b[31m"), strlen("\x1b[31m")))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, strptr("X-B"), 3, strptr("a\x7f"), strlen("a\x7f")))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, strptr("X-B"), 3, strptr("a\tb\xc3\xa9"), strlen("a\tb\xc3\xa9")))
  ovid/io.Print("\n")

  var ok *ovid/http.Request = ovid/http.NewRequest(io, strptr("GET"), 3, strptr("/"), 1)
  var bad *ovid/http.Request = ovid/http.NewRequest(io, 0, 0, 0, 0)
  ovid/http.Parse(bad, strptr("GET /\r\n\r\n"), strlen("GET /\r\n\r\n"))
  // A handler that failed, a request that could not be read, then the
  // response as the handler left it.
  show(io, ok, res, 1)
  show(io, bad, res, 0)
  show(io, ok, res, 0)
  ovid/http.SetStatus(res, 204)
  show(io, ok, res, 0)
  // A 205 says it has no body; a HEAD response says how long the body
  // would have been, and leaves it out.
  ovid/http.SetStatus(res, 205)
  show(io, ok, res, 0)
  ovid/http.SetStatus(res, 200)
  show(io, ovid/http.NewRequest(io, strptr("HEAD"), 4, strptr("/"), 1), res, 0)

  // A test: a request made by hand, the handler called directly.
  var req *ovid/http.Request = ovid/http.NewRequest(io, strptr("PUT"), 3, strptr("/x?b=2"), strlen("/x?b=2"))
  ovid/http.SetBody(io, req, strptr("abc"), 3)
  ovid/http.AddHeader(io, req, strptr("X-Id"), strlen("X-Id"), strptr("  7 "), strlen("  7 "))
  var out *ovid/http.Response = ovid/http.NewResponse(io)
  handler(io, req, out)
  ovid/io.Print("test: ")
  ovid/io.PrintInt(io, ovid/http.Status(out))
  ovid/io.Print(" ")
  ovid/io.Stdout(bytes(ovid/http.Sent(out), ovid/http.SentLen(out)))
  ovid/io.Print(" ")
  ovid/io.Stdout(bytes(ovid/http.Header(req, strptr("x-id"), 4), ovid/http.HeaderLen(req, strptr("x-id"), 4)))
  ovid/io.Print("\n")
  return 0
}
