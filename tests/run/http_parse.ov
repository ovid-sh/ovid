// stdout: "ok 0\n"
// stdout: "http/1.0 0\n"
// stdout: "no version 1\n"
// stdout: "bad version 1\n"
// stdout: "empty method 1\n"
// stdout: "bare lf 1\n"
// stdout: "bare cr 1\n"
// stdout: "folded 1\n"
// stdout: "no colon 1\n"
// stdout: "space before colon 1\n"
// stdout: "no blank line 1\n"
// stdout: "two lengths 1\n"
// stdout: "length not digits 1\n"
// stdout: "body short 1\n"
// stdout: "chunked 3\n"
// stdout: "control in value 1\n"
// stdout: "del in value 1\n"
// stdout: "tab and high bytes in value 0\n"
// stdout: "status 0 -1 -1\n"
// stdout: "headers -1 -1 -1 -1 -1 0\n"
// stdout: "values -1 -1 0\n"
// stdout: "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 418 \r\nX-A: 1\r\nContent-Length: 2\r\n\r\nhi"
// stdout: "HTTP/1.1 204 No Content\r\nX-A: 1\r\n\r\n"
// stdout: "HTTP/1.1 205 Reset Content\r\nX-A: 1\r\nContent-Length: 0\r\n\r\n"
// stdout: "HTTP/1.1 200 OK\r\nX-A: 1\r\nContent-Length: 2\r\n\r\n"
// stdout: "test: 201 /x 3 b=2 7\n"
// stdout: "has: 110111011\n"
package demo

import ovid/io
import ovid/http
import ovid/mem

func try(io *ovid/io.Cap, label bytes, req bytes) i64 {
  var r *ovid/http.Request = ovid/http.NewRequest(io, "", "")
  ovid/io.Print(label)
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.Parse(r, req))
  ovid/io.Print("\n")
  return 0
}

func show(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response, result i64) i64 {
  var b *ovid/mem.Buf = ovid/http.Format(io, req, res, result)
  return ovid/io.Stdout(ovid/mem.Bytes(b))
}

// handler is what a test calls with a request made by hand.
func handler(io *ovid/io.Cap, req *ovid/http.Request, res *ovid/http.Response) i64 {
  ovid/http.SetStatus(res, 201)
  ovid/http.Write(io, res, ovid/http.Path(req))
  ovid/http.Write(io, res, " ")
  ovid/http.WriteInt(io, res, len(ovid/http.Body(req)))
  ovid/http.Write(io, res, " ")
  ovid/http.Write(io, res, ovid/http.Query(req))
  return 0
}

func main(io *ovid/io.Cap) i64 {
  try(io, "ok", "GET / HTTP/1.1\r\nA: b\r\n\r\n")
  try(io, "http/1.0", "GET / HTTP/1.0\r\n\r\n")
  try(io, "no version", "GET /\r\n\r\n")
  try(io, "bad version", "GET / HTTP/2\r\n\r\n")
  try(io, "empty method", " / HTTP/1.1\r\n\r\n")
  try(io, "bare lf", "GET / HTTP/1.1\nA: b\n\n")
  try(io, "bare cr", "GET / HTTP/1.1\r\nA: b\rc\r\n\r\n")
  try(io, "folded", "GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n")
  try(io, "no colon", "GET / HTTP/1.1\r\nA b\r\n\r\n")
  try(io, "space before colon", "GET / HTTP/1.1\r\nA : b\r\n\r\n")
  try(io, "no blank line", "GET / HTTP/1.1\r\nA: b\r\n")
  try(io, "two lengths", "GET / HTTP/1.1\r\nContent-Length: 1\r\ncontent-length: 1\r\n\r\nx")
  try(io, "length not digits", "GET / HTTP/1.1\r\nContent-Length: +1\r\n\r\nx")
  try(io, "body short", "GET / HTTP/1.1\r\nContent-Length: 9\r\n\r\nabc")
  try(io, "chunked", "GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n")
  try(io, "control in value", "GET / HTTP/1.1\r\nA: b\x01c\r\n\r\n")
  try(io, "del in value", "GET / HTTP/1.1\r\nA: b\x7fc\r\n\r\n")
  try(io, "tab and high bytes in value", "GET / HTTP/1.1\r\nA: b\tc\xc3\xa9\r\n\r\n")

  var res *ovid/http.Response = ovid/http.NewResponse(io)
  ovid/io.Print("status ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 418))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 99))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetStatus(res, 600))
  ovid/io.Print("\n")
  // Refused: an empty name, a name with a space, a value with CRLF,
  // Content-Length, and Transfer-Encoding; accepted: X-A.
  ovid/io.Print("headers ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "", "1"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "X A", "1"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "X-A", "1\r\nSet-Cookie: x"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "Content-length", "1"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "transfer-Encoding", "chunked"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, res, "X-A", "1"))
  ovid/io.Print("\n")
  ovid/http.Write(io, res, "hi")
  // An escape byte and DEL are refused in a value; tab and bytes from
  // 0x80 up are not.
  var other *ovid/http.Response = ovid/http.NewResponse(io)
  ovid/io.Print("values ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, "X-B", "\x1b[31m"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, "X-B", "a\x7f"))
  ovid/io.Print(" ")
  ovid/io.PrintInt(io, ovid/http.SetHeader(io, other, "X-B", "a\tb\xc3\xa9"))
  ovid/io.Print("\n")

  var ok *ovid/http.Request = ovid/http.NewRequest(io, "GET", "/")
  var bad *ovid/http.Request = ovid/http.NewRequest(io, "", "")
  ovid/http.Parse(bad, "GET /\r\n\r\n")
  // A handler that failed, a request that could not be read, then the
  // response as the handler left it.
  show(io, ok, res, 1)
  show(io, bad, res, 0)
  show(io, ok, res, 0)
  ovid/http.SetStatus(res, 204)
  show(io, ok, res, 0)
  // A 205 says it has no body; a HEAD response says how long the body
  // would have been, and leaves it out.
  ovid/http.SetStatus(res, 205)
  show(io, ok, res, 0)
  ovid/http.SetStatus(res, 200)
  show(io, ovid/http.NewRequest(io, "HEAD", "/"), res, 0)

  // A test: a request made by hand, the handler called directly.
  var req *ovid/http.Request = ovid/http.NewRequest(io, "PUT", "/x?b=2")
  ovid/http.SetBody(io, req, "abc")
  ovid/http.AddHeader(io, req, "X-Id", "  7 ")
  var out *ovid/http.Response = ovid/http.NewResponse(io)
  handler(io, req, out)
  ovid/io.Print("test: ")
  ovid/io.PrintInt(io, ovid/http.Status(out))
  ovid/io.Print(" ")
  ovid/io.Stdout(ovid/http.Sent(out))
  ovid/io.Print(" ")
  ovid/io.Stdout(ovid/http.Header(req, "x-id"))
  ovid/io.Print("\n")
  // A header with an empty value is there, with an empty value; a
  // missing one is not, and reads as empty too. The same for the
  // headers a handler set, and one it set with a value is there.
  ovid/http.AddHeader(io, req, "X-Empty", "")
  ovid/http.SetHeader(io, out, "X-Set-Empty", "")
  ovid/http.SetHeader(io, out, "Content-Type", "text/plain")
  ovid/io.Print("has: ")
  yes(io, ovid/http.HasHeader(req, "x-empty"))
  yes(io, len(ovid/http.Header(req, "x-empty")) == 0)
  yes(io, ovid/http.HasHeader(req, "x-none"))
  yes(io, len(ovid/http.Header(req, "x-none")) == 0)
  yes(io, ovid/http.HasSentHeader(out, "x-set-empty"))
  yes(io, len(ovid/http.SentHeader(out, "x-set-empty")) == 0)
  yes(io, ovid/http.HasSentHeader(out, "x-set-none"))
  yes(io, len(ovid/http.SentHeader(out, "x-set-none")) == 0)
  yes(io, ovid/http.HasSentHeader(out, "content-type"))
  ovid/io.Print("\n")
  return 0
}

func yes(io *ovid/io.Cap, b bool) i64 {
  if b {
    return ovid/io.Print("1")
  }
  return ovid/io.Print("0")
}
