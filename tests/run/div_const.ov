// stdout: "ok\n"
package demo
import ovid/io

// A division or remainder by a constant other than 0 and -1 is a
// shift or a multiply, by one that fits 32 bits; it must agree with
// idiv, which a division by a param still uses, on dividends at the
// edges, near multiples of the divisor, and at every magnitude.

func rdiv(n i64, d i64) i64 {
  return n / d
}

func rmod(n i64, d i64) i64 {
  return n % d
}

func chk0(n i64) i64 {
  var bad i64 = 0
  if n / 2 != rdiv(n, 2) {
    bad = 1
  }
  if n % 2 != rmod(n, 2) {
    bad = 1
  }
  return bad
}

