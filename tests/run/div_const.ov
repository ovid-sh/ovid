func all(n i64) i64 {
  var bad i64 = 0
  bad = bad + chk0(n)
  bad = bad + chk1(n)
  bad = bad + chk2(n)
  bad = bad + chk3(n)
  bad = bad + chk4(n)
  bad = bad + chk5(n)
  bad = bad + chk6(n)
  bad = bad + chk7(n)
  bad = bad + chk8(n)
  bad = bad + chk9(n)
  bad = bad + chk10(n)
  bad = bad + chk11(n)
  bad = bad + chk12(n)
  bad = bad + chk13(n)
  bad = bad + chk14(n)
  bad = bad + chk15(n)
  bad = bad + chk16(n)
  bad = bad + chk17(n)
  bad = bad + chk18(n)
  bad = bad + chk19(n)
  bad = bad + chk20(n)
  bad = bad + chk21(n)
  bad = bad + chk22(n)
  bad = bad + chk23(n)
  bad = bad + chk24(n)
  bad = bad + chk25(n)
  bad = bad + chk26(n)
  bad = bad + chk27(n)
  bad = bad + chk28(n)
  bad = bad + chk29(n)
  bad = bad + chk30(n)
  bad = bad + chk31(n)
  bad = bad + chk32(n)
  return bad
}

func edge(n i64) i64 {
  return ((all(n) + all(n + 1)) + all(n - 1)) + all(0 - n)
}

func main(io *ovid/io.Cap) i64 {
  var bad i64 = 0
  var min i64 = (0 - 9223372036854775807) - 1
  bad = bad + all(min)
  bad = bad + all(min + 1)
  bad = bad + all(9223372036854775807)
  bad = bad + edge(0)
  var x i64 = 12345
  var i i64 = 0
  while i < 5000 {
    x = (x * 6364136223846793005) + 1442695040888963407
    bad = bad + edge(x >> (i % 64))
    i = i + 1
  }
  bad = bad + edge(2)
  bad = bad + edge(2 * 3)
  bad = bad + edge(3)
  bad = bad + edge(3 * 3)
  bad = bad + edge(5)
  bad = bad + edge(5 * 3)
  bad = bad + edge(6)
  bad = bad + edge(6 * 3)
  bad = bad + edge(7)
  bad = bad + edge(7 * 3)
  bad = bad + edge(9)
  bad = bad + edge(9 * 3)
  bad = bad + edge(10)
  bad = bad + edge(10 * 3)
  bad = bad + edge(16)
  bad = bad + edge(16 * 3)
  bad = bad + edge(25)
  bad = bad + edge(25 * 3)
  bad = bad + edge(60)
  bad = bad + edge(60 * 3)
  bad = bad + edge(64)
  bad = bad + edge(64 * 3)
  bad = bad + edge(100)
  bad = bad + edge(100 * 3)
  bad = bad + edge(641)
  bad = bad + edge(641 * 3)
  bad = bad + edge(1000)
  bad = bad + edge(1000 * 3)
  bad = bad + edge(1024)
  bad = bad + edge(1024 * 3)
  bad = bad + edge(65536)
  bad = bad + edge(65536 * 3)
  bad = bad + edge(1000000000)
  bad = bad + edge(1000000000 * 3)
  bad = bad + edge(1000000007)
  bad = bad + edge(1000000007 * 3)
  bad = bad + edge(1073741824)
  bad = bad + edge(1073741824 * 3)
  bad = bad + edge(2147483646)
  bad = bad + edge(2147483646 * 3)
  bad = bad + edge(2147483647)
  bad = bad + edge(2147483647 * 3)
  bad = bad + edge(2147483648)
  bad = bad + edge(2147483648 * 3)
  bad = bad + edge(4611686018427387905)
  bad = bad + edge(4611686018427387905 * 3)
  bad = bad + edge(9223372036854775807)
  bad = bad + edge(9223372036854775807 * 3)
  bad = bad + edge((0 - 2))
  bad = bad + edge((0 - 2) * 3)
  bad = bad + edge((0 - 3))
  bad = bad + edge((0 - 3) * 3)
  bad = bad + edge((0 - 7))
  bad = bad + edge((0 - 7) * 3)
  bad = bad + edge((0 - 8))
  bad = bad + edge((0 - 8) * 3)
  bad = bad + edge((0 - 10))
  bad = bad + edge((0 - 10) * 3)
  bad = bad + edge((0 - 1024))
  bad = bad + edge((0 - 1024) * 3)
  bad = bad + edge((0 - 1000000000))
  bad = bad + edge((0 - 1000000000) * 3)
  bad = bad + edge((0 - 2147483647))
  bad = bad + edge((0 - 2147483647) * 3)
  bad = bad + edge((0 - 2147483648))
  bad = bad + edge((0 - 2147483648) * 3)
  if bad > 0 {
    ovid/io.PrintInt(io, bad)
    ovid/io.Print(strptr(" wrong\n"))
    return 1
  }
  ovid/io.Print(strptr("ok\n"))
  return 0
}
