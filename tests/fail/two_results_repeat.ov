// A two-result func whose name repeats a type is reported at its decl and
// neither called nor received: both checkers say only that.
package demo
import ovid/io
type F struct {
  x i64
}
func F(x i64) (i64, error) { // error: duplicate_name 1
  return x, 0
}
func main(io *ovid/io.Cap) i64 {
  var v i64, e error = F(1)
  v, e = F(F(2))
  return v + (e as i64)
}
