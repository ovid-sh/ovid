// One name cannot receive both results.
package demo
import ovid/io
func Two(x i64) (i64, error) {
  return x, 0
}
func main(io *ovid/io.Cap) i64 {
  var a i64, a error = Two(1) // error: duplicate_name 3
  var b i64 = 0
  b, b = Two(2) // error: duplicate_name 3 // error: type_mismatch 10 expected="i64" got="error"
  return b
}
