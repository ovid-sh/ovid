// A second decl of a name gets one error, at that decl. Nothing inside a
// repeated type or func is checked: the second F's bad return is not
// reported.
package demo
import ovid/io
import ovid/io // error: duplicate_name 1
const Twice i64 = 1
type Twice struct { // error: duplicate_name 1
  a i64
}
type Pair struct {
  a i64
  a i64 // error: duplicate_name 3
}
func F(x i64, x i64) i64 { // error: duplicate_name 15
  return x
}
func F(y i64) i64 { // error: duplicate_name 1
  return true
}
func Pair() i64 { // error: duplicate_name 1
  return 0
}
func main(io *ovid/io.Cap) i64 {
  var n i64 = 1
  var n i64 = 2 // error: duplicate_name 3
  return n
}
