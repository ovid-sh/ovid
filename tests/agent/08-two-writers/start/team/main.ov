package team

import ovid/io

// Alpha is the first stage's score of x.
func Alpha(x i64) i64 {
  return x + 1
}

// Beta is the second stage's score of x.
func Beta(x i64) i64 {
  return x * 2
}

func main(io *ovid/io.Cap) i64 {
  ovid/io.PrintInt(io, Alpha(4))
  ovid/io.Print(strptr(" "))
  ovid/io.PrintInt(io, Beta(4))
  ovid/io.Print(strptr("\n"))
  return 0
}
