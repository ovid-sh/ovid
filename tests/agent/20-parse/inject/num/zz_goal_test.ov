package num

import ovid/io

// GoalParse is this file's only call of ParseI64, so a spelling of
// errors other than (i64, i64) changes it alone. It stores the value at
// out and returns 0, or returns 1 for E_SYNTAX, 2 for E_RANGE, and 3 for
// any other error.
func GoalParse(s bytes, out i64) i64 {
  var v i64, e i64 = ParseI64(s)
  store64(out, v)
  if e == 0 {
    return 0
  } else if e == E_SYNTAX {
    return 1
  } else if e == E_RANGE {
    return 2
  }
  return 3
}

// GoalIs reports whether s parses to want.
func GoalIs(io *ovid/io.Cap, s bytes, want i64) bool {
  var cell i64 = ovid/io.Alloc(io, 8)
  return GoalParse(s, cell) == 0 && load64(cell) == want
}

// GoalErr reports whether s fails with code (1 E_SYNTAX, 2 E_RANGE).
func GoalErr(io *ovid/io.Cap, s bytes, code i64) bool {
  var cell i64 = ovid/io.Alloc(io, 8)
  return GoalParse(s, cell) == code
}

func TestGoalParseValid(io *ovid/io.Cap) i64 {
  if !GoalIs(io, "0", 0) || !GoalIs(io, "-0", 0) || !GoalIs(io, "7", 7) || !GoalIs(io, "-7", -7) {
    return 1
  }
  if !GoalIs(io, "00012", 12) || !GoalIs(io, "-000", 0) || !GoalIs(io, "1234567890", 1234567890) {
    return 2
  }
  if !GoalIs(io, "9223372036854775807", 9223372036854775807) || !GoalIs(io, "0009223372036854775807", 9223372036854775807) {
    return 3
  }
  if !GoalIs(io, "-9223372036854775808", -9223372036854775807 - 1) || !GoalIs(io, "-9223372036854775807", -9223372036854775807) {
    return 4
  }
  var big bytes = "123456"
  if !GoalIs(io, big[1:4], 234) {
    return 5
  }
  return 0
}

func TestGoalParseSyntax(io *ovid/io.Cap) i64 {
  if !GoalErr(io, "", 1) || !GoalErr(io, "-", 1) || !GoalErr(io, "+1", 1) || !GoalErr(io, "--1", 1) {
    return 1
  }
  if !GoalErr(io, " 1", 1) || !GoalErr(io, "1 ", 1) || !GoalErr(io, "12a", 1) || !GoalErr(io, "1-", 1) {
    return 2
  }
  if !GoalErr(io, "1\r", 1) || !GoalErr(io, "0x10", 1) || !GoalErr(io, "/", 1) || !GoalErr(io, ":", 1) {
    return 3
  }
  return 0
}

func TestGoalParseRange(io *ovid/io.Cap) i64 {
  if !GoalErr(io, "9223372036854775808", 2) || !GoalErr(io, "-9223372036854775809", 2) {
    return 1
  }
  if !GoalErr(io, "99999999999999999999", 2) || !GoalErr(io, "-99999999999999999999", 2) {
    return 2
  }
  if !GoalErr(io, "18446744073709551616", 2) || !GoalErr(io, "10000000000000000000", 2) || !GoalErr(io, "-18446744073709551617", 2) {
    return 3
  }
  return 0
}
