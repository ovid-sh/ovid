package calc

import ovid/io

// Mid is the midpoint of lo and hi, rounded down.
func Mid(lo i64, hi i64) bool {
  return lo + (hi - lo) / 2
}

func main(io *ovid/io.Cap) i64 {
  ovid/io.PrintInt(io, Mid(10, 20))
  ovid/io.Print(strptr("\n"))
  ovid/io.PrintInt(io, Span(3, 11))
  ovid/io.Print(strptr("\n"))
  return 0
}
