package ovid/io

// Cap is the capability main receives: argv and the heap. Only code
// handed a *Cap can allocate or read arguments. maps is the newest mapping
// Alloc took from the kernel after the first region, or 0; each starts
// with the one before it and its own length (see Alloc).
type Cap struct {
  argc i64
  argv i64
  heap i64
  used i64
  size i64
  maps i64
}

const SYS_READ i64 = 0
const SYS_WRITE i64 = 1
const SYS_CLOSE i64 = 3
const SYS_FSTAT i64 = 5
const SYS_MMAP i64 = 9
const SYS_MUNMAP i64 = 11
const SYS_MADVISE i64 = 28
const SYS_EXIT i64 = 60
const SYS_OPENAT i64 = 257
const SYS_FSTATAT i64 = 262
const AT_FDCWD i64 = -100
const O_RDONLY i64 = 0
const O_WRONLY i64 = 1
const O_CREAT i64 = 64
const O_EXCL i64 = 128
const O_TRUNC i64 = 512

// Error codes: the second result of a func that can fail, 0 for success.
// They are the kernel's errno values. ErrText names the common ones.
const E_PERM i64 = 1
const E_NOENT i64 = 2
const E_INTR i64 = 4
const E_IO i64 = 5
const E_BADF i64 = 9
const E_AGAIN i64 = 11
const E_ACCES i64 = 13
const E_EXIST i64 = 17
const E_NOTDIR i64 = 20
const E_ISDIR i64 = 21
const E_INVAL i64 = 22
const E_NOSPC i64 = 28
const O_DIRECTORY i64 = 65536
const SYS_GETDENTS64 i64 = 217
const SYS_GETPID i64 = 39
const SYS_FSYNC i64 = 74
const SYS_RENAME i64 = 82
const SYS_UNLINK i64 = 87
const SYS_FCHMOD i64 = 91
const SYS_MKDIRAT i64 = 258

// Argc is the number of command-line arguments, the program name included.
func Argc(io *Cap) i64 {
  return io.argc
}

// Arg is command-line argument i; Arg(io, 0) is the program name. It is
// empty for an i that is not an argument: past argv the stack holds the
// environment, which is not the program's to read through here. The bytes
// are NUL-terminated in memory, so ArgC(io, i) is the address a syscall
// path can take.
func Arg(io *Cap, i i64) bytes {
  var p i64 = ArgC(io, i)
  if p == 0 {
    return bytes(0, 0)
  }
  return bytes(p, CLen(p))
}

// ArgC is the address of argument i, NUL-terminated, or 0 for an i that
// is not an argument.
func ArgC(io *Cap, i i64) i64 {
  if i < 0 || i >= io.argc {
    return 0
  }
  return load64(io.argv + (i * 8))
}

// EXIT_OOM is the exit code of a program the kernel refused memory, here
// and in the startup code.
const EXIT_OOM i64 = 71

// HEAPCHUNK is the size of each region Alloc takes from the kernel; the
// runtime maps the first one before main runs.
const HEAPCHUNK i64 = 128 << 20

// MAPHEAD is the header Alloc puts at the start of each mapping it takes
// after the first region: the previous mapping (io.maps) and the length.
const MAPHEAD i64 = 16

// Alloc returns n zeroed bytes (8-aligned) from the heap. Nothing is freed
// but by ResetHeap. A request that does not fit in what is left of the
// current region starts a new region, or, when it is more than half a
// region, gets a mapping of its own and leaves the current region in use.
// The result is never 0: if the kernel refuses, the program ends with exit
// code 71 and "out of memory" on standard error.
func Alloc(io *Cap, n i64) i64 {
  var align i64 = (n + 7) & ^7
  if align < 8 {
    align = 8
  }
  var u i64 = io.used
  if (u + align) > io.size {
    // Every mapping is linked into io.maps, so ResetHeap can find it.
    var own bool = align > HEAPCHUNK / 2
    var size i64 = HEAPCHUNK
    if own {
      size = align + MAPHEAD
    }
    var q i64 = Map(size)
    store64(q, io.maps)
    store64(q + 8, size)
    io.maps = q
    if own {
      return q + MAPHEAD
    }
    io.heap = q
    io.size = HEAPCHUNK
    u = MAPHEAD
  }
  var p i64 = io.heap + u
  io.used = u + align
  return p
}

// AllocBytes is Alloc as a bytes: n zeroed bytes.
func AllocBytes(io *Cap, n i64) bytes {
  return bytes(Alloc(io, n), n)
}

// HeapMark is a point in the heap's life that ResetHeap returns to.
type HeapMark struct {
  heap i64
  used i64
  size i64
  maps i64
}

// MarkHeap records where the heap is now. The mark itself is allocated
// before that point, so it outlives every reset to it.
func MarkHeap(io *Cap) *HeapMark {
  var m *HeapMark = Alloc(io, sizeof(HeapMark)) as *HeapMark
  m.heap = io.heap
  m.used = io.used
  m.size = io.size
  m.maps = io.maps
  return m
}

// ResetHeap frees everything Alloc returned since m: the mappings taken
// since go back to the kernel, and the rest of the region m was in is
// zeroed, so Alloc returns those addresses again. It is for a host that
// serves one request after another, between two of them: memory a request
// allocated must not be used after, as it reads zeros or another
// request's data. Bytes the region had in use are zeroed in place; whole
// pages past them, when a later region took over, are handed back to the
// kernel (MADV_DONTNEED), which zeroes them on the next touch. m must be a
// mark of this io not yet reset past: a reset to m frees any later mark.
// It returns 0, or the error code of the unmap the kernel refused (a host's
// seccomp policy): that mapping and the older ones stay, the next reset
// tries them again, and the rest of the reset is done all the same.
func ResetHeap(io *Cap, m *HeapMark) i64 {
  var end i64 = io.heap + io.used
  if io.heap != m.heap {
    end = m.heap + m.size
  }
  var q i64 = io.maps
  var r i64 = 0
  while q != m.maps && r == 0 {
    var prev i64 = load64(q)
    r = Code(syscall(SYS_MUNMAP, q, load64(q + 8), 0, 0, 0, 0))
    if r == 0 {
      q = prev
    }
  }
  // A refused mapping, and the older ones, stay linked for the next reset.
  io.maps = q
  io.heap = m.heap
  io.size = m.size
  io.used = m.used
  var p i64 = m.heap + m.used
  if io.heap + io.size == end {
    var page i64 = (p + 4095) & ^4095
    // A host may refuse madvise (seccomp); the loop below then zeroes
    // those pages too.
    if page < end && syscall(SYS_MADVISE, page, end - page, 4, 0, 0, 0) == 0 {
      end = page
    }
  }
  while p < end {
    store64(p, 0)
    p = p + 8
  }
  return r
}

// Exit ends the program at once with code (the exit status is its low 8
// bits): nothing after it runs. Ending the process is a power, so it
// takes the capability, and a func that can end the program says so. It
// never returns; its i64 result lets a fatal path read
// return ovid/io.Exit(io, 1), with no unreachable return after it.
func Exit(io *Cap, code i64) i64 {
  syscall(SYS_EXIT, code, 0, 0, 0, 0, 0)
  return code
}

// Map returns n fresh zeroed bytes from the kernel (mmap, private and
// anonymous), or ends the program when there is no memory. The mapping is
// not reserved (MAP_NORESERVE, 0x4000): it is address space until it is
// touched, so under the kernel's default overcommit heuristic a host with
// less memory than a region can still grant it. Strict overcommit
// (vm.overcommit_memory=2) ignores the flag, and other limits still apply.
func Map(n i64) i64 {
  var p i64 = syscall(SYS_MMAP, 0, n, 3, 0x4022, -1, 0)
  if p < 0 && p > -4096 {
    Write(2, "out of memory\n")
    syscall(SYS_EXIT, EXIT_OOM, 0, 0, 0, 0, 0)
  }
  return p
}

// CLen is the length of the NUL-terminated string at p.
func CLen(p i64) i64 {
  var i i64 = 0
  while load8(p + i) != 0 {
    i = i + 1
  }
  return i
}

// Code turns a syscall's result into an error code: 0 for a result that is
// not an error, else the errno (a positive E_ value).
func Code(r i64) i64 {
  if r < 0 && r > -4096 {
    return 0 - r
  }
  return 0
}

// ErrText names the error code e, for a message:
// ovid/io.Eprint(ovid/io.ErrText(e)).
func ErrText(e i64) bytes {
  if e == 0 {
    return "ok"
  } else if e == E_PERM {
    return "not permitted"
  } else if e == E_NOENT {
    return "no such file or directory"
  } else if e == E_INTR {
    return "interrupted"
  } else if e == E_IO {
    return "i/o error"
  } else if e == E_BADF {
    return "bad file descriptor"
  } else if e == E_AGAIN {
    return "try again"
  } else if e == E_ACCES {
    return "permission denied"
  } else if e == E_EXIST {
    return "file exists"
  } else if e == E_NOTDIR {
    return "not a directory"
  } else if e == E_ISDIR {
    return "is a directory"
  } else if e == E_INVAL {
    return "invalid argument"
  } else if e == E_NOSPC {
    return "no space left on device"
  }
  return "error"
}

// Write writes all of b to fd. It returns 0, or an error code.
func Write(fd i64, b bytes) i64 {
  return WriteN(fd, ptr(b), len(b))
}

// WriteN writes all n bytes at p to fd. It returns 0, or an error code.
func WriteN(fd i64, p i64, n i64) i64 {
  var off i64 = 0
  while off < n {
    var w i64 = syscall(SYS_WRITE, fd, p + off, n - off, 0, 0, 0)
    if w < 0 {
      return Code(w)
    }
    if w == 0 {
      return E_IO
    }
    off = off + w
  }
  return 0
}

// Stdout writes b to standard output.
func Stdout(b bytes) i64 {
  return Write(1, b)
}

// Stderr writes b to standard error.
func Stderr(b bytes) i64 {
  return Write(2, b)
}

// CStr copies b into a new NUL-terminated string, for a syscall path.
func CStr(io *Cap, b bytes) i64 {
  var n i64 = len(b)
  var d i64 = Alloc(io, n + 1)
  var i i64 = 0
  while i < n {
    store8(d + i, b[i])
    i = i + 1
  }
  store8(d + n, 0)
  return d
}

// Open opens the NUL-terminated path: an fd and 0, or 0 and an error code.
func Open(path i64, flags i64, mode i64) (i64, i64) {
  var r i64 = syscall(SYS_OPENAT, AT_FDCWD, path, flags, mode, 0, 0)
  if r < 0 {
    return 0, Code(r)
  }
  return r, 0
}

// Close closes fd. It returns 0, or an error code.
func Close(fd i64) i64 {
  return Code(syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0))
}

// Read reads from fd into b, up to len(b) bytes: the count (0 at the
// end) and 0, or 0 and an error code.
func Read(fd i64, b bytes) (i64, i64) {
  var r i64 = syscall(SYS_READ, fd, ptr(b), len(b), 0, 0, 0)
  if r < 0 {
    return 0, Code(r)
  }
  return r, 0
}

// Fstat fills buf (256 bytes) with struct stat for fd: size at 48. It
// returns 0, or an error code.
func Fstat(fd i64, buf i64) i64 {
  return Code(syscall(SYS_FSTAT, fd, buf, 0, 0, 0, 0))
}

// FstatAt fills buf (256 bytes) with struct stat for the NUL-terminated
// path. It returns 0, or an error code.
func FstatAt(path i64, buf i64) i64 {
  return Code(syscall(SYS_FSTATAT, AT_FDCWD, path, buf, 0, 0, 0))
}

// ReadFile reads the whole file named by path: its data (NUL-terminated
// in memory, past the end) and 0, or an empty bytes and an error code.
func ReadFile(io *Cap, path bytes) (bytes, i64) {
  var none bytes = bytes(0, 0)
  var fd i64, e i64 = Open(CStr(io, path), O_RDONLY, 0)
  if e != 0 {
    return none, e
  }
  var st i64 = Alloc(io, 256)
  e = Fstat(fd, st)
  if e != 0 {
    Close(fd)
    return none, e
  }
  var sz i64 = load64(st + 48)
  var buf i64 = Alloc(io, sz + 1)
  var got i64 = 0
  while got < sz {
    var r i64, re i64 = Read(fd, bytes(buf + got, sz - got))
    if re != 0 {
      Close(fd)
      return none, re
    }
    if r == 0 {
      // The file shrank under us.
      Close(fd)
      return none, E_IO
    }
    got = got + r
  }
  e = Close(fd)
  if e != 0 {
    return none, e
  }
  store8(buf + sz, 0)
  return bytes(buf, sz), 0
}

// WriteFile creates or truncates path with permission mode (493 is 0755,
// 420 is 0644) and writes data. It returns 0, or an error code.
func WriteFile(io *Cap, path bytes, data bytes, mode i64) i64 {
  var flags i64 = (O_WRONLY + O_CREAT) + O_TRUNC
  var fd i64, e i64 = Open(CStr(io, path), flags, mode)
  if e != 0 {
    return e
  }
  var w i64 = Write(fd, data)
  var c i64 = Close(fd)
  if w == 0 {
    w = c
  }
  return w
}

// Fsync waits until everything written to fd is on the disk. On a
// directory's fd it makes the names in it (a create, rename, or unlink)
// durable. It returns 0, or an error code.
func Fsync(fd i64) i64 {
  return Code(syscall(SYS_FSYNC, fd, 0, 0, 0, 0, 0))
}

// Rename moves the file at the NUL-terminated path from to the path to,
// replacing what is there in one step: a reader sees the old file or the
// new one, never a part of either. It returns 0, or an error code.
func Rename(from i64, to i64) i64 {
  return Code(syscall(SYS_RENAME, from, to, 0, 0, 0, 0))
}

// Unlink removes the name at the NUL-terminated path. It returns 0, or an
// error code.
func Unlink(path i64) i64 {
  return Code(syscall(SYS_UNLINK, path, 0, 0, 0, 0, 0))
}

// DirLen is the length of path's directory part, its last "/" included;
// 0 when path has none.
func DirLen(path bytes) i64 {
  var n i64 = len(path)
  while n > 0 && path[n - 1] != 47 {
    n = n - 1
  }
  return n
}

// PutInt writes v (v >= 0) in decimal at dst, without a NUL, and returns
// the address after the last digit.
func PutInt(dst i64, v i64) i64 {
  var div i64 = 1
  while (v / div) >= 10 {
    div = div * 10
  }
  while div > 0 {
    store8(dst, 48 + ((v / div) % 10))
    dst = dst + 1
    div = div / 10
  }
  return dst
}

// Temp is a temp file that CreateTemp made: its open fd and its
// NUL-terminated name.
type Temp struct {
  fd i64
  name i64
}

// CreateTemp makes a new, empty file beside path, named
// <dir>/.<base>.<pid>.<n>.ovid-tmp, open for writing: the Temp and 0, or a
// null pointer and an error code. The file is created exclusively and
// private (0600), so a name someone else put there, a symlink included, is
// never written through: the next n is tried.
func CreateTemp(io *Cap, path bytes) (*Temp, i64) {
  var t *Temp = Alloc(io, sizeof(Temp)) as *Temp
  var pathn i64 = len(path)
  var slash i64 = DirLen(path)
  var tmp i64 = Alloc(io, pathn + 48)
  var n i64 = 0
  while n < slash {
    store8(tmp + n, path[n])
    n = n + 1
  }
  store8(tmp + n, 46)
  n = n + 1
  var i i64 = slash
  while i < pathn {
    store8(tmp + n, path[i])
    n = n + 1
    i = i + 1
  }
  store8(tmp + n, 46)
  var tail i64 = PutInt((tmp + n) + 1, syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0))
  store8(tail, 46)
  tail = tail + 1
  t.name = tmp
  var fd i64 = 0
  var e i64 = E_EXIST
  var try i64 = 0
  while e == E_EXIST && try < 100 {
    var end i64 = PutInt(tail, try)
    var suffix i64 = strptr(".ovid-tmp")
    i = 0
    while i <= strlen(".ovid-tmp") {
      store8(end + i, load8(suffix + i))
      i = i + 1
    }
    fd, e = Open(tmp, (O_WRONLY + O_CREAT) + O_EXCL, 384)
    try = try + 1
  }
  if e != 0 {
    return 0 as *Temp, e
  }
  t.fd = fd
  return t, 0
}

// FillTemp writes data to the temp file t, gives it permission mode (not
// masked by the umask) once the data is in, syncs it if sync, and closes
// it. It returns 0, or an error code, and then the file is removed. An
// error that only close reports (a write the kernel had put off) counts.
func FillTemp(t *Temp, data bytes, mode i64, sync bool) i64 {
  var r i64 = Write(t.fd, data)
  if r == 0 {
    r = Code(syscall(SYS_FCHMOD, t.fd, mode, 0, 0, 0, 0))
  }
  if r == 0 && sync {
    r = Fsync(t.fd)
  }
  var c i64 = Close(t.fd)
  if r == 0 {
    r = c
  }
  if r != 0 {
    Unlink(t.name)
  }
  return r
}

// SyncPath syncs the file or directory at the NUL-terminated path (see
// Fsync), which must be readable. It returns 0, or an error code.
func SyncPath(path i64) i64 {
  var fd i64, e i64 = Open(path, O_RDONLY, 0)
  if e != 0 {
    return e
  }
  var r i64 = Fsync(fd)
  var c i64 = Close(fd)
  if r == 0 {
    r = c
  }
  return r
}

// WriteFileAtomic replaces or creates path with data and permission mode
// in one step: the data goes to a temp file in the
// same directory (see CreateTemp), which is renamed over path. Another
// process sees the old file or the new one, never a part, and a program
// that is running from path can be replaced. Nothing is synced, so after a
// power loss the file may be empty: use it for a file that can be made
// again, WriteFileDurable for one that cannot. It returns 0, or an error
// code, and then path is untouched.
func WriteFileAtomic(io *Cap, path bytes, data bytes, mode i64) i64 {
  var t *Temp, e i64 = CreateTemp(io, path)
  if e != 0 {
    return e
  }
  var r i64 = FillTemp(t, data, mode, false)
  if r != 0 {
    return r
  }
  r = Rename(t.name, CStr(io, path))
  if r != 0 {
    Unlink(t.name)
  }
  return r
}

// WriteFileDurable is WriteFileAtomic that also survives a crash: the
// temp file is synced before the rename and the directory after it, so
// once it returns 0 the new content is on the disk. The two syncs cost
// milliseconds on a disk. It returns 0, or an error code. If the temp file
// or the rename failed, path is untouched; but the last step, syncing the
// directory, comes after the rename, so when that is what failed path
// already holds the new content and it is only not known to be durable.
// A caller that must tell the two apart reads path back.
func WriteFileDurable(io *Cap, path bytes, data bytes, mode i64) i64 {
  var t *Temp, e i64 = CreateTemp(io, path)
  if e != 0 {
    return e
  }
  var r i64 = FillTemp(t, data, mode, true)
  if r != 0 {
    return r
  }
  r = Rename(t.name, CStr(io, path))
  if r != 0 {
    Unlink(t.name)
    return r
  }
  var n i64 = DirLen(path)
  if n == 0 {
    return SyncPath(strptr("."))
  }
  return SyncPath(CStr(io, path[0:n]))
}

// Getdents reads directory entries from fd (opened with O_DIRECTORY) into
// buf, as linux_dirent64 records: d_ino at 0, d_off at 8, d_reclen (u16)
// at 16, d_type at 18 (4 dir, 8 file, 10 symlink, 0 unknown), NUL-
// terminated name at 19. It returns the bytes read (0 at the end) and 0,
// or 0 and an error code.
func Getdents(fd i64, buf bytes) (i64, i64) {
  var r i64 = syscall(SYS_GETDENTS64, fd, ptr(buf), len(buf), 0, 0, 0)
  if r < 0 {
    return 0, Code(r)
  }
  return r, 0
}

// Mkdir creates the directory at the NUL-terminated path, mode 0755. It
// returns 0, or an error code.
func Mkdir(path i64) i64 {
  return Code(syscall(SYS_MKDIRAT, AT_FDCWD, path, 493, 0, 0, 0))
}

// IsDir reports whether path is a directory, and 0, or false and the
// error code of looking.
func IsDir(io *Cap, path bytes) (bool, i64) {
  var st i64 = Alloc(io, 256)
  var e i64 = FstatAt(CStr(io, path), st)
  if e != 0 {
    return false, e
  }
  var m i64 = load32(st + 24)
  return (m & 0xF000) == 0x4000, 0
}

// Print writes b to standard output: ovid/io.Print("hi\n").
func Print(b bytes) i64 {
  return Write(1, b)
}

// Eprint is Print to standard error.
func Eprint(b bytes) i64 {
  return Write(2, b)
}

// PrintInt writes v in decimal to standard output. It uses heap scratch
// and gives it back, so it may be called in a loop.
func PrintInt(io *Cap, v i64) i64 {
  return WriteInt(io, 1, v)
}

// WriteInt writes v in decimal to fd.
func WriteInt(io *Cap, fd i64, v i64) i64 {
  var mark i64 = io.used
  var region i64 = io.heap
  var buf i64 = Alloc(io, 24)
  // Digits go right to left; negatives are built from negative remainders
  // so the most negative i64 works too.
  var i i64 = 24
  var x i64 = v
  if x > 0 {
    x = 0 - x
  }
  while x != 0 || i == 24 {
    i = i - 1
    store8(buf + i, 48 - (x % 10))
    x = x / 10
  }
  if v < 0 {
    i = i - 1
    store8(buf + i, 45)
  }
  var r i64 = Write(fd, bytes(buf + i, 24 - i))
  // Hand the scratch back zeroed, as Alloc promises.
  while i < 24 {
    store8(buf + i, 0)
    i = i + 1
  }
  if io.heap == region {
    io.used = mark
  }
  return r
}
