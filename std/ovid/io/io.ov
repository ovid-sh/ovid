package ovid/io

// Cap is the capability main receives: argv and the heap. Only code
// handed a *Cap can allocate or read arguments.
type Cap struct {
  argc i64
  argv i64
  heap i64
  used i64
  size i64
  net i64
}

const SYS_READ i64 = 0
const SYS_WRITE i64 = 1
const SYS_CLOSE i64 = 3
const SYS_FSTAT i64 = 5
const SYS_MMAP i64 = 9
const SYS_EXIT i64 = 60
const SYS_OPENAT i64 = 257
const SYS_FSTATAT i64 = 262
const AT_FDCWD i64 = -100
const O_RDONLY i64 = 0
const O_WRONLY i64 = 1
const O_CREAT i64 = 64
const O_EXCL i64 = 128
const O_TRUNC i64 = 512
const EEXIST i64 = -17
const O_DIRECTORY i64 = 65536
const SYS_GETDENTS64 i64 = 217
const SYS_GETPID i64 = 39
const SYS_FSYNC i64 = 74
const SYS_RENAME i64 = 82
const SYS_UNLINK i64 = 87
const SYS_FCHMOD i64 = 91
const SYS_MKDIRAT i64 = 258

// Argc is the number of command-line arguments, the program name included.
func Argc(io *Cap) i64 {
  return io.argc
}

// Arg is the address of argument i, NUL-terminated; its length is CLen.
// Arg(io, 0) is the program name. It is 0 for an i that is not an argument:
// past argv the stack holds the environment, which is not the program's to
// read through here.
func Arg(io *Cap, i i64) i64 {
  if i < 0 || i >= io.argc {
    return 0
  }
  return load64(io.argv + (i * 8))
}

// EXIT_OOM is the exit code of a program the kernel refused memory, here
// and in the startup code.
const EXIT_OOM i64 = 71

// HEAPCHUNK is the size of each region Alloc takes from the kernel; the
// runtime maps the first one before main runs.
const HEAPCHUNK i64 = 128 << 20

// Alloc returns n zeroed bytes (8-aligned) from the heap. Nothing is ever
// freed. A request that does not fit in what is left of the current region
// starts a new region, or, when it is more than half a region, gets a
// mapping of its own and leaves the current region in use. The result is
// never 0: if the kernel refuses, the program ends with exit code 71 and
// "out of memory" on standard error.
func Alloc(io *Cap, n i64) i64 {
  var align i64 = (n + 7) & ^7
  if align < 8 {
    align = 8
  }
  var u i64 = io.used
  if (u + align) > io.size {
    if align > HEAPCHUNK / 2 {
      return Map(align)
    }
    io.heap = Map(HEAPCHUNK)
    io.size = HEAPCHUNK
    u = 0
  }
  var p i64 = io.heap + u
  io.used = u + align
  return p
}

// Map returns n fresh zeroed bytes from the kernel (mmap, private and
// anonymous), or ends the program when there is no memory. The mapping is
// not reserved (MAP_NORESERVE, 0x4000): it is address space until it is
// touched, so under the kernel's default overcommit heuristic a host with
// less memory than a region can still grant it. Strict overcommit
// (vm.overcommit_memory=2) ignores the flag, and other limits still apply.
func Map(n i64) i64 {
  var p i64 = syscall(SYS_MMAP, 0, n, 3, 0x4022, -1, 0)
  if p < 0 && p > -4096 {
    Write(2, strptr("out of memory\n"), strlen("out of memory\n"))
    syscall(SYS_EXIT, EXIT_OOM, 0, 0, 0, 0, 0)
  }
  return p
}

// CLen is the length of the NUL-terminated string at p.
func CLen(p i64) i64 {
  var i i64 = 0
  while load8(p + i) != 0 {
    i = i + 1
  }
  return i
}

// Write writes all n bytes at p to fd. It returns 0, or -1 on error.
func Write(fd i64, p i64, n i64) i64 {
  var off i64 = 0
  while off < n {
    var w i64 = syscall(SYS_WRITE, fd, p + off, n - off, 0, 0, 0)
    if w <= 0 {
      return -1
    }
    off = off + w
  }
  return 0
}

// Stdout writes n bytes at p to standard output.
func Stdout(p i64, n i64) i64 {
  return Write(1, p, n)
}

// Stderr writes n bytes at p to standard error.
func Stderr(p i64, n i64) i64 {
  return Write(2, p, n)
}

// CStr copies n bytes at p into a new NUL-terminated string.
func CStr(io *Cap, p i64, n i64) i64 {
  var d i64 = Alloc(io, n + 1)
  var i i64 = 0
  while i < n {
    store8(d + i, load8(p + i))
    i = i + 1
  }
  store8(d + n, 0)
  return d
}

// Open opens the NUL-terminated path; it returns an fd, or < 0 on error.
func Open(path i64, flags i64, mode i64) i64 {
  return syscall(SYS_OPENAT, AT_FDCWD, path, flags, mode, 0, 0)
}

// Close closes fd.
func Close(fd i64) i64 {
  return syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
}

// Read reads up to n bytes from fd into p; it returns the count, 0 at the
// end, or < 0 on error.
func Read(fd i64, p i64, n i64) i64 {
  return syscall(SYS_READ, fd, p, n, 0, 0, 0)
}

// Fstat fills buf (256 bytes) with struct stat for fd: size at 48.
func Fstat(fd i64, buf i64) i64 {
  return syscall(SYS_FSTAT, fd, buf, 0, 0, 0, 0)
}

// FstatAt fills buf (256 bytes) with struct stat for the NUL-terminated path.
func FstatAt(path i64, buf i64) i64 {
  return syscall(SYS_FSTATAT, AT_FDCWD, path, buf, 0, 0, 0)
}

// ReadFile reads the whole file named by path (pathn bytes). It returns 0
// and stores the data address at outp and its length at outn (allocate
// two 8-byte cells and load64 them), or -1. The data is NUL-terminated.
func ReadFile(io *Cap, path i64, pathn i64, outp i64, outn i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var fd i64 = Open(cs, O_RDONLY, 0)
  if fd < 0 {
    return -1
  }
  var st i64 = Alloc(io, 256)
  if Fstat(fd, st) < 0 {
    Close(fd)
    return -1
  }
  var sz i64 = load64(st + 48)
  var buf i64 = Alloc(io, sz + 1)
  var got i64 = 0
  while got < sz {
    var r i64 = Read(fd, buf + got, sz - got)
    if r <= 0 {
      Close(fd)
      return -1
    }
    got = got + r
  }
  Close(fd)
  store8(buf + sz, 0)
  store64(outp, buf)
  store64(outn, sz)
  return 0
}

// WriteFile creates or truncates path with permission mode (493 is 0755,
// 420 is 0644) and writes datan bytes. It returns 0, or < 0 on error.
func WriteFile(io *Cap, path i64, pathn i64, data i64, datan i64, mode i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var flags i64 = (O_WRONLY + O_CREAT) + O_TRUNC
  var fd i64 = Open(cs, flags, mode)
  if fd < 0 {
    return -1
  }
  var w i64 = Write(fd, data, datan)
  var c i64 = Close(fd)
  if w == 0 {
    w = c
  }
  return w
}

// Fsync waits until everything written to fd is on the disk. On a
// directory's fd it makes the names in it (a create, rename, or unlink)
// durable. It returns 0, or < 0 on error.
func Fsync(fd i64) i64 {
  return syscall(SYS_FSYNC, fd, 0, 0, 0, 0, 0)
}

// Rename moves the file at the NUL-terminated path from to the path to,
// replacing what is there in one step: a reader sees the old file or the
// new one, never a part of either.
func Rename(from i64, to i64) i64 {
  return syscall(SYS_RENAME, from, to, 0, 0, 0, 0)
}

// Unlink removes the name at the NUL-terminated path.
func Unlink(path i64) i64 {
  return syscall(SYS_UNLINK, path, 0, 0, 0, 0, 0)
}

// DirLen is the length of path's directory part, its last "/" included;
// 0 when path has none.
func DirLen(path i64, pathn i64) i64 {
  while pathn > 0 && load8((path + pathn) - 1) != 47 {
    pathn = pathn - 1
  }
  return pathn
}

// PutInt writes v (v >= 0) in decimal at dst, without a NUL, and returns
// the address after the last digit.
func PutInt(dst i64, v i64) i64 {
  var div i64 = 1
  while (v / div) >= 10 {
    div = div * 10
  }
  while div > 0 {
    store8(dst, 48 + ((v / div) % 10))
    dst = dst + 1
    div = div / 10
  }
  return dst
}

// Temp is a temp file that CreateTemp made: its open fd (< 0 if it could
// not be made) and its NUL-terminated name.
type Temp struct {
  fd i64
  name i64
}

// CreateTemp makes a new, empty file beside path (pathn bytes), named
// <dir>/.<base>.<pid>.<n>.ovid-tmp, open for writing. The file is created
// exclusively and private (0600), so a name someone else put there, a
// symlink included, is never written through: the next n is tried. Check
// fd on the result.
func CreateTemp(io *Cap, path i64, pathn i64) *Temp {
  var t *Temp = Alloc(io, sizeof(Temp)) as *Temp
  var slash i64 = DirLen(path, pathn)
  var tmp i64 = Alloc(io, pathn + 48)
  var n i64 = 0
  while n < slash {
    store8(tmp + n, load8(path + n))
    n = n + 1
  }
  store8(tmp + n, 46)
  n = n + 1
  var i i64 = slash
  while i < pathn {
    store8(tmp + n, load8(path + i))
    n = n + 1
    i = i + 1
  }
  store8(tmp + n, 46)
  var tail i64 = PutInt((tmp + n) + 1, syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0))
  store8(tail, 46)
  tail = tail + 1
  t.name = tmp
  t.fd = EEXIST
  var try i64 = 0
  while t.fd == EEXIST && try < 100 {
    var end i64 = PutInt(tail, try)
    var suffix i64 = strptr(".ovid-tmp")
    i = 0
    while i <= strlen(".ovid-tmp") {
      store8(end + i, load8(suffix + i))
      i = i + 1
    }
    t.fd = Open(tmp, (O_WRONLY + O_CREAT) + O_EXCL, 384)
    try = try + 1
  }
  return t
}

// FillTemp writes datan bytes to the temp file t, gives it permission mode
// (not masked by the umask) once the data is in, syncs it if sync, and
// closes it. It returns 0, or < 0 on error, and then the file is removed.
// An error that only close reports (a write the kernel had put off) counts.
func FillTemp(t *Temp, data i64, datan i64, mode i64, sync bool) i64 {
  var r i64 = Write(t.fd, data, datan)
  if r == 0 {
    r = syscall(SYS_FCHMOD, t.fd, mode, 0, 0, 0, 0)
  }
  if r == 0 && sync {
    r = Fsync(t.fd)
  }
  var c i64 = Close(t.fd)
  if r == 0 {
    r = c
  }
  if r != 0 {
    Unlink(t.name)
  }
  return r
}

// SyncPath syncs the file or directory at the NUL-terminated path (see
// Fsync), which must be readable. It returns 0, or < 0 on error.
func SyncPath(path i64) i64 {
  var fd i64 = Open(path, O_RDONLY, 0)
  if fd < 0 {
    return fd
  }
  var r i64 = Fsync(fd)
  var c i64 = Close(fd)
  if r == 0 {
    r = c
  }
  return r
}

// WriteFileAtomic replaces or creates path (pathn bytes) with datan bytes
// and permission mode in one step: the data goes to a temp file in the
// same directory (see CreateTemp), which is renamed over path. Another
// process sees the old file or the new one, never a part, and a program
// that is running from path can be replaced. Nothing is synced, so after a
// power loss the file may be empty: use it for a file that can be made
// again, WriteFileDurable for one that cannot. It returns 0, or < 0 on
// error, and then path is untouched.
func WriteFileAtomic(io *Cap, path i64, pathn i64, data i64, datan i64, mode i64) i64 {
  var t *Temp = CreateTemp(io, path, pathn)
  if t.fd < 0 {
    return t.fd
  }
  var r i64 = FillTemp(t, data, datan, mode, false)
  if r != 0 {
    return r
  }
  r = Rename(t.name, CStr(io, path, pathn))
  if r != 0 {
    Unlink(t.name)
  }
  return r
}

// WriteFileDurable is WriteFileAtomic that also survives a crash: the
// temp file is synced before the rename and the directory after it, so
// once it returns 0 the new content is on the disk. The two syncs cost
// milliseconds on a disk. It returns < 0 on error. If the temp file or the
// rename failed, path is untouched; but the last step, syncing the
// directory, comes after the rename, so when that is what failed path
// already holds the new content and it is only not known to be durable.
// A caller that must tell the two apart reads path back.
func WriteFileDurable(io *Cap, path i64, pathn i64, data i64, datan i64, mode i64) i64 {
  var t *Temp = CreateTemp(io, path, pathn)
  if t.fd < 0 {
    return t.fd
  }
  var r i64 = FillTemp(t, data, datan, mode, true)
  if r != 0 {
    return r
  }
  r = Rename(t.name, CStr(io, path, pathn))
  if r != 0 {
    Unlink(t.name)
    return r
  }
  var n i64 = DirLen(path, pathn)
  if n == 0 {
    return SyncPath(strptr("."))
  }
  return SyncPath(CStr(io, path, n))
}

// Getdents reads directory entries from fd (opened with O_DIRECTORY) into
// buf, at most n bytes, as linux_dirent64 records: d_ino at 0, d_off at 8,
// d_reclen (u16) at 16, d_type at 18 (4 dir, 8 file, 10 symlink, 0 unknown),
// NUL-terminated name at 19. Returns the bytes read, 0 at the end, or < 0.
func Getdents(fd i64, buf i64, n i64) i64 {
  return syscall(SYS_GETDENTS64, fd, buf, n, 0, 0, 0)
}

// Mkdir creates the directory at the NUL-terminated path, mode 0755.
func Mkdir(path i64) i64 {
  return syscall(SYS_MKDIRAT, AT_FDCWD, path, 493, 0, 0, 0)
}

// IsDir is 1 if path (pathn bytes) is a directory, else 0.
func IsDir(io *Cap, path i64, pathn i64) i64 {
  var cs i64 = CStr(io, path, pathn)
  var st i64 = Alloc(io, 256)
  if FstatAt(cs, st) < 0 {
    return 0
  }
  var m i64 = load32(st + 24)
  if (m & 0xF000) == 0x4000 {
    return 1
  }
  return 0
}

// Print writes the NUL-terminated string at p to standard output, so a
// literal needs no length: ovid/io.Print(strptr("hi\n")).
func Print(p i64) i64 {
  return Write(1, p, CLen(p))
}

// Eprint is Print to standard error.
func Eprint(p i64) i64 {
  return Write(2, p, CLen(p))
}

// PrintInt writes v in decimal to standard output. It uses heap scratch
// and gives it back, so it may be called in a loop.
func PrintInt(io *Cap, v i64) i64 {
  return WriteInt(io, 1, v)
}

// WriteInt writes v in decimal to fd.
func WriteInt(io *Cap, fd i64, v i64) i64 {
  var mark i64 = io.used
  var region i64 = io.heap
  var buf i64 = Alloc(io, 24)
  // Digits go right to left; negatives are built from negative remainders
  // so the most negative i64 works too.
  var i i64 = 24
  var x i64 = v
  if x > 0 {
    x = 0 - x
  }
  while x != 0 || i == 24 {
    i = i - 1
    store8(buf + i, 48 - (x % 10))
    x = x / 10
  }
  if v < 0 {
    i = i - 1
    store8(buf + i, 45)
  }
  var r i64 = Write(fd, buf + i, 24 - i)
  // Hand the scratch back zeroed, as Alloc promises.
  while i < 24 {
    store8(buf + i, 0)
    i = i + 1
  }
  if io.heap == region {
    io.used = mark
  }
  return r
}

// The network.
//
// Net is the capability to reach it. The runtime hands one to a main that
// asks for it, func main(io *Cap, net *Net) i64, and nothing else makes
// one: outside this package a *Net cannot come from a cast. So a func
// reaches the network only if it is passed a Net, a Listener, a Conn, or a
// Poller, and its signature says so.
//
// A Listener or a Conn is never 0. One that could not be made says why:
// ListenErr and ConnErr are 0, or the kernel's negative errno.

const SYS_SOCKET i64 = 41
const SYS_CONNECT i64 = 42
const SYS_SENDTO i64 = 44
const SYS_BIND i64 = 49
const SYS_LISTEN i64 = 50
const SYS_GETSOCKNAME i64 = 51
const SYS_SETSOCKOPT i64 = 54
const SYS_EPOLL_WAIT i64 = 232
const SYS_EPOLL_CTL i64 = 233
const SYS_ACCEPT4 i64 = 288
const SYS_EPOLL_CREATE1 i64 = 291

const EINTR i64 = -4
const EBADF i64 = -9
const EAGAIN i64 = -11

const EPOLLIN i64 = 1
const EPOLLOUT i64 = 4
const EPOLLERR i64 = 8
const EPOLLHUP i64 = 16

// Net is the same block as the Cap, under a type that grants less.
type Net struct {
  block i64
}

// NetState is what the network funcs share: closed Conns to hand out
// again, the Conn that stands for "none", and scratch for system calls.
type NetState struct {
  io *Cap
  free *Conn
  none *Conn
  cell i64
}

type Listener struct {
  st *NetState
  fd i64
  err i64
}

type Conn struct {
  st *NetState
  fd i64
  err i64
  next *Conn
}

// Poller waits for several Conns and Listeners at once.
type Poller struct {
  fd i64
  evs i64
  max i64
  ev i64
}

func netState(net *Net) *NetState {
  var io *Cap = (net as i64) as *Cap
  if io.net == 0 {
    var st *NetState = Alloc(io, sizeof(NetState)) as *NetState
    st.io = io
    st.cell = Alloc(io, 16)
    st.none = Alloc(io, sizeof(Conn)) as *Conn
    st.none.st = st
    st.none.fd = -1
    io.net = st as i64
  }
  return io.net as *NetState
}

// sockaddr fills st.cell with a struct sockaddr_in for ip (four bytes, the
// first in the high byte: 127.0.0.1 is 0x7f000001) and port.
func sockaddr(st *NetState, ip i64, port i64) i64 {
  var sa i64 = st.cell
  store64(sa, 0)
  store64(sa + 8, 0)
  store8(sa, 2)
  store8(sa + 2, port >> 8)
  store8(sa + 3, port)
  store8(sa + 4, ip >> 24)
  store8(sa + 5, ip >> 16)
  store8(sa + 6, ip >> 8)
  store8(sa + 7, ip)
  return sa
}

// Listen returns a Listener on the IPv4 address ip and port; port 0 lets
// the kernel choose one, which ListenPort then reports. Check ListenErr.
func Listen(net *Net, ip i64, port i64, backlog i64) *Listener {
  var st *NetState = netState(net)
  var l *Listener = Alloc(st.io, sizeof(Listener)) as *Listener
  l.st = st
  // AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC.
  l.fd = syscall(SYS_SOCKET, 2, 526337, 0, 0, 0, 0)
  if l.fd < 0 {
    l.err = l.fd
    return l
  }
  // SOL_SOCKET, SO_REUSEADDR.
  store64(st.cell, 1)
  syscall(SYS_SETSOCKOPT, l.fd, 1, 2, st.cell, 4, 0)
  l.err = syscall(SYS_BIND, l.fd, sockaddr(st, ip, port), 16, 0, 0, 0)
  if l.err == 0 {
    l.err = syscall(SYS_LISTEN, l.fd, backlog, 0, 0, 0, 0)
  }
  if l.err != 0 {
    Close(l.fd)
    l.fd = -1
  }
  return l
}

func ListenErr(l *Listener) i64 {
  return l.err
}

// ListenPort is the port l listens on, or < 0.
func ListenPort(l *Listener) i64 {
  var sa i64 = l.st.cell
  store64(sa + 8, 16)
  var r i64 = syscall(SYS_GETSOCKNAME, l.fd, sa, sa + 8, 0, 0, 0)
  if r < 0 {
    return r
  }
  return (load8(sa + 2) << 8) | load8(sa + 3)
}

func newConn(st *NetState, fd i64) *Conn {
  var c *Conn = st.free
  if c == 0 as *Conn {
    c = Alloc(st.io, sizeof(Conn)) as *Conn
    c.st = st
  } else {
    st.free = c.next
  }
  c.fd = fd
  c.err = 0
  return c
}

// Accept takes one waiting connection from l. It does not block: when
// none is waiting, the Conn it returns has ConnErr EAGAIN.
func Accept(l *Listener) *Conn {
  // SOCK_NONBLOCK | SOCK_CLOEXEC.
  var fd i64 = syscall(SYS_ACCEPT4, l.fd, 0, 0, 526336, 0, 0)
  if fd < 0 {
    l.st.none.err = fd
    return l.st.none
  }
  // IPPROTO_TCP, TCP_NODELAY: a small write is sent at once.
  store64(l.st.cell, 1)
  syscall(SYS_SETSOCKOPT, fd, 6, 1, l.st.cell, 4, 0)
  return newConn(l.st, fd)
}

// Dial connects to the IPv4 address ip and port, and waits until it has.
// Check ConnErr. The Conn blocks on ConnRead and ConnWrite.
func Dial(net *Net, ip i64, port i64) *Conn {
  var st *NetState = netState(net)
  // AF_INET, SOCK_STREAM | SOCK_CLOEXEC.
  var fd i64 = syscall(SYS_SOCKET, 2, 524289, 0, 0, 0, 0)
  var r i64 = fd
  if fd >= 0 {
    r = syscall(SYS_CONNECT, fd, sockaddr(st, ip, port), 16, 0, 0, 0)
    if r < 0 {
      Close(fd)
    }
  }
  if r < 0 {
    st.none.err = r
    return st.none
  }
  return newConn(st, fd)
}

// ConnErr is 0 for a Conn that is open, or why it is not.
func ConnErr(c *Conn) i64 {
  if c.fd < 0 && c.err == 0 {
    return EBADF
  }
  return c.err
}

// ConnRead reads up to n bytes into p. It returns the count, 0 when the
// peer has closed, or < 0 (EAGAIN when a non-blocking Conn has nothing).
func ConnRead(c *Conn, p i64, n i64) i64 {
  if c.fd < 0 {
    return EBADF
  }
  return syscall(SYS_READ, c.fd, p, n, 0, 0, 0)
}

// ConnWrite sends up to n bytes at p and returns how many were taken, or
// < 0. A peer that has gone is an error, not the end of the program.
func ConnWrite(c *Conn, p i64, n i64) i64 {
  if c.fd < 0 {
    return EBADF
  }
  // MSG_NOSIGNAL.
  return syscall(SYS_SENDTO, c.fd, p, n, 16384, 0, 0)
}

// ConnClose closes c. The handle is dead from here on; ovid/io may hand
// its memory out again as another Conn.
func ConnClose(c *Conn) i64 {
  if c.fd < 0 {
    return EBADF
  }
  var r i64 = Close(c.fd)
  c.fd = -1
  c.next = c.st.free
  c.st.free = c
  return r
}

// NewPoller makes a Poller that reports up to max events per PollWait.
func NewPoller(net *Net, max i64) *Poller {
  var st *NetState = netState(net)
  var p *Poller = Alloc(st.io, sizeof(Poller)) as *Poller
  // EPOLL_CLOEXEC.
  p.fd = syscall(SYS_EPOLL_CREATE1, 524288, 0, 0, 0, 0, 0)
  p.max = max
  p.evs = Alloc(st.io, max * 12)
  p.ev = Alloc(st.io, 16)
  return p
}

func pollCtl(p *Poller, op i64, fd i64, events i64, data i64) i64 {
  store64(p.ev, events)
  store64(p.ev + 4, data)
  return syscall(SYS_EPOLL_CTL, p.fd, op, fd, p.ev, 0, 0)
}

// PollListener has p report, with data, when l has a connection waiting.
func PollListener(p *Poller, l *Listener, data i64) i64 {
  return pollCtl(p, 1, l.fd, EPOLLIN, data)
}

// PollConn has p report events on c (EPOLLIN, EPOLLOUT) with data, or
// changes what it reports if c is already watched. Closing c ends it.
func PollConn(p *Poller, c *Conn, events i64, data i64) i64 {
  var r i64 = pollCtl(p, 1, c.fd, events, data)
  // EEXIST: watched already, so this is a change.
  if r == -17 {
    r = pollCtl(p, 3, c.fd, events, data)
  }
  return r
}

// PollWait waits up to ms milliseconds (-1: forever) and returns how many
// events there are, or < 0. Event i is PollEvents(p, i) on PollData(p, i).
func PollWait(p *Poller, ms i64) i64 {
  return syscall(SYS_EPOLL_WAIT, p.fd, p.evs, p.max, ms, 0, 0)
}

func PollEvents(p *Poller, i i64) i64 {
  return load32(p.evs + (i * 12))
}

func PollData(p *Poller, i i64) i64 {
  return load64((p.evs + (i * 12)) + 4)
}
