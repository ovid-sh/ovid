package ovid/test

import ovid/io

// Eq reports whether got equals want. If not, it writes
// "got <got>, want <want>" to stderr, which ovid test shows as the failed
// test's output:
//   if !ovid/test.Eq(io, Sum(s), 10) {
//     return 1
//   }
func Eq(io *ovid/io.Cap, got i64, want i64) bool {
  if got == want {
    return true
  }
  ovid/io.Eprint(io, "got ")
  ovid/io.WriteInt(io, ovid/io.Stderr(io), got)
  ovid/io.Eprint(io, ", want ")
  ovid/io.WriteInt(io, ovid/io.Stderr(io), want)
  ovid/io.Eprint(io, "\n")
  return false
}

// True reports ok. If it is false, it writes msg and a newline to
// stderr: ovid/test.True(io, n > 0, "n is positive").
func True(io *ovid/io.Cap, ok bool, msg bytes) bool {
  if !ok {
    ovid/io.Eprint(io, msg)
    ovid/io.Eprint(io, "\n")
  }
  return ok
}
