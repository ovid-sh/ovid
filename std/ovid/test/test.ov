package ovid/test

import ovid/io

// Eq reports whether got equals want. If not, it writes
// "got <got>, want <want>" to stderr, which ovid test shows as the failed
// test's output:
//   if !ovid/test.Eq(io, Sum(s), 10) {
//     return 1
//   }
func Eq(io *ovid/io.Cap, got i64, want i64) bool {
  if got == want {
    return true
  }
  ovid/io.Eprint("got ")
  ovid/io.WriteInt(io, 2, got)
  ovid/io.Eprint(", want ")
  ovid/io.WriteInt(io, 2, want)
  ovid/io.Eprint("\n")
  return false
}

// True reports ok. If it is false, it writes msg and a newline to
// stderr: ovid/test.True(n > 0, "n is positive").
func True(ok bool, msg bytes) bool {
  if !ok {
    ovid/io.Eprint(msg)
    ovid/io.Eprint("\n")
  }
  return ok
}
