package ovid/mem

import ovid/io

// Buf is a growable byte buffer: data[0:len], capacity cap.
type Buf struct {
  data i64
  len i64
  cap i64
}

// Eq reports whether a and b hold the same bytes.
func Eq(a bytes, b bytes) bool {
  return EqN(ptr(a), len(a), ptr(b), len(b))
}

// EqN reports whether the an bytes at a equal the bn bytes at b.
func EqN(a i64, an i64, b i64, bn i64) bool {
  if an != bn {
    return false
  }
  var i i64 = 0
  while (i + 8) <= an {
    if load64(a + i) != load64(b + i) {
      return false
    }
    i = i + 8
  }
  while i < an {
    if load8(a + i) != load8(b + i) {
      return false
    }
    i = i + 1
  }
  return true
}

// EqC compares the NUL-terminated string at p with lit. For an
// argument, ovid/mem.Eq(ovid/io.Arg(io, 1), "-v") is the form: Arg is
// empty past the last argument, where ArgC is 0.
func EqC(p i64, lit bytes) bool {
  return EqN(p, ovid/io.CLen(p), ptr(lit), len(lit))
}

// Copy copies src into dst, which must have room (a shorter dst is a
// failed check), and returns the count.
func Copy(dst bytes, src bytes) i64 {
  var n i64 = len(src)
  if n > 0 {
    dst[n - 1] = dst[n - 1]
  }
  return CopyN(ptr(dst), ptr(src), n)
}

// Bytes is the bytes b holds so far.
func Bytes(b *Buf) bytes {
  return bytes(b.data, b.len)
}

// CopyN copies n bytes from src to dst and returns n.
func CopyN(dst i64, src i64, n i64) i64 {
  var i i64 = 0
  // Eight bytes at a time, unless dst starts inside the word being read:
  // there the byte loop's result (the bytes repeat) is the defined one.
  if dst < src || (dst - src) >= 8 {
    while (i + 8) <= n {
      store64(dst + i, load64(src + i))
      i = i + 8
    }
  }
  while i < n {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  return n
}

// New is an empty Buf with room for cap bytes.
func New(io *ovid/io.Cap, cap i64) *Buf {
  var raw i64 = ovid/io.Alloc(io, sizeof(Buf))
  var b *Buf = raw as *Buf
  b.data = ovid/io.Alloc(io, cap)
  b.len = 0
  b.cap = cap
  return b
}

// Grow makes room for need more bytes and returns 0.
func Grow(io *ovid/io.Cap, b *Buf, need i64) i64 {
  if (b.len + need) <= b.cap {
    return 0
  }
  var nc i64 = b.cap * 2
  if nc < 64 {
    nc = 64
  }
  while (b.len + need) > nc {
    nc = nc * 2
  }
  var nd i64 = ovid/io.Alloc(io, nc)
  CopyN(nd, b.data, b.len)
  b.data = nd
  b.cap = nc
  return 0
}

// WByte appends the byte c.
func WByte(io *ovid/io.Cap, b *Buf, c i64) i64 {
  Grow(io, b, 1)
  store8(b.data + b.len, c)
  b.len = b.len + 1
  return 0
}

// WBytes appends s.
func WBytes(io *ovid/io.Cap, b *Buf, s bytes) i64 {
  return WBytesN(io, b, ptr(s), len(s))
}

// WBytesN appends n bytes at p.
func WBytesN(io *ovid/io.Cap, b *Buf, p i64, n i64) i64 {
  Grow(io, b, n)
  CopyN(b.data + b.len, p, n)
  b.len = b.len + n
  return 0
}

// FormatI64 writes v in decimal at dst and returns the length. dst needs
// 52 bytes: digits are staged at dst+32.
func FormatI64(dst i64, v i64) i64 {
  if v == 0 {
    store8(dst, 48)
    return 1
  }
  // The digits come from negative remainders, so the most negative i64,
  // which has no positive counterpart, works too.
  var x i64 = v
  if v > 0 {
    x = 0 - v
  }
  var tmp i64 = dst + 32
  var n i64 = 0
  while x != 0 {
    store8(tmp + n, 48 - (x % 10))
    n = n + 1
    x = x / 10
  }
  var o i64 = 0
  if v < 0 {
    store8(dst, 45)
    o = 1
  }
  var i i64 = 0
  while i < n {
    store8((dst + o) + i, load8(((tmp + n) - 1) - i))
    i = i + 1
  }
  return o + n
}

// HexOut writes the low width nibbles of v as lowercase hex at dst.
func HexOut(dst i64, v i64, width i64) i64 {
  var i i64 = width - 1
  while i >= 0 {
    var nib i64 = v & 15
    var ch i64 = 48 + nib
    if nib >= 10 {
      ch = 87 + nib
    }
    store8(dst + i, ch)
    v = v >> 4
    i = i - 1
  }
  return width
}
